# Root environment for docker compose and local scripts.
# Copy to .env and fill in. Never commit the real file.

POSTGRES_USER=mockmate
POSTGRES_PASSWORD=mockmate
POSTGRES_DB=mockmate

ENVIRONMENT=local
DEBUG=true
# 32+ characters in production; the API refuses to start with the default.
SECRET_KEY=change-me-use-a-long-random-string
BACKEND_CORS_ORIGINS=http://localhost:3000

# Browser-visible URLs (baked into the frontend bundle at build time).
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# AI provider credentials are read by FastAPI only; never use NEXT_PUBLIC_ here.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=60

# Optional local LLM configuration.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# Payments. Leave empty to keep checkout in the "not configured" state.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_BASE_URL=https://api.razorpay.com/v1
FOUNDER_EMAIL=founder@example.com
