# Root environment for docker compose and local scripts.
# Copy to .env and fill in. Never commit the real file.

POSTGRES_USER=mockmate
POSTGRES_PASSWORD=mockmate
POSTGRES_DB=mockmate

ENVIRONMENT=local
DEBUG=true
SECRET_KEY=change-me-use-a-long-random-string
BACKEND_CORS_ORIGINS=http://localhost:3000

NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=60
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# Cashfree Payment Gateway: start with sandbox credentials, never commit secrets.
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
CASHFREE_BASE_URL=https://sandbox.cashfree.com/pg
CASHFREE_API_VERSION=2023-08-01
FRONTEND_BASE_URL=http://localhost:3000
FOUNDER_EMAIL=founder@example.com
