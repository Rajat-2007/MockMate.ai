        "w": 1280,
        "h": 0
      },
      "html": "<style>\n@import url('https://fonts.googleapis.com/css2?family=Kumbh+Sans:wght@400;500;600;700&family=Share+Tech+Mono&display=swap');\n@import url(\"https://cdn.jsdelivr.net/npm/lucide-static@1.48.0/font/lucide.css\");\n:root{\n  --ground:#F2F4FF; --ink:#13293D; --ink-70:rgba(19,41,61,.70); --ink-50:rgba(19,41,61,.52);\n  --accent:#006494; --band:#A9D3FF; --support:#96C5F7;\n  --line:rgba(19,41,61,.14); --line-2:rgba(0,100,148,.22);\n  --cta-a:#4F46E5; --cta-b:#2563EB;\n}\n*{box-sizing:border-box}\nbody{margin:0;background:var(--ground);color:var(--ink);font-family:'Kumbh Sans',system-ui,sans-serif;-webkit-font-smoothing:antialiased}\nh1,h2,h3,p,ul,ol{margin:0;padding:0}\nul{list-style:none}\na{text-decoration:none;color:inherit}\n.mono{font-family:'Share Tech Mono',ui-monospace,monospace;letter-spacing:.02em}\n.wrap{max-width:1180px;margin:0 auto;padding:0 32px}\n.band{background:var(--band)}\n.hair{border-top:1px solid var(--line)}\n\n/* nav */\n.nav{border-bottom:1px solid var(--line);background:var(--ground)}\n.nav-in{height:70px;display:flex;align-items:center;gap:36px}\n.brand{display:flex;align-items:center;gap:10px;font-weight:600;font-size:17px;letter-spacing:-.01em}\n.mark{width:26px;height:26px;border-radius:4px;background:var(--ink);display:flex;align-items:flex-end;justify-content:center;gap:2px;padding:6px 5px}\n.mark i{display:block;width:2px;background:var(--support);border-radius:1px}\n.mark i:nth-child(1){height:60%}.mark i:nth-child(2){height:100%}.mark i:nth-child(3){height:44%}\n.nav-links{display:flex;gap:26px;margin-left:8px;font-size:14px;color:var(--ink-70)}\n.nav-links a:hover{color:var(--accent)}\n.nav-right{margin-left:auto;display:flex;align-items:center;gap:18px}\n.nav-login{font-size:14px;font-weight:500;color:var(--ink-70)}\n.btn{display:inline-flex;align-items:center;gap:8px;border-radius:6px;font-weight:600;font-size:14px;padding:11px 18px;border:1px solid transparent}\n.btn-primary{background:linear-gradient(90deg,var(--cta-a),var(--cta-b));color:#fff;box-shadow:0 8px 18px -12px rgba(79,70,229,.9)}\n.btn-primary:hover{filter:brightness(1.06)}\n.btn-line{border-color:var(--line-2);color:var(--accent);background:transparent}\n.btn-sm{padding:9px 14px;font-size:13px}\n\n/* hero */\n.hero{display:grid;grid-template-columns:minmax(0,.92fr) minmax(0,1.08fr);gap:52px;padding:60px 0 64px;align-items:center}\n.hero h1{font-size:57px;line-height:1.02;letter-spacing:-.028em;font-weight:600}\n.hero-sub{margin-top:22px;font-size:16.5px;line-height:1.62;color:var(--ink-70);max-width:430px}\n.hero-cta{margin-top:30px;display:flex;align-items:center;gap:22px}\n.link-arrow{display:inline-flex;align-items:center;gap:7px;font-size:14px;font-weight:500;color:var(--accent);border-bottom:1px solid var(--line-2);padding-bottom:2px}\n.microcopy{margin-top:16px;font-size:12px;color:var(--ink-50)}\n\n.bento{display:grid;grid-template-columns:1.32fr 1fr;gap:12px}\n.screen{background:var(--ink);border-radius:8px;padding:16px;color:#F2F4FF;box-shadow:0 18px 34px -26px rgba(19,41,61,.85);display:flex;flex-direction:column;gap:14px}\n.screen-top{display:flex;align-items:center;gap:6px;flex-wrap:wrap}\n.chip{font-size:10.5px;font-family:'Share Tech Mono',monospace;padding:3px 7px;border:1px solid rgba(242,244,255,.26);border-radius:4px;color:rgba(242,244,255,.9)}\n.chip.on{background:var(--support);border-color:var(--support);color:#13293D}\n.screen-timer{margin-left:auto;font-family:'Share Tech Mono',monospace;font-size:11px;color:rgba(242,244,255,.72)}\n.q{font-size:14.5px;line-height:1.5;color:#F2F4FF}\n.q-tag{font-family:'Share Tech Mono',monospace;font-size:10.5px;color:var(--support);margin-bottom:7px}\n.wave{display:flex;align-items:flex-end;gap:3px;height:52px}\n.wave i{flex:1;min-width:0;background:var(--support);border-radius:1px;animation:tick 2.4s ease-in-out infinite}\n.wave i:nth-child(4n+1){height:30%}\n.wave i:nth-child(4n+2){height:76%;animation-duration:1.7s}\n.wave i:nth-child(4n+3){height:48%}\n.wave i:nth-child(4n+4){height:94%;animation-duration:3.1s}\n@keyframes tick{0%,100%{transform:scaleY(.72)}50%{transform:scaleY(1)}}\n.wave i{transform-origin:bottom}\n.answer{display:flex;align-items:center;gap:10px;background:rgba(242,244,255,.07);border:1px solid rgba(242,244,255,.14);border-radius:6px;padding:9px 10px}\n.mic{width:32px;height:32px;border-radius:50%;background:var(--support);color:#13293D;display:flex;align-items:center;justify-content:center;font-size:15px;flex:none}\n.answer-txt{font-size:11.5px;color:rgba(242,244,255,.66);line-height:1.4}\n.answer-txt b{display:block;color:#F2F4FF;font-weight:500;font-size:12px}\n\n.mini{background:#fff;border:1px solid var(--line);border-radius:8px;padding:14px;display:flex;flex-direction:column;gap:10px}\n.mini-h{display:flex;align-items:baseline;justify-content:space-between;font-size:11.5px;color:var(--ink-70)}\n.mini-h .mono{font-size:12px;color:var(--ink)}\n.lvl{display:flex;gap:3px;align-items:flex-end;height:34px}\n.lvl span{flex:1;height:100%;background:rgba(19,41,61,.11);border-radius:1px}\n.lvl span:nth-child(-n+9){background:var(--accent)}\n.lvl span:nth-child(n+10):nth-child(-n+11){background:var(--support)}\n.rail{height:4px;border-radius:2px;background:rgba(19,41,61,.1);overflow:hidden}\n.lvl-row{display:grid;grid-template-columns:1fr 34px;gap:8px;align-items:center;margin-top:8px}\n.lvl-row span:first-child{font-size:11.5px;color:var(--ink-70)}\n.lvl-row .v{font-family:'Share Tech Mono',monospace;font-size:11px;text-align:right}\n.lvl-row i{display:block;height:4px;border-radius:2px;background:var(--accent)}\n.ov{display:flex;align-items:baseline;gap:6px;margin-top:2px}\n.ov b{font-size:22px;font-weight:600;letter-spacing:-.02em}\n.ov span{font-size:11px;color:var(--ink-50)}\n\n/* capabilities */\n.caps{display:grid;grid-template-columns:repeat(4,1fr);padding:26px 0 30px}\n.cap{padding:0 22px;border-left:1px solid var(--line)}\n.cap:first-child{padding-left:0;border-left:0}\n.cap b{font-family:'Share Tech Mono',monospace;font-size:27px;font-weight:400;display:block;letter-spacing:-.01em}\n.cap span{font-size:12.5px;color:var(--ink-70);display:block;margin-top:4px}\n\n/* section shells */\n.sec{padding:80px 0}\n.sec-h{display:flex;align-items:flex-end;justify-content:space-between;gap:32px;margin-bottom:34px}\n.sec-h h2{font-size:34px;line-height:1.1;letter-spacing:-.024em;font-weight:600;max-width:520px}\n.sec-h p{font-size:14px;color:var(--ink-70);max-width:360px;line-height:1.6}\n\n/* cascade steps */\n.cascade{display:flex;flex-direction:column;gap:9px}\n.step{background:var(--ground);border:1px solid var(--line-2);border-radius:8px;padding:17px 20px;display:grid;grid-template-columns:44px 1fr auto;gap:16px;align-items:center}\n.step:nth-child(2){margin-left:6%}\n.step:nth-child(3){margin-left:12%}\n.step:nth-child(4){margin-left:18%}\n.step:nth-child(5){margin-left:24%}\n.step-n{font-family:'Share Tech Mono',monospace;font-size:12px;color:var(--accent)}\n.step h3{font-size:16.5px;font-weight:600;letter-spacing:-.01em}\n.step p{font-size:13px;color:var(--ink-70);margin-top:3px}\n.step i{font-size:15px;color:var(--accent)}\n\n/* categories */\n.cats{display:grid;grid-template-columns:1fr 1fr;column-gap:56px}\n.cat{display:grid;grid-template-columns:20px 1fr 18px;gap:14px;align-items:center;padding:15px 4px;border-top:1px solid var(--line);transition:background .15s}\n.cat:hover{background:rgba(169,211,255,.28)}\n.cat i{font-size:16px;color:var(--accent)}\n.cat b{font-size:16px;font-weight:600;display:block;letter-spacing:-.01em}\n.cat span{font-size:12.5px;color:var(--ink-70);display:block;margin-top:2px}\n.cat .ar{font-size:14px;color:var(--ink-50)}\n\n/* personas + languages */\n.personas{display:grid;grid-template-columns:.78fr 1.22fr;border-radius:8px;overflow:visible;margin-top:6px}\n.dark-panel{background:var(--ink);border-radius:8px;padding:30px 86px 26px 28px;display:flex;flex-direction:column;justify-content:flex-end;gap:18px;color:#F2F4FF;min-height:430px}\n.dark-panel h3{font-size:21px;font-weight:600;letter-spacing:-.015em}\n.dark-panel .wave{height:44px;margin-top:2px}\n.dark-panel .wave i{background:var(--support);opacity:.9}\n.langs{display:flex;flex-wrap:wrap;gap:6px}\n.lang{font-size:11.5px;padding:5px 9px;border:1px solid rgba(242,244,255,.24);border-radius:4px;color:rgba(242,244,255,.92)}\n.lang.on{background:var(--support);border-color:var(--support);color:#13293D;font-weight:500}\n.note{font-size:11px;line-height:1.5;color:rgba(242,244,255,.56)}\n.card-white{background:#fff;border:1px solid var(--line);border-radius:8px;padding:26px 28px;margin-left:-56px;margin-top:34px;margin-bottom:34px;position:relative;box-shadow:0 16px 30px -28px rgba(19,41,61,.7)}\n.card-white h3{font-size:19px;font-weight:600;letter-spacing:-.01em;margin-bottom:4px}\n.card-white .sub{font-size:12.5px;color:var(--ink-70);margin-bottom:14px}\n.p-row{display:grid;grid-template-columns:1fr auto;gap:16px;padding:12px 0;border-top:1px solid var(--line);align-items:start}\n.p-row b{font-size:15px;font-weight:600;display:block}\n.p-row span{font-size:12.5px;color:var(--ink-70);display:block;margin-top:3px;max-width:300px;line-height:1.5}\n.p-row em{font-family:'Share Tech Mono',monospace;font-style:normal;font-size:10.5px;color:var(--accent);border:1px solid var(--line-2);border-radius:4px;padding:3px 7px;white-space:nowrap}\n\n/* features */\n.feat{display:grid;grid-template-columns:repeat(5,1fr);grid-template-rows:170px 170px;gap:11px}\n.feat .giant{grid-column:span 3;grid-row:span 2;background:var(--ground);border:1px solid var(--line-2);border-radius:8px;padding:24px;display:flex;flex-direction:column}\n.cell{background:var(--ground);border:1px solid var(--line-2);border-radius:8px;padding:16px;display:flex;flex-direction:column;gap:8px;overflow:hidden}\n.cell h4{font-size:14px;font-weight:600;letter-spacing:-.01em}\n.cell p{font-size:11.5px;color:var(--ink-70);line-height:1.45}\n.giant h4{font-size:22px;font-weight:600;letter-spacing:-.02em}\n.giant p{font-size:13px;color:var(--ink-70);max-width:330px;margin-top:6px;line-height:1.55}\n.giant .wave{height:76px;margin:auto 0}\n.controls{display:flex;align-items:center;gap:8px;margin-top:auto}\n.ctl{width:34px;height:34px;border-radius:6px;border:1px solid var(--line-2);display:flex;align-items:center;justify-content:center;font-size:14px;color:var(--accent)}\n.ctl.dark{background:var(--ink);border-color:var(--ink);color:#F2F4FF}\n.ctl.mono-t{width:auto;padding:0 10px;font-family:'Share Tech Mono',monospace;font-size:11px;margin-left:auto;border-color:var(--line)}\n.tokens{font-family:'Share Tech Mono',monospace;font-size:11px;line-height:1.7;color:var(--ink-70)}\n.tokens b{color:var(--accent);font-weight:400}\n.tokens u{color:#7a3fb0;text-decoration:none}\n.bars{display:flex;align-items:flex-end;gap:4px;height:44px;margin-top:auto}\n.bars i{flex:1;background:var(--support);border-radius:1px}\n.bars i:nth-child(1){height:38%}.bars i:nth-child(2){height:56%}.bars i:nth-child(3){height:44%}\n.bars i:nth-child(4){height:72%}.bars i:nth-child(5){height:88%}.bars i:nth-child(6){height:64%}\n.bars i:nth-child(7){height:96%}\n.doc{display:flex;flex-direction:column;gap:4px;margin-top:auto}\n.doc i{display:block;height:4px;border-radius:1px;background:rgba(19,41,61,.14)}\n.doc i:nth-child(1){width:86%}.doc i:nth-child(2){width:64%}.doc i:nth-child(3){width:74%}\n.doc i:nth-child(4){width:40%;background:var(--accent)}\n\n/* pricing */\n.plans{display:grid;grid-template-columns:repeat(3,1fr);gap:0;border-top:1px solid var(--line)}\n.plan{padding:26px 26px 28px;border-left:1px solid var(--line);display:flex;flex-direction:column}\n.plan:first-child{border-left:0;padding-left:0}\n.plan:last-child{padding-right:0}\n.plan h3{font-size:16px;font-weight:600}\n.plan .who{font-size:12px;color:var(--ink-70);margin-top:5px;min-height:34px;line-height:1.5}\n.price{display:flex;align-items:baseline;gap:5px;margin:14px 0 18px}\n.price b{font-size:34px;font-weight:600;letter-spacing:-.03em}\n.price span{font-size:12px;color:var(--ink-50)}\n.limits{display:flex;flex-direction:column;gap:0;margin-bottom:22px}\n.limits div{display:grid;grid-template-columns:1fr auto;gap:10px;font-size:12.5px;padding:8px 0;border-top:1px dashed rgba(19,41,61,.13);color:var(--ink-70)}\n.limits div b{font-family:'Share Tech Mono',monospace;font-weight:400;font-size:12px;color:var(--ink)}\n.plan .btn{margin-top:auto;justify-content:center}\n.every{border-top:1px solid var(--line);margin-top:26px;padding-top:16px;display:flex;gap:26px;flex-wrap:wrap;font-size:12.5px;color:var(--ink-70)}\n.every span{display:inline-flex;align-items:center;gap:7px}\n.every i{font-size:14px;color:var(--accent)}\n.proposed{margin-top:14px;font-size:11.5px;color:var(--ink-50)}\n\n/* faq */\n.faq{display:grid;grid-template-columns:1fr 268px;gap:56px;align-items:start}\n.q-item{padding:18px 0;border-top:1px solid var(--line)}\n.q-item h4{font-size:15.5px;font-weight:600;letter-spacing:-.01em}\n.q-item p{font-size:13.5px;line-height:1.62;color:var(--ink-70);margin-top:7px;max-width:640px}\n.callout{background:rgba(169,211,255,.42);border:1px solid var(--line-2);border-radius:8px;padding:20px}\n.callout h4{font-size:14px;font-weight:600}\n.callout p{font-size:12.5px;line-height:1.55;color:var(--ink-70);margin:7px 0 14px}\n.callout a{font-size:12.5px;font-weight:600;color:var(--accent);border-bottom:1px solid var(--line-2);display:inline-block;padding-bottom:2px}\n\n/* closing cta */\n.closer{display:flex;align-items:center;justify-content:space-between;gap:80px;padding:60px 0;min-height:250px}\n.closer h2{font-size:36px;line-height:1.08;letter-spacing:-.028em;font-weight:600;max-width:440px}\n.closer p{font-size:13.5px;color:var(--ink-70);margin-top:12px}\n.closer-right{display:flex;flex-direction:column;align-items:flex-end;gap:12px;flex:none}\n.closer-right a.link-arrow{color:var(--ink);border-color:rgba(19,41,61,.3)}\n\n/* footer */\n.foot{padding:48px 0 26px}\n.foot-grid{display:grid;grid-template-columns:1.7fr 1fr 1fr 1fr 1fr;gap:32px}\n.foot h5{font-size:11px;font-family:'Share Tech Mono',monospace;font-weight:400;color:var(--ink-50);text-transform:uppercase;letter-spacing:.08em;margin-bottom:12px}\n.foot li{font-size:13px;color:var(--ink-70);margin-bottom:9px}\n.foot li a:hover{color:var(--accent)}\n.foot-brand p{font-size:12.5px;color:var(--ink-70);margin-top:12px;max-width:230px;line-height:1.6}\n.foot-bottom{display:flex;align-items:center;justify-content:space-between;border-top:1px solid var(--line);margin-top:34px;padding-top:18px;font-size:11.5px;color:var(--ink-50)}\n.social{display:flex;gap:14px;font-size:15px;color:var(--ink-70)}\n\n@media (max-width:1024px){\n  .hero{grid-template-columns:1fr;gap:40px;padding:40px 0 48px}\n  .hero h1{font-size:42px}\n  .caps{grid-template-columns:1fr 1fr;row-gap:24px}\n  .cap:nth-child(3){padding-left:0;border-left:0}\n  .personas{grid-template-columns:1fr}\n  .dark-panel{min-height:auto;padding:24px}\n  .card-white{margin:-24px 16px 16px;padding:22px}\n  .feat{grid-template-columns:1fr 1fr;grid-template-rows:auto}\n  .feat .giant{grid-column:span 2;grid-row:auto}\n  .plans{grid-template-columns:1fr}\n  .plan{border-left:0;border-top:1px solid var(--line);padding:22px 0}\n  .plan:first-child{border-top:0}\n  .faq{grid-template-columns:1fr;gap:28px}\n  .closer{flex-direction:column;align-items:flex-start;gap:26px;padding:44px 0}\n  .closer-right{align-items:flex-start}\n  .foot-grid{grid-template-columns:1fr 1fr}\n  .cats{grid-template-columns:1fr}\n}\n@media (max-width:720px){\n  .wrap{padding:0 20px}\n  .nav-links,.nav-login{display:none}\n  .hero h1{font-size:34px;line-height:1.06}\n  .hero-sub{font-size:15px}\n  .bento{grid-template-columns:1fr}\n  .caps{grid-template-columns:1fr 1fr}\n  .step{grid-template-columns:36px 1fr;padding:15px}\n  .step:nth-child(2),.step:nth-child(3),.step:nth-child(4),.step:nth-child(5){margin-left:0}\n  .sec{padding:56px 0}\n  .sec-h{flex-direction:column;align-items:flex-start;gap:12px}\n  .sec-h h2{font-size:26px}\n  .feat{grid-template-columns:1fr}\n  .feat .giant{grid-column:span 1}\n  .foot-grid{grid-template-columns:1fr 1fr}\n}\n</style>\n<header class=\"nav\" data-kid=\"1\" data-name=\"site header\">\n<div class=\"wrap nav-in\" data-kid=\"1-1\" data-name=\"main navigation bar container\">\n<a class=\"brand\" data-kid=\"1-1-1\" data-name=\"brand logo link\" href=\"/\"><span class=\"mark\" data-kid=\"1-1-1-1\" data-name=\"brand logo mark\"><i data-kid=\"1-1-1-1-1\" data-name=\"logo mark left bar\"></i><i data-kid=\"1-1-1-1-2\" data-name=\"logo mark center bar\"></i><i data-kid=\"1-1-1-1-3\" data-name=\"logo mark right bar\"></i></span>MockMate AI</a>\n<nav class=\"nav-links\" data-kid=\"1-1-2\" data-name=\"primary navigation links\">\n<a data-kid=\"1-1-2-1\" data-name=\"features nav link\" href=\"/features\">Features</a>\n<a data-kid=\"1-1-2-2\" data-name=\"how it works nav link\" href=\"/how-it-works\">How it works</a>\n<a data-kid=\"1-1-2-3\" data-name=\"interviews nav link\" href=\"/interview-questions\">Interviews</a>\n<a data-kid=\"1-1-2-4\" data-name=\"pricing nav link\" href=\"/pricing\">Pricing</a>\n<a data-kid=\"1-1-2-5\" data-name=\"resources nav link\" href=\"/blog\">Resources</a>\n</nav>\n<div class=\"nav-right\" data-kid=\"1-1-3\" data-name=\"navigation actions group\">\n<a class=\"nav-login\" data-kid=\"1-1-3-1\" data-name=\"log in link\" href=\"/login\">Log in</a>\n<a class=\"btn btn-primary btn-sm\" data-kid=\"1-1-3-2\" data-name=\"start free interview header button\" href=\"/signup\">Start free interview</a>\n</div>\n</div>\n</header>\n<main data-kid=\"2\" data-name=\"main content\">\n<section class=\"wrap hero\" data-kid=\"2-1\" data-name=\"hero section\">\n<div data-kid=\"2-1-1\" data-name=\"hero text column\">\n<h1 data-kid=\"2-1-1-1\" data-name=\"hero headline text\">Practice Smarter.<br data-kid=\"2-1-1-1-1\" data-name=\"headline line break\"/>Interview Better.<br data-kid=\"2-1-1-1-2\" data-name=\"headline line break\"/>Get Career Ready.</h1>\n<p class=\"hero-sub\" data-kid=\"2-1-1-2\" data-name=\"hero subheading text\">Prepare for your next opportunity with AI-powered mock interviews, personalized feedback and realistic interview practice for every career path.</p>\n<div class=\"hero-cta\" data-kid=\"2-1-1-3\" data-name=\"hero call-to-action group\">\n<a class=\"btn btn-primary\" data-kid=\"2-1-1-3-1\" data-name=\"primary start free interview button\" href=\"/signup\">Start Free Interview</a>\n<a class=\"link-arrow\" data-kid=\"2-1-1-3-2\" data-name=\"see how it works link with arrow\" href=\"#how\">See how it works <i class=\"icon-arrow-right\" data-kid=\"2-1-1-3-2-1\" data-name=\"right arrow icon\"></i></a>\n</div>\n<p class=\"microcopy\" data-kid=\"2-1-1-4\" data-name=\"free plan microcopy text\">Free plan: 3 interviews a month, text mode, no card required.</p>\n</div>\n<div class=\"bento\" data-kid=\"2-1-2\" data-name=\"product preview bento grid\">\n<div class=\"screen\" data-kid=\"2-1-2-1\" data-name=\"interview practice screen mockup\">\n<div class=\"screen-top\" data-kid=\"2-1-2-1-1\" data-name=\"screen chip row\">\n<span class=\"chip on\" data-kid=\"2-1-2-1-1-1\" data-name=\"technical category chip\">Technical</span><span class=\"chip\" data-kid=\"2-1-2-1-1-2\" data-name=\"degree and branch chip\">B.Tech · CSE</span><span class=\"chip\" data-kid=\"2-1-2-1-1-3\" data-name=\"difficulty chip\">Hard</span>\n<span class=\"screen-timer\" data-kid=\"2-1-2-1-1-4\" data-name=\"remaining time label\">18:42 left</span>\n</div>\n<div data-kid=\"2-1-2-1-2\" data-name=\"current question block\">\n<div class=\"q-tag\" data-kid=\"2-1-2-1-2-1\" data-name=\"question counter label\">Q6 / 12</div>\n<p class=\"q\" data-kid=\"2-1-2-1-2-2\" data-name=\"interview question text\">You mentioned a payment webhook in your project. What happens when the same event arrives twice?</p>\n</div>\n<div class=\"wave\" data-kid=\"2-1-2-1-3\" data-name=\"audio waveform visualizer\">\n<i data-kid=\"2-1-2-1-3-1\" data-name=\"waveform bar\"></i><i data-kid=\"2-1-2-1-3-2\" data-name=\"waveform bar\"></i><i data-kid=\"2-1-2-1-3-3\" data-name=\"waveform bar\"></i><i data-kid=\"2-1-2-1-3-4\" data-name=\"waveform bar\"></i><i data-kid=\"2-1-2-1-3-5\" data-name=\"waveform bar\"></i><i data-kid=\"2-1-2-1-3-6\" data-name=\"waveform bar\"></i><i data-kid=\"2-1-2-1-3-7\" data-name=\"waveform bar\"></i><i data-kid=\"2-1-2-1-3-8\" data-name=\"waveform bar\"></i><i data-kid=\"2-1-2-1-3-9\" data-name=\"waveform bar\"></i><i data-kid=\"2-1-2-1-3-10\" data-name=\"waveform bar\"></i><i data-kid=\"2-1-2-1-3-11\" data-name=\"waveform bar\"></i><i data-kid=\"2-1-2-1-3-12\" data-name=\"waveform bar\"></i>\n<i data-kid=\"2-1-2-1-3-13\" data-name=\"waveform bar\"></i><i data-kid=\"2-1-2-1-3-14\" data-name=\"waveform bar\"></i><i data-kid=\"2-1-2-1-3-15\" data-name=\"waveform bar\"></i><i data-kid=\"2-1-2-1-3-16\" data-name=\"waveform bar\"></i><i data-kid=\"2-1-2-1-3-17\" data-name=\"waveform bar\"></i><i data-kid=\"2-1-2-1-3-18\" data-name=\"waveform bar\"></i><i data-kid=\"2-1-2-1-3-19\" data-name=\"waveform bar\"></i><i data-kid=\"2-1-2-1-3-20\" data-name=\"waveform bar\"></i><i data-kid=\"2-1-2-1-3-21\" data-name=\"waveform bar\"></i><i data-kid=\"2-1-2-1-3-22\" data-name=\"waveform bar\"></i><i data-kid=\"2-1-2-1-3-23\" data-name=\"waveform bar\"></i><i data-kid=\"2-1-2-1-3-24\" data-name=\"waveform bar\"></i>\n</div>\n<div class=\"answer\" data-kid=\"2-1-2-1-4\" data-name=\"listening answer status bar\">\n<span class=\"mic\" data-kid=\"2-1-2-1-4-1\" data-name=\"microphone icon badge\"><i class=\"icon-mic\" data-kid=\"2-1-2-1-4-1-1\" data-name=\"microphone icon\"></i></span>\n<span class=\"answer-txt\" data-kid=\"2-1-2-1-4-2\" data-name=\"listening status text\"><b data-kid=\"2-1-2-1-4-2-1\" data-name=\"listening status heading\">Listening</b>Answer in English or switch to Hindi</span>\n<span class=\"chip\" data-kid=\"2-1-2-1-4-3\" data-name=\"answer elapsed time chip\">00:14</span>\n</div>\n</div>\n<div data-kid=\"2-1-2-2\" data-name=\"input level and scores panel column\" style=\"display:flex;flex-direction:column;gap:12px\">\n<div class=\"mini\" data-kid=\"2-1-2-2-1\" data-name=\"input level meter card\">\n<div class=\"mini-h\" data-kid=\"2-1-2-2-1-1\" data-name=\"input level header row\"><span data-kid=\"2-1-2-2-1-1-1\" data-name=\"input level label\">Input level</span><span class=\"mono\" data-kid=\"2-1-2-2-1-1-2\" data-name=\"input level decibel readout\">-12 dB</span></div>\n<div class=\"lvl\" data-kid=\"2-1-2-2-1-2\" data-name=\"input level bar meter\"><span data-kid=\"2-1-2-2-1-2-1\" data-name=\"level meter segment\"></span><span data-kid=\"2-1-2-2-1-2-2\" data-name=\"level meter segment\"></span><span data-kid=\"2-1-2-2-1-2-3\" data-name=\"level meter segment\"></span><span data-kid=\"2-1-2-2-1-2-4\" data-name=\"level meter segment\"></span><span data-kid=\"2-1-2-2-1-2-5\" data-name=\"level meter segment\"></span><span data-kid=\"2-1-2-2-1-2-6\" data-name=\"level meter segment\"></span><span data-kid=\"2-1-2-2-1-2-7\" data-name=\"level meter segment\"></span><span data-kid=\"2-1-2-2-1-2-8\" data-name=\"level meter segment\"></span><span data-kid=\"2-1-2-2-1-2-9\" data-name=\"level meter segment\"></span><span data-kid=\"2-1-2-2-1-2-10\" data-name=\"level meter segment\"></span><span data-kid=\"2-1-2-2-1-2-11\" data-name=\"level meter segment\"></span><span data-kid=\"2-1-2-2-1-2-12\" data-name=\"level meter segment\"></span><span data-kid=\"2-1-2-2-1-2-13\" data-name=\"level meter segment\"></span><span data-kid=\"2-1-2-2-1-2-14\" data-name=\"level meter segment\"></span></div>\n</div>\n<div class=\"mini\" data-kid=\"2-1-2-2-2\" data-name=\"answer scores card\" style=\"flex:1\">\n<div class=\"mini-h\" data-kid=\"2-1-2-2-2-1\" data-name=\"answer scores header row\"><span data-kid=\"2-1-2-2-2-1-1\" data-name=\"answer scores label\">Answer scores</span><span class=\"mono\" data-kid=\"2-1-2-2-2-1-2\" data-name=\"question number tag\">Q6</span></div>\n<div class=\"ov\" data-kid=\"2-1-2-2-2-2\" data-name=\"overall score display\"><b data-kid=\"2-1-2-2-2-2-1\" data-name=\"overall score value\">7.2</b><span data-kid=\"2-1-2-2-2-2-2\" data-name=\"score scale caption\">/ 10 rubric average</span></div>\n<div class=\"lvl-row\" data-kid=\"2-1-2-2-2-3\" data-name=\"knowledge score row\"><span data-kid=\"2-1-2-2-2-3-1\" data-name=\"knowledge score label\">Knowledge</span><span class=\"v\" data-kid=\"2-1-2-2-2-3-2\" data-name=\"knowledge score value\">7.5</span><i data-kid=\"2-1-2-2-2-3-3\" data-name=\"knowledge score progress bar\" style=\"grid-column:1/3;width:75%;margin-top:6px\"></i></div>\n<div class=\"lvl-row\" data-kid=\"2-1-2-2-2-4\" data-name=\"structure score row\"><span data-kid=\"2-1-2-2-2-4-1\" data-name=\"structure score label\">Structure</span><span class=\"v\" data-kid=\"2-1-2-2-2-4-2\" data-name=\"structure score value\">6.0</span><i data-kid=\"2-1-2-2-2-4-3\" data-name=\"structure score progress bar\" style=\"grid-column:1/3;width:60%;margin-top:6px\"></i></div>\n<div class=\"lvl-row\" data-kid=\"2-1-2-2-2-5\" data-name=\"communication score row\"><span data-kid=\"2-1-2-2-2-5-1\" data-name=\"communication score label\">Communication</span><span class=\"v\" data-kid=\"2-1-2-2-2-5-2\" data-name=\"communication score value\">8.0</span><i data-kid=\"2-1-2-2-2-5-3\" data-name=\"communication score progress bar\" style=\"grid-column:1/3;width:80%;margin-top:6px\"></i></div>\n</div>\n</div>\n</div>\n</section>\n<section class=\"wrap\" data-kid=\"2-2\" data-name=\"capability stats section\">\n<div class=\"caps hair\" data-kid=\"2-2-1\" data-name=\"capability stats row\">\n<div class=\"cap\" data-kid=\"2-2-1-1\" data-name=\"interview categories stat\"><b data-kid=\"2-2-1-1-1\" data-name=\"interview categories count\">10</b><span data-kid=\"2-2-1-1-2\" data-name=\"interview categories label\">interview categories</span></div>\n<div class=\"cap\" data-kid=\"2-2-1-2\" data-name=\"interview languages stat\"><b data-kid=\"2-2-1-2-1\" data-name=\"interview languages count\">11</b><span data-kid=\"2-2-1-2-2\" data-name=\"interview languages label\">interview languages</span></div>\n<div class=\"cap\" data-kid=\"2-2-1-3\" data-name=\"interviewer personalities stat\"><b data-kid=\"2-2-1-3-1\" data-name=\"interviewer personalities count\">6</b><span data-kid=\"2-2-1-3-2\" data-name=\"interviewer personalities label\">interviewer personalities</span></div>\n<div class=\"cap\" data-kid=\"2-2-1-4\" data-name=\"coding languages stat\"><b data-kid=\"2-2-1-4-1\" data-name=\"coding languages count\">4</b><span data-kid=\"2-2-1-4-2\" data-name=\"coding languages label\">coding languages</span></div>\n</div>\n</section>\n<section class=\"band\" data-kid=\"2-3\" data-name=\"how it works section\" id=\"how\">\n<div class=\"wrap sec\" data-kid=\"2-3-1\" data-name=\"how it works content container\">\n<div class=\"sec-h\" data-kid=\"2-3-1-1\" data-name=\"how it works section header\">\n<h2 data-kid=\"2-3-1-1-1\" data-name=\"how it works heading\">How a mock interview runs</h2>\n<p data-kid=\"2-3-1-1-2\" data-name=\"how it works intro text\">Five steps from your first profile to a scored report. You can re-run any step before the session starts.</p>\n</div>\n<div class=\"cascade\" data-kid=\"2-3-1-2\" data-name=\"interview steps cascade\">\n<div class=\"step\" data-kid=\"2-3-1-2-1\" data-name=\"step one card\"><span class=\"step-n\" data-kid=\"2-3-1-2-1-1\" data-name=\"step one number\">01</span><div data-kid=\"2-3-1-2-1-2\" data-name=\"step one text block\"><h3 data-kid=\"2-3-1-2-1-2-1\" data-name=\"step one title\">Create your profile</h3><p data-kid=\"2-3-1-2-1-2-2\" data-name=\"step one description\">Course, year of study, experience level and target role.</p></div><i class=\"icon-arrow-up-right\" data-kid=\"2-3-1-2-1-3\" data-name=\"step one arrow icon\"></i></div>\n<div class=\"step\" data-kid=\"2-3-1-2-2\" data-name=\"step two card\"><span class=\"step-n\" data-kid=\"2-3-1-2-2-1\" data-name=\"step two number\">02</span><div data-kid=\"2-3-1-2-2-2\" data-name=\"step two text block\"><h3 data-kid=\"2-3-1-2-2-2-1\" data-name=\"step two title\">Choose your career goal</h3><p data-kid=\"2-3-1-2-2-2-2\" data-name=\"step two description\">Interview category and role, from BCA fresher to credit analyst.</p></div><i class=\"icon-arrow-up-right\" data-kid=\"2-3-1-2-2-3\" data-name=\"step two arrow icon\"></i></div>\n<div class=\"step\" data-kid=\"2-3-1-2-3\" data-name=\"step three card\"><span class=\"step-n\" data-kid=\"2-3-1-2-3-1\" data-name=\"step three number\">03</span><div data-kid=\"2-3-1-2-3-2\" data-name=\"step three text block\"><h3 data-kid=\"2-3-1-2-3-2-1\" data-name=\"step three title\">Select your interview language</h3><p data-kid=\"2-3-1-2-3-2-2\" data-name=\"step three description\">English, Hindi, Hinglish or eight more regional languages.</p></div><i class=\"icon-arrow-up-right\" data-kid=\"2-3-1-2-3-3\" data-name=\"step three arrow icon\"></i></div>\n<div class=\"step\" data-kid=\"2-3-1-2-4\" data-name=\"step four card\"><span class=\"step-n\" data-kid=\"2-3-1-2-4-1\" data-name=\"step four number\">04</span><div data-kid=\"2-3-1-2-4-2\" data-name=\"step four text block\"><h3 data-kid=\"2-3-1-2-4-2-1\" data-name=\"step four title\">Start your AI interview</h3><p data-kid=\"2-3-1-2-4-2-2\" data-name=\"step four description\">Speak or type. Follow-up questions adapt to what you say.</p></div><i class=\"icon-arrow-up-right\" data-kid=\"2-3-1-2-4-3\" data-name=\"step four arrow icon\"></i></div>\n<div class=\"step\" data-kid=\"2-3-1-2-5\" data-name=\"step five card\"><span class=\"step-n\" data-kid=\"2-3-1-2-5-1\" data-name=\"step five number\">05</span><div data-kid=\"2-3-1-2-5-2\" data-name=\"step five text block\"><h3 data-kid=\"2-3-1-2-5-2-1\" data-name=\"step five title\">Receive your performance report</h3><p data-kid=\"2-3-1-2-5-2-2\" data-name=\"step five description\">Rubric scores, missed concepts, better answers and the next interview to try.</p></div><i class=\"icon-arrow-up-right\" data-kid=\"2-3-1-2-5-3\" data-name=\"step five arrow icon\"></i></div>\n</div>\n</div>\n</section>\n<section class=\"wrap sec\" data-kid=\"2-4\" data-name=\"interview categories section\">\n<div class=\"sec-h\" data-kid=\"2-4-1\" data-name=\"interview categories section header\">\n<h2 data-kid=\"2-4-1-1\" data-name=\"interview categories heading\">Interview categories</h2>\n<p data-kid=\"2-4-1-2\" data-name=\"interview categories intro text\">Question banks are written per stream, so a B.Com session asks about accounting and a law session asks about case reasoning.</p>\n</div>\n<div class=\"cats\" data-kid=\"2-4-2\" data-name=\"interview category link grid\">\n<a class=\"cat\" data-kid=\"2-4-2-1\" data-name=\"technical category link\" href=\"/technical-interview\"><i class=\"icon-cpu\" data-kid=\"2-4-2-1-1\" data-name=\"cpu icon\"></i><div data-kid=\"2-4-2-1-2\" data-name=\"technical category text\"><b data-kid=\"2-4-2-1-2-1\" data-name=\"technical category title\">Technical</b><span data-kid=\"2-4-2-1-2-2\" data-name=\"technical category description\">Branch subjects, fundamentals, final-year projects</span></div><i class=\"icon-arrow-up-right ar\" data-kid=\"2-4-2-1-3\" data-name=\"technical category arrow icon\"></i></a>\n<a class=\"cat\" data-kid=\"2-4-2-2\" data-name=\"hr category link\" href=\"/hr-interview\"><i class=\"icon-users\" data-kid=\"2-4-2-2-1\" data-name=\"users icon\"></i><div data-kid=\"2-4-2-2-2\" data-name=\"hr category text\"><b data-kid=\"2-4-2-2-2-1\" data-name=\"hr category title\">HR</b><span data-kid=\"2-4-2-2-2-2\" data-name=\"hr category description\">Motivation, teamwork, salary and notice period</span></div><i class=\"icon-arrow-up-right ar\" data-kid=\"2-4-2-2-3\" data-name=\"hr category arrow icon\"></i></a>\n<a class=\"cat\" data-kid=\"2-4-2-3\" data-name=\"resume-based category link\" href=\"/resume-based-interview\"><i class=\"icon-file-text\" data-kid=\"2-4-2-3-1\" data-name=\"file text icon\"></i><div data-kid=\"2-4-2-3-2\" data-name=\"resume-based category text\"><b data-kid=\"2-4-2-3-2-1\" data-name=\"resume-based category title\">Resume-based</b><span data-kid=\"2-4-2-3-2-2\" data-name=\"resume-based category description\">Questions generated from your uploaded resume</span></div><i class=\"icon-arrow-up-right ar\" data-kid=\"2-4-2-3-3\" data-name=\"resume-based category arrow icon\"></i></a>\n<a class=\"cat\" data-kid=\"2-4-2-4\" data-name=\"coding category link\" href=\"/coding-interview\"><i class=\"icon-code\" data-kid=\"2-4-2-4-1\" data-name=\"code icon\"></i><div data-kid=\"2-4-2-4-2\" data-name=\"coding category text\"><b data-kid=\"2-4-2-4-2-1\" data-name=\"coding category title\">Coding</b><span data-kid=\"2-4-2-4-2-2\" data-name=\"coding category description\">C++, Java, Python, JavaScript with test cases</span></div><i class=\"icon-arrow-up-right ar\" data-kid=\"2-4-2-4-3\" data-name=\"coding category arrow icon\"></i></a>\n<a class=\"cat\" data-kid=\"2-4-2-5\" data-name=\"management category link\" href=\"/interview-questions\"><i class=\"icon-briefcase\" data-kid=\"2-4-2-5-1\" data-name=\"briefcase icon\"></i><div data-kid=\"2-4-2-5-2\" data-name=\"management category text\"><b data-kid=\"2-4-2-5-2-1\" data-name=\"management category title\">Management</b><span data-kid=\"2-4-2-5-2-2\" data-name=\"management category description\">Marketing, finance, operations, case studies</span></div><i class=\"icon-arrow-up-right ar\" data-kid=\"2-4-2-5-3\" data-name=\"management category arrow icon\"></i></a>\n<a class=\"cat\" data-kid=\"2-4-2-6\" data-name=\"commerce category link\" href=\"/interview-preparation/bcom\"><i class=\"icon-calculator\" data-kid=\"2-4-2-6-1\" data-name=\"calculator icon\"></i><div data-kid=\"2-4-2-6-2\" data-name=\"commerce category text\"><b data-kid=\"2-4-2-6-2-1\" data-name=\"commerce category title\">Commerce</b><span data-kid=\"2-4-2-6-2-2\" data-name=\"commerce category description\">Accounting, taxation, banking, economics</span></div><i class=\"icon-arrow-up-right ar\" data-kid=\"2-4-2-6-3\" data-name=\"commerce category arrow icon\"></i></a>\n<a class=\"cat\" data-kid=\"2-4-2-7\" data-name=\"science category link\" href=\"/interview-preparation/bsc\"><i class=\"icon-flask-conical\" data-kid=\"2-4-2-7-1\" data-name=\"flask icon\"></i><div data-kid=\"2-4-2-7-2\" data-name=\"science category text\"><b data-kid=\"2-4-2-7-2-1\" data-name=\"science category title\">Science</b><span data-kid=\"2-4-2-7-2-2\" data-name=\"science category description\">Subject concepts, lab practice, research method</span></div><i class=\"icon-arrow-up-right ar\" data-kid=\"2-4-2-7-3\" data-name=\"science category arrow icon\"></i></a>\n<a class=\"cat\" data-kid=\"2-4-2-8\" data-name=\"law category link\" href=\"/interview-preparation/law\"><i class=\"icon-scale\" data-kid=\"2-4-2-8-1\" data-name=\"scale icon\"></i><div data-kid=\"2-4-2-8-2\" data-name=\"law category text\"><b data-kid=\"2-4-2-8-2-1\" data-name=\"law category title\">Law</b><span data-kid=\"2-4-2-8-2-2\" data-name=\"law category description\">Legal concepts, case analysis, internships</span></div><i class=\"icon-arrow-up-right ar\" data-kid=\"2-4-2-8-3\" data-name=\"law category arrow icon\"></i></a>\n<a class=\"cat\" data-kid=\"2-4-2-9\" data-name=\"medical category link\" href=\"/interview-preparation/medical\"><i class=\"icon-stethoscope\" data-kid=\"2-4-2-9-1\" data-name=\"stethoscope icon\"></i><div data-kid=\"2-4-2-9-2\" data-name=\"medical category text\"><b data-kid=\"2-4-2-9-2-1\" data-name=\"medical category title\">Medical</b><span data-kid=\"2-4-2-9-2-2\" data-name=\"medical category description\">Clinical knowledge, ethics, professional scenarios</span></div><i class=\"icon-arrow-up-right ar\" data-kid=\"2-4-2-9-3\" data-name=\"medical category arrow icon\"></i></a>\n<a class=\"cat\" data-kid=\"2-4-2-10\" data-name=\"general professional category link\" href=\"/interview-for-freshers\"><i class=\"icon-compass\" data-kid=\"2-4-2-10-1\" data-name=\"compass icon\"></i><div data-kid=\"2-4-2-10-2\" data-name=\"general professional category text\"><b data-kid=\"2-4-2-10-2-1\" data-name=\"general professional category title\">General professional</b><span data-kid=\"2-4-2-10-2-2\" data-name=\"general professional category description\">Any role outside the nine above</span></div><i class=\"icon-arrow-up-right ar\" data-kid=\"2-4-2-10-3\" data-name=\"general professional category arrow icon\"></i></a>\n</div>\n</section>\n<section class=\"wrap sec\" data-kid=\"2-5\" data-name=\"interviewer and language section\" style=\"padding-top:0\">\n<div class=\"personas\" data-kid=\"2-5-1\" data-name=\"personas and languages layout\">\n<div class=\"dark-panel\" data-kid=\"2-5-1-1\" data-name=\"language dark panel\">\n<div data-kid=\"2-5-1-1-1\" data-name=\"language panel heading group\">\n<h3 data-kid=\"2-5-1-1-1-1\" data-name=\"interview languages heading\">Interview languages</h3>\n<div class=\"wave\" data-kid=\"2-5-1-1-1-2\" data-name=\"language panel waveform\"><i data-kid=\"2-5-1-1-1-2-1\" data-name=\"language waveform bar\"></i><i data-kid=\"2-5-1-1-1-2-2\" data-name=\"language waveform bar\"></i><i data-kid=\"2-5-1-1-1-2-3\" data-name=\"language waveform bar\"></i><i data-kid=\"2-5-1-1-1-2-4\" data-name=\"language waveform bar\"></i><i data-kid=\"2-5-1-1-1-2-5\" data-name=\"language waveform bar\"></i><i data-kid=\"2-5-1-1-1-2-6\" data-name=\"language waveform bar\"></i><i data-kid=\"2-5-1-1-1-2-7\" data-name=\"language waveform bar\"></i><i data-kid=\"2-5-1-1-1-2-8\" data-name=\"language waveform bar\"></i><i data-kid=\"2-5-1-1-1-2-9\" data-name=\"language waveform bar\"></i><i data-kid=\"2-5-1-1-1-2-10\" data-name=\"language waveform bar\"></i><i data-kid=\"2-5-1-1-1-2-11\" data-name=\"language waveform bar\"></i><i data-kid=\"2-5-1-1-1-2-12\" data-name=\"language waveform bar\"></i></div>\n</div>\n<div class=\"langs\" data-kid=\"2-5-1-1-2\" data-name=\"language chip list\">\n<span class=\"lang on\" data-kid=\"2-5-1-1-2-1\" data-name=\"english language chip\">English</span><span class=\"lang\" data-kid=\"2-5-1-1-2-2\" data-name=\"hindi language chip\">हिन्दी</span><span class=\"lang\" data-kid=\"2-5-1-1-2-3\" data-name=\"hinglish language chip\">Hinglish</span><span class=\"lang\" data-kid=\"2-5-1-1-2-4\" data-name=\"bengali language chip\">বাংলা</span><span class=\"lang\" data-kid=\"2-5-1-1-2-5\" data-name=\"tamil language chip\">தமிழ்</span><span class=\"lang\" data-kid=\"2-5-1-1-2-6\" data-name=\"telugu language chip\">తెలుగు</span><span class=\"lang\" data-kid=\"2-5-1-1-2-7\" data-name=\"marathi language chip\">मराठी</span><span class=\"lang\" data-kid=\"2-5-1-1-2-8\" data-name=\"gujarati language chip\">ગુજરાતી</span><span class=\"lang\" data-kid=\"2-5-1-1-2-9\" data-name=\"kannada language chip\">ಕನ್ನಡ</span><span class=\"lang\" data-kid=\"2-5-1-1-2-10\" data-name=\"malayalam language chip\">മലയാളം</span><span class=\"lang\" data-kid=\"2-5-1-1-2-11\" data-name=\"punjabi language chip\">ਪੰਜਾਬੀ</span>\n</div>\n<p class=\"note\" data-kid=\"2-5-1-1-3\" data-name=\"language speech availability note\">Questions, follow-ups and reports follow the language picked for that session. Speech input and output are enabled per language once its speech tests pass; the typed mode is available in all 11.</p>\n</div>\n<div data-kid=\"2-5-1-2\" data-name=\"interviewer personalities column\">\n<div class=\"card-white\" data-kid=\"2-5-1-2-1\" data-name=\"interviewer personalities card\">\n<h3 data-kid=\"2-5-1-2-1-1\" data-name=\"interviewer personalities heading\">Interviewer personalities</h3>\n<div class=\"sub\" data-kid=\"2-5-1-2-1-2\" data-name=\"interviewer personalities subheading\">The same question set, delivered by a different interviewer.</div>\n<div class=\"p-row\" data-kid=\"2-5-1-2-1-3\" data-name=\"friendly interviewer row\"><div data-kid=\"2-5-1-2-1-3-1\" data-name=\"friendly interviewer text\"><b data-kid=\"2-5-1-2-1-3-1-1\" data-name=\"friendly interviewer name\">Friendly</b><span data-kid=\"2-5-1-2-1-3-1-2\" data-name=\"friendly interviewer description\">Warm tone, longer answers, gentle follow-ups.</span></div><em data-kid=\"2-5-1-2-1-3-2\" data-name=\"friendly interviewer tag\">First attempts</em></div>\n<div class=\"p-row\" data-kid=\"2-5-1-2-1-4\" data-name=\"professional interviewer row\"><div data-kid=\"2-5-1-2-1-4-1\" data-name=\"professional interviewer text\"><b data-kid=\"2-5-1-2-1-4-1-1\" data-name=\"professional interviewer name\">Professional</b><span data-kid=\"2-5-1-2-1-4-1-2\" data-name=\"professional interviewer description\">Keeps to the agenda and to the clock.</span></div><em data-kid=\"2-5-1-2-1-4-2\" data-name=\"professional interviewer tag\">Real conditions</em></div>\n<div class=\"p-row\" data-kid=\"2-5-1-2-1-5\" data-name=\"strict interviewer row\"><div data-kid=\"2-5-1-2-1-5-1\" data-name=\"strict interviewer text\"><b data-kid=\"2-5-1-2-1-5-1-1\" data-name=\"strict interviewer name\">Strict</b><span data-kid=\"2-5-1-2-1-5-1-2\" data-name=\"strict interviewer description\">Presses on thin answers and asks for evidence.</span></div><em data-kid=\"2-5-1-2-1-5-2\" data-name=\"strict interviewer tag\">Pressure rounds</em></div>\n<div class=\"p-row\" data-kid=\"2-5-1-2-1-6\" data-name=\"technical expert interviewer row\"><div data-kid=\"2-5-1-2-1-6-1\" data-name=\"technical expert interviewer text\"><b data-kid=\"2-5-1-2-1-6-1-1\" data-name=\"technical expert interviewer name\">Technical Expert</b><span data-kid=\"2-5-1-2-1-6-1-2\" data-name=\"technical expert interviewer description\">Follows project decisions down to fundamentals.</span></div><em data-kid=\"2-5-1-2-1-6-2\" data-name=\"technical expert interviewer tag\">Technical</em></div>\n<div class=\"p-row\" data-kid=\"2-5-1-2-1-7\" data-name=\"hr specialist interviewer row\"><div data-kid=\"2-5-1-2-1-7-1\" data-name=\"hr specialist interviewer text\"><b data-kid=\"2-5-1-2-1-7-1-1\" data-name=\"hr specialist interviewer name\">HR Specialist</b><span data-kid=\"2-5-1-2-1-7-1-2\" data-name=\"hr specialist interviewer description\">Behavioural questions, culture fit, compensation.</span></div><em data-kid=\"2-5-1-2-1-7-2\" data-name=\"hr specialist interviewer tag\">HR rounds</em></div>\n<div class=\"p-row\" data-kid=\"2-5-1-2-1-8\" data-name=\"hiring manager interviewer row\" style=\"border-bottom:1px solid var(--line)\"><div data-kid=\"2-5-1-2-1-8-1\" data-name=\"hiring manager interviewer text\"><b data-kid=\"2-5-1-2-1-8-1-1\" data-name=\"hiring manager interviewer name\">Experienced Hiring Manager</b><span data-kid=\"2-5-1-2-1-8-1-2\" data-name=\"hiring manager interviewer description\">Panel-style trade-offs and ownership questions.</span></div><em data-kid=\"2-5-1-2-1-8-2\" data-name=\"hiring manager interviewer tag\">Experienced</em></div>\n</div>\n</div>\n</div>\n</section>\n<section class=\"band\" data-kid=\"2-6\" data-name=\"session features section\">\n<div class=\"wrap sec\" data-kid=\"2-6-1\" data-name=\"session features content container\">\n<div class=\"sec-h\" data-kid=\"2-6-1-1\" data-name=\"session features section header\">\n<h2 data-kid=\"2-6-1-1-1\" data-name=\"session features heading\">What a session includes</h2>\n<p data-kid=\"2-6-1-1-2\" data-name=\"session features intro text\">Everything in one room: the interviewer, your resume, the editor and the report.</p>\n</div>\n<div class=\"feat\" data-kid=\"2-6-1-2\" data-name=\"session features bento grid\">\n<div class=\"giant\" data-kid=\"2-6-1-2-1\" data-name=\"live voice interviews feature card\">\n<h4 data-kid=\"2-6-1-2-1-1\" data-name=\"live voice interviews title\">Live voice interviews</h4>\n<p data-kid=\"2-6-1-2-1-2\" data-name=\"live voice interviews description\">Speech-to-text, generated follow-ups and spoken questions, with a typed fallback in the same session.</p>\n<div class=\"wave\" data-kid=\"2-6-1-2-1-3\" data-name=\"live voice waveform visualizer\">\n<i data-kid=\"2-6-1-2-1-3-1\" data-name=\"live voice waveform bar\"></i><i data-kid=\"2-6-1-2-1-3-2\" data-name=\"live voice waveform bar\"></i><i data-kid=\"2-6-1-2-1-3-3\" data-name=\"live voice waveform bar\"></i><i data-kid=\"2-6-1-2-1-3-4\" data-name=\"live voice waveform bar\"></i><i data-kid=\"2-6-1-2-1-3-5\" data-name=\"live voice waveform bar\"></i><i data-kid=\"2-6-1-2-1-3-6\" data-name=\"live voice waveform bar\"></i><i data-kid=\"2-6-1-2-1-3-7\" data-name=\"live voice waveform bar\"></i><i data-kid=\"2-6-1-2-1-3-8\" data-name=\"live voice waveform bar\"></i><i data-kid=\"2-6-1-2-1-3-9\" data-name=\"live voice waveform bar\"></i><i data-kid=\"2-6-1-2-1-3-10\" data-name=\"live voice waveform bar\"></i><i data-kid=\"2-6-1-2-1-3-11\" data-name=\"live voice waveform bar\"></i><i data-kid=\"2-6-1-2-1-3-12\" data-name=\"live voice waveform bar\"></i><i data-kid=\"2-6-1-2-1-3-13\" data-name=\"live voice waveform bar\"></i><i data-kid=\"2-6-1-2-1-3-14\" data-name=\"live voice waveform bar\"></i><i data-kid=\"2-6-1-2-1-3-15\" data-name=\"live voice waveform bar\"></i><i data-kid=\"2-6-1-2-1-3-16\" data-name=\"live voice waveform bar\"></i><i data-kid=\"2-6-1-2-1-3-17\" data-name=\"live voice waveform bar\"></i><i data-kid=\"2-6-1-2-1-3-18\" data-name=\"live voice waveform bar\"></i><i data-kid=\"2-6-1-2-1-3-19\" data-name=\"live voice waveform bar\"></i><i data-kid=\"2-6-1-2-1-3-20\" data-name=\"live voice waveform bar\"></i><i data-kid=\"2-6-1-2-1-3-21\" data-name=\"live voice waveform bar\"></i><i data-kid=\"2-6-1-2-1-3-22\" data-name=\"live voice waveform bar\"></i><i data-kid=\"2-6-1-2-1-3-23\" data-name=\"live voice waveform bar\"></i><i data-kid=\"2-6-1-2-1-3-24\" data-name=\"live voice waveform bar\"></i><i data-kid=\"2-6-1-2-1-3-25\" data-name=\"live voice waveform bar\"></i><i data-kid=\"2-6-1-2-1-3-26\" data-name=\"live voice waveform bar\"></i><i data-kid=\"2-6-1-2-1-3-27\" data-name=\"live voice waveform bar\"></i><i data-kid=\"2-6-1-2-1-3-28\" data-name=\"live voice waveform bar\"></i>\n</div>\n<div class=\"controls\" data-kid=\"2-6-1-2-1-4\" data-name=\"live voice call controls row\">\n<span class=\"ctl dark\" data-kid=\"2-6-1-2-1-4-1\" data-name=\"microphone toggle button\"><i class=\"icon-mic\" data-kid=\"2-6-1-2-1-4-1-1\" data-name=\"microphone icon\"></i></span>\n<span class=\"ctl\" data-kid=\"2-6-1-2-1-4-2\" data-name=\"pause button\"><i class=\"icon-pause\" data-kid=\"2-6-1-2-1-4-2-1\" data-name=\"pause icon\"></i></span>\n<span class=\"ctl\" data-kid=\"2-6-1-2-1-4-3\" data-name=\"restart button\"><i class=\"icon-rotate-ccw\" data-kid=\"2-6-1-2-1-4-3-1\" data-name=\"restart icon\"></i></span>\n<span class=\"ctl\" data-kid=\"2-6-1-2-1-4-4\" data-name=\"end call button\"><i class=\"icon-phone-off\" data-kid=\"2-6-1-2-1-4-4-1\" data-name=\"end call icon\"></i></span>\n<span class=\"ctl mono-t\" data-kid=\"2-6-1-2-1-4-5\" data-name=\"session time readout\">18:42</span>\n</div>\n</div>\n<div class=\"cell\" data-kid=\"2-6-1-2-2\" data-name=\"resume analysis feature card\">\n<h4 data-kid=\"2-6-1-2-2-1\" data-name=\"resume analysis title\">Resume analysis</h4>\n<p data-kid=\"2-6-1-2-2-2\" data-name=\"resume analysis description\">PDF or DOCX, parsed privately.</p>\n<div class=\"doc\" data-kid=\"2-6-1-2-2-3\" data-name=\"resume document lines graphic\"><i data-kid=\"2-6-1-2-2-3-1\" data-name=\"document line\"></i><i data-kid=\"2-6-1-2-2-3-2\" data-name=\"document line\"></i><i data-kid=\"2-6-1-2-2-3-3\" data-name=\"document line\"></i><i data-kid=\"2-6-1-2-2-3-4\" data-name=\"document highlight line\"></i></div>\n</div>\n<div class=\"cell\" data-kid=\"2-6-1-2-3\" data-name=\"coding round feature card\">\n<h4 data-kid=\"2-6-1-2-3-1\" data-name=\"coding round title\">Coding round</h4>\n<div class=\"tokens\" data-kid=\"2-6-1-2-3-2\" data-name=\"code snippet block\"><b data-kid=\"2-6-1-2-3-2-1\" data-name=\"python def keyword\">def</b> <u data-kid=\"2-6-1-2-3-2-2\" data-name=\"parse function name\">parse</u>(s):<br data-kid=\"2-6-1-2-3-2-3\" data-name=\"code line break\"/>  <b data-kid=\"2-6-1-2-3-2-4\" data-name=\"return keyword\">return</b> s.strip()<br data-kid=\"2-6-1-2-3-2-5\" data-name=\"code line break\"/>  <span data-kid=\"2-6-1-2-3-2-6\" data-name=\"test count comment\" style=\"color:var(--ink-50)\"># 8 tests</span></div>\n</div>\n<div class=\"cell\" data-kid=\"2-6-1-2-4\" data-name=\"progress feature card\">\n<h4 data-kid=\"2-6-1-2-4-1\" data-name=\"progress title\">Progress</h4>\n<p data-kid=\"2-6-1-2-4-2\" data-name=\"progress description\">Score by category, by attempt.</p>\n<div class=\"bars\" data-kid=\"2-6-1-2-4-3\" data-name=\"progress bar chart\"><i data-kid=\"2-6-1-2-4-3-1\" data-name=\"progress chart bar\"></i><i data-kid=\"2-6-1-2-4-3-2\" data-name=\"progress chart bar\"></i><i data-kid=\"2-6-1-2-4-3-3\" data-name=\"progress chart bar\"></i><i data-kid=\"2-6-1-2-4-3-4\" data-name=\"progress chart bar\"></i><i data-kid=\"2-6-1-2-4-3-5\" data-name=\"progress chart bar\"></i><i data-kid=\"2-6-1-2-4-3-6\" data-name=\"progress chart bar\"></i><i data-kid=\"2-6-1-2-4-3-7\" data-name=\"progress chart bar\"></i></div>\n</div>\n<div class=\"cell\" data-kid=\"2-6-1-2-5\" data-name=\"report feature card\">\n<h4 data-kid=\"2-6-1-2-5-1\" data-name=\"report title\">Report</h4>\n<p data-kid=\"2-6-1-2-5-2\" data-name=\"report description\">Rubric notes and better answers.</p>\n<div class=\"mini-h\" data-kid=\"2-6-1-2-5-3\" data-name=\"report overall score row\" style=\"margin-top:auto\"><span data-kid=\"2-6-1-2-5-3-1\" data-name=\"overall label\">Overall</span><span class=\"mono\" data-kid=\"2-6-1-2-5-3-2\" data-name=\"overall score value\">7.2</span></div>\n<div class=\"rail\" data-kid=\"2-6-1-2-5-4\" data-name=\"report progress rail\"><i data-kid=\"2-6-1-2-5-4-1\" data-name=\"report progress fill\" style=\"display:block;height:4px;width:72%;background:var(--accent)\"></i></div>\n</div>\n</div>\n</div>\n</section>\n<section class=\"wrap sec\" data-kid=\"2-7\" data-name=\"pricing section\" id=\"pricing\">\n<div class=\"sec-h\" data-kid=\"2-7-1\" data-name=\"pricing section header\">\n<h2 data-kid=\"2-7-1-1\" data-name=\"pricing heading\">Pricing</h2>\n<p data-kid=\"2-7-1-2\" data-name=\"pricing intro text\">Every plan includes the question banks for your course and a transcript you can export.</p>\n</div>\n<div class=\"plans\" data-kid=\"2-7-2\" data-name=\"pricing plan grid\">\n<div class=\"plan\" data-kid=\"2-7-2-1\" data-name=\"free pricing plan card\">\n<h3 data-kid=\"2-7-2-1-1\" data-name=\"free plan name\">Free</h3>\n<p class=\"who\" data-kid=\"2-7-2-1-2\" data-name=\"free plan audience text\">For a first look at how an AI interview feels.</p>\n<div class=\"price\" data-kid=\"2-7-2-1-3\" data-name=\"free plan price\"><b data-kid=\"2-7-2-1-3-1\" data-name=\"free plan price amount\">₹0</b><span data-kid=\"2-7-2-1-3-2\" data-name=\"free plan price period\">/ month</span></div>\n<div class=\"limits\" data-kid=\"2-7-2-1-4\" data-name=\"free plan limits list\">\n<div data-kid=\"2-7-2-1-4-1\" data-name=\"free plan interview limit row\"><span data-kid=\"2-7-2-1-4-1-1\" data-name=\"interview limit label\">AI interviews</span><b data-kid=\"2-7-2-1-4-1-2\" data-name=\"free interview limit value\">3 / mo</b></div>\n<div data-kid=\"2-7-2-1-4-2\" data-name=\"free plan voice mode row\"><span data-kid=\"2-7-2-1-4-2-1\" data-name=\"voice mode label\">Voice mode</span><b data-kid=\"2-7-2-1-4-2-2\" data-name=\"free voice mode value\">—</b></div>\n<div data-kid=\"2-7-2-1-4-3\" data-name=\"free plan resumes row\"><span data-kid=\"2-7-2-1-4-3-1\" data-name=\"resumes label\">Resumes</span><b data-kid=\"2-7-2-1-4-3-2\" data-name=\"free resumes value\">1</b></div>\n<div data-kid=\"2-7-2-1-4-4\" data-name=\"free plan report row\"><span data-kid=\"2-7-2-1-4-4-1\" data-name=\"report label\">Report</span><b data-kid=\"2-7-2-1-4-4-2\" data-name=\"free report value\">Basic</b></div>\n</div>\n<a class=\"btn btn-line\" data-kid=\"2-7-2-1-5\" data-name=\"start free plan button\" href=\"/signup\">Start free</a>\n</div>\n<div class=\"plan\" data-kid=\"2-7-2-2\" data-name=\"starter pricing plan card\">\n<h3 data-kid=\"2-7-2-2-1\" data-name=\"starter plan name\">Starter</h3>\n<p class=\"who\" data-kid=\"2-7-2-2-2\" data-name=\"starter plan audience text\">For final-year students and freshers in placement season.</p>\n<div class=\"price\" data-kid=\"2-7-2-2-3\" data-name=\"starter plan price\"><b data-kid=\"2-7-2-2-3-1\" data-name=\"starter plan price amount\">₹399</b><span data-kid=\"2-7-2-2-3-2\" data-name=\"starter plan price period\">/ month</span></div>\n<div class=\"limits\" data-kid=\"2-7-2-2-4\" data-name=\"starter plan limits list\">\n<div data-kid=\"2-7-2-2-4-1\" data-name=\"starter interview limit row\"><span data-kid=\"2-7-2-2-4-1-1\" data-name=\"interview limit label\">AI interviews</span><b data-kid=\"2-7-2-2-4-1-2\" data-name=\"starter interview limit value\">20 / mo</b></div>\n<div data-kid=\"2-7-2-2-4-2\" data-name=\"starter voice mode row\"><span data-kid=\"2-7-2-2-4-2-1\" data-name=\"voice mode label\">Voice mode</span><b data-kid=\"2-7-2-2-4-2-2\" data-name=\"starter voice mode value\">Yes</b></div>\n<div data-kid=\"2-7-2-2-4-3\" data-name=\"starter resumes row\"><span data-kid=\"2-7-2-2-4-3-1\" data-name=\"resumes label\">Resumes</span><b data-kid=\"2-7-2-2-4-3-2\" data-name=\"starter resumes value\">3</b></div>\n<div data-kid=\"2-7-2-2-4-4\" data-name=\"starter report row\"><span data-kid=\"2-7-2-2-4-4-1\" data-name=\"report label\">Report</span><b data-kid=\"2-7-2-2-4-4-2\" data-name=\"starter report value\">Full</b></div>\n</div>\n<a class=\"btn btn-primary\" data-kid=\"2-7-2-2-5\" data-name=\"choose starter plan button\" href=\"/signup\">Choose Starter</a>\n</div>\n<div class=\"plan\" data-kid=\"2-7-2-3\" data-name=\"pro pricing plan card\">\n<h3 data-kid=\"2-7-2-3-1\" data-name=\"pro plan name\">Pro</h3>\n<p class=\"who\" data-kid=\"2-7-2-3-2\" data-name=\"pro plan audience text\">For working professionals switching roles or sitting multiple rounds.</p>\n<div class=\"price\" data-kid=\"2-7-2-3-3\" data-name=\"pro plan price\"><b data-kid=\"2-7-2-3-3-1\" data-name=\"pro plan price amount\">₹899</b><span data-kid=\"2-7-2-3-3-2\" data-name=\"pro plan price period\">/ month</span></div>\n<div class=\"limits\" data-kid=\"2-7-2-3-4\" data-name=\"pro plan limits list\">\n<div data-kid=\"2-7-2-3-4-1\" data-name=\"pro interview limit row\"><span data-kid=\"2-7-2-3-4-1-1\" data-name=\"interview limit label\">AI interviews</span><b data-kid=\"2-7-2-3-4-1-2\" data-name=\"pro interview limit value\">60 / mo</b></div>\n<div data-kid=\"2-7-2-3-4-2\" data-name=\"pro voice mode row\"><span data-kid=\"2-7-2-3-4-2-1\" data-name=\"voice mode label\">Voice mode</span><b data-kid=\"2-7-2-3-4-2-2\" data-name=\"pro voice mode value\">Yes</b></div>\n<div data-kid=\"2-7-2-3-4-3\" data-name=\"pro resumes row\"><span data-kid=\"2-7-2-3-4-3-1\" data-name=\"resumes label\">Resumes</span><b data-kid=\"2-7-2-3-4-3-2\" data-name=\"pro resumes value\">10</b></div>\n<div data-kid=\"2-7-2-3-4-4\" data-name=\"pro report row\"><span data-kid=\"2-7-2-3-4-4-1\" data-name=\"report label\">Report</span><b data-kid=\"2-7-2-3-4-4-2\" data-name=\"pro report value\">Advanced</b></div>\n</div>\n<a class=\"btn btn-line\" data-kid=\"2-7-2-3-5\" data-name=\"choose pro plan button\" href=\"/signup\">Choose Pro</a>\n</div>\n</div>\n<div class=\"every\" data-kid=\"2-7-3\" data-name=\"included features checklist\">\n<span data-kid=\"2-7-3-1\" data-name=\"all categories included item\"><i class=\"icon-check\" data-kid=\"2-7-3-1-1\" data-name=\"checkmark icon\"></i>All 10 interview categories</span>\n<span data-kid=\"2-7-3-2\" data-name=\"all languages included item\"><i class=\"icon-check\" data-kid=\"2-7-3-2-1\" data-name=\"checkmark icon\"></i>11 interview languages</span>\n<span data-kid=\"2-7-3-3\" data-name=\"session transcript included item\"><i class=\"icon-check\" data-kid=\"2-7-3-3-1\" data-name=\"checkmark icon\"></i>Session transcript</span>\n<span data-kid=\"2-7-3-4\" data-name=\"pdf export included item\"><i class=\"icon-check\" data-kid=\"2-7-3-4-1\" data-name=\"checkmark icon\"></i>PDF export</span>\n</div>\n<p class=\"proposed\" data-kid=\"2-7-4\" data-name=\"pricing currency and tax disclaimer\">Prices in INR, inclusive of GST. Introductory pricing, subject to change.</p>\n</section>\n<section class=\"wrap sec\" data-kid=\"2-8\" data-name=\"faq section\" style=\"padding-top:0\">\n<div class=\"sec-h\" data-kid=\"2-8-1\" data-name=\"faq section header\"><h2 data-kid=\"2-8-1-1\" data-name=\"faq heading\">Questions we get before signing up</h2></div>\n<div class=\"faq\" data-kid=\"2-8-2\" data-name=\"faq layout\">\n<div data-kid=\"2-8-2-1\" data-name=\"faq question list\">\n<div class=\"q-item\" data-kid=\"2-8-2-1-1\" data-name=\"english language faq item\"><h4 data-kid=\"2-8-2-1-1-1\" data-name=\"english language faq question\">Do I have to interview in English?</h4><p data-kid=\"2-8-2-1-1-2\" data-name=\"english language faq answer\">No. Pick any of the 11 languages on the setup screen before each session, including Hinglish. Questions, follow-ups and the report stay in that language for the whole session.</p></div>\n<div class=\"q-item\" data-kid=\"2-8-2-1-2\" data-name=\"b.com fit faq item\"><h4 data-kid=\"2-8-2-1-2-1\" data-name=\"b.com fit faq question\">I am a B.Com student. Will the questions fit my course?</h4><p data-kid=\"2-8-2-1-2-2\" data-name=\"b.com fit faq answer\">Yes. Commerce sessions ask about accounting, taxation, banking and economics. Management, science, law, medical and pharmacy banks follow the same pattern for their streams.</p></div>\n<div class=\"q-item\" data-kid=\"2-8-2-1-3\" data-name=\"scoring faq item\"><h4 data-kid=\"2-8-2-1-3-1\" data-name=\"scoring faq question\">How is my answer scored?</h4><p data-kid=\"2-8-2-1-3-2\" data-name=\"scoring faq answer\">Each answer is scored against the rubric for your stream and category, such as subject accuracy, structure and communication. The report shows the criterion behind every score, so you can see why an answer lost marks.</p></div>\n<div class=\"q-item\" data-kid=\"2-8-2-1-4\" data-name=\"connection drop faq item\"><h4 data-kid=\"2-8-2-1-4-1\" data-name=\"connection drop faq question\">What happens if my connection drops mid-interview?</h4><p data-kid=\"2-8-2-1-4-2\" data-name=\"connection drop faq answer\">The session is stored at every answer. Reopen it from Interviews and you continue from the last saved turn; the timer is paused while you are disconnected.</p></div>\n<div class=\"q-item\" data-kid=\"2-8-2-1-5\" data-name=\"transcript faq item\"><h4 data-kid=\"2-8-2-1-5-1\" data-name=\"transcript faq question\">Can I read the transcript afterwards?</h4><p data-kid=\"2-8-2-1-5-2\" data-name=\"transcript faq answer\">Every completed session keeps the full question and answer transcript, and you can export the report to PDF.</p></div>\n<div class=\"q-item\" data-kid=\"2-8-2-1-6\" data-name=\"resume privacy faq item\"><h4 data-kid=\"2-8-2-1-6-1\" data-name=\"resume privacy faq question\">What happens to my resume?</h4><p data-kid=\"2-8-2-1-6-2\" data-name=\"resume privacy faq answer\">It is stored privately and read only by your own sessions. You can delete a resume from your profile at any time.</p></div>\n</div>\n<aside class=\"callout\" data-kid=\"2-8-2-2\" data-name=\"support callout\">\n<h4 data-kid=\"2-8-2-2-1\" data-name=\"support callout title\">Plans, privacy or refunds</h4>\n<p data-kid=\"2-8-2-2-2\" data-name=\"support callout text\">Support answers on email within one working day. Account and resume deletion requests are handled by the same team.</p>\n<a data-kid=\"2-8-2-2-3\" data-name=\"contact support link\" href=\"/contact\">Contact support</a>\n</aside>\n</div>\n</section>\n<section class=\"band\" data-kid=\"2-9\" data-name=\"closing call-to-action section\">\n<div class=\"wrap closer\" data-kid=\"2-9-1\" data-name=\"closing cta layout\">\n<div data-kid=\"2-9-1-1\" data-name=\"closing cta text block\">\n<h2 data-kid=\"2-9-1-1-1\" data-name=\"closing cta headline\">Your Next Interview Starts Here.</h2>\n<p data-kid=\"2-9-1-1-2\" data-name=\"closing cta free plan note\">Free plan: 3 interviews a month, text mode, no card required.</p>\n</div>\n<div class=\"closer-right\" data-kid=\"2-9-1-2\" data-name=\"closing cta action group\">\n<a class=\"btn btn-primary\" data-kid=\"2-9-1-2-1\" data-name=\"closing start free interview button\" href=\"/signup\">Start Free Interview</a>\n<a class=\"link-arrow\" data-kid=\"2-9-1-2-2\" data-name=\"see plans and limits link\" href=\"/pricing\">See plans and limits</a>\n</div>\n</div>\n</section>\n</main>\n<footer class=\"wrap foot\" data-kid=\"3\" data-name=\"site footer\">\n<div class=\"foot-grid\" data-kid=\"3-1\" data-name=\"footer link columns\">\n<div class=\"foot-brand\" data-kid=\"3-1-1\" data-name=\"footer brand column\">\n<a class=\"brand\" data-kid=\"3-1-1-1\" data-name=\"footer brand logo link\" href=\"/\"><span class=\"mark\" data-kid=\"3-1-1-1-1\" data-name=\"footer logo mark\"><i data-kid=\"3-1-1-1-1-1\" data-name=\"footer logo mark left bar\"></i><i data-kid=\"3-1-1-1-1-2\" data-name=\"footer logo mark center bar\"></i><i data-kid=\"3-1-1-1-1-3\" data-name=\"footer logo mark right bar\"></i></span>MockMate AI</a>\n<p data-kid=\"3-1-1-2\" data-name=\"footer brand description text\">AI mock interviews for every course and career path. Interface in English, interviews in 11 languages.</p>\n</div>\n<div data-kid=\"3-1-2\" data-name=\"product footer column\">\n<h5 data-kid=\"3-1-2-1\" data-name=\"product column heading\">Product</h5>\n<ul data-kid=\"3-1-2-2\" data-name=\"product link list\"><li data-kid=\"3-1-2-2-1\" data-name=\"footer features list item\"><a data-kid=\"3-1-2-2-1-1\" data-name=\"footer features link\" href=\"/features\">Features</a></li><li data-kid=\"3-1-2-2-2\" data-name=\"footer how it works list item\"><a data-kid=\"3-1-2-2-2-1\" data-name=\"footer how it works link\" href=\"/how-it-works\">How it works</a></li><li data-kid=\"3-1-2-2-3\" data-name=\"footer pricing list item\"><a data-kid=\"3-1-2-2-3-1\" data-name=\"footer pricing link\" href=\"/pricing\">Pricing</a></li><li data-kid=\"3-1-2-2-4\" data-name=\"footer ai mock interview list item\"><a data-kid=\"3-1-2-2-4-1\" data-name=\"footer ai mock interview link\" href=\"/ai-mock-interview\">AI mock interview</a></li></ul>\n</div>\n<div data-kid=\"3-1-3\" data-name=\"practice footer column\">\n<h5 data-kid=\"3-1-3-1\" data-name=\"practice column heading\">Practice</h5>\n<ul data-kid=\"3-1-3-2\" data-name=\"practice link list\"><li data-kid=\"3-1-3-2-1\" data-name=\"footer interview questions list item\"><a data-kid=\"3-1-3-2-1-1\" data-name=\"footer interview questions link\" href=\"/interview-questions\">Interview questions</a></li><li data-kid=\"3-1-3-2-2\" data-name=\"footer coding round list item\"><a data-kid=\"3-1-3-2-2-1\" data-name=\"footer coding round link\" href=\"/coding-interview\">Coding round</a></li><li data-kid=\"3-1-3-2-3\" data-name=\"footer b.tech list item\"><a data-kid=\"3-1-3-2-3-1\" data-name=\"footer b.tech link\" href=\"/interview-preparation/btech\">B.Tech</a></li><li data-kid=\"3-1-3-2-4\" data-name=\"footer mba list item\"><a data-kid=\"3-1-3-2-4-1\" data-name=\"footer mba link\" href=\"/interview-preparation/mba\">MBA</a></li></ul>\n</div>\n<div data-kid=\"3-1-4\" data-name=\"company footer column\">\n<h5 data-kid=\"3-1-4-1\" data-name=\"company column heading\">Company</h5>\n<ul data-kid=\"3-1-4-2\" data-name=\"company link list\"><li data-kid=\"3-1-4-2-1\" data-name=\"footer about list item\"><a data-kid=\"3-1-4-2-1-1\" data-name=\"footer about link\" href=\"/about\">About</a></li><li data-kid=\"3-1-4-2-2\" data-name=\"footer contact list item\"><a data-kid=\"3-1-4-2-2-1\" data-name=\"footer contact link\" href=\"/contact\">Contact</a></li><li data-kid=\"3-1-4-2-3\" data-name=\"footer blog list item\"><a data-kid=\"3-1-4-2-3-1\" data-name=\"footer blog link\" href=\"/blog\">Blog</a></li><li data-kid=\"3-1-4-2-4\" data-name=\"footer faq list item\"><a data-kid=\"3-1-4-2-4-1\" data-name=\"footer faq link\" href=\"/faq\">FAQ</a></li></ul>\n</div>\n<div data-kid=\"3-1-5\" data-name=\"legal footer column\">\n<h5 data-kid=\"3-1-5-1\" data-name=\"legal column heading\">Legal</h5>\n<ul data-kid=\"3-1-5-2\" data-name=\"legal link list\"><li data-kid=\"3-1-5-2-1\" data-name=\"footer privacy list item\"><a data-kid=\"3-1-5-2-1-1\" data-name=\"footer privacy link\" href=\"/privacy\">Privacy policy</a></li><li data-kid=\"3-1-5-2-2\" data-name=\"footer terms list item\"><a data-kid=\"3-1-5-2-2-1\" data-name=\"footer terms link\" href=\"/terms\">Terms of service</a></li><li data-kid=\"3-1-5-2-3\" data-name=\"footer cookie list item\"><a data-kid=\"3-1-5-2-3-1\" data-name=\"footer cookie link\" href=\"/cookies\">Cookie policy</a></li><li data-kid=\"3-1-5-2-4\" data-name=\"footer interview tips list item\"><a data-kid=\"3-1-5-2-4-1\" data-name=\"footer interview tips link\" href=\"/interview-tips\">Interview tips</a></li></ul>\n</div>\n</div>\n<div class=\"foot-bottom\" data-kid=\"3-2\" data-name=\"footer bottom bar\">\n<span data-kid=\"3-2-1\" data-name=\"copyright notice text\">© 2026 MockMate AI</span>\n<div class=\"social\" data-kid=\"3-2-2\" data-name=\"social media icon row\"><i class=\"icon-linkedin\" data-kid=\"3-2-2-1\" data-name=\"linkedin icon\"></i><i class=\"icon-youtube\" data-kid=\"3-2-2-2\" data-name=\"youtube icon\"></i><i class=\"icon-instagram\" data-kid=\"3-2-2-3\" data-name=\"instagram icon\"></i><i class=\"icon-twitter\" data-kid=\"3-2-2-4\" data-name=\"twitter icon\"></i></div>\n</div>\n</footer>",
