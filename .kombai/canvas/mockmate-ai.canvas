        "h": 0
      },
      "html": "<style>\n@import url('https://fonts.googleapis.com/css2?family=Cardo:ital,wght@0,400;0,700;1,400&family=Albert+Sans:wght@400;500;600;700&display=swap');\n@import url(\"https://cdn.jsdelivr.net/npm/@phosphor-icons/web@2.1.2/src/regular/style.css\");\n:root{\n  --peach:#FEBE9B; --shell:#F8EDE8; --ink:#1D1411; --ink-70:rgba(29,20,17,.72); --ink-50:rgba(29,20,17,.52);\n  --coral:#FE8B65; --gold:#F1C160; --indigo:#4F46E5; --blue:#2563EB; --hair:rgba(29,20,17,.16);\n  --hard:8px 8px 0 rgba(29,20,17,.10);\n}\n*{box-sizing:border-box}\nbody{margin:0;background:var(--peach);color:var(--ink);font-family:'Albert Sans',system-ui,sans-serif;-webkit-font-smoothing:antialiased}\nh1,h2,h3,h4,p,ul,ol{margin:0;padding:0}ul{list-style:none}\na{text-decoration:none;color:inherit}\n.serif{font-family:'Cardo',Georgia,serif;font-weight:400}\n.wrap{max-width:1180px;margin:0 auto;padding:0 32px}\n.peach{background:var(--peach)}\n.shell{background:var(--shell)}\n.hair{border-top:1px solid var(--hair)}\n\n/* ornaments */\n.reg{position:absolute;width:16px;height:16px;opacity:.55}\n.reg::before,.reg::after{content:\"\";position:absolute;background:var(--ink)}\n.reg::before{left:0;top:50%;width:100%;height:1px}\n.reg::after{top:0;left:50%;height:100%;width:1px}\n\n/* nav */\n.nav{background:var(--peach);border-bottom:1px solid rgba(29,20,17,.18)}\n.nav-in{height:76px;display:flex;align-items:center;gap:34px}\n.brand{display:flex;align-items:center;gap:10px;font-size:18px;font-weight:700;letter-spacing:-.02em}\n.brand .dot{position:relative;width:24px;height:24px}\n.brand .dot i{position:absolute;width:18px;height:18px;border-radius:50%;border:1.5px solid var(--ink)}\n.brand .dot i:first-child{left:0;top:0;background:var(--coral)}\n.brand .dot i:last-child{right:0;bottom:0;background:var(--gold);mix-blend-mode:multiply}\n.nav-links{display:flex;gap:24px;font-size:14.5px;color:var(--ink-70);margin-left:10px}\n.nav-links a:hover{color:var(--ink)}\n.nav-right{margin-left:auto;display:flex;align-items:center;gap:16px}\n.nav-login{font-size:14.5px;font-weight:500}\n.pill{display:inline-flex;align-items:center;justify-content:center;gap:8px;border-radius:999px;padding:12px 22px;font-size:14px;font-weight:600;border:1px solid transparent}\n.pill-primary{background:var(--indigo);color:#fff;box-shadow:3px 3px 0 rgba(29,20,17,.22)}\n.pill-primary:hover{background:#4338ca}\n.pill-outline{border-color:rgba(29,20,17,.35);color:var(--ink);background:transparent}\n.pill-sm{padding:9px 16px;font-size:13px}\n\n/* hero */\n.hero{padding:56px 0 44px;display:grid;grid-template-columns:1.02fr .98fr;gap:54px;align-items:center}\n.hero h1{font-size:61px;line-height:1.03;letter-spacing:-.02em}\n.hero h1 mark{background:linear-gradient(transparent 58%,var(--gold) 58%,var(--gold) 92%,transparent 92%);color:inherit;padding:0 2px}\n.hero-sub{margin-top:22px;font-size:16.5px;line-height:1.62;color:var(--ink-70);max-width:460px}\n.hero-cta{margin-top:30px;display:flex;align-items:center;gap:20px}\n.txt-link{font-size:14.5px;font-weight:600;border-bottom:1.5px solid rgba(29,20,17,.4);padding-bottom:2px;display:inline-flex;align-items:center;gap:6px}\n.micro{margin-top:16px;font-size:12.5px;color:var(--ink-50)}\n\n.art{position:relative;padding:6px}\n.plate{background:var(--shell);border:1px solid rgba(29,20,17,.2);border-radius:18px;padding:12px;box-shadow:var(--hard);clip-path:polygon(0 0,100% 0,100% calc(100% - 52px),calc(100% - 52px) 100%,0 100%)}\n.plate img{display:block;width:100%;height:auto;aspect-ratio:3/2;object-fit:cover;object-position:center;border-radius:10px}\n.art .reg.tl{left:-14px;top:-10px}\n.art .reg.br{right:16px;bottom:16px}\n.float-card{position:absolute;left:-22px;bottom:26px;background:#fff;border:1px solid rgba(29,20,17,.2);border-radius:14px;padding:12px 14px;box-shadow:4px 4px 0 rgba(29,20,17,.12);width:220px}\n.float-top{display:flex;align-items:center;justify-content:space-between;font-size:11px;color:var(--ink-50)}\n.wave{display:flex;align-items:flex-end;gap:2.5px;height:26px;margin-top:8px}\n.wave i{flex:1;background:var(--coral);border-radius:1px}\n.wave i:nth-child(3n){background:var(--indigo)}\n.wave i:nth-child(4n+1){height:32%}.wave i:nth-child(4n+2){height:74%}.wave i:nth-child(4n+3){height:52%}.wave i:nth-child(4n+4){height:96%}\n\n/* spec strip */\n.specs{background:var(--peach);border-top:1px solid rgba(29,20,17,.2);border-bottom:1px solid rgba(29,20,17,.2)}\n.specs-in{display:grid;grid-template-columns:repeat(4,1fr)}\n.spec{padding:22px 24px;border-left:1px solid rgba(29,20,17,.18)}\n.spec:first-child{border-left:0;padding-left:0}\n.spec .n{font-family:'Cardo',Georgia,serif;font-size:33px;line-height:1}\n.spec .l{font-size:12.5px;color:var(--ink-70);margin-top:6px}\n\n/* split span */\n.split{background:var(--peach);padding:70px 0 0}\n.split-bg{position:relative}\n.split-card{background:var(--shell);border:1px solid rgba(29,20,17,.18);border-radius:22px;box-shadow:var(--hard);display:grid;grid-template-columns:1.02fr .98fr;overflow:hidden}\n.steps-panel{padding:36px 34px 32px}\n.steps-panel h2{font-size:35px;line-height:1.08;letter-spacing:-.02em;margin-bottom:6px}\n.steps-panel .sub{font-size:13.5px;color:var(--ink-70);max-width:320px;line-height:1.5;margin-bottom:24px}\n.step{display:grid;grid-template-columns:40px 1fr;gap:12px;padding:13px 0;border-top:1px solid rgba(29,20,17,.14);position:relative}\n.step .num{font-family:'Cardo',Georgia,serif;font-size:23px;color:var(--coral);line-height:1}\n.step b{font-size:15.5px;font-weight:600;display:block;letter-spacing:-.01em}\n.step span{font-size:12.5px;color:var(--ink-70);display:block;margin-top:3px;line-height:1.45}\n\n.cat-panel{background:rgba(254,190,155,.42);border-left:1px solid rgba(29,20,17,.18);padding:26px 26px 28px}\n.cat-head{display:flex;align-items:baseline;justify-content:space-between;margin-bottom:16px}\n.cat-head h3{font-size:15px;font-weight:600}\n.cat-head span{font-size:11.5px;color:var(--ink-50)}\n.cat-grid{display:grid;grid-template-columns:1fr 1fr;gap:7px}\n.cat{display:flex;align-items:center;gap:8px;background:rgba(248,237,232,.72);border:1px solid rgba(29,20,17,.12);border-radius:10px;padding:10px 11px;font-size:12.5px;font-weight:500;line-height:1.25}\n.cat i{font-size:14px;color:var(--ink-70)}\n.cat.on{background:var(--ink);color:var(--shell);border-color:var(--ink)}\n.cat.on i{color:var(--gold)}\n.cat-foot{margin-top:16px;font-size:11.5px;color:var(--ink-70);display:flex;align-items:center;gap:7px}\n\n/* transcript */\n.transcript-sec{background:var(--shell);padding:56px 0 76px}\n.t-grid{display:grid;grid-template-columns:.86fr 1.14fr;gap:48px;align-items:start}\n.t-left h2{font-size:35px;line-height:1.1;letter-spacing:-.02em}\n.t-left .sub{font-size:14px;color:var(--ink-70);line-height:1.6;margin-top:10px;max-width:330px}\n.persona-pills{display:flex;flex-wrap:wrap;gap:7px;margin-top:22px}\n.pp{font-size:12.5px;padding:8px 13px;border-radius:999px;border:1px solid rgba(29,20,17,.22);background:transparent;font-weight:500}\n.pp.on{background:var(--coral);border-color:var(--coral);font-weight:600}\n.p-note{margin-top:18px;background:rgba(254,190,155,.36);border:1px solid rgba(29,20,17,.16);border-radius:14px;padding:16px 18px}\n.p-note b{font-size:14px;display:block}\n.p-note p{font-size:12.5px;color:var(--ink-70);line-height:1.55;margin-top:5px}\n\n.chat{background:#fff;border:1px solid rgba(29,20,17,.2);border-radius:20px;box-shadow:6px 6px 0 rgba(29,20,17,.09);overflow:hidden}\n.chat-head{display:flex;align-items:center;gap:10px;padding:14px 18px;border-bottom:1px solid rgba(29,20,17,.12);background:rgba(248,237,232,.6)}\n.chat-head .av{width:32px;height:32px;border-radius:50%;overflow:hidden;flex:none;background:var(--coral)}\n.chat-head .av img{width:100%;height:100%;object-fit:cover;display:block}\n.chat-head b{font-size:13.5px;display:block;line-height:1.2}\n.chat-head span{font-size:11px;color:var(--ink-50);display:block;margin-top:2px}\n.chat-head .time{margin-left:auto;font-size:11.5px;color:var(--ink-50);border:1px solid rgba(29,20,17,.18);border-radius:999px;padding:4px 9px}\n.chat-body{padding:18px;display:flex;flex-direction:column;gap:12px}\n.bub{max-width:86%;font-size:13px;line-height:1.55;padding:12px 15px}\n.bub.ai{background:var(--shell);border:1px solid rgba(29,20,17,.12);border-radius:16px 16px 16px 5px;align-self:flex-start}\n.bub.me{background:rgba(79,70,229,.09);border:1px solid rgba(79,70,229,.28);border-radius:16px 16px 4px 16px;align-self:flex-end}\n.bub-tag{font-size:10.5px;color:var(--ink-50);margin-bottom:4px;display:block}\n.listen{align-self:flex-start;display:flex;align-items:center;gap:9px;border:1px dashed rgba(29,20,17,.28);border-radius:999px;padding:8px 14px;font-size:12px;color:var(--ink-70)}\n.listen .pulse{width:7px;height:7px;border-radius:50%;background:var(--coral);animation:blip 1.4s ease-in-out infinite}\n@keyframes blip{0%,100%{opacity:.35}50%{opacity:1}}\n.chat-foot{display:flex;align-items:center;gap:6px;padding:12px 18px;border-top:1px solid rgba(29,20,17,.12);background:rgba(248,237,232,.5);flex-wrap:wrap}\n.lg{font-size:11px;padding:5px 9px;border-radius:999px;border:1px solid rgba(29,20,17,.18);color:var(--ink-70)}\n.lg.on{background:var(--ink);border-color:var(--ink);color:var(--shell)}\n.chat-foot .more{margin-left:auto;font-size:11px;color:var(--ink-50)}\n\n/* features gallery */\n.feat-sec{background:var(--shell);padding:0 0 76px}\n.feat-head{display:flex;align-items:flex-end;justify-content:space-between;gap:32px;margin-bottom:26px;border-top:1px solid rgba(29,20,17,.16);padding-top:36px}\n.feat-head h2{font-size:35px;letter-spacing:-.02em;line-height:1.1;max-width:440px}\n.feat-head p{font-size:13.5px;color:var(--ink-70);max-width:330px;line-height:1.55}\n.gal{display:grid;grid-template-columns:minmax(0,1fr) 268px;gap:14px}\n.giant{background:var(--peach);border:1px solid rgba(29,20,17,.18);border-radius:18px;padding:26px;box-shadow:4px 4px 0 rgba(29,20,17,.08);display:flex;flex-direction:column;gap:14px}\n.giant h3{font-size:24px;letter-spacing:-.01em}\n.giant p{font-size:13px;color:var(--ink-70);line-height:1.55;max-width:380px}\n.resume-mock{background:#fff;border:1px solid rgba(29,20,17,.16);border-radius:12px;padding:16px}\n.giant-foot{display:flex;gap:22px;flex-wrap:wrap;margin-top:auto;padding-top:16px;border-top:1px solid rgba(29,20,17,.18);font-size:11.5px;color:var(--ink-70)}\n.giant-foot span{display:flex;align-items:center;gap:6px}\n.giant-foot i{font-size:14px}\n.rm-top{display:flex;align-items:center;gap:8px;font-size:12px;color:var(--ink-70)}\n.rm-top i{font-size:15px}\n.rm-lines{display:flex;flex-direction:column;gap:5px;margin:12px 0}\n.rm-lines i{display:block;height:4px;border-radius:2px;background:rgba(29,20,17,.13)}\n.rm-lines i:nth-child(1){width:62%}.rm-lines i:nth-child(2){width:88%}.rm-lines i:nth-child(3){width:44%}\n.skills{display:flex;flex-wrap:wrap;gap:5px;margin-top:2px}\n.skill{font-size:10.5px;padding:4px 8px;border-radius:999px;background:rgba(241,193,96,.4);border:1px solid rgba(29,20,17,.12)}\n.rm-q{font-family:'Cardo',Georgia,serif;font-size:15px;line-height:1.45;margin-top:14px;padding-top:12px;border-top:1px dashed rgba(29,20,17,.2)}\n.thumbs{display:grid;grid-template-rows:repeat(4,1fr);gap:14px}\n.thumb{background:#fff;border:1px solid rgba(29,20,17,.18);border-radius:16px;padding:15px;display:flex;flex-direction:column;gap:6px;box-shadow:3px 3px 0 rgba(29,20,17,.07)}\n.thumb .th-top{display:flex;align-items:center;justify-content:space-between}\n.thumb b{font-size:13px}\n.thumb i{font-size:16px;color:var(--ink-70)}\n.thumb p{font-size:11.5px;color:var(--ink-70);line-height:1.4}\n.mini-wave{display:flex;align-items:flex-end;gap:2px;height:18px;margin-top:auto}\n.mini-wave i{flex:1;background:var(--coral);border-radius:1px}\n.mini-wave i:nth-child(3n){background:var(--indigo)}\n.mini-wave i:nth-child(odd){height:60%}.mini-wave i:nth-child(even){height:100%}.mini-wave i:nth-child(5n){height:35%}\n.mini-code{font-family:ui-monospace,'SF Mono',monospace;font-size:10.5px;color:var(--ink-70);line-height:1.6;margin-top:auto}\n.mini-code b{color:var(--indigo);font-weight:400}\n.mini-bars{display:flex;align-items:flex-end;gap:3px;height:22px;margin-top:auto}\n.mini-bars i{flex:1;background:var(--gold);border-radius:1px}\n.mini-bars i:nth-child(1){height:40%}.mini-bars i:nth-child(2){height:62%}.mini-bars i:nth-child(3){height:52%}.mini-bars i:nth-child(4){height:84%}.mini-bars i:nth-child(5){height:70%}.mini-bars i:nth-child(6){height:96%}\n\n/* pricing */\n.price-sec{background:var(--shell);padding:0 0 76px}\n.price-head{display:flex;align-items:flex-end;justify-content:space-between;gap:30px;border-top:1px solid rgba(29,20,17,.16);padding-top:36px;margin-bottom:24px}\n.price-head h2{font-size:35px;letter-spacing:-.02em;line-height:1.1}\n.price-head p{font-size:13.5px;color:var(--ink-70);max-width:340px;line-height:1.55}\n.tiles{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}\n.tile{background:#fff;border:1px solid rgba(29,20,17,.18);border-radius:18px;padding:22px 22px 24px;display:flex;flex-direction:column;box-shadow:4px 4px 0 rgba(29,20,17,.07)}\n.tile.hi{background:var(--peach);box-shadow:6px 6px 0 rgba(29,20,17,.12)}\n.tile h3{font-size:17px;font-weight:600;display:flex;align-items:center;justify-content:space-between}\n.tile .for{font-size:11.5px;color:var(--ink-70);line-height:1.45;margin-top:5px;min-height:32px}\n.tile .amt{font-family:'Cardo',Georgia,serif;font-size:34px;margin:12px 0 2px;letter-spacing:-.01em}\n.tile .amt span{font-family:'Albert Sans',sans-serif;font-size:11.5px;color:var(--ink-50);margin-left:4px}\n.tile ul{margin:12px 0 18px;display:flex;flex-direction:column;gap:7px}\n.tile li{font-size:12.5px;color:var(--ink-70);display:flex;gap:7px;align-items:flex-start;line-height:1.4}\n.tile li i{font-size:13px;margin-top:1px;color:var(--ink)}\n.tile li b{color:var(--ink);font-weight:600}\n.tile .pill{margin-top:auto;width:100%}\n\n.cmp{margin-top:26px;border:1px solid rgba(29,20,17,.18);border-radius:16px;overflow:hidden;background:rgba(255,255,255,.5)}\n.cmp table{width:100%;border-collapse:collapse;font-size:12.5px}\n.cmp th,.cmp td{padding:11px 16px;text-align:left;border-bottom:1px solid rgba(29,20,17,.1)}\n.cmp thead th{font-size:11px;text-transform:uppercase;letter-spacing:.07em;color:var(--ink-50);font-weight:600;background:rgba(254,190,155,.3)}\n.cmp tbody tr:last-child td{border-bottom:0}\n.cmp td:nth-child(n+2),.cmp th:nth-child(n+2){text-align:center}\n.cmp td:first-child{color:var(--ink-70)}\n.cmp .yes{color:var(--indigo);font-weight:600}\n.cmp .no{color:rgba(29,20,17,.32)}\n.price-note{margin-top:14px;font-size:11.5px;color:var(--ink-50)}\n\n/* faq */\n.faq-sec{background:var(--shell);padding:0 0 80px}\n.faq-head{border-top:1px solid rgba(29,20,17,.16);padding-top:36px;display:flex;align-items:flex-end;justify-content:space-between;gap:30px;margin-bottom:22px}\n.faq-head h2{font-size:35px;letter-spacing:-.02em}\n.faq-cols{display:grid;grid-template-columns:1fr 1fr;column-gap:56px}\n.faq-item{padding:16px 0;border-top:1px solid rgba(29,20,17,.14)}\n.faq-item h4{font-size:14.5px;font-weight:600;display:flex;gap:8px}\n.faq-item h4 i{color:var(--coral);font-size:14px;margin-top:2px}\n.faq-item p{font-size:12.5px;line-height:1.62;color:var(--ink-70);margin-top:6px;padding-left:22px}\n.faq-cta{margin-top:22px;display:flex;align-items:center;gap:14px;font-size:12.5px;color:var(--ink-70)}\n\n/* final cta */\n.final{background:var(--peach);padding:64px 0;position:relative;overflow:hidden}\n.halftone{position:absolute;inset:0;background-image:radial-gradient(rgba(29,20,17,.16) 1px,transparent 1px);background-size:9px 9px;opacity:.5;pointer-events:none}\n.final-in{position:relative;text-align:center;display:flex;flex-direction:column;align-items:center;gap:16px}\n.avatar{width:84px;height:84px;border-radius:50%;overflow:hidden;border:2px solid var(--ink);box-shadow:4px 4px 0 rgba(29,20,17,.16);background:var(--coral)}\n.avatar img{width:100%;height:100%;object-fit:cover;display:block}\n.final h2{font-size:47px;letter-spacing:-.02em;line-height:1.06;max-width:640px}\n.final p{font-size:13.5px;color:var(--ink-70)}\n.final .pill{margin-top:6px}\n\n/* footer */\n.foot{background:var(--peach);border-top:1px solid rgba(29,20,17,.2);padding:44px 0 26px}\n.foot-grid{display:grid;grid-template-columns:1.6fr 1fr 1fr 1fr 1fr;gap:30px}\n.foot h5{font-size:11px;text-transform:uppercase;letter-spacing:.09em;color:var(--ink-50);font-weight:600;margin-bottom:12px}\n.foot li{font-size:13px;color:var(--ink-70);margin-bottom:8px}\n.foot li a:hover{color:var(--ink);border-bottom:1px solid rgba(29,20,17,.4)}\n.foot-brand p{font-size:12.5px;color:var(--ink-70);line-height:1.6;margin-top:12px;max-width:240px}\n.foot-bottom{margin-top:32px;border-top:1px solid rgba(29,20,17,.18);padding-top:16px;display:flex;align-items:center;justify-content:space-between;font-size:11.5px;color:var(--ink-50)}\n.social{display:flex;gap:8px}\n.social i{width:30px;height:30px;border-radius:50%;border:1px solid rgba(29,20,17,.28);display:flex;align-items:center;justify-content:center;font-size:14px}\n\n@media (max-width:1024px){\n  .hero{grid-template-columns:1fr;gap:42px;padding:40px 0}\n  .hero h1{font-size:44px}\n  .split-card{grid-template-columns:1fr}\n  .cat-panel{border-left:0;border-top:1px solid rgba(29,20,17,.18)}\n  .t-grid{grid-template-columns:1fr;gap:34px}\n  .gal{grid-template-columns:1fr}\n  .thumbs{grid-template-rows:none;grid-template-columns:1fr 1fr}\n  .tiles{grid-template-columns:1fr}\n  .faq-cols{grid-template-columns:1fr}\n  .foot-grid{grid-template-columns:1fr 1fr}\n  .specs-in{grid-template-columns:1fr 1fr}\n  .spec:nth-child(3){border-left:0;padding-left:0}\n}\n@media (max-width:720px){\n  .wrap{padding:0 20px}\n  .nav-links,.nav-login{display:none}\n  .hero h1{font-size:34px}\n  .hero-sub{font-size:15px}\n  .float-card{left:auto;right:8px;bottom:10px;width:180px}\n  .cmp{overflow-x:auto}\n  .cmp table{min-width:520px}\n  .final h2{font-size:30px}\n  .thumbs{grid-template-columns:1fr}\n  .foot-grid{grid-template-columns:1fr 1fr}\n}\n</style>\n<header class=\"nav\" data-kid=\"1\" data-name=\"site header navigation\">\n<div class=\"wrap nav-in\" data-kid=\"1-1\" data-name=\"nav container with brand and links\">\n<a class=\"brand\" data-kid=\"1-1-1\" data-name=\"brand logo link with name\" href=\"/\"><span class=\"dot\" data-kid=\"1-1-1-1\" data-name=\"overlapping circular logo mark\"><i data-kid=\"1-1-1-1-1\" data-name=\"coral circle of logo mark\"></i><i data-kid=\"1-1-1-1-2\" data-name=\"gold circle of logo mark\"></i></span>MockMate AI</a>\n<nav class=\"nav-links\" data-kid=\"1-1-2\" data-name=\"primary page navigation links\">\n<a data-kid=\"1-1-2-1\" data-name=\"navigation link to features\" href=\"/features\">Features</a>\n<a data-kid=\"1-1-2-2\" data-name=\"navigation link to how it works\" href=\"/how-it-works\">How it works</a>\n<a data-kid=\"1-1-2-3\" data-name=\"navigation link to interview questions\" href=\"/interview-questions\">Interviews</a>\n<a data-kid=\"1-1-2-4\" data-name=\"navigation link to pricing\" href=\"/pricing\">Pricing</a>\n<a data-kid=\"1-1-2-5\" data-name=\"navigation link to blog\" href=\"/blog\">Blog</a>\n</nav>\n<div class=\"nav-right\" data-kid=\"1-1-3\" data-name=\"right side nav actions\">\n<a class=\"nav-login\" data-kid=\"1-1-3-1\" data-name=\"login link\" href=\"/login\">Log in</a>\n<a class=\"pill pill-primary pill-sm\" data-kid=\"1-1-3-2\" data-name=\"primary start free interview button\" href=\"/signup\">Start free interview</a>\n</div>\n</div>\n</header>\n<main data-kid=\"2\" data-name=\"main page content\">\n<section class=\"wrap hero\" data-kid=\"2-1\" data-name=\"hero section\">\n<div data-kid=\"2-1-1\" data-name=\"hero copy column\">\n<h1 class=\"serif\" data-dynamic=\"true\" data-kid=\"2-1-1-1\" data-name=\"hero headline\" data-reason=\"line text replaced by typewriter effect\">Practice Smarter.<br data-kid=\"2-1-1-1-1\" data-name=\"line break\"/><mark data-dynamic=\"true\" data-kid=\"2-1-1-1-2\" data-name=\"highlighted headline phrase\" data-reason=\"line text replaced by typewriter effect\">Interview Better.</mark><br data-kid=\"2-1-1-1-3\" data-name=\"line break\"/>Get Career Ready.</h1>\n<p class=\"hero-sub\" data-kid=\"2-1-1-2\" data-name=\"hero subheadline description\">Prepare for your next opportunity with AI-powered mock interviews, personalized feedback and realistic interview practice for every career path.</p>\n<div class=\"hero-cta\" data-kid=\"2-1-1-3\" data-name=\"hero call-to-action row\">\n<a class=\"pill pill-primary\" data-kid=\"2-1-1-3-1\" data-name=\"primary get started button\" href=\"/signup\">Start Free Interview</a>\n<a class=\"txt-link\" data-kid=\"2-1-1-3-2\" data-name=\"how it works text link\" href=\"/how-it-works\">How it works <i class=\"ph ph-arrow-right\" data-kid=\"2-1-1-3-2-1\" data-name=\"right arrow icon\"></i></a>\n</div>\n<p class=\"micro\" data-kid=\"2-1-1-4\" data-name=\"free plan micro copy note\">Free plan: 3 interviews a month, text mode, no card required.</p>\n</div>\n<div class=\"art\" data-kid=\"2-1-2\" data-name=\"hero illustration area\">\n<span class=\"reg tl\" data-kid=\"2-1-2-1\" data-name=\"registration crosshair ornament\"></span>\n<div class=\"plate\" data-kid=\"2-1-2-2\" data-name=\"plate frame holding illustration\">\n<img alt=\"Risograph illustration of a seated student answering a spoken question from an AI voice node\" data-kid=\"2-1-2-2-1\" data-name=\"hero risograph illustration\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/.kombai/canvas/assets/riso-hero.svg\"/>\n</div>\n<div class=\"float-card\" data-kid=\"2-1-2-3\" data-name=\"floating answer status card\">\n<div class=\"float-top\" data-dynamic=\"true\" data-kid=\"2-1-2-3-1\" data-name=\"float card header\" data-reason=\"status label and timer are reset by scripted interview flow\"><span data-dynamic=\"true\" data-kid=\"2-1-2-3-1-1\" data-name=\"answer status label\" data-reason=\"text reinitialized by interview flow script on segment loop\">Answering</span><span data-kid=\"2-1-2-3-1-2\" data-name=\"elapsed timer\">00:14</span></div>\n<div class=\"wave\" data-kid=\"2-1-2-3-2\" data-name=\"audio waveform visualization\"><i data-kid=\"2-1-2-3-2-1\" data-name=\"waveform bar\"></i><i data-kid=\"2-1-2-3-2-2\" data-name=\"waveform bar\"></i><i data-kid=\"2-1-2-3-2-3\" data-name=\"waveform bar\"></i><i data-kid=\"2-1-2-3-2-4\" data-name=\"waveform bar\"></i><i data-kid=\"2-1-2-3-2-5\" data-name=\"waveform bar\"></i><i data-kid=\"2-1-2-3-2-6\" data-name=\"waveform bar\"></i><i data-kid=\"2-1-2-3-2-7\" data-name=\"waveform bar\"></i><i data-kid=\"2-1-2-3-2-8\" data-name=\"waveform bar\"></i><i data-kid=\"2-1-2-3-2-9\" data-name=\"waveform bar\"></i><i data-kid=\"2-1-2-3-2-10\" data-name=\"waveform bar\"></i><i data-kid=\"2-1-2-3-2-11\" data-name=\"waveform bar\"></i><i data-kid=\"2-1-2-3-2-12\" data-name=\"waveform bar\"></i><i data-kid=\"2-1-2-3-2-13\" data-name=\"waveform bar\"></i><i data-kid=\"2-1-2-3-2-14\" data-name=\"waveform bar\"></i><i data-kid=\"2-1-2-3-2-15\" data-name=\"waveform bar\"></i><i data-kid=\"2-1-2-3-2-16\" data-name=\"waveform bar\"></i></div>\n</div>\n<span class=\"reg br\" data-kid=\"2-1-2-4\" data-name=\"registration crosshair ornament\"></span>\n</div>\n</section>\n<section class=\"specs\" data-kid=\"2-2\" data-name=\"spec strip section\">\n<div class=\"wrap specs-in\" data-kid=\"2-2-1\" data-name=\"spec metrics grid\">\n<div class=\"spec\" data-kid=\"2-2-1-1\" data-name=\"spec stat block\"><div class=\"n serif\" data-kid=\"2-2-1-1-1\" data-name=\"spec stat number\">10</div><div class=\"l\" data-kid=\"2-2-1-1-2\" data-name=\"spec stat label\">interview categories across every stream</div></div>\n<div class=\"spec\" data-kid=\"2-2-1-2\" data-name=\"spec stat block\"><div class=\"n serif\" data-kid=\"2-2-1-2-1\" data-name=\"spec stat number\">11</div><div class=\"l\" data-kid=\"2-2-1-2-2\" data-name=\"spec stat label\">interview languages, English to Punjabi</div></div>\n<div class=\"spec\" data-kid=\"2-2-1-3\" data-name=\"spec stat block\"><div class=\"n serif\" data-kid=\"2-2-1-3-1\" data-name=\"spec stat number\">6</div><div class=\"l\" data-kid=\"2-2-1-3-2\" data-name=\"spec stat label\">interviewer personalities to practise with</div></div>\n<div class=\"spec\" data-kid=\"2-2-1-4\" data-name=\"spec stat block\"><div class=\"n serif\" data-kid=\"2-2-1-4-1\" data-name=\"spec stat number\">4</div><div class=\"l\" data-kid=\"2-2-1-4-2\" data-name=\"spec stat label\">coding languages with test cases</div></div>\n</div>\n</section>\n<section class=\"split\" data-kid=\"2-3\" data-name=\"how-it-works split section\">\n<div class=\"wrap split-bg\" data-kid=\"2-3-1\" data-name=\"split layout background wrapper\">\n<div class=\"split-card\" data-kid=\"2-3-1-1\" data-name=\"split card container\">\n<div class=\"steps-panel\" data-kid=\"2-3-1-1-1\" data-name=\"steps panel false\">\n<h2 class=\"serif\" data-kid=\"2-3-1-1-1-1\" data-name=\"section headline\">From profile to report in five steps</h2>\n<p class=\"sub\" data-kid=\"2-3-1-1-1-2\" data-name=\"section subheading\">The setup screen asks once, then every later interview starts from your saved profile.</p>\n<div class=\"step\" data-kid=\"2-3-1-1-1-3\" data-name=\"step row false\"><span class=\"num serif\" data-kid=\"2-3-1-1-1-3-1\" data-name=\"step number\">01</span><div data-kid=\"2-3-1-1-1-3-2\" data-name=\"step content\"><b data-kid=\"2-3-1-1-1-3-2-1\" data-name=\"step title\">Create your profile</b><span data-kid=\"2-3-1-1-1-3-2-2\" data-name=\"step description\">Course, year of study, experience level and target role.</span></div></div>\n<div class=\"step\" data-kid=\"2-3-1-1-1-4\" data-name=\"step row\"><span class=\"num serif\" data-kid=\"2-3-1-1-1-4-1\" data-name=\"step number\">02</span><div data-kid=\"2-3-1-1-1-4-2\" data-name=\"step content\"><b data-kid=\"2-3-1-1-1-4-2-1\" data-name=\"step title\">Choose your career goal</b><span data-kid=\"2-3-1-1-1-4-2-2\" data-name=\"step description\">Category and role, from BBA marketing trainee to pharmacy assistant.</span></div></div>\n<div class=\"step\" data-kid=\"2-3-1-1-1-5\" data-name=\"step row\"><span class=\"num serif\" data-kid=\"2-3-1-1-1-5-1\" data-name=\"step number\">03</span><div data-kid=\"2-3-1-1-1-5-2\" data-name=\"step content\"><b data-kid=\"2-3-1-1-1-5-2-1\" data-name=\"step title\">Select your interview language</b><span data-kid=\"2-3-1-1-1-5-2-2\" data-name=\"step description\">Pick the language for this session, including Hinglish.</span></div></div>\n<div class=\"step\" data-kid=\"2-3-1-1-1-6\" data-name=\"step row\"><span class=\"num serif\" data-kid=\"2-3-1-1-1-6-1\" data-name=\"step number\">04</span><div data-kid=\"2-3-1-1-1-6-2\" data-name=\"step content\"><b data-kid=\"2-3-1-1-1-6-2-1\" data-name=\"step title\">Start your AI interview</b><span data-kid=\"2-3-1-1-1-6-2-2\" data-name=\"step description\">Voice or text, with follow-up questions that build on your answers.</span></div></div>\n<div class=\"step\" data-kid=\"2-3-1-1-1-7\" data-name=\"step row\" style=\"border-bottom:1px solid rgba(29,20,17,.14)\"><span class=\"num serif\" data-kid=\"2-3-1-1-1-7-1\" data-name=\"step number\">05</span><div data-kid=\"2-3-1-1-1-7-2\" data-name=\"step content\"><b data-kid=\"2-3-1-1-1-7-2-1\" data-name=\"step title\">Receive your performance report</b><span data-kid=\"2-3-1-1-1-7-2-2\" data-name=\"step description\">Rubric scores, missed concepts and better answers for each question.</span></div></div>\n</div>\n<div class=\"cat-panel\" data-kid=\"2-3-1-1-2\" data-name=\"category selection panel\">\n<div class=\"cat-head\" data-kid=\"2-3-1-1-2-1\" data-name=\"panel header\"><h3 data-kid=\"2-3-1-1-2-1-1\" data-name=\"panel title\">Choose a category</h3><span data-kid=\"2-3-1-1-2-1-2\" data-name=\"available count label\">10 available</span></div>\n<div class=\"cat-grid\" data-kid=\"2-3-1-1-2-2\" data-name=\"category grid\">\n<span class=\"cat on\" data-kid=\"2-3-1-1-2-2-1\" data-name=\"category chip selected\"><i class=\"ph ph-desktop\" data-kid=\"2-3-1-1-2-2-1-1\" data-name=\"desktop monitor icon\"></i>Technical</span>\n<span class=\"cat\" data-kid=\"2-3-1-1-2-2-2\" data-name=\"category chip false\"><i class=\"ph ph-users\" data-kid=\"2-3-1-1-2-2-2-1\" data-name=\"users group icon\"></i>HR</span>\n<span class=\"cat\" data-kid=\"2-3-1-1-2-2-3\" data-name=\"category chip\"><i class=\"ph ph-file-text\" data-kid=\"2-3-1-1-2-2-3-1\" data-name=\"document icon\"></i>Resume</span>\n<span class=\"cat\" data-kid=\"2-3-1-1-2-2-4\" data-name=\"category chip\"><i class=\"ph ph-code\" data-kid=\"2-3-1-1-2-2-4-1\" data-name=\"code brackets icon\"></i>Coding</span>\n<span class=\"cat\" data-kid=\"2-3-1-1-2-2-5\" data-name=\"category chip\"><i class=\"ph ph-briefcase\" data-kid=\"2-3-1-1-2-2-5-1\" data-name=\"briefcase icon\"></i>Management</span>\n<span class=\"cat\" data-kid=\"2-3-1-1-2-2-6\" data-name=\"category chip\"><i class=\"ph ph-calculator\" data-kid=\"2-3-1-1-2-2-6-1\" data-name=\"calculator icon\"></i>Commerce</span>\n<span class=\"cat\" data-kid=\"2-3-1-1-2-2-7\" data-name=\"category chip\"><i class=\"ph ph-flask\" data-kid=\"2-3-1-1-2-2-7-1\" data-name=\"flask science icon\"></i>Science</span>\n<span class=\"cat\" data-kid=\"2-3-1-1-2-2-8\" data-name=\"category chip\"><i class=\"ph ph-scales\" data-kid=\"2-3-1-1-2-2-8-1\" data-name=\"scales of justice icon\"></i>Law</span>\n<span class=\"cat\" data-kid=\"2-3-1-1-2-2-9\" data-name=\"category chip\"><i class=\"ph ph-stethoscope\" data-kid=\"2-3-1-1-2-2-9-1\" data-name=\"stethoscope icon\"></i>Medical</span>\n<span class=\"cat\" data-kid=\"2-3-1-1-2-2-10\" data-name=\"category chip\"><i class=\"ph ph-compass\" data-kid=\"2-3-1-1-2-2-10-1\" data-name=\"compass icon\"></i>General</span>\n</div>\n<div data-kid=\"2-3-1-1-2-3\" data-name=\"settings divider block\" style=\"margin-top:20px;padding-top:16px;border-top:1px solid rgba(29,20,17,.16)\">\n<div data-kid=\"2-3-1-1-2-3-1\" data-name=\"difficulty selector row\" style=\"display:flex;align-items:center;gap:8px;flex-wrap:wrap\">\n<span data-kid=\"2-3-1-1-2-3-1-1\" data-name=\"difficulty label\" style=\"font-size:11.5px;color:var(--ink-70);width:70px;flex:none\">Difficulty</span>\n<span class=\"pp\" data-kid=\"2-3-1-1-2-3-1-2\" data-name=\"difficulty option\" style=\"font-size:11.5px;padding:5px 11px\">Easy</span>\n<span class=\"pp on\" data-kid=\"2-3-1-1-2-3-1-3\" data-name=\"difficulty option selected\" style=\"font-size:11.5px;padding:5px 11px;background:var(--ink);border-color:var(--ink);color:var(--shell)\">Medium</span>\n<span class=\"pp\" data-kid=\"2-3-1-1-2-3-1-4\" data-name=\"difficulty option\" style=\"font-size:11.5px;padding:5px 11px\">Hard</span>\n</div>\n<div data-kid=\"2-3-1-1-2-3-2\" data-name=\"answer method selector row\" style=\"display:flex;align-items:center;gap:8px;flex-wrap:wrap;margin-top:9px\">\n<span data-kid=\"2-3-1-1-2-3-2-1\" data-name=\"answer method label\" style=\"font-size:11.5px;color:var(--ink-70);width:70px;flex:none\">Answer by</span>\n<span class=\"pp on\" data-kid=\"2-3-1-1-2-3-2-2\" data-name=\"voice option selected\" style=\"font-size:11.5px;padding:5px 11px\">Voice</span>\n<span class=\"pp\" data-kid=\"2-3-1-1-2-3-2-3\" data-name=\"text option\" style=\"font-size:11.5px;padding:5px 11px\">Text</span>\n</div>\n<div data-kid=\"2-3-1-1-2-3-3\" data-name=\"session length selector row\" style=\"display:flex;align-items:center;gap:8px;flex-wrap:wrap;margin-top:9px\">\n<span data-kid=\"2-3-1-1-2-3-3-1\" data-name=\"length label\" style=\"font-size:11.5px;color:var(--ink-70);width:70px;flex:none\">Length</span>\n<span class=\"pp\" data-kid=\"2-3-1-1-2-3-3-2\" data-name=\"length option false\" style=\"font-size:11.5px;padding:5px 11px\">15 min</span>\n<span class=\"pp on\" data-kid=\"2-3-1-1-2-3-3-3\" data-name=\"length option selected\" style=\"font-size:11.5px;padding:5px 11px;background:var(--ink);border-color:var(--ink);color:var(--shell)\">30 min</span>\n<span class=\"pp\" data-kid=\"2-3-1-1-2-3-3-4\" data-name=\"length option\" style=\"font-size:11.5px;padding:5px 11px\">45 min</span>\n</div>\n</div>\n<div class=\"cat-foot\" data-kid=\"2-3-1-1-2-4\" data-name=\"footnote note about questions changing\"><i class=\"ph ph-info\" data-kid=\"2-3-1-1-2-4-1\" data-name=\"info icon\"></i>Questions change with the category and the course on your profile.</div>\n</div>\n</div>\n</div>\n</section>\n<section class=\"transcript-sec\" data-kid=\"2-4\" data-name=\"interview persona section\">\n<div class=\"wrap t-grid\" data-kid=\"2-4-1\" data-name=\"persona section grid\">\n<div class=\"t-left\" data-kid=\"2-4-1-1\" data-name=\"persona copy column\">\n<h2 class=\"serif\" data-kid=\"2-4-1-1-1\" data-name=\"section headline\">Choose who interviews you</h2>\n<p class=\"sub\" data-kid=\"2-4-1-1-2\" data-name=\"section subheading\">Each personality changes the tone, the follow-ups and how hard the examiner pushes.</p>\n<div class=\"persona-pills\" data-kid=\"2-4-1-1-3\" data-name=\"persona pills\">\n<span class=\"pp\" data-kid=\"2-4-1-1-3-1\" data-name=\"persona option friendly\">Friendly</span>\n<span class=\"pp on\" data-kid=\"2-4-1-1-3-2\" data-name=\"persona option selected\">Professional</span>\n<span class=\"pp\" data-kid=\"2-4-1-1-3-3\" data-name=\"persona option strict\">Strict</span>\n<span class=\"pp\" data-kid=\"2-4-1-1-3-4\" data-name=\"persona option technical expert\">Technical Expert</span>\n<span class=\"pp\" data-kid=\"2-4-1-1-3-5\" data-name=\"persona option hr specialist\">HR Specialist</span>\n<span class=\"pp\" data-kid=\"2-4-1-1-3-6\" data-name=\"persona option hiring manager\">Hiring Manager</span>\n</div>\n<div class=\"p-note\" data-kid=\"2-4-1-1-4\" data-name=\"selected persona info card\">\n<b data-kid=\"2-4-1-1-4-1\" data-name=\"persona name\">Professional</b>\n<p data-kid=\"2-4-1-1-4-2\" data-name=\"persona behavior description\">Keeps to the agenda and the clock, with neutral follow-ups. Best for rehearsing under real interview conditions.</p>\n</div>\n</div>\n<div class=\"chat\" data-kid=\"2-4-1-2\" data-name=\"chat transcript card\">\n<div class=\"chat-head\" data-kid=\"2-4-1-2-1\" data-name=\"chat header\">\n<span class=\"av\" data-kid=\"2-4-1-2-1-1\" data-name=\"avatar container\"><img alt=\"Illustrated AI interviewer avatar with headset\" data-kid=\"2-4-1-2-1-1-1\" data-name=\"AI interviewer avatar image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/.kombai/canvas/assets/riso-avatar.svg\"/></span>\n<span data-kid=\"2-4-1-2-1-2\" data-name=\"interviewer identity block\"><b data-kid=\"2-4-1-2-1-2-1\" data-name=\"interviewer name\">Professional interviewer</b><span data-kid=\"2-4-1-2-1-2-2\" data-name=\"interview context meta\">Commerce · B.Com · Medium · Interview 3 of 20</span></span>\n<span class=\"time\" data-dynamic=\"true\" data-kid=\"2-4-1-2-1-3\" data-name=\"remaining time badge\" data-reason=\"remaining time text updated by live timer script\">18:42 left</span>\n</div>\n<div class=\"chat-body\" data-kid=\"2-4-1-2-2\" data-name=\"chat message list\">\n<div class=\"bub ai\" data-dynamic=\"true\" data-kid=\"2-4-1-2-2-1\" data-name=\"AI question bubble\" data-reason=\"bubble content and tag rewritten by scripted transcript carousel\"><span class=\"bub-tag\" data-dynamic=\"true\" data-kid=\"2-4-1-2-2-1-1\" data-name=\"bubble tag label\" data-reason=\"text rewritten by transcript carousel script\">Question 4</span>अपने last internship के बारे में बताइए — आपने वहाँ कौन सा काम संभाला?</div>\n<div class=\"bub me\" data-dynamic=\"true\" data-kid=\"2-4-1-2-2-2\" data-name=\"user answer bubble\" data-reason=\"text rewritten by scripted transcript carousel\">मैंने एक CA firm में चार महीने काम किया। मेरा काम GST returns और TDS entries तैयार करना था।</div>\n<div class=\"bub ai\" data-dynamic=\"true\" data-kid=\"2-4-1-2-2-3\" data-name=\"AI follow-up bubble\" data-reason=\"text rewritten by scripted transcript carousel\"><span class=\"bub-tag\" data-dynamic=\"true\" data-kid=\"2-4-1-2-2-3-1\" data-name=\"bubble tag label\" data-reason=\"text rewritten by transcript carousel script\">Follow-up</span>अच्छा। TDS return और GST return में मुख्य फर्क क्या है?</div>\n<div class=\"listen\" data-dynamic=\"true\" data-kid=\"2-4-1-2-2-4\" data-name=\"listening status pill\" data-reason=\"text rewritten by interview flow script as segment loop cycles\"><span class=\"pulse\" data-kid=\"2-4-1-2-2-4-1\" data-name=\"pulsing listening dot\"></span>Listening in Hindi</div>\n</div>\n<div class=\"chat-foot\" data-kid=\"2-4-1-2-3\" data-name=\"language selector footer\">\n<span class=\"lg on\" data-kid=\"2-4-1-2-3-1\" data-name=\"language selector hindi selected\">हिन्दी</span><span class=\"lg\" data-kid=\"2-4-1-2-3-2\" data-name=\"language selector english\">English</span><span class=\"lg\" data-kid=\"2-4-1-2-3-3\" data-name=\"language selector hinglish\">Hinglish</span><span class=\"lg\" data-kid=\"2-4-1-2-3-4\" data-name=\"language selector bangla\">বাংলা</span><span class=\"lg\" data-kid=\"2-4-1-2-3-5\" data-name=\"language selector tamil\">தமிழ்</span><span class=\"lg\" data-kid=\"2-4-1-2-3-6\" data-name=\"language selector marathi\">मराठी</span>\n<span class=\"more\" data-kid=\"2-4-1-2-3-7\" data-name=\"more languages label\">11 languages</span>\n</div>\n</div>\n</div>\n</section>\n<section class=\"feat-sec\" data-kid=\"2-5\" data-name=\"features gallery section\">\n<div class=\"wrap\" data-kid=\"2-5-1\" data-name=\"features section wrapper\">\n<div class=\"feat-head\" data-kid=\"2-5-1-1\" data-name=\"features section header\">\n<h2 class=\"serif\" data-kid=\"2-5-1-1-1\" data-name=\"features section headline\">Questions taken from your own resume</h2>\n<p data-kid=\"2-5-1-1-2\" data-name=\"features section subheading\">Upload once. Every session reads the same document, so the questions stay about your work.</p>\n</div>\n<div class=\"gal\" data-kid=\"2-5-1-2\" data-name=\"features gallery grid\">\n<div class=\"giant\" data-kid=\"2-5-1-2-1\" data-name=\"large resume feature card\">\n<h3 class=\"serif\" data-kid=\"2-5-1-2-1-1\" data-name=\"card title\">Resume-based questioning</h3>\n<p data-kid=\"2-5-1-2-1-2\" data-name=\"card description\">PDF or DOCX up to the upload limit. Skills, education, projects and internships are extracted, and questions are written against them.</p>\n<div class=\"resume-mock\" data-kid=\"2-5-1-2-1-3\" data-name=\"resume mock preview\">\n<div class=\"rm-top\" data-kid=\"2-5-1-2-1-3-1\" data-name=\"file name label\"><i class=\"ph ph-file-pdf\" data-kid=\"2-5-1-2-1-3-1-1\" data-name=\"pdf document icon\"></i>Resume_BCom_2026.pdf · parsed</div>\n<div class=\"rm-lines\" data-kid=\"2-5-1-2-1-3-2\" data-name=\"mock document body lines\"><i data-kid=\"2-5-1-2-1-3-2-1\" data-name=\"mock line bar\"></i><i data-kid=\"2-5-1-2-1-3-2-2\" data-name=\"mock line bar\"></i><i data-kid=\"2-5-1-2-1-3-2-3\" data-name=\"mock line bar\"></i></div>\n<div class=\"skills\" data-kid=\"2-5-1-2-1-3-3\" data-name=\"extracted skill tags\"><span class=\"skill\" data-kid=\"2-5-1-2-1-3-3-1\" data-name=\"skill tag\">Tally ERP</span><span class=\"skill\" data-kid=\"2-5-1-2-1-3-3-2\" data-name=\"skill tag\">GST filing</span><span class=\"skill\" data-kid=\"2-5-1-2-1-3-3-3\" data-name=\"skill tag\">TDS</span><span class=\"skill\" data-kid=\"2-5-1-2-1-3-3-4\" data-name=\"skill tag\">MS Excel</span><span class=\"skill\" data-kid=\"2-5-1-2-1-3-3-5\" data-name=\"skill tag\">Audit support</span></div>\n<div class=\"rm-q\" data-kid=\"2-5-1-2-1-3-4\" data-name=\"sample generated question\">“You filed GST returns for twelve clients. How did you fix a mismatch between GSTR-1 and GSTR-3B?”</div>\n<div class=\"rm-q\" data-kid=\"2-5-1-2-1-3-5\" data-name=\"sample follow-up question\" style=\"border-top:0;margin-top:6px;padding-top:0;font-size:14px\">“Which returns did you file yourself, and which went to a senior for review?”</div>\n</div>\n<div class=\"giant-foot\" data-kid=\"2-5-1-2-1-4\" data-name=\"card feature badges\">\n<span data-kid=\"2-5-1-2-1-4-1\" data-name=\"file format badge\"><i class=\"ph ph-file-pdf\" data-kid=\"2-5-1-2-1-4-1-1\" data-name=\"pdf icon\"></i>PDF or DOCX</span>\n<span data-kid=\"2-5-1-2-1-4-2\" data-name=\"private storage badge\"><i class=\"ph ph-lock-simple\" data-kid=\"2-5-1-2-1-4-2-1\" data-name=\"lock icon\"></i>Private storage</span>\n<span data-kid=\"2-5-1-2-1-4-3\" data-name=\"delete anytime badge\"><i class=\"ph ph-trash\" data-kid=\"2-5-1-2-1-4-3-1\" data-name=\"trash icon\"></i>Delete anytime</span>\n</div>\n</div>\n<div class=\"thumbs\" data-kid=\"2-5-1-2-2\" data-name=\"thumb card column\">\n<div class=\"thumb\" data-kid=\"2-5-1-2-2-1\" data-name=\"voice answers thumb card\">\n<div class=\"th-top\" data-kid=\"2-5-1-2-2-1-1\" data-name=\"thumb header\"><b data-kid=\"2-5-1-2-2-1-1-1\" data-name=\"thumb title\">Voice answers</b><i class=\"ph ph-mic\" data-kid=\"2-5-1-2-2-1-1-2\" data-name=\"microphone icon\"></i></div>\n<p data-kid=\"2-5-1-2-2-1-2\" data-name=\"thumb description\">Speech-to-text, with a typed fallback.</p>\n<div class=\"mini-wave\" data-kid=\"2-5-1-2-2-1-3\" data-name=\"mini waveform visualization\"><i data-kid=\"2-5-1-2-2-1-3-1\" data-name=\"waveform bar\"></i><i data-kid=\"2-5-1-2-2-1-3-2\" data-name=\"waveform bar\"></i><i data-kid=\"2-5-1-2-2-1-3-3\" data-name=\"waveform bar\"></i><i data-kid=\"2-5-1-2-2-1-3-4\" data-name=\"waveform bar\"></i><i data-kid=\"2-5-1-2-2-1-3-5\" data-name=\"waveform bar\"></i><i data-kid=\"2-5-1-2-2-1-3-6\" data-name=\"waveform bar\"></i><i data-kid=\"2-5-1-2-2-1-3-7\" data-name=\"waveform bar\"></i><i data-kid=\"2-5-1-2-2-1-3-8\" data-name=\"waveform bar\"></i><i data-kid=\"2-5-1-2-2-1-3-9\" data-name=\"waveform bar\"></i><i data-kid=\"2-5-1-2-2-1-3-10\" data-name=\"waveform bar\"></i></div>\n</div>\n<div class=\"thumb\" data-kid=\"2-5-1-2-2-2\" data-name=\"coding round thumb card\">\n<div class=\"th-top\" data-kid=\"2-5-1-2-2-2-1\" data-name=\"thumb header\"><b data-kid=\"2-5-1-2-2-2-1-1\" data-name=\"thumb title\">Coding round</b><i class=\"ph ph-code\" data-kid=\"2-5-1-2-2-2-1-2\" data-name=\"code brackets icon\"></i></div>\n<div class=\"mini-code\" data-kid=\"2-5-1-2-2-2-2\" data-name=\"mini code snippet\"><b data-kid=\"2-5-1-2-2-2-2-1\" data-name=\"code keyword true\">for</b> (x <b data-kid=\"2-5-1-2-2-2-2-2\" data-name=\"code keyword true\">of</b> rows) {<br data-kid=\"2-5-1-2-2-2-2-3\" data-name=\"line break\"/>  sum += x.amt;<br data-kid=\"2-5-1-2-2-2-2-4\" data-name=\"line break\"/>}</div>\n</div>\n<div class=\"thumb\" data-kid=\"2-5-1-2-2-3\" data-name=\"feedback report thumb card\">\n<div class=\"th-top\" data-kid=\"2-5-1-2-2-3-1\" data-name=\"thumb header\"><b data-kid=\"2-5-1-2-2-3-1-1\" data-name=\"thumb title\">Feedback report</b><i class=\"ph ph-note\" data-kid=\"2-5-1-2-2-3-1-2\" data-name=\"note icon\"></i></div>\n<p data-kid=\"2-5-1-2-2-3-2\" data-name=\"thumb description\">Rubric notes, better answers, missed concepts.</p>\n<div class=\"mini-bars\" data-kid=\"2-5-1-2-2-3-3\" data-name=\"mini bar chart\"><i data-kid=\"2-5-1-2-2-3-3-1\" data-name=\"chart bar\"></i><i data-kid=\"2-5-1-2-2-3-3-2\" data-name=\"chart bar\"></i><i data-kid=\"2-5-1-2-2-3-3-3\" data-name=\"chart bar\"></i><i data-kid=\"2-5-1-2-2-3-3-4\" data-name=\"chart bar\"></i><i data-kid=\"2-5-1-2-2-3-3-5\" data-name=\"chart bar\"></i><i data-kid=\"2-5-1-2-2-3-3-6\" data-name=\"chart bar\"></i></div>\n</div>\n<div class=\"thumb\" data-kid=\"2-5-1-2-2-4\" data-name=\"progress thumb card\">\n<div class=\"th-top\" data-kid=\"2-5-1-2-2-4-1\" data-name=\"thumb header\"><b data-kid=\"2-5-1-2-2-4-1-1\" data-name=\"thumb title\">Progress</b><i class=\"ph ph-chart-line\" data-kid=\"2-5-1-2-2-4-1-2\" data-name=\"line chart icon\"></i></div>\n<p data-kid=\"2-5-1-2-2-4-2\" data-name=\"thumb description\">Score by category across attempts.</p>\n<div class=\"mini-bars\" data-kid=\"2-5-1-2-2-4-3\" data-name=\"mini bar chart\"><i data-kid=\"2-5-1-2-2-4-3-1\" data-name=\"chart bar\"></i><i data-kid=\"2-5-1-2-2-4-3-2\" data-name=\"chart bar\"></i><i data-kid=\"2-5-1-2-2-4-3-3\" data-name=\"chart bar\"></i><i data-kid=\"2-5-1-2-2-4-3-4\" data-name=\"chart bar\"></i><i data-kid=\"2-5-1-2-2-4-3-5\" data-name=\"chart bar\"></i><i data-kid=\"2-5-1-2-2-4-3-6\" data-name=\"chart bar\"></i></div>\n</div>\n</div>\n</div>\n</div>\n</section>\n<section class=\"price-sec\" data-kid=\"2-6\" data-name=\"pricing section\">\n<div class=\"wrap\" data-kid=\"2-6-1\" data-name=\"pricing section wrapper\">\n<div class=\"price-head\" data-kid=\"2-6-1-1\" data-name=\"pricing header\">\n<h2 class=\"serif\" data-kid=\"2-6-1-1-1\" data-name=\"pricing headline\">Pricing</h2>\n<p data-kid=\"2-6-1-1-2\" data-name=\"pricing subheading\">Every plan keeps your transcripts and the question banks for your course.</p>\n</div>\n<div class=\"tiles\" data-kid=\"2-6-1-2\" data-name=\"pricing tiles grid\">\n<div class=\"tile\" data-kid=\"2-6-1-2-1\" data-name=\"free plan pricing card\">\n<h3 data-kid=\"2-6-1-2-1-1\" data-name=\"plan name\">Free</h3>\n<p class=\"for\" data-kid=\"2-6-1-2-1-2\" data-name=\"plan description\">For a first look at how an AI interview feels.</p>\n<div class=\"amt serif\" data-kid=\"2-6-1-2-1-3\" data-name=\"price amount\">₹0<span data-kid=\"2-6-1-2-1-3-1\" data-name=\"billing period\">/ month</span></div>\n<ul data-kid=\"2-6-1-2-1-4\" data-name=\"feature list\">\n<li data-kid=\"2-6-1-2-1-4-1\" data-name=\"feature list item\"><i class=\"ph ph-check\" data-kid=\"2-6-1-2-1-4-1-1\" data-name=\"checkmark icon\"></i><span data-kid=\"2-6-1-2-1-4-1-2\" data-name=\"feature text\"><b data-kid=\"2-6-1-2-1-4-1-2-1\" data-name=\"feature count\">3</b> interviews a month</span></li>\n<li data-kid=\"2-6-1-2-1-4-2\" data-name=\"feature list item\"><i class=\"ph ph-check\" data-kid=\"2-6-1-2-1-4-2-1\" data-name=\"checkmark icon\"></i><span data-kid=\"2-6-1-2-1-4-2-2\" data-name=\"feature text\">Text mode</span></li>\n<li data-kid=\"2-6-1-2-1-4-3\" data-name=\"feature list item\"><i class=\"ph ph-check\" data-kid=\"2-6-1-2-1-4-3-1\" data-name=\"checkmark icon\"></i><span data-kid=\"2-6-1-2-1-4-3-2\" data-name=\"feature text\"><b data-kid=\"2-6-1-2-1-4-3-2-1\" data-name=\"feature count\">1</b> resume</span></li>\n<li data-kid=\"2-6-1-2-1-4-4\" data-name=\"feature list item\"><i class=\"ph ph-check\" data-kid=\"2-6-1-2-1-4-4-1\" data-name=\"checkmark icon\"></i><span data-kid=\"2-6-1-2-1-4-4-2\" data-name=\"feature text\">Basic report</span></li>\n</ul>\n<a class=\"pill pill-outline\" data-kid=\"2-6-1-2-1-5\" data-name=\"plan select button\" href=\"/signup\">Start free</a>\n</div>\n<div class=\"tile hi\" data-kid=\"2-6-1-2-2\" data-name=\"starter plan pricing card\">\n<h3 data-kid=\"2-6-1-2-2-1\" data-name=\"plan name\">Starter</h3>\n<p class=\"for\" data-kid=\"2-6-1-2-2-2\" data-name=\"plan description\">For final-year students and freshers in placement season.</p>\n<div class=\"amt serif\" data-kid=\"2-6-1-2-2-3\" data-name=\"price amount\">₹399<span data-kid=\"2-6-1-2-2-3-1\" data-name=\"billing period\">/ month</span></div>\n<ul data-kid=\"2-6-1-2-2-4\" data-name=\"feature list\">\n<li data-kid=\"2-6-1-2-2-4-1\" data-name=\"feature list item\"><i class=\"ph ph-check\" data-kid=\"2-6-1-2-2-4-1-1\" data-name=\"checkmark icon\"></i><span data-kid=\"2-6-1-2-2-4-1-2\" data-name=\"feature text\"><b data-kid=\"2-6-1-2-2-4-1-2-1\" data-name=\"feature count\">20</b> interviews a month</span></li>\n<li data-kid=\"2-6-1-2-2-4-2\" data-name=\"feature list item\"><i class=\"ph ph-check\" data-kid=\"2-6-1-2-2-4-2-1\" data-name=\"checkmark icon\"></i><span data-kid=\"2-6-1-2-2-4-2-2\" data-name=\"feature text\">Voice and text</span></li>\n<li data-kid=\"2-6-1-2-2-4-3\" data-name=\"feature list item\"><i class=\"ph ph-check\" data-kid=\"2-6-1-2-2-4-3-1\" data-name=\"checkmark icon\"></i><span data-kid=\"2-6-1-2-2-4-3-2\" data-name=\"feature text\"><b data-kid=\"2-6-1-2-2-4-3-2-1\" data-name=\"feature count\">3</b> resumes</span></li>\n<li data-kid=\"2-6-1-2-2-4-4\" data-name=\"feature list item\"><i class=\"ph ph-check\" data-kid=\"2-6-1-2-2-4-4-1\" data-name=\"checkmark icon\"></i><span data-kid=\"2-6-1-2-2-4-4-2\" data-name=\"feature text\">Full report and history</span></li>\n</ul>\n<a class=\"pill pill-primary\" data-kid=\"2-6-1-2-2-5\" data-name=\"plan select button\" href=\"/signup\">Choose Starter</a>\n</div>\n<div class=\"tile\" data-kid=\"2-6-1-2-3\" data-name=\"pro plan pricing card\">\n<h3 data-kid=\"2-6-1-2-3-1\" data-name=\"plan name\">Pro</h3>\n<p class=\"for\" data-kid=\"2-6-1-2-3-2\" data-name=\"plan description\">For working professionals sitting several rounds at once.</p>\n<div class=\"amt serif\" data-kid=\"2-6-1-2-3-3\" data-name=\"price amount\">₹899<span data-kid=\"2-6-1-2-3-3-1\" data-name=\"billing period\">/ month</span></div>\n<ul data-kid=\"2-6-1-2-3-4\" data-name=\"feature list\">\n<li data-kid=\"2-6-1-2-3-4-1\" data-name=\"feature list item\"><i class=\"ph ph-check\" data-kid=\"2-6-1-2-3-4-1-1\" data-name=\"checkmark icon\"></i><span data-kid=\"2-6-1-2-3-4-1-2\" data-name=\"feature text\"><b data-kid=\"2-6-1-2-3-4-1-2-1\" data-name=\"feature count\">60</b> interviews a month</span></li>\n<li data-kid=\"2-6-1-2-3-4-2\" data-name=\"feature list item\"><i class=\"ph ph-check\" data-kid=\"2-6-1-2-3-4-2-1\" data-name=\"checkmark icon\"></i><span data-kid=\"2-6-1-2-3-4-2-2\" data-name=\"feature text\">All 6 interviewer personalities</span></li>\n<li data-kid=\"2-6-1-2-3-4-3\" data-name=\"feature list item\"><i class=\"ph ph-check\" data-kid=\"2-6-1-2-3-4-3-1\" data-name=\"checkmark icon\"></i><span data-kid=\"2-6-1-2-3-4-3-2\" data-name=\"feature text\"><b data-kid=\"2-6-1-2-3-4-3-2-1\" data-name=\"feature count\">10</b> resumes</span></li>\n<li data-kid=\"2-6-1-2-3-4-4\" data-name=\"feature list item\"><i class=\"ph ph-check\" data-kid=\"2-6-1-2-3-4-4-1\" data-name=\"checkmark icon\"></i><span data-kid=\"2-6-1-2-3-4-4-2\" data-name=\"feature text\">Advanced analytics</span></li>\n</ul>\n<a class=\"pill pill-outline\" data-kid=\"2-6-1-2-3-5\" data-name=\"plan select button\" href=\"/signup\">Choose Pro</a>\n</div>\n</div>\n<div class=\"cmp\" data-kid=\"2-6-1-3\" data-name=\"plan comparison table container\">\n<table data-kid=\"2-6-1-3-1\" data-name=\"plan comparison table\">\n<thead data-kid=\"2-6-1-3-1-1\" data-name=\"table header row\">\n<tr data-kid=\"2-6-1-3-1-1-1\" data-name=\"header row\"><th data-kid=\"2-6-1-3-1-1-1-1\" data-name=\"column header false\">What changes</th><th data-kid=\"2-6-1-3-1-1-1-2\" data-name=\"column header free\">Free</th><th data-kid=\"2-6-1-3-1-1-1-3\" data-name=\"column header starter\">Starter</th><th data-kid=\"2-6-1-3-1-1-1-4\" data-name=\"column header pro\">Pro</th></tr>\n</thead>\n<tbody data-kid=\"2-6-1-3-1-2\" data-name=\"table body\">\n<tr data-kid=\"2-6-1-3-1-2-1\" data-name=\"comparison row interviews per month\"><td data-kid=\"2-6-1-3-1-2-1-1\" data-name=\"row label false\">Interviews per month</td><td data-kid=\"2-6-1-3-1-2-1-2\" data-name=\"free value\">3</td><td data-kid=\"2-6-1-3-1-2-1-3\" data-name=\"starter value\">20</td><td data-kid=\"2-6-1-3-1-2-1-4\" data-name=\"pro value\">60</td></tr>\n<tr data-kid=\"2-6-1-3-1-2-2\" data-name=\"comparison row saved resumes\"><td data-kid=\"2-6-1-3-1-2-2-1\" data-name=\"row label\">Saved resumes</td><td data-kid=\"2-6-1-3-1-2-2-2\" data-name=\"free value\">1</td><td data-kid=\"2-6-1-3-1-2-2-3\" data-name=\"starter value\">3</td><td data-kid=\"2-6-1-3-1-2-2-4\" data-name=\"pro value\">10</td></tr>\n<tr data-kid=\"2-6-1-3-1-2-3\" data-name=\"comparison row voice mode\"><td data-kid=\"2-6-1-3-1-2-3-1\">Voice mode</td><td class=\"no\" data-kid=\"2-6-1-3-1-2-3-2\" data-name=\"free unavailable\">—</td><td class=\"yes\" data-kid=\"2-6-1-3-1-2-3-3\" data-name=\"starter included\">Included</td><td class=\"yes\" data-kid=\"2-6-1-3-1-2-3-4\" data-name=\"pro included\">Included</td></tr>\n<tr data-kid=\"2-6-1-3-1-2-4\" data-name=\"comparison row coding round\"><td data-kid=\"2-6-1-3-1-2-4-1\" data-name=\"row label\">Coding round</td><td class=\"no\" data-kid=\"2-6-1-3-1-2-4-2\" data-name=\"free unavailable\">—</td><td class=\"yes\" data-kid=\"2-6-1-3-1-2-4-3\" data-name=\"starter included\">Included</td><td class=\"yes\" data-kid=\"2-6-1-3-1-2-4-4\" data-name=\"pro included\">Included</td></tr>\n<tr data-kid=\"2-6-1-3-1-2-5\" data-name=\"comparison row report depth\"><td data-kid=\"2-6-1-3-1-2-5-1\" data-name=\"row label\">Report depth</td><td data-kid=\"2-6-1-3-1-2-5-2\" data-name=\"free value\">Basic</td><td data-kid=\"2-6-1-3-1-2-5-3\" data-name=\"starter value\">Full</td><td data-kid=\"2-6-1-3-1-2-5-4\" data-name=\"pro value\">Advanced</td></tr>\n<tr data-kid=\"2-6-1-3-1-2-6\" data-name=\"comparison row progress analytics\"><td data-kid=\"2-6-1-3-1-2-6-1\" data-name=\"row label\">Progress analytics</td><td class=\"no\" data-kid=\"2-6-1-3-1-2-6-2\" data-name=\"free unavailable\">—</td><td class=\"no\" data-kid=\"2-6-1-3-1-2-6-3\" data-name=\"starter unavailable\">—</td><td class=\"yes\" data-kid=\"2-6-1-3-1-2-6-4\" data-name=\"pro included\">Included</td></tr>\n</tbody>\n</table>\n</div>\n<p class=\"price-note\" data-kid=\"2-6-1-4\" data-name=\"pricing disclaimer note\">Prices in INR, inclusive of GST. Introductory pricing, subject to change.</p>\n</div>\n</section>\n<section class=\"faq-sec\" data-kid=\"2-7\" data-name=\"faq section\">\n<div class=\"wrap\" data-kid=\"2-7-1\" data-name=\"faq section wrapper\">\n<div class=\"faq-head\" data-kid=\"2-7-1-1\" data-name=\"faq header\">\n<h2 class=\"serif\" data-kid=\"2-7-1-1-1\" data-name=\"faq headline\">Before you sign up</h2>\n</div>\n<div class=\"faq-cols\" data-kid=\"2-7-1-2\" data-name=\"faq columns\">\n<div data-kid=\"2-7-1-2-1\" data-name=\"faq left column\">\n<div class=\"faq-item\" data-kid=\"2-7-1-2-1-1\" data-name=\"faq item\"><h4 data-kid=\"2-7-1-2-1-1-1\" data-name=\"faq question false\"><i class=\"ph ph-question\" data-kid=\"2-7-1-2-1-1-1-1\" data-name=\"question mark icon\"></i>Do I have to interview in English?</h4><p data-kid=\"2-7-1-2-1-1-2\" data-name=\"faq answer\">No. Choose any of the 11 languages on the setup screen, including Hinglish. Questions, follow-ups and the report stay in that language.</p></div>\n<div class=\"faq-item\" data-kid=\"2-7-1-2-1-2\" data-name=\"faq item\"><h4 data-kid=\"2-7-1-2-1-2-1\" data-name=\"faq question\"><i class=\"ph ph-question\" data-kid=\"2-7-1-2-1-2-1-1\" data-name=\"question mark icon\"></i>Will the questions match my course?</h4><p data-kid=\"2-7-1-2-1-2-2\" data-name=\"faq answer\">Yes. Commerce sessions ask about accounting, taxation, banking and economics; law sessions ask about case reasoning; medical sessions use professional scenarios.</p></div>\n<div class=\"faq-item\" data-kid=\"2-7-1-2-1-3\" data-name=\"faq item\"><h4 data-kid=\"2-7-1-2-1-3-1\" data-name=\"faq question\"><i class=\"ph ph-question\" data-kid=\"2-7-1-2-1-3-1-1\" data-name=\"question mark icon\"></i>How is an answer scored?</h4><p data-kid=\"2-7-1-2-1-3-2\" data-name=\"faq answer\">Against the rubric for your stream and category, such as subject accuracy, structure and communication. The report names the criterion behind each score.</p></div>\n</div>\n<div data-kid=\"2-7-1-2-2\" data-name=\"faq right column\">\n<div class=\"faq-item\" data-kid=\"2-7-1-2-2-1\" data-name=\"faq item\"><h4 data-kid=\"2-7-1-2-2-1-1\" data-name=\"faq question\"><i class=\"ph ph-question\" data-kid=\"2-7-1-2-2-1-1-1\" data-name=\"question mark icon\"></i>Can I resume an interrupted interview?</h4><p data-kid=\"2-7-1-2-2-1-2\" data-name=\"faq answer\">Yes. Every answer is saved, so reopening the session continues from the last turn and the timer stays paused until you return.</p></div>\n<div class=\"faq-item\" data-kid=\"2-7-1-2-2-2\" data-name=\"faq item\"><h4 data-kid=\"2-7-1-2-2-2-1\" data-name=\"faq question\"><i class=\"ph ph-question\" data-kid=\"2-7-1-2-2-2-1-1\" data-name=\"question mark icon\"></i>What if my microphone does not work?</h4><p data-kid=\"2-7-1-2-2-2-2\" data-name=\"faq answer\">The session switches to typed answers without ending. If permission is denied, the same questions continue in text mode.</p></div>\n<div class=\"faq-item\" data-kid=\"2-7-1-2-2-3\" data-name=\"faq item\"><h4 data-kid=\"2-7-1-2-2-3-1\" data-name=\"faq question\"><i class=\"ph ph-question\" data-kid=\"2-7-1-2-2-3-1-1\" data-name=\"question mark icon\"></i>Who can read my resume?</h4><p data-kid=\"2-7-1-2-2-3-2\" data-name=\"faq answer\">Only your own sessions read it. Files are stored privately and can be deleted from the resume page at any time.</p></div>\n</div>\n</div>\n<div class=\"faq-cta\" data-kid=\"2-7-1-3\" data-name=\"faq bottom call-to-action\"><span data-kid=\"2-7-1-3-1\" data-name=\"cta text\">Still have a question?</span><a class=\"txt-link\" data-kid=\"2-7-1-3-2\" data-name=\"contact support link\" href=\"/contact\">Contact support <i class=\"ph ph-arrow-right\" data-kid=\"2-7-1-3-2-1\" data-name=\"right arrow icon\"></i></a></div>\n</div>\n</section>\n<section class=\"final\" data-kid=\"2-8\" data-name=\"final call-to-action section\">\n<div class=\"halftone\" data-kid=\"2-8-1\" data-name=\"decorative halftone dot background\"></div>\n<div class=\"wrap final-in\" data-kid=\"2-8-2\" data-name=\"final CTA inner\">\n<span class=\"avatar\" data-kid=\"2-8-2-1\" data-name=\"avatar circle\"><img alt=\"Illustrated AI interviewer avatar with headset\" data-kid=\"2-8-2-1-1\" data-name=\"AI interviewer avatar\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/.kombai/canvas/assets/riso-avatar.svg\"/></span>\n<h2 class=\"serif\" data-kid=\"2-8-2-2\" data-name=\"final CTA headline\">Your Next Interview Starts Here.</h2>\n<p data-kid=\"2-8-2-3\" data-name=\"final CTA subheading\">Free plan: 3 interviews a month, text mode, no card required.</p>\n<a class=\"pill pill-primary\" data-kid=\"2-8-2-4\" data-name=\"primary get started button\" href=\"/signup\">Start Free Interview</a>\n</div>\n</section>\n</main>\n<footer class=\"foot\" data-kid=\"3\" data-name=\"site footer\">\n<div class=\"wrap\" data-kid=\"3-1\" data-name=\"footer inner wrapper\">\n<div class=\"foot-grid\" data-kid=\"3-1-1\" data-name=\"footer link grid\">\n<div class=\"foot-brand\" data-kid=\"3-1-1-1\" data-name=\"footer brand column\">\n<a class=\"brand\" data-kid=\"3-1-1-1-1\" data-name=\"brand logo link\" href=\"/\"><span class=\"dot\" data-kid=\"3-1-1-1-1-1\" data-name=\"overlapping circular logo mark\"><i data-kid=\"3-1-1-1-1-1-1\" data-name=\"coral circle of logo mark\"></i><i data-kid=\"3-1-1-1-1-1-2\" data-name=\"gold circle of logo mark\"></i></span>MockMate AI</a>\n<p data-kid=\"3-1-1-1-2\" data-name=\"brand tagline\">AI mock interviews for every course and career path. Interface in English, interviews in 11 languages.</p>\n</div>\n<div data-kid=\"3-1-1-2\" data-name=\"footer product links column\">\n<h5 data-kid=\"3-1-1-2-1\" data-name=\"column heading\">Product</h5>\n<ul data-kid=\"3-1-1-2-2\" data-name=\"product link list\"><li data-kid=\"3-1-1-2-2-1\" data-name=\"list item\"><a data-kid=\"3-1-1-2-2-1-1\" data-name=\"features link\" href=\"/features\">Features</a></li><li data-kid=\"3-1-1-2-2-2\" data-name=\"list item\"><a data-kid=\"3-1-1-2-2-2-1\" data-name=\"how it works link\" href=\"/how-it-works\">How it works</a></li><li data-kid=\"3-1-1-2-2-3\" data-name=\"list item\"><a data-kid=\"3-1-1-2-2-3-1\" data-name=\"pricing link\" href=\"/pricing\">Pricing</a></li><li data-kid=\"3-1-1-2-2-4\" data-name=\"list item\"><a data-kid=\"3-1-1-2-2-4-1\" data-name=\"AI mock interview link\" href=\"/ai-mock-interview\">AI mock interview</a></li></ul>\n</div>\n<div data-kid=\"3-1-1-3\" data-name=\"footer practice links column\">\n<h5 data-kid=\"3-1-1-3-1\" data-name=\"column heading\">Practice</h5>\n<ul data-kid=\"3-1-1-3-2\" data-name=\"practice link list\"><li data-kid=\"3-1-1-3-2-1\" data-name=\"list item\"><a data-kid=\"3-1-1-3-2-1-1\" data-name=\"interview questions link\" href=\"/interview-questions\">Interview questions</a></li><li data-kid=\"3-1-1-3-2-2\" data-name=\"list item\"><a data-kid=\"3-1-1-3-2-2-1\" data-name=\"coding round link\" href=\"/coding-interview\">Coding round</a></li><li data-kid=\"3-1-1-3-2-3\" data-name=\"list item\"><a data-kid=\"3-1-1-3-2-3-1\" data-name=\"MBA link\" href=\"/interview-preparation/mba\">MBA</a></li><li data-kid=\"3-1-1-3-2-4\" data-name=\"list item\"><a data-kid=\"3-1-1-3-2-4-1\" data-name=\"B.Com link\" href=\"/interview-preparation/bcom\">B.Com</a></li></ul>\n</div>\n<div data-kid=\"3-1-1-4\" data-name=\"footer company links column\">\n<h5 data-kid=\"3-1-1-4-1\" data-name=\"column heading\">Company</h5>\n<ul data-kid=\"3-1-1-4-2\" data-name=\"company link list\"><li data-kid=\"3-1-1-4-2-1\" data-name=\"list item\"><a data-kid=\"3-1-1-4-2-1-1\" data-name=\"about link\" href=\"/about\">About</a></li><li data-kid=\"3-1-1-4-2-2\"><a data-kid=\"3-1-1-4-2-2-1\" data-name=\"contact link\" href=\"/contact\">Contact</a></li><li data-kid=\"3-1-1-4-2-3\" data-name=\"list item\"><a data-kid=\"3-1-1-4-2-3-1\" data-name=\"blog link\" href=\"/blog\">Blog</a></li><li data-kid=\"3-1-1-4-2-4\" data-name=\"list item\"><a data-kid=\"3-1-1-4-2-4-1\" data-name=\"FAQ link\" href=\"/faq\">FAQ</a></li></ul>\n</div>\n<div data-kid=\"3-1-1-5\" data-name=\"footer legal links column\">\n<h5 data-kid=\"3-1-1-5-1\" data-name=\"column heading\">Legal</h5>\n<ul data-kid=\"3-1-1-5-2\" data-name=\"legal link list\"><li data-kid=\"3-1-1-5-2-1\" data-name=\"list item\"><a data-kid=\"3-1-1-5-2-1-1\" data-name=\"privacy policy link\" href=\"/privacy\">Privacy policy</a></li><li data-kid=\"3-1-1-5-2-2\" data-name=\"list item\"><a data-kid=\"3-1-1-5-2-2-1\" data-name=\"terms of service link\" href=\"/terms\">Terms of service</a></li><li data-kid=\"3-1-1-5-2-3\" data-name=\"list item\"><a data-kid=\"3-1-1-5-2-3-1\" data-name=\"cookie policy link\" href=\"/cookies\">Cookie policy</a></li><li data-kid=\"3-1-1-5-2-4\" data-name=\"list item\"><a data-kid=\"3-1-1-5-2-4-1\" data-name=\"interview tips link\" href=\"/interview-tips\">Interview tips</a></li></ul>\n</div>\n</div>\n<div class=\"foot-bottom\" data-kid=\"3-1-2\" data-name=\"footer bottom bar\">\n<span data-kid=\"3-1-2-1\" data-name=\"copyright notice\">© 2026 MockMate AI</span>\n<div class=\"social\" data-kid=\"3-1-2-2\" data-name=\"social icon set\"><i class=\"ph ph-linkedin-logo\" data-kid=\"3-1-2-2-1\" data-name=\"linkedin icon\"></i><i class=\"ph ph-youtube-logo\" data-kid=\"3-1-2-2-2\" data-name=\"youtube icon\"></i><i class=\"ph ph-instagram-logo\" data-kid=\"3-1-2-2-3\" data-name=\"instagram icon\"></i><i class=\"ph ph-x-logo\" data-kid=\"3-1-2-2-4\" data-name=\"x logo icon\"></i></div>\n</div>\n</div>\n</footer>",
