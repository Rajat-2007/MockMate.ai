    "var_4981c9283f18": {
      "type": "variant",
      "label": "Mobile Interview Room — V1 Baltic (390)",
      "parentId": "var_116b5457c4e9",
      "themeId": null,
      "rect": {
        "x": 11530,
        "y": 0,
        "w": 390,
        "h": 0
      },
      "html": "<style>\n@import url('https://fonts.googleapis.com/css2?family=Kumbh+Sans:wght@400;500;600;700&family=Share+Tech+Mono&display=swap');\n@import url(\"https://cdn.jsdelivr.net/npm/lucide-static@1.48.0/font/lucide.css\");\n:root{\n  --room:#0E2233; --plate:#142D3F; --plate2:#183445; --line:rgba(242,244,255,.13);\n  --text:#F2F4FF; --muted:rgba(242,244,255,.6); --dim:rgba(242,244,255,.4);\n  --ice:#96C5F7; --support:#A9D3FF;\n}\n*{box-sizing:border-box}\nbody{margin:0;background:var(--room);color:var(--text);font-family:'Kumbh Sans',system-ui,sans-serif;-webkit-font-smoothing:antialiased;font-size:14px}\nh1,h2,h3,h4,p,ul{margin:0;padding:0}ul{list-style:none}\na{text-decoration:none;color:inherit}\n.mono{font-family:'Share Tech Mono',ui-monospace,monospace}\n.pad{padding:0 16px}\n\n/* bar */\n.bar{height:54px;background:#0B1B29;border-bottom:1px solid var(--line);display:flex;align-items:center;gap:9px;padding:0 14px}\n.mark{width:22px;height:22px;border-radius:3px;background:var(--ice);display:flex;align-items:flex-end;justify-content:center;gap:2px;padding:5px 4px;flex:none}\n.mark i{display:block;width:2px;background:#0B1B29;border-radius:1px}\n.mark i:nth-child(1){height:60%}.mark i:nth-child(2){height:100%}.mark i:nth-child(3){height:44%}\n.bar-name{font-size:12.5px;font-weight:600}\n.bar-name span{display:block;font-size:9.5px;color:var(--dim);font-weight:400;margin-top:1px}\n.clock{margin-left:auto;display:inline-flex;align-items:center;gap:5px;background:rgba(150,197,247,.12);border:1px solid rgba(150,197,247,.3);padding:4px 8px;border-radius:4px;font-family:'Share Tech Mono',monospace;font-size:11.5px}\n.clock i{font-size:11px;color:var(--ice)}\n.end{width:32px;height:32px;border:1px solid rgba(242,244,255,.28);border-radius:5px;display:flex;align-items:center;justify-content:center;font-size:13px;flex:none}\n\n/* meta chips */\n.chips-row{display:flex;gap:5px;overflow-x:auto;padding:10px 14px 0}\n.chip{flex:none;font-size:9.5px;font-family:'Share Tech Mono',monospace;padding:3px 7px;border:1px solid var(--line);border-radius:3px;color:var(--muted);white-space:nowrap}\n.chip.on{background:var(--ice);border-color:var(--ice);color:#0B1B29;font-weight:400}\n\n/* progress */\n.prog{padding:10px 14px 0}\n.prog-top{display:flex;justify-content:space-between;font-size:9.5px;color:var(--dim);letter-spacing:.05em;text-transform:uppercase;margin-bottom:5px}\n.bar-line{height:4px;background:rgba(242,244,255,.13);border-radius:2px;overflow:hidden}\n.bar-line i{display:block;height:100%;width:50%;background:var(--ice)}\n\n/* question */\n.qbox{margin:12px 14px 0;background:var(--plate);border:1px solid var(--line);border-radius:6px;padding:13px}\n.q-top{display:flex;align-items:center;gap:7px;font-size:9px;letter-spacing:.1em;text-transform:uppercase;color:var(--dim)}\n.q-top b{font-family:'Share Tech Mono',monospace;color:var(--ice);font-size:10px;letter-spacing:.02em;font-weight:400;text-transform:none}\n.q-top .rp{margin-left:auto;font-size:10px;letter-spacing:0;text-transform:none;color:var(--muted);border:1px solid var(--line);border-radius:3px;padding:2px 6px;display:inline-flex;align-items:center;gap:4px}\n.qtext{font-size:17px;line-height:1.36;letter-spacing:-.01em;font-weight:500;margin-top:8px}\n.qsub{font-size:10.5px;color:var(--dim);margin-top:6px;line-height:1.45}\n\n/* answer */\n.acard{margin:10px 14px 0;background:var(--plate2);border:1px solid var(--line);border-radius:6px;padding:12px}\n.a-top{display:flex;align-items:center;gap:7px;font-size:9px;letter-spacing:.1em;text-transform:uppercase;color:var(--dim)}\n.a-top .li{margin-left:auto;display:inline-flex;align-items:center;gap:5px;color:var(--ice);letter-spacing:.03em;text-transform:none;font-size:10px}\n.pulse{width:5px;height:5px;border-radius:50%;background:var(--ice);animation:bl 1.5s ease-in-out infinite}\n@keyframes bl{0%,100%{opacity:.3}50%{opacity:1}}\n.micwrap{display:flex;align-items:center;gap:12px;margin-top:10px}\n.mic{width:56px;height:56px;border-radius:50%;background:var(--ice);color:#0B1B29;display:flex;align-items:center;justify-content:center;font-size:22px;flex:none;box-shadow:0 0 0 6px rgba(150,197,247,.14)}\n.levels{flex:1}\n.levels .l{display:flex;align-items:flex-end;gap:2.5px;height:26px}\n.levels .l i{flex:1;background:rgba(150,197,247,.25);border-radius:1px}\n.levels .l i.on{background:var(--ice)}\n.levels .l i:nth-child(1){height:36%}.levels .l i:nth-child(2){height:62%}.levels .l i:nth-child(3){height:88%}\n.levels .l i:nth-child(4){height:70%}.levels .l i:nth-child(5){height:96%}.levels .l i:nth-child(6){height:54%}\n.levels .l i:nth-child(7){height:30%}.levels .l i:nth-child(8){height:18%}.levels .l i:nth-child(9){height:10%}\n.levels .m{display:flex;justify-content:space-between;font-size:8.5px;letter-spacing:.07em;color:var(--dim);margin-top:4px}\n.tx{margin-top:10px;border-top:1px solid var(--line);padding-top:9px;font-size:12.5px;line-height:1.55}\n.caret{display:inline-block;width:1.5px;height:13px;background:var(--ice);vertical-align:-2px;animation:bl 1s steps(2) infinite}\n.tx-note{display:flex;align-items:center;justify-content:space-between;margin-top:8px;font-size:9.5px;color:var(--dim)}\n.tx-note a{color:var(--ice);border-bottom:1px solid rgba(150,197,247,.4);padding-bottom:1px}\n\n/* controls */\n.ctl{display:flex;gap:7px;margin:10px 14px 0}\n.cbtn{width:38px;height:38px;border:1px solid var(--line);border-radius:6px;display:flex;align-items:center;justify-content:center;font-size:14px;color:var(--text);background:rgba(242,244,255,.04);flex:none}\n.submit{flex:1;display:flex;align-items:center;justify-content:center;gap:7px;background:linear-gradient(90deg,#4F46E5,#2563EB);color:#fff;font-size:13px;font-weight:600;border-radius:6px}\n.disclaimer{font-size:9.5px;color:var(--dim);line-height:1.5;margin:9px 14px 0}\n\n/* earlier */\n.earlier{margin:14px 14px 0;border-top:1px solid var(--line);padding-top:10px}\n.e-head{display:flex;justify-content:space-between;font-size:9px;letter-spacing:.1em;text-transform:uppercase;color:var(--dim);margin-bottom:6px}\n.eturn{padding:7px 0;border-bottom:1px solid rgba(242,244,255,.07)}\n.eturn:last-child{border-bottom:0}\n.eturn .q{font-size:11px;font-weight:600;color:var(--muted);display:flex;gap:6px}\n.eturn .q b{font-family:'Share Tech Mono',monospace;font-size:9.5px;color:var(--ice);font-weight:400}\n.eturn .a{font-size:10.5px;line-height:1.5;color:var(--dim);margin-top:3px;padding-left:22px}\n\n/* bottom note */\n.bnote{margin:12px 14px 14px;background:rgba(150,197,247,.08);border:1px solid rgba(150,197,247,.2);border-radius:5px;padding:9px 10px}\n.bnote b{font-size:10px;display:flex;align-items:center;gap:5px;color:var(--support)}\n.bnote p{font-size:9.5px;color:var(--muted);line-height:1.45;margin-top:4px}\n</style>\n<div class=\"bar\" data-kid=\"1\" data-name=\"top app bar\">\n<span class=\"mark\" data-kid=\"1-1\" data-name=\"app logo mark with bar icon\"><i data-kid=\"1-1-1\" data-name=\"logo mark bar 1\"></i><i data-kid=\"1-1-2\" data-name=\"logo mark bar 2\"></i><i data-kid=\"1-1-3\" data-name=\"logo mark bar 3\"></i></span>\n<span class=\"bar-name\" data-kid=\"1-2\" data-name=\"screen title and category label\">Technical interview<span data-kid=\"1-2-1\" data-name=\"category and difficulty subtitle\">BCA · Medium</span></span>\n<span class=\"clock\" data-dynamic=\"true\" data-kid=\"1-3\" data-name=\"countdown timer pill\" data-reason=\"elapsed/remaining time text updated every second by timer script\"><i class=\"icon-timer\" data-kid=\"1-3-1\" data-name=\"timer clock icon\"></i>18:42</span>\n<a class=\"end\" data-kid=\"1-4\" data-name=\"end interview button\" href=\"/dashboard/interviews\"><i class=\"icon-phone-off\" data-kid=\"1-4-1\" data-name=\"phone-off hangup icon\"></i></a>\n</div>\n<div class=\"chips-row\" data-kid=\"2\" data-name=\"metadata chip row\">\n<span class=\"chip on\" data-kid=\"2-1\" data-name=\"active skill tag chip\">Technical Expert</span>\n<span class=\"chip\" data-kid=\"2-2\" data-name=\"voice input tag chip\">Voice</span>\n<span class=\"chip\" data-kid=\"2-3\" data-name=\"language tag chip\">English</span>\n<span class=\"chip\" data-kid=\"2-4\" data-name=\"resume shared tag chip\">Resume on</span>\n</div>\n<div class=\"prog\" data-kid=\"3\" data-name=\"question progress block\">\n<div class=\"prog-top\" data-kid=\"3-1\" data-name=\"progress status header row\"><span data-kid=\"3-1-1\" data-name=\"question position label\">Question 6 of 12</span><span data-dynamic=\"true\" data-kid=\"3-1-2\" data-name=\"elapsed time label\" data-reason=\"elapsed time text updated by timer script\">11:18 elapsed</span></div>\n<div class=\"bar-line\" data-kid=\"3-2\" data-name=\"progress track bar\"><i data-kid=\"3-2-1\" data-name=\"progress fill indicator\"></i></div>\n</div>\n<div class=\"qbox\" data-kid=\"4\" data-name=\"interview question card\">\n<div class=\"q-top\" data-kid=\"4-1\" data-name=\"question meta header row\"><b data-kid=\"4-1-1\" data-name=\"question number badge\">Q6</b>Technical Expert asking<span class=\"rp\" data-kid=\"4-1-2\" data-name=\"replay control chip\"><i class=\"icon-repeat\" data-kid=\"4-1-2-1\" data-name=\"repeat replay icon\"></i>Replay</span></div>\n<p class=\"qtext\" data-kid=\"4-2\" data-name=\"question headline text\">You mentioned a payment webhook. What happens when the same event arrives twice?</p>\n<p class=\"qsub\" data-kid=\"4-3\" data-name=\"question instruction subtext\">Answer in English. Switch to text at any time.</p>\n</div>\n<div class=\"acard\" data-kid=\"5\" data-name=\"answer card\">\n<div class=\"a-top\" data-kid=\"5-1\" data-name=\"answer header row with live status\"><i class=\"icon-mic\" data-kid=\"5-1-1\" data-name=\"microphone indicator icon\" style=\"font-size:11px;color:var(--ice)\"></i>Your answer<span class=\"li\" data-dynamic=\"true\" data-kid=\"5-1-2\" data-name=\"live listening status\" data-reason=\"listening timer text updated every second\"><span class=\"pulse\" data-kid=\"5-1-2-1\" data-name=\"blinking live status dot\"></span>Listening 00:14</span></div>\n<div class=\"micwrap\" data-kid=\"5-2\" data-name=\"mic capture row\">\n<span class=\"mic\" data-kid=\"5-2-1\" data-name=\"microphone record button\"><i class=\"icon-mic\" data-kid=\"5-2-1-1\" data-name=\"mic icon\"></i></span>\n<div class=\"levels\" data-kid=\"5-2-2\" data-name=\"voice level meter block\">\n<div class=\"l\" data-dynamic=\"true\" data-kid=\"5-2-2-1\" data-name=\"audio level bars\" data-reason=\"bar heights and on-states driven by live mic input\"><i class=\"on\" data-kid=\"5-2-2-1-1\" data-name=\"level bar\"></i><i class=\"on\" data-kid=\"5-2-2-1-2\" data-name=\"level bar\"></i><i class=\"on\" data-kid=\"5-2-2-1-3\" data-name=\"level bar\"></i><i class=\"on\" data-kid=\"5-2-2-1-4\" data-name=\"level bar\"></i><i class=\"on\" data-kid=\"5-2-2-1-5\" data-name=\"level bar\"></i><i class=\"on\" data-kid=\"5-2-2-1-6\" data-name=\"level bar\"></i><i data-kid=\"5-2-2-1-7\" data-name=\"level bar\" style=\"height:24%\"></i><i data-kid=\"5-2-2-1-8\" data-name=\"level bar\"></i><i data-kid=\"5-2-2-1-9\" data-name=\"level bar\"></i></div>\n<div class=\"m\" data-kid=\"5-2-2-2\" data-name=\"level meter caption row\"><span data-kid=\"5-2-2-2-1\" data-name=\"mic level caption\">MIC LEVEL</span><span data-dynamic=\"true\" data-kid=\"5-2-2-2-2\" data-name=\"decibel readout\" data-reason=\"dB value updated from live audio input\">-12 dB</span><span data-kid=\"5-2-2-2-3\" data-name=\"connection status label\">CONNECTED</span></div>\n</div>\n</div>\n<p class=\"tx\" data-dynamic=\"true\" data-kid=\"5-3\" data-name=\"transcribed answer text\" data-reason=\"transcription text written by speech-to-text script\">I store the event id before processing, so a repeat delivery fails the lookup and returns 200 without charging again<span class=\"caret\" data-kid=\"5-3-1\" data-name=\"blinking text caret\"></span></p>\n<div class=\"tx-note\" data-kid=\"5-4\" data-name=\"transcription note row\"><span data-kid=\"5-4-1\" data-name=\"editable transcription hint\">Transcription editable</span><a data-kid=\"5-4-2\" data-name=\"edit answer link\" href=\"#\">Edit answer</a></div>\n</div>\n<div class=\"ctl\" data-kid=\"6\" data-name=\"controls row\">\n<span class=\"cbtn\" data-kid=\"6-1\" data-name=\"switch to keyboard button\"><i class=\"icon-keyboard\" data-kid=\"6-1-1\" data-name=\"keyboard toggle icon\"></i></span>\n<span class=\"cbtn\" data-kid=\"6-2\" data-name=\"pause answer button\"><i class=\"icon-pause\" data-kid=\"6-2-1\" data-name=\"pause icon\"></i></span>\n<a class=\"submit\" data-kid=\"6-3\" data-name=\"submit answer call-to-action button\" href=\"#\"><i class=\"icon-arrow-right\" data-kid=\"6-3-1\" data-name=\"arrow right icon\"></i>Submit answer</a>\n</div>\n<p class=\"disclaimer\" data-kid=\"7\" data-name=\"submission disclaimer text\">Submitting ends your turn. The answer is scored privately and the report opens when you end the interview.</p>\n<div class=\"earlier\" data-kid=\"8\" data-name=\"previous turns section\">\n<div class=\"e-head\" data-kid=\"8-1\" data-name=\"earlier turns header row\"><span data-kid=\"8-1-1\" data-name=\"earlier turns label\">Earlier</span><span data-kid=\"8-1-2\" data-name=\"turn count label\">5 turns</span></div>\n<div class=\"eturn\" data-kid=\"8-2\" data-name=\"previous turn entry\"><div class=\"q\" data-kid=\"8-2-1\" data-name=\"previous question line\"><b data-kid=\"8-2-1-1\" data-name=\"previous question number\">Q5</b>How are sessions stored between requests?</div><div class=\"a\" data-kid=\"8-2-2\" data-name=\"previous answer text\">Signed cookie with the id; the row lives in Postgres with an expiry column.</div></div>\n<div class=\"eturn\" data-kid=\"8-3\" data-name=\"previous turn entry\"><div class=\"q\" data-kid=\"8-3-1\" data-name=\"previous question line\"><b data-kid=\"8-3-1-1\" data-name=\"previous question number\">Q4</b>Which column did you index?</div><div class=\"a\" data-kid=\"8-3-2\" data-name=\"previous answer text\">Event id, because every webhook lookup filters on it.</div></div>\n</div>\n<div class=\"bnote\" data-kid=\"9\" data-name=\"privacy note banner\">\n<b data-kid=\"9-1\" data-name=\"lock note heading\"><i class=\"icon-lock\" data-kid=\"9-1-1\" data-name=\"lock icon\"></i>Scores stay hidden</b>\n<p data-kid=\"9-2\" data-name=\"privacy note body text\">Each answer is scored against the BCA rubric. Scores and missed concepts appear in the report.</p>\n</div>",
      "comments": [],
      "created": "2026-11-10T15:22:18.456534+00:00",
      "modified": "2026-11-10T15:23:09.878857+00:00",
      "id": "var_4981c9283f18",
      "contentHeight": 779
    },
    "var_302681c30385": {
