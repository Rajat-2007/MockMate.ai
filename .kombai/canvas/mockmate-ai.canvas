        "h": 0
      },
      "html": "<style>\n@import url('https://fonts.googleapis.com/css2?family=Saira+Condensed:wght@500;600;700&family=Commissioner:wght@400;500;600;700&display=swap');\n@import url(\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.48.0/dist/tabler-icons.min.css\");\n:root{\n  --turq:#31AFD4; --light:#F3F5F9; --ink:#291720; --ink-70:rgba(41,23,32,.72); --ink-50:rgba(41,23,32,.52);\n  --blue:#004FFF; --orchid:#E07BE0; --cta:#4F46E5; --hair:rgba(41,23,32,.2);\n}\n*{box-sizing:border-box}\nbody{margin:0;background:var(--light);color:var(--ink);font-family:'Commissioner',system-ui,sans-serif;-webkit-font-smoothing:antialiased}\nh1,h2,h3,h4,p,ul,ol{margin:0;padding:0}ul{list-style:none}\na{text-decoration:none;color:inherit}\n.display{font-family:'Saira Condensed',Impact,sans-serif;font-weight:600;letter-spacing:.005em;text-transform:none}\n.wrap{max-width:1180px;margin:0 auto;padding:0 32px}\n.turq{background:var(--turq)}\n.cham{clip-path:polygon(9px 0,100% 0,100% calc(100% - 9px),calc(100% - 9px) 100%,0 100%,0 9px)}\n.cham-sm{clip-path:polygon(6px 0,100% 0,100% calc(100% - 6px),calc(100% - 6px) 100%,0 100%,0 6px)}\n\n/* nav */\n.nav{background:var(--turq);border-bottom:1px solid var(--hair)}\n.nav-in{height:72px;display:flex;align-items:center;gap:32px}\n.brand{display:flex;align-items:center;gap:9px;font-weight:700;font-size:16px;letter-spacing:-.01em}\n.mark{width:26px;height:26px;background:var(--ink);display:flex;align-items:center;justify-content:center;gap:2px;clip-path:polygon(7px 0,100% 0,100% calc(100% - 7px),calc(100% - 7px) 100%,0 100%,0 7px)}\n.mark i{display:block;width:2px;background:var(--turq)}\n.mark i:nth-child(1){height:7px}.mark i:nth-child(2){height:13px}.mark i:nth-child(3){height:5px}\n.nav-links{display:flex;gap:22px;font-size:13.5px;font-weight:500;color:rgba(41,23,32,.78);margin-left:8px}\n.nav-links a:hover{color:var(--ink)}\n.nav-right{margin-left:auto;display:flex;align-items:center;gap:16px}\n.nav-login{font-size:13.5px;font-weight:600}\n.btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;background:var(--cta);color:#fff;font-size:13.5px;font-weight:600;padding:12px 20px;clip-path:polygon(9px 0,100% 0,100% calc(100% - 9px),calc(100% - 9px) 100%,0 100%,0 9px)}\n.btn:hover{background:#4338ca}\n.btn-sm{padding:9px 16px;font-size:12.5px}\n.btn-line{background:transparent;color:var(--ink);border:1px solid var(--hair);clip-path:none}\n.btn-line:hover{background:rgba(41,23,32,.06)}\n\n/* hero */\n.hero{background:var(--turq);padding:44px 0 46px}\n.hero-in{display:grid;grid-template-columns:1.02fr 1.18fr .66fr;gap:28px;align-items:center}\n.hero h1{font-size:50px;line-height:1.03}\n.hero-sub{margin-top:18px;font-size:14.5px;line-height:1.6;color:rgba(41,23,32,.82);max-width:340px}\n.hero-cta{margin-top:24px;display:flex;flex-direction:column;align-items:flex-start;gap:12px}\n.hero-link{font-size:13px;font-weight:600;border-bottom:1.5px solid rgba(41,23,32,.45);padding-bottom:1px;display:inline-flex;align-items:center;gap:6px}\n.micro{margin-top:14px;font-size:11.5px;color:rgba(41,23,32,.62)}\n\n/* sim */\n.sim{background:var(--light);border:1px solid var(--ink);position:relative}\n.sim-bar{display:flex;align-items:center;justify-content:space-between;padding:9px 12px;background:var(--ink);color:#F3F5F9;font-size:11px}\n.sim-bar .q{color:var(--orchid);font-weight:600;letter-spacing:.06em}\n.sim-body{padding:14px}\n.sim-nodes{display:grid;grid-template-columns:1fr 26px 1fr;align-items:center;gap:6px}\n.node{border:1px solid var(--hair);padding:8px 10px;background:#fff}\n.node span{display:block;font-size:9.5px;letter-spacing:.08em;text-transform:uppercase;color:var(--ink-50)}\n.node b{display:block;font-size:12px;margin-top:3px;font-weight:600}\n.node em{display:block;font-style:normal;font-size:10px;color:var(--ink-70);margin-top:2px}\n.node.you{border-color:var(--blue);background:rgba(0,79,255,.05)}\n.conn{height:1px;background:repeating-linear-gradient(90deg,var(--ink) 0 3px,transparent 3px 6px);position:relative}\n.conn::after{content:\"\";position:absolute;right:0;top:-2px;width:6px;height:6px;background:var(--ink)}\n.wave{display:flex;align-items:flex-end;gap:2.5px;height:38px;margin:14px 0}\n.wave i{flex:1;background:var(--turq);border-radius:0}\n.wave i:nth-child(3n){background:var(--blue)}\n.wave i:nth-child(4n+1){height:34%}.wave i:nth-child(4n+2){height:78%}.wave i:nth-child(4n+3){height:52%}.wave i:nth-child(4n+4){height:96%}\n.sim-q{border-top:1px solid var(--hair);padding-top:10px;font-family:'Saira Condensed',sans-serif;font-weight:500;font-size:17px;line-height:1.25}\n.sim-q .ask{font-family:'Commissioner',sans-serif;font-size:9.5px;letter-spacing:.09em;text-transform:uppercase;color:var(--ink-50);display:block;margin-bottom:5px}\n.sim-ctl{display:flex;align-items:center;gap:6px;margin-top:12px;border-top:1px solid var(--hair);padding-top:10px}\n.cbtn{width:28px;height:28px;display:flex;align-items:center;justify-content:center;border:1px solid var(--hair);background:#fff;font-size:13px;color:var(--ink)}\n.cbtn.on{background:var(--ink);color:var(--light);border-color:var(--ink)}\n.sim-ctl .t{margin-left:auto;font-size:11px;font-weight:600;letter-spacing:.04em}\n\n/* pips */\n.pips{background:var(--ink);color:#F3F5F9;padding:14px 15px}\n.pips h4{font-size:9.5px;letter-spacing:.12em;text-transform:uppercase;color:rgba(243,245,249,.55);font-weight:500}\n.pip{display:grid;grid-template-columns:8px 1fr;gap:8px;padding:9px 0;border-bottom:1px solid rgba(243,245,249,.14);align-items:start}\n.pip:last-child{border-bottom:0}\n.pip .sq{width:6px;height:6px;background:var(--orchid);margin-top:5px}\n.pip span{font-size:9.5px;letter-spacing:.07em;text-transform:uppercase;color:rgba(243,245,249,.55);display:block}\n.pip b{font-size:12.5px;font-weight:600;display:block;margin-top:2px;white-space:nowrap}\n\n/* how it runs */\n.route-sec{background:var(--turq);padding:34px 0 46px;border-top:1px solid rgba(41,23,32,.28)}\n.route-head{display:flex;justify-content:space-between;align-items:flex-end;gap:30px;margin-bottom:24px}\n.route-head h2{font-size:34px;line-height:1.1}\n.route-head p{font-size:12.5px;color:rgba(41,23,32,.76);max-width:330px;line-height:1.55}\n.track{display:grid;grid-template-columns:repeat(5,1fr);border-top:1px solid var(--ink);margin-bottom:16px}\n.track span{width:9px;height:9px;background:var(--turq);border:1px solid var(--ink);margin-top:-5px;margin-left:16px}\n.nodes{display:grid;grid-template-columns:repeat(5,1fr)}\n.node-col{padding:0 16px}\n.node-col:first-child{padding-left:0}\n.node-col .n{font-family:'Saira Condensed',sans-serif;font-size:13px;font-weight:600;letter-spacing:.1em}\n.node-col b{display:block;font-size:14px;font-weight:600;margin-top:5px;letter-spacing:-.01em}\n.node-col p{font-size:11.5px;color:rgba(41,23,32,.78);line-height:1.5;margin-top:5px}\n\n/* categories + languages */\n.twocol{background:var(--light);padding:64px 0}\n.twocol-in{display:grid;grid-template-columns:1.45fr 1fr;gap:40px;align-items:start}\n.blk-h{display:flex;align-items:baseline;justify-content:space-between;gap:16px;margin-bottom:16px}\n.blk-h h2{font-size:30px;line-height:1.1}\n.blk-h span{font-size:11.5px;color:var(--ink-50)}\n.catwall{display:grid;grid-template-columns:repeat(2,1fr);gap:7px}\n.cchip{background:#fff;border:1px solid var(--hair);padding:11px 12px;display:flex;align-items:center;gap:8px;font-size:12.5px;font-weight:500}\n.cchip i{font-size:15px;color:var(--blue)}\n.cchip:hover{background:rgba(49,175,212,.14)}\n.langbox{background:var(--ink);padding:20px 20px 18px;color:#F3F5F9}\n.langbox h3{font-size:15px;font-weight:600}\n.langbox .sub{font-size:11px;color:rgba(243,245,249,.6);margin-top:5px;line-height:1.5}\n.langwall{display:flex;flex-wrap:wrap;gap:5px;margin-top:14px}\n.lchip{font-size:11.5px;padding:5px 9px;border:1px solid rgba(243,245,249,.3);color:rgba(243,245,249,.92)}\n.lang-note{margin-top:16px;padding-top:12px;border-top:1px solid rgba(243,245,249,.2);font-size:10.5px;line-height:1.55;color:rgba(243,245,249,.62);background:none}\n\n/* features master detail */\n.feat-sec{background:var(--light);padding:0 0 66px}\n.feat-in{display:grid;grid-template-columns:300px 1fr;gap:0;border:1px solid var(--hair);border-top:1px solid var(--ink)}\n.f-list{border-right:1px solid var(--hair)}\n.f-list .li{display:flex;align-items:center;gap:9px;padding:17px 16px;font-size:13px;font-weight:500;border-bottom:1px solid var(--hair);color:var(--ink-70)}\n.f-list .li i{font-size:15px}\n.f-list .li.on{background:var(--ink);color:#F3F5F9}\n.f-list .li.on i{color:var(--orchid)}\n.f-list .li:last-child{border-bottom:0}\n.f-detail{padding:24px 26px}\n.f-detail h3{font-size:26px;line-height:1.15}\n.f-detail .d{font-size:12.5px;color:var(--ink-70);line-height:1.6;margin-top:8px;max-width:420px}\n.f-vis{margin-top:18px;border:1px solid var(--hair);background:#fff;padding:14px}\n.f-vis-top{display:flex;align-items:center;gap:8px;font-size:10px;letter-spacing:.09em;text-transform:uppercase;color:var(--ink-50)}\n.f-vis-top .tag{margin-left:auto;border:1px solid var(--hair);padding:2px 6px;letter-spacing:.04em;color:var(--ink-70)}\n.f-vis .wave{height:54px;margin:12px 0 10px}\n.vis-ctl{display:flex;align-items:center;gap:6px;border-top:1px solid var(--hair);padding-top:10px}\n.vis-ctl .note{margin-left:auto;font-size:10.5px;color:var(--ink-50)}\n\n/* personalities */\n.pers-sec{background:var(--ink);padding:44px 0 48px;color:#F3F5F9}\n.pers-head{display:flex;align-items:flex-end;justify-content:space-between;gap:30px;margin-bottom:20px}\n.pers-head h2{font-size:30px;line-height:1.1;color:#F3F5F9}\n.pers-head p{font-size:11.5px;color:rgba(243,245,249,.6);max-width:300px;line-height:1.55}\n.personas{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}\n.per{border:1px solid rgba(243,245,249,.22);padding:13px 15px;background:rgba(243,245,249,.04)}\n.p-top{display:flex;align-items:center;justify-content:space-between}\n.p-top b{font-size:13.5px;font-weight:600}\n.p-top span{font-size:9.5px;letter-spacing:.08em;text-transform:uppercase;color:var(--orchid)}\n.per p{font-size:11px;color:rgba(243,245,249,.62);line-height:1.5;margin-top:5px}\n\n/* pricing */\n.price-sec{background:var(--light);padding:62px 0}\n.price-head{display:flex;align-items:flex-end;justify-content:space-between;gap:30px;margin-bottom:22px;border-top:1px solid var(--ink);padding-top:26px}\n.price-head h2{font-size:30px;line-height:1.1}\n.price-head p{font-size:11.5px;color:var(--ink-70);max-width:330px;line-height:1.55}\n.board{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}\n.col{border:1px solid var(--hair);background:#fff;padding:18px 18px 20px;display:flex;flex-direction:column}\n.col .c-head{display:flex;align-items:baseline;justify-content:space-between;border-bottom:1px solid var(--hair);padding-bottom:10px}\n.col h3{font-size:15px;font-weight:600}\n.col .c-head span{font-size:9.5px;letter-spacing:.08em;text-transform:uppercase;color:var(--ink-50)}\n.col .for{font-size:11px;color:var(--ink-70);line-height:1.5;margin-top:9px;min-height:32px}\n.col .amt{font-family:'Saira Condensed',sans-serif;font-size:38px;font-weight:600;line-height:1;margin:10px 0 0}\n.col .amt em{font-style:normal;font-family:'Commissioner',sans-serif;font-size:10.5px;color:var(--ink-50);margin-left:4px}\n.quota{margin:14px 0 6px}\n.quota .qtop{display:flex;align-items:baseline;justify-content:space-between;font-size:10px;letter-spacing:.06em;text-transform:uppercase;color:var(--ink-50)}\n.quota .qtop b{font-size:11.5px;letter-spacing:0;color:var(--ink);text-transform:none}\n.qbar{height:6px;background:rgba(41,23,32,.1);margin-top:6px}\n.qbar i{display:block;height:100%;background:var(--blue)}\n.col.hi{border-color:var(--ink);border-top:3px solid var(--blue)}\n.clist{margin:12px 0 16px}\n.crow{display:flex;align-items:center;justify-content:space-between;gap:8px;font-size:11.5px;padding:6px 0;border-bottom:1px dashed rgba(41,23,32,.18);color:var(--ink-70)}\n.crow b{font-weight:600;color:var(--ink);font-size:11.5px}\n.col .btn,.col .btn-line{margin-top:auto;width:100%}\n.col .btn-line{border:1px solid var(--hair);background:transparent;color:var(--ink)}\n.note-row{display:flex;align-items:center;justify-content:space-between;gap:20px;margin-top:14px;font-size:11px;color:var(--ink-50)}\n.note-row span{display:flex;align-items:center;gap:14px}\n\n/* faq */\n.faq-sec{background:var(--light);padding:0 0 66px}\n.faq-head{border-top:1px solid var(--hair);padding-top:26px;margin-bottom:18px}\n.faq-head h2{font-size:30px}\n.faq-grid{display:grid;grid-template-columns:1fr 1fr;column-gap:52px}\n.fq{padding:15px 0;border-top:1px solid var(--hair);display:block}\n.fq .m{display:none}\n.fq h4{font-size:13px;font-weight:600;line-height:1.4}\n.fq p{font-size:11.5px;color:var(--ink-70);line-height:1.6;margin-top:4px}\n\n/* final */\n.final{background:var(--turq);padding:48px 0 44px;border-top:1px solid rgba(41,23,32,.28)}\n.final-in{display:grid;grid-template-columns:1fr auto;gap:40px;align-items:center}\n.final h2{font-size:44px;line-height:1.04;max-width:520px}\n.final .stats{display:flex;align-items:center;gap:0;margin-top:18px;border-top:1px solid rgba(41,23,32,.35);padding-top:14px}\n.final .st{padding:0 18px;border-left:1px solid rgba(41,23,32,.3)}\n.final .st:first-child{padding-left:0;border-left:0}\n.final .st b{display:block;font-family:'Saira Condensed',sans-serif;font-size:24px;font-weight:600;line-height:1}\n.final .st span{font-size:10.5px;color:rgba(41,23,32,.72);letter-spacing:.04em}\n.final-right{display:flex;flex-direction:column;align-items:flex-end;gap:10px}\n.final-right .micro{margin:0;color:rgba(41,23,32,.66)}\n\n/* footer */\n.foot{background:var(--light);padding:40px 0 22px}\n.foot-grid{display:grid;grid-template-columns:1.6fr 1fr 1fr 1fr 1fr;gap:28px}\n.foot h5{font-size:9.5px;letter-spacing:.12em;text-transform:uppercase;color:var(--ink-50);margin-bottom:11px;font-weight:600}\n.foot li{font-size:12px;color:var(--ink-70);margin-bottom:8px}\n.foot li a:hover{color:var(--blue)}\n.foot-brand p{font-size:11.5px;color:var(--ink-70);line-height:1.6;margin-top:10px;max-width:230px}\n.foot-bottom{margin-top:28px;border-top:1px solid var(--hair);padding-top:14px;display:flex;align-items:center;justify-content:space-between;font-size:10.5px;color:var(--ink-50)}\n.social{display:flex;gap:6px}\n.social i{width:26px;height:26px;border:1px solid var(--hair);display:flex;align-items:center;justify-content:center;font-size:13px}\n\n@media (max-width:1024px){\n  .hero-in{grid-template-columns:1fr 1fr;gap:22px}\n  .pips{grid-column:span 2;display:grid;grid-template-columns:repeat(3,1fr);gap:0 18px}\n  .hero h1{font-size:44px}\n  .nodes{grid-template-columns:1fr 1fr;row-gap:22px}\n  .track{display:none}\n  .twocol-in{grid-template-columns:1fr}\n  .catwall{grid-template-columns:1fr 1fr}\n  .feat-in{grid-template-columns:1fr}\n  .f-list{border-right:0;border-bottom:1px solid var(--hair);display:grid;grid-template-columns:1fr 1fr}\n  .personas{grid-template-columns:1fr 1fr}\n  .board{grid-template-columns:1fr}\n  .faq-grid{grid-template-columns:1fr}\n  .final-in{grid-template-columns:1fr;gap:20px}\n  .final-right{align-items:flex-start}\n  .foot-grid{grid-template-columns:1fr 1fr}\n}\n@media (max-width:720px){\n  .wrap{padding:0 18px}\n  .nav-links,.nav-login{display:none}\n  .hero-in{grid-template-columns:1fr}\n  .pips{grid-column:span 1;grid-template-columns:1fr 1fr}\n  .hero h1{font-size:36px}\n  .sim-q{font-size:15px}\n  .catwall{grid-template-columns:1fr 1fr}\n  .f-list{grid-template-columns:1fr}\n  .personas{grid-template-columns:1fr}\n  .final h2{font-size:32px}\n  .final .stats{flex-wrap:wrap;gap:12px 0}\n  .foot-grid{grid-template-columns:1fr 1fr}\n}\n</style>\n<header class=\"nav\" data-kid=\"1\" data-name=\"page header\">\n<div class=\"wrap nav-in\" data-kid=\"1-1\" data-name=\"nav inner layout\">\n<a class=\"brand\" data-kid=\"1-1-1\" data-name=\"logo brand link\" href=\"/\"><span class=\"mark\" data-kid=\"1-1-1-1\" data-name=\"logo mark with equalizer bars\"><i data-kid=\"1-1-1-1-1\" data-name=\"equalizer bar\"></i><i data-kid=\"1-1-1-1-2\" data-name=\"equalizer bar\"></i><i data-kid=\"1-1-1-1-3\" data-name=\"equalizer bar\"></i></span>MockMate AI</a>\n<nav class=\"nav-links\" data-kid=\"1-1-2\" data-name=\"main navigation menu\">\n<a data-kid=\"1-1-2-1\" data-name=\"nav link: Features\" href=\"/features\">Features</a>\n<a data-kid=\"1-1-2-2\" data-name=\"nav link: How it works\" href=\"/how-it-works\">How it works</a>\n<a data-kid=\"1-1-2-3\" data-name=\"nav link: Interviews\" href=\"/interview-questions\">Interviews</a>\n<a data-kid=\"1-1-2-4\" data-name=\"nav link: Pricing\" href=\"/pricing\">Pricing</a>\n<a data-kid=\"1-1-2-5\" data-name=\"nav link: Blog\" href=\"/blog\">Blog</a>\n</nav>\n<div class=\"nav-right\" data-kid=\"1-1-3\" data-name=\"right side nav actions\">\n<a class=\"nav-login\" data-kid=\"1-1-3-1\" data-name=\"login link\" href=\"/login\">Log in</a>\n<a class=\"btn btn-sm\" data-kid=\"1-1-3-2\" data-name=\"header CTA button: Start free interview\" href=\"/signup\">Start free interview</a>\n</div>\n</div>\n</header>\n<main data-kid=\"2\" data-name=\"page main content\">\n<section class=\"hero\" data-kid=\"2-1\" data-name=\"hero section\">\n<div class=\"wrap hero-in\" data-kid=\"2-1-1\" data-name=\"hero content grid\">\n<div data-kid=\"2-1-1-1\" data-name=\"hero headline block (left column)\">\n<h1 class=\"display\" data-kid=\"2-1-1-1-1\" data-name=\"hero headline\">Practice Smarter.<br data-kid=\"2-1-1-1-1-1\" data-name=\"line break in headline\"/>Interview Better.<br data-kid=\"2-1-1-1-1-2\" data-name=\"line break in headline\"/>Get Career Ready.</h1>\n<p class=\"hero-sub\" data-kid=\"2-1-1-1-2\" data-name=\"hero supporting description\">AI mock interviews with a real interviewer, a scored report and the same question banks your placement round uses.</p>\n<div class=\"hero-cta\" data-kid=\"2-1-1-1-3\" data-name=\"hero CTA container\">\n<a class=\"btn\" data-kid=\"2-1-1-1-3-1\" data-name=\"hero primary CTA button\" href=\"/signup\">Start Free Interview</a>\n<a class=\"hero-link\" data-kid=\"2-1-1-1-3-2\" data-name='hero secondary \"how it works\" link' href=\"/how-it-works\">See how it works <i class=\"ti ti-arrow-up-right\" data-kid=\"2-1-1-1-3-2-1\" data-name=\"arrow up-right icon\"></i></a>\n</div>\n<p class=\"micro\" data-kid=\"2-1-1-1-4\" data-name=\"hero fine-print note\">Free plan: 3 interviews a month, text mode.</p>\n</div>\n<div class=\"sim\" data-kid=\"2-1-1-2\" data-name=\"interview session mock window\">\n<div class=\"sim-bar\" data-kid=\"2-1-1-2-1\" data-name=\"simulation window title bar\"><span data-kid=\"2-1-1-2-1-1\" data-name=\"simulation window title text\">Interview session</span><span class=\"q\" data-kid=\"2-1-1-2-1-2\" data-name=\"question counter label\">Question 6 of 12</span></div>\n<div class=\"sim-body\" data-kid=\"2-1-1-2-2\" data-name=\"simulation body content\">\n<div class=\"sim-nodes\" data-kid=\"2-1-1-2-2-1\" data-name=\"parties row: interviewer and candidate\">\n<div class=\"node\" data-kid=\"2-1-1-2-2-1-1\" data-name=\"interviewer card\"><span data-kid=\"2-1-1-2-2-1-1-1\" data-name=\"interviewer role label\">Interviewer</span><b data-kid=\"2-1-1-2-2-1-1-2\" data-name=\"interviewer name title\">Technical Expert</b><em data-kid=\"2-1-1-2-2-1-1-3\" data-name=\"interviewer voice note\">Voice, English</em></div>\n<div class=\"conn\" data-kid=\"2-1-1-2-2-1-2\" data-name=\"connector line between parties\"></div>\n<div class=\"node you\" data-kid=\"2-1-1-2-2-1-3\" data-name=\"candidate card (highlighted)\"><span data-kid=\"2-1-1-2-2-1-3-1\" data-name=\"candidate role label\">Candidate</span><b data-kid=\"2-1-1-2-2-1-3-2\" data-name=\"candidate description\">BCA, Final year</b><em data-kid=\"2-1-1-2-2-1-3-3\" data-name=\"candidate status note\">Answering</em></div>\n</div>\n<div class=\"wave\" data-kid=\"2-1-1-2-2-2\" data-name=\"voice waveform display\"><i data-kid=\"2-1-1-2-2-2-1\" data-name=\"waveform bar\"></i><i data-kid=\"2-1-1-2-2-2-2\" data-name=\"waveform bar\"></i><i data-kid=\"2-1-1-2-2-2-3\" data-name=\"waveform bar\"></i><i data-kid=\"2-1-1-2-2-2-4\" data-name=\"waveform bar\"></i><i data-kid=\"2-1-1-2-2-2-5\" data-name=\"waveform bar\"></i><i data-kid=\"2-1-1-2-2-2-6\" data-name=\"waveform bar\"></i><i data-kid=\"2-1-1-2-2-2-7\" data-name=\"waveform bar\"></i><i data-kid=\"2-1-1-2-2-2-8\" data-name=\"waveform bar\"></i><i data-kid=\"2-1-1-2-2-2-9\" data-name=\"waveform bar\"></i><i data-kid=\"2-1-1-2-2-2-10\" data-name=\"waveform bar\"></i><i data-kid=\"2-1-1-2-2-2-11\" data-name=\"waveform bar\"></i><i data-kid=\"2-1-1-2-2-2-12\" data-name=\"waveform bar\"></i><i data-kid=\"2-1-1-2-2-2-13\" data-name=\"waveform bar\"></i><i data-kid=\"2-1-1-2-2-2-14\" data-name=\"waveform bar\"></i><i data-kid=\"2-1-1-2-2-2-15\" data-name=\"waveform bar\"></i><i data-kid=\"2-1-1-2-2-2-16\" data-name=\"waveform bar\"></i><i data-kid=\"2-1-1-2-2-2-17\" data-name=\"waveform bar\"></i><i data-kid=\"2-1-1-2-2-2-18\" data-name=\"waveform bar\"></i><i data-kid=\"2-1-1-2-2-2-19\" data-name=\"waveform bar\"></i><i data-kid=\"2-1-1-2-2-2-20\" data-name=\"waveform bar\"></i><i data-kid=\"2-1-1-2-2-2-21\" data-name=\"waveform bar\"></i><i data-kid=\"2-1-1-2-2-2-22\" data-name=\"waveform bar\"></i><i data-kid=\"2-1-1-2-2-2-23\" data-name=\"waveform bar\"></i><i data-kid=\"2-1-1-2-2-2-24\" data-name=\"waveform bar\"></i><i data-kid=\"2-1-1-2-2-2-25\" data-name=\"waveform bar\"></i><i data-kid=\"2-1-1-2-2-2-26\" data-name=\"waveform bar\"></i><i data-kid=\"2-1-1-2-2-2-27\" data-name=\"waveform bar\"></i><i data-kid=\"2-1-1-2-2-2-28\" data-name=\"waveform bar\"></i></div>\n<div class=\"sim-q\" data-kid=\"2-1-1-2-2-3\" data-name=\"current question display\"><span class=\"ask\" data-kid=\"2-1-1-2-2-3-1\" data-name=\"question label\">Current question</span>You built a library issue tracker. How would you store a book that is issued to two students by mistake?</div>\n<div class=\"sim-ctl\" data-kid=\"2-1-1-2-2-4\" data-name=\"simulation control bar\">\n<span class=\"cbtn on\" data-kid=\"2-1-1-2-2-4-1\" data-name=\"active control: microphone\"><i class=\"ti ti-microphone\" data-kid=\"2-1-1-2-2-4-1-1\" data-name=\"microphone icon\"></i></span>\n<span class=\"cbtn\" data-kid=\"2-1-1-2-2-4-2\" data-name=\"control: repeat\"><i class=\"ti ti-repeat\" data-kid=\"2-1-1-2-2-4-2-1\" data-name=\"repeat icon\"></i></span>\n<span class=\"cbtn\" data-kid=\"2-1-1-2-2-4-3\" data-name=\"control: volume\"><i class=\"ti ti-volume\" data-kid=\"2-1-1-2-2-4-3-1\" data-name=\"volume icon\"></i></span>\n<span class=\"cbtn\" data-kid=\"2-1-1-2-2-4-4\" data-name=\"control: hang up\"><i class=\"ti ti-phone-off\" data-kid=\"2-1-1-2-2-4-4-1\" data-name=\"hang up phone icon\"></i></span>\n<span class=\"t\" data-kid=\"2-1-1-2-2-4-5\" data-name=\"remaining time counter (static mock)\">18:42 left</span>\n</div>\n</div>\n</div>\n<aside class=\"pips\" data-kid=\"2-1-1-3\" data-name=\"session settings panel (hero sidebar)\">\n<h4 data-kid=\"2-1-1-3-1\" data-name=\"session settings heading\">Session settings</h4>\n<div class=\"pip\" data-kid=\"2-1-1-3-2\" data-name=\"setting row: category\"><span class=\"sq\" data-kid=\"2-1-1-3-2-1\" data-name=\"setting indicator square\"></span><div data-kid=\"2-1-1-3-2-2\" data-name=\"category value container\"><span data-kid=\"2-1-1-3-2-2-1\" data-name=\"category label\">Category</span><b data-kid=\"2-1-1-3-2-2-2\" data-name='category value Text:false \"Technical\"'>Technical</b></div></div>\n<div class=\"pip\" data-kid=\"2-1-1-3-3\" data-name=\"setting row: course\"><span class=\"sq\" data-kid=\"2-1-1-3-3-1\" data-name=\"setting indicator square\"></span><div data-kid=\"2-1-1-3-3-2\" data-name=\"course value container\"><span data-kid=\"2-1-1-3-3-2-1\" data-name=\"course label\">Course</span><b data-kid=\"2-1-1-3-3-2-2\" data-name=\"course value\">BCA</b></div></div>\n<div class=\"pip\" data-kid=\"2-1-1-3-4\" data-name=\"setting row: difficulty\"><span class=\"sq\" data-kid=\"2-1-1-3-4-1\" data-name=\"setting indicator square\"></span><span data-kid=\"2-1-1-3-4-2\" data-name=\"difficulty label\">Difficulty</span><b data-kid=\"2-1-1-3-4-3\" data-name=\"difficulty value\">Medium</b></div>\n<div class=\"pip\" data-kid=\"2-1-1-3-5\" data-name=\"setting row: language\"><span class=\"sq\" data-kid=\"2-1-1-3-5-1\" data-name=\"setting indicator square\"></span><span data-kid=\"2-1-1-3-5-2\" data-name=\"language label\">Language</span><b data-kid=\"2-1-1-3-5-3\" data-name=\"language value\">English</b></div>\n<div class=\"pip\" data-kid=\"2-1-1-3-6\" data-name=\"setting row: answer mode\"><span class=\"sq\" data-kid=\"2-1-1-3-6-1\" data-name=\"setting indicator square\"></span><span data-kid=\"2-1-1-3-6-2\" data-name=\"answer mode label\">Answer mode</span><b data-kid=\"2-1-1-3-6-3\" data-name=\"answer mode value\">Voice</b></div>\n<div class=\"pip\" data-kid=\"2-1-1-3-7\" data-name=\"setting row: length\"><span class=\"sq\" data-kid=\"2-1-1-3-7-1\" data-name=\"setting indicator square\"></span><span data-kid=\"2-1-1-3-7-2\" data-name=\"length label\">Length</span><b data-kid=\"2-1-1-3-7-3\" data-name=\"length value\">30 min</b></div>\n</aside>\n</div>\n</section>\n<section class=\"route-sec\" data-kid=\"2-2\" data-name=\"how a session runs section\">\n<div class=\"wrap\" data-kid=\"2-2-1\" data-name=\"section container\">\n<div class=\"route-head\" data-kid=\"2-2-1-1\" data-name=\"section header row\">\n<h2 class=\"display\" data-kid=\"2-2-1-1-1\" data-name=\"section headline\">How a session runs</h2>\n<p data-kid=\"2-2-1-1-2\" data-name=\"section sub text\">Each step is saved, so a dropped connection or a closed tab picks up where you left it.</p>\n</div>\n<div class=\"track\" data-kid=\"2-2-1-2\" data-name=\"progress track\"><span data-kid=\"2-2-1-2-1\" data-name=\"track tick mark\"></span><span data-kid=\"2-2-1-2-2\" data-name=\"track tick mark\"></span><span data-kid=\"2-2-1-2-3\" data-name=\"track tick mark\"></span><span data-kid=\"2-2-1-2-4\" data-name=\"track tick mark\"></span><span data-kid=\"2-2-1-2-5\" data-name=\"track tick mark\"></span></div>\n<div class=\"nodes\" data-kid=\"2-2-1-3\" data-name=\"steps grid\">\n<div class=\"node-col\" data-kid=\"2-2-1-3-1\" data-name=\"step column: Create your profile\"><span class=\"n\" data-kid=\"2-2-1-3-1-1\" data-name=\"step number label\">01</span><b data-kid=\"2-2-1-3-1-2\" data-name=\"step title\">Create your profile</b><p data-kid=\"2-2-1-3-1-3\" data-name=\"step description\">Course, year, experience level and target role.</p></div>\n<div class=\"node-col\" data-kid=\"2-2-1-3-2\" data-name=\"step column: Choose your goal\"><span class=\"n\" data-kid=\"2-2-1-3-2-1\" data-name=\"step number label\">02</span><b data-kid=\"2-2-1-3-2-2\" data-name=\"step title\">Choose your goal</b><p data-kid=\"2-2-1-3-2-3\" data-name=\"step description\">Category and role, from B.Tech CSE to B.Pharm.</p></div>\n<div class=\"node-col\" data-kid=\"2-2-1-3-3\" data-name=\"step column: Pick a language\"><span class=\"n\" data-kid=\"2-2-1-3-3-1\" data-name=\"step number label\">03</span><b data-kid=\"2-2-1-3-3-2\" data-name=\"step title\">Pick a language</b><p data-kid=\"2-2-1-3-3-3\" data-name=\"step description\">Any of 11, including Hinglish, per session.</p></div>\n<div class=\"node-col\" data-kid=\"2-2-1-3-4\" data-name=\"step column: Run the interview\"><span class=\"n\" data-kid=\"2-2-1-3-4-1\" data-name=\"step number label\">04</span><b data-kid=\"2-2-1-3-4-2\" data-name=\"step title\">Run the interview</b><p data-kid=\"2-2-1-3-4-3\" data-name=\"step description\">Voice or text, with adaptive follow-ups.</p></div>\n<div class=\"node-col\" data-kid=\"2-2-1-3-5\" data-name=\"step column: Read the report\"><span class=\"n\" data-kid=\"2-2-1-3-5-1\" data-name=\"step number label\">05</span><b data-kid=\"2-2-1-3-5-2\" data-name=\"step title\">Read the report</b><p data-kid=\"2-2-1-3-5-3\" data-name=\"step description\">Rubric scores, missed points, better answers.</p></div>\n</div>\n</div>\n</section>\n<section class=\"twocol\" data-kid=\"2-3\" data-name=\"categories and languages section\">\n<div class=\"wrap twocol-in\" data-kid=\"2-3-1\" data-name=\"two-column layout\">\n<div data-kid=\"2-3-1-1\" data-name=\"categories column\">\n<div class=\"blk-h\" data-kid=\"2-3-1-1-1\" data-name=\"category header row\"><h2 class=\"display\" data-kid=\"2-3-1-1-1-1\" data-name=\"section headline\">Interview categories</h2><span data-kid=\"2-3-1-1-1-2\" data-name=\"category count label\">10 in total</span></div>\n<div class=\"catwall\" data-kid=\"2-3-1-1-2\" data-name=\"category chip grid\">\n<span class=\"cchip\" data-kid=\"2-3-1-1-2-1\" data-name=\"category chip: Technical\"><i class=\"ti ti-cpu\" data-kid=\"2-3-1-1-2-1-1\" data-name=\"CPU icon\"></i>Technical</span>\n<span class=\"cchip\" data-kid=\"2-3-1-1-2-2\" data-name=\"category chip: HR\"><i class=\"ti ti-users\" data-kid=\"2-3-1-1-2-2-1\" data-name=\"users icon\"></i>HR</span>\n<span class=\"cchip\" data-kid=\"2-3-1-1-2-3\" data-name=\"category chip: Resume-based\"><i class=\"ti ti-file-text\" data-kid=\"2-3-1-1-2-3-1\" data-name=\"file text icon\"></i>Resume-based</span>\n<span class=\"cchip\" data-kid=\"2-3-1-1-2-4\" data-name=\"category chip: Coding\"><i class=\"ti ti-code\" data-kid=\"2-3-1-1-2-4-1\" data-name=\"code icon\"></i>Coding</span>\n<span class=\"cchip\" data-kid=\"2-3-1-1-2-5\" data-name=\"category chip: Management\"><i class=\"ti ti-briefcase\" data-kid=\"2-3-1-1-2-5-1\" data-name=\"briefcase icon\"></i>Management</span>\n<span class=\"cchip\" data-kid=\"2-3-1-1-2-6\" data-name=\"category chip: Commerce\"><i class=\"ti ti-calculator\" data-kid=\"2-3-1-1-2-6-1\" data-name=\"calculator icon\"></i>Commerce</span>\n<span class=\"cchip\" data-kid=\"2-3-1-1-2-7\" data-name=\"category chip: Science\"><i class=\"ti ti-flask\" data-kid=\"2-3-1-1-2-7-1\" data-name=\"flask icon\"></i>Science</span>\n<span class=\"cchip\" data-kid=\"2-3-1-1-2-8\" data-name=\"category chip: Law\"><i class=\"ti ti-scale\" data-kid=\"2-3-1-1-2-8-1\" data-name=\"scale/balance icon\"></i>Law</span>\n<span class=\"cchip\" data-kid=\"2-3-1-1-2-9\" data-name=\"category chip: Medical\"><i class=\"ti ti-stethoscope\" data-kid=\"2-3-1-1-2-9-1\" data-name=\"stethoscope icon\"></i>Medical</span>\n<span class=\"cchip\" data-kid=\"2-3-1-1-2-10\" data-name=\"category chip: General\"><i class=\"ti ti-compass\" data-kid=\"2-3-1-1-2-10-1\" data-name=\"compass icon\"></i>General</span>\n</div>\n<p data-kid=\"2-3-1-1-3\" data-name=\"category explanatory note\" style=\"font-size:11.5px;color:var(--ink-70);line-height:1.6;margin-top:14px;max-width:520px\">Each category reads the course on your profile, so a B.Com session covers accounting and a BDS session covers clinical scenarios.</p>\n</div>\n<div class=\"langbox\" data-kid=\"2-3-1-2\" data-name=\"language panel (dark)\">\n<h3 data-kid=\"2-3-1-2-1\" data-name=\"language panel heading\">Interview languages</h3>\n<p class=\"sub\" data-kid=\"2-3-1-2-2\" data-name=\"language panel subtitle\">The interface stays in English. The interview runs in the language you pick for that session.</p>\n<div class=\"langwall\" data-kid=\"2-3-1-2-3\" data-name=\"language chip wall\">\n<span class=\"lchip\" data-kid=\"2-3-1-2-3-1\" data-name=\"language chip: English\">English</span><span class=\"lchip\" data-kid=\"2-3-1-2-3-2\" data-name=\"language chip: Hindi\">हिन्दी</span><span class=\"lchip\" data-kid=\"2-3-1-2-3-3\" data-name=\"language chip: Hinglish\">Hinglish</span><span class=\"lchip\" data-kid=\"2-3-1-2-3-4\" data-name=\"language chip: Bangla\">বাংলা</span><span class=\"lchip\" data-kid=\"2-3-1-2-3-5\" data-name=\"language chip: Tamil\">தமிழ்</span><span class=\"lchip\" data-kid=\"2-3-1-2-3-6\" data-name=\"language chip: Telugu\">తెలుగు</span><span class=\"lchip\" data-kid=\"2-3-1-2-3-7\" data-name=\"language chip: Marathi\">मराठी</span><span class=\"lchip\" data-kid=\"2-3-1-2-3-8\" data-name=\"language chip: Gujarati\">ગુજરાતી</span><span class=\"lchip\" data-kid=\"2-3-1-2-3-9\" data-name=\"language chip: Kannada\">ಕನ್ನಡ</span><span class=\"lchip\" data-kid=\"2-3-1-2-3-10\" data-name=\"language chip: Malayalam\">മലയാളം</span><span class=\"lchip\" data-kid=\"2-3-1-2-3-11\" data-name=\"language chip: Punjabi\">ਪੰਜਾਬੀ</span>\n</div>\n<p class=\"lang-note\" data-kid=\"2-3-1-2-4\" data-name=\"language note\">Typed answers work in all 11. Speech input and output are enabled per language once that language's speech tests pass.</p>\n</div>\n</div>\n</section>\n<section class=\"feat-sec\" data-kid=\"2-4\" data-name=\"features master-detail section\">\n<div class=\"wrap\" data-kid=\"2-4-1\" data-name=\"section container\">\n<div data-kid=\"2-4-1-1\" data-name=\"section header row (inline styles)\" style=\"display:flex;align-items:flex-end;justify-content:space-between;gap:30px;padding-top:26px;border-top:1px solid var(--ink);margin-bottom:20px\">\n<h2 class=\"display\" data-kid=\"2-4-1-1-1\" data-name=\"section headline\" style=\"font-size:30px;line-height:1.1\">What a session includes</h2>\n<p data-kid=\"2-4-1-1-2\" data-name=\"section sub text\" style=\"font-size:11.5px;color:var(--ink-70);max-width:320px;line-height:1.55\">The interviewer, your resume, the code editor and the report share one room.</p>\n</div>\n<div class=\"feat-in\" data-kid=\"2-4-1-2\" data-name=\"master-detail layout\">\n<div class=\"f-list\" data-kid=\"2-4-1-2-1\" data-name=\"feature list / tab panel\">\n<div class=\"li on\" data-kid=\"2-4-1-2-1-1\" data-name=\"active tab: voice interviews\"><i class=\"ti ti-microphone\" data-kid=\"2-4-1-2-1-1-1\" data-name=\"microphone icon\"></i>Voice interviews</div>\n<div class=\"li\" data-kid=\"2-4-1-2-1-2\" data-name=\"tab: resume analysis\"><i class=\"ti ti-file-text\" data-kid=\"2-4-1-2-1-2-1\" data-name=\"file text icon\"></i>Resume analysis</div>\n<div class=\"li\" data-kid=\"2-4-1-2-1-3\" data-name=\"tab: coding round\"><i class=\"ti ti-code\" data-kid=\"2-4-1-2-1-3-1\" data-name=\"code icon\"></i>Coding round</div>\n<div class=\"li\" data-kid=\"2-4-1-2-1-4\" data-name=\"tab: feedback report\"><i class=\"ti ti-clipboard-check\" data-kid=\"2-4-1-2-1-4-1\" data-name=\"clipboard check icon\"></i>Feedback report</div>\n<div class=\"li\" data-kid=\"2-4-1-2-1-5\" data-name=\"tab: progress tracking\"><i class=\"ti ti-chart-bar\" data-kid=\"2-4-1-2-1-5-1\" data-name=\"bar chart icon\"></i>Progress tracking</div>\n<div class=\"li\" data-kid=\"2-4-1-2-1-6\" data-name=\"tab: session recovery\"><i class=\"ti ti-refresh\" data-kid=\"2-4-1-2-1-6-1\" data-name=\"refresh icon\"></i>Session recovery</div>\n</div>\n<div class=\"f-detail\" data-kid=\"2-4-1-2-2\" data-name=\"feature detail panel: voice interviews\">\n<h3 class=\"display\" data-kid=\"2-4-1-2-2-1\" data-name=\"detail headline\">Voice interviews</h3>\n<p class=\"d\" data-kid=\"2-4-1-2-2-2\" data-name=\"detail description\">The question is spoken, your answer is transcribed, and the follow-up is generated from what you actually said. Type instead at any point without ending the session.</p>\n<div class=\"f-vis\" data-kid=\"2-4-1-2-2-3\" data-name=\"feature visual / mock panel\">\n<div class=\"f-vis-top\" data-kid=\"2-4-1-2-2-3-1\" data-name=\"visual header row\"><i class=\"ti ti-microphone\" data-kid=\"2-4-1-2-2-3-1-1\" data-name=\"microphone icon\"></i>Live transcript <span class=\"tag\" data-kid=\"2-4-1-2-2-3-1-2\" data-name=\"language tag (English)\">English</span></div>\n<div class=\"wave\" data-kid=\"2-4-1-2-2-3-2\" data-name=\"transcript waveform display\"><i data-kid=\"2-4-1-2-2-3-2-1\" data-name=\"waveform bar\"></i><i data-kid=\"2-4-1-2-2-3-2-2\" data-name=\"waveform bar\"></i><i data-kid=\"2-4-1-2-2-3-2-3\" data-name=\"waveform bar\"></i><i data-kid=\"2-4-1-2-2-3-2-4\" data-name=\"waveform bar\"></i><i data-kid=\"2-4-1-2-2-3-2-5\" data-name=\"waveform bar\"></i><i data-kid=\"2-4-1-2-2-3-2-6\" data-name=\"waveform bar\"></i><i data-kid=\"2-4-1-2-2-3-2-7\" data-name=\"waveform bar\"></i><i data-kid=\"2-4-1-2-2-3-2-8\" data-name=\"waveform bar\"></i><i data-kid=\"2-4-1-2-2-3-2-9\" data-name=\"waveform bar\"></i><i data-kid=\"2-4-1-2-2-3-2-10\" data-name=\"waveform bar\"></i><i data-kid=\"2-4-1-2-2-3-2-11\" data-name=\"waveform bar\"></i><i data-kid=\"2-4-1-2-2-3-2-12\" data-name=\"waveform bar\"></i><i data-kid=\"2-4-1-2-2-3-2-13\" data-name=\"waveform bar\"></i><i data-kid=\"2-4-1-2-2-3-2-14\" data-name=\"waveform bar\"></i><i data-kid=\"2-4-1-2-2-3-2-15\" data-name=\"waveform bar\"></i><i data-kid=\"2-4-1-2-2-3-2-16\" data-name=\"waveform bar\"></i><i data-kid=\"2-4-1-2-2-3-2-17\" data-name=\"waveform bar\"></i><i data-kid=\"2-4-1-2-2-3-2-18\" data-name=\"waveform bar\"></i><i data-kid=\"2-4-1-2-2-3-2-19\" data-name=\"waveform bar\"></i><i data-kid=\"2-4-1-2-2-3-2-20\" data-name=\"waveform bar\"></i><i data-kid=\"2-4-1-2-2-3-2-21\" data-name=\"waveform bar\"></i><i data-kid=\"2-4-1-2-2-3-2-22\" data-name=\"waveform bar\"></i><i data-kid=\"2-4-1-2-2-3-2-23\" data-name=\"waveform bar\"></i><i data-kid=\"2-4-1-2-2-3-2-24\" data-name=\"waveform bar\"></i><i data-kid=\"2-4-1-2-2-3-2-25\" data-name=\"waveform bar\"></i><i data-kid=\"2-4-1-2-2-3-2-26\" data-name=\"waveform bar\"></i></div>\n<p data-kid=\"2-4-1-2-2-3-3\" data-name=\"sample transcript transcription\" style=\"font-size:12.5px;line-height:1.6;border-top:1px solid var(--hair);padding-top:10px\">“I kept a single issue record and a join table for issues and students. Two students on one book would have failed the availability trigger.”</p>\n<div class=\"vis-ctl\" data-kid=\"2-4-1-2-2-3-4\" data-name=\"transcript control bar\">\n<span class=\"cbtn on\" data-kid=\"2-4-1-2-2-3-4-1\" data-name=\"active control: microphone\"><i class=\"ti ti-microphone\" data-kid=\"2-4-1-2-2-3-4-1-1\" data-name=\"microphone icon\"></i></span>\n<span class=\"cbtn\" data-kid=\"2-4-1-2-2-3-4-2\" data-name=\"control: pause\"><i class=\"ti ti-pause\" data-kid=\"2-4-1-2-2-3-4-2-1\" data-name=\"pause icon\"></i></span>\n<span class=\"cbtn\" data-kid=\"2-4-1-2-2-3-4-3\" data-name=\"control: repeat\"><i class=\"ti ti-repeat\" data-kid=\"2-4-1-2-2-3-4-3-1\" data-name=\"repeat icon\"></i></span>\n<span class=\"cbtn\" data-kid=\"2-4-1-2-2-3-4-4\" data-name=\"control: hang up\"><i class=\"ti ti-phone-off\" data-kid=\"2-4-1-2-2-3-4-4-1\" data-name=\"hang up phone icon\"></i></span>\n<span class=\"note\" data-kid=\"2-4-1-2-2-3-4-5\" data-name=\"transcription edit note\">Transcription editable before submit</span>\n</div>\n</div>\n</div>\n</div>\n</div>\n</section>\n<section class=\"pers-sec\" data-kid=\"2-5\" data-name=\"personality section (dark)\">\n<div class=\"wrap\" data-kid=\"2-5-1\" data-name=\"section container\">\n<div class=\"pers-head\" data-kid=\"2-5-1-1\" data-name=\"section header with description\">\n<h2 class=\"display\" data-kid=\"2-5-1-1-1\" data-name=\"section headline\">Interviewer personalities</h2>\n<p data-kid=\"2-5-1-1-2\" data-name=\"section sub text\">The same question bank, delivered differently. Switch before each interview.</p>\n</div>\n<div class=\"personas\" data-kid=\"2-5-1-2\" data-name=\"persona cards grid\">\n<div class=\"per\" data-kid=\"2-5-1-2-1\" data-name=\"persona card: Friendly\"><div class=\"p-top\" data-kid=\"2-5-1-2-1-1\" data-name=\"persona header row (name + tag)\"><b data-kid=\"2-5-1-2-1-1-1\" data-name=\"persona name Title\">Friendly</b><span data-kid=\"2-5-1-2-1-1-2\" data-name=\"persona tag: First attempts\">First attempts</span></div><p data-kid=\"2-5-1-2-1-2\" data-name=\"persona description\">Warm tone, longer answers, gentle follow-ups.</p></div>\n<div class=\"per\" data-kid=\"2-5-1-2-2\" data-name=\"persona card: Professional\"><div class=\"p-top\" data-kid=\"2-5-1-2-2-1\" data-name=\"persona header row (name + tag)\"><b data-kid=\"2-5-1-2-2-1-1\" data-name=\"persona name Title\">Professional</b><span data-kid=\"2-5-1-2-2-1-2\" data-name=\"persona tag: Real conditions\">Real conditions</span></div><p data-kid=\"2-5-1-2-2-2\" data-name=\"persona description\">Neutral tone, keeps to the agenda and the clock.</p></div>\n<div class=\"per\" data-kid=\"2-5-1-2-3\" data-name=\"persona card: Strict\"><div class=\"p-top\" data-kid=\"2-5-1-2-3-1\" data-name=\"persona header row (name + tag)\"><b data-kid=\"2-5-1-2-3-1-1\" data-name=\"persona name Title\">Strict</b><span data-kid=\"2-5-1-2-3-1-2\" data-name=\"persona tag: Pressure rounds\">Pressure rounds</span></div><p data-kid=\"2-5-1-2-3-2\" data-name=\"persona description\">Presses on thin answers and asks for evidence.</p></div>\n<div class=\"per\" data-kid=\"2-5-1-2-4\" data-name=\"persona card: Technical Expert\"><div class=\"p-top\" data-kid=\"2-5-1-2-4-1\" data-name=\"persona header row (name + tag)\"><b data-kid=\"2-5-1-2-4-1-1\" data-name=\"persona name Title\">Technical Expert</b><span data-kid=\"2-5-1-2-4-1-2\" data-name=\"persona tag: Technical\">Technical</span></div><p data-kid=\"2-5-1-2-4-2\" data-name=\"persona description\">Follows project decisions down to fundamentals.</p></div>\n<div class=\"per\" data-kid=\"2-5-1-2-5\" data-name=\"persona card: HR Specialist\"><div class=\"p-top\" data-kid=\"2-5-1-2-5-1\" data-name=\"persona header row (name + tag)\"><b data-kid=\"2-5-1-2-5-1-1\" data-name=\"persona name Title\">HR Specialist</b><span data-kid=\"2-5-1-2-5-1-2\" data-name=\"persona tag: HR rounds\">HR rounds</span></div><p data-kid=\"2-5-1-2-5-2\" data-name=\"persona description\">Behavioural questions, culture fit, compensation.</p></div>\n<div class=\"per\" data-kid=\"2-5-1-2-6\" data-name=\"persona card: Hiring Manager\"><div class=\"p-top\" data-kid=\"2-5-1-2-6-1\" data-name=\"persona header row (name + tag)\"><b data-kid=\"2-5-1-2-6-1-1\" data-name=\"persona name Title\">Hiring Manager</b><span data-kid=\"2-5-1-2-6-1-2\" data-name=\"persona tag: Experienced\">Experienced</span></div><p data-kid=\"2-5-1-2-6-2\" data-name=\"persona description\">Panel-style trade-offs and ownership questions.</p></div>\n</div>\n</div>\n</section>\n<section class=\"price-sec\" data-kid=\"2-6\" data-name=\"pricing section\">\n<div class=\"wrap\" data-kid=\"2-6-1\" data-name=\"section container\">\n<div class=\"price-head\" data-kid=\"2-6-1-1\" data-name=\"pricing header row\">\n<h2 class=\"display\" data-kid=\"2-6-1-1-1\" data-name=\"section headline\">Plans and limits</h2>\n<p data-kid=\"2-6-1-1-2\" data-name=\"section sub text\">Monthly interview quotas, shown against the Pro ceiling. Everything resets on the billing date.</p>\n</div>\n<div class=\"board\" data-kid=\"2-6-1-2\" data-name=\"pricing cards grid (board)\">\n<div class=\"col\" data-kid=\"2-6-1-2-1\" data-name=\"pricing card: Free\">\n<div class=\"c-head\" data-kid=\"2-6-1-2-1-1\" data-name=\"card header (tier name + price)\"><h3 data-kid=\"2-6-1-2-1-1-1\" data-name=\"tier name Title\">Free</h3><span data-kid=\"2-6-1-2-1-1-2\" data-name=\"price badge (₹0)\">₹0</span></div>\n<p class=\"for\" data-kid=\"2-6-1-2-1-2\" data-name=\"card audience description\">For a first look at how an AI interview feels.</p>\n<div class=\"amt\" data-kid=\"2-6-1-2-1-3\" data-name=\"monthly price display\">₹0<em data-kid=\"2-6-1-2-1-3-1\" data-name=\"per-month suffix\">/ month</em></div>\n<div class=\"quota\" data-kid=\"2-6-1-2-1-4\" data-name=\"quota section (interviews)\">\n<div class=\"qtop\" data-kid=\"2-6-1-2-1-4-1\" data-name=\"quota header row\"><span data-kid=\"2-6-1-2-1-4-1-1\" data-name=\"quota label (Interviews)\">Interviews</span><b data-kid=\"2-6-1-2-1-4-1-2\" data-name='quota value Text:false \"3 / 60\"'>3 / 60</b></div>\n<div class=\"qbar\" data-kid=\"2-6-1-2-1-4-2\" data-name=\"quota progress track\"><i data-kid=\"2-6-1-2-1-4-2-1\" data-name=\"quota progress fill (5%)\" style=\"width:5%\"></i></div>\n</div>\n<div class=\"clist\" data-kid=\"2-6-1-2-1-5\" data-name=\"feature list wrapper\">\n<div class=\"crow\" data-kid=\"2-6-1-2-1-5-1\" data-name=\"feature row: Answer mode\"><span data-kid=\"2-6-1-2-1-5-1-1\" data-name=\"feature label\">Answer mode</span><b data-kid=\"2-6-1-2-1-5-1-2\" data-name='feature value false \"Text\"'>Text</b></div>\n<div class=\"crow\" data-kid=\"2-6-1-2-1-5-2\" data-name=\"feature row: Saved resumes\"><span data-kid=\"2-6-1-2-1-5-2-1\" data-name=\"feature label\">Saved resumes</span><b data-kid=\"2-6-1-2-1-5-2-2\" data-name='feature value false \"1\"'>1</b></div>\n<div class=\"crow\" data-kid=\"2-6-1-2-1-5-3\" data-name=\"feature row: Report\"><span data-kid=\"2-6-1-2-1-5-3-1\" data-name=\"feature label\">Report</span><b data-kid=\"2-6-1-2-1-5-3-2\" data-name='feature value false \"Basic\"'>Basic</b></div>\n<div class=\"crow\" data-kid=\"2-6-1-2-1-5-4\" data-name=\"feature row: Coding round\" style=\"border-bottom:0\"><span data-kid=\"2-6-1-2-1-5-4-1\" data-name=\"feature label\">Coding round</span><b data-kid=\"2-6-1-2-1-5-4-2\" data-name='feature value false \"—\"'>—</b></div>\n</div>\n<a class=\"btn-line btn\" data-kid=\"2-6-1-2-1-6\" data-name=\"card CTA: Start free\" href=\"/signup\">Start free</a>\n</div>\n<div class=\"col hi\" data-kid=\"2-6-1-2-2\" data-name=\"pricing card: Starter (highlighted)\">\n<div class=\"c-head\" data-kid=\"2-6-1-2-2-1\" data-name=\"card header (tier name + price)\"><h3 data-kid=\"2-6-1-2-2-1-1\" data-name=\"tier name Title\">Starter</h3><span data-kid=\"2-6-1-2-2-1-2\" data-name=\"price badge (₹399)\">₹399</span></div>\n<p class=\"for\" data-kid=\"2-6-1-2-2-2\" data-name=\"card audience description\">For final-year students and freshers in placement season.</p>\n<div class=\"amt\" data-kid=\"2-6-1-2-2-3\" data-name=\"monthly price display\">₹399<em data-kid=\"2-6-1-2-2-3-1\" data-name=\"per-month suffix\">/ month</em></div>\n<div class=\"quota\" data-kid=\"2-6-1-2-2-4\" data-name=\"quota section (interviews)\">\n<div class=\"qtop\" data-kid=\"2-6-1-2-2-4-1\" data-name=\"quota header row\"><span data-kid=\"2-6-1-2-2-4-1-1\" data-name=\"quota label (Interviews)\">Interviews</span><b data-kid=\"2-6-1-2-2-4-1-2\" data-name='quota value Text:false \"20 / 60\"'>20 / 60</b></div>\n<div class=\"qbar\" data-kid=\"2-6-1-2-2-4-2\" data-name=\"quota progress track\"><i data-kid=\"2-6-1-2-2-4-2-1\" data-name=\"quota progress fill (33%)\" style=\"width:33%\"></i></div>\n</div>\n<div class=\"clist\" data-kid=\"2-6-1-2-2-5\" data-name=\"feature list wrapper\">\n<div class=\"crow\" data-kid=\"2-6-1-2-2-5-1\" data-name=\"feature row: Answer mode\"><span data-kid=\"2-6-1-2-2-5-1-1\" data-name=\"feature label\">Answer mode</span><b data-kid=\"2-6-1-2-2-5-1-2\" data-name='feature value false \"Voice and text\"'>Voice and text</b></div>\n<div class=\"crow\" data-kid=\"2-6-1-2-2-5-2\" data-name=\"feature row: Saved resumes\"><span data-kid=\"2-6-1-2-2-5-2-1\" data-name=\"feature label\">Saved resumes</span><b data-kid=\"2-6-1-2-2-5-2-2\" data-name='feature value false \"3\"'>3</b></div>\n<div class=\"crow\" data-kid=\"2-6-1-2-2-5-3\" data-name=\"feature row: Report\"><span data-kid=\"2-6-1-2-2-5-3-1\" data-name=\"feature label\">Report</span><b data-kid=\"2-6-1-2-2-5-3-2\" data-name='feature value false \"Full\"'>Full</b></div>\n<div class=\"crow\" data-kid=\"2-6-1-2-2-5-4\" data-name=\"feature row: Coding round\" style=\"border-bottom:0\"><span data-kid=\"2-6-1-2-2-5-4-1\" data-name=\"feature label\">Coding round</span><b data-kid=\"2-6-1-2-2-5-4-2\" data-name='feature value false \"Included\"'>Included</b></div>\n</div>\n<a class=\"btn\" data-kid=\"2-6-1-2-2-6\" data-name=\"card CTA: Choose Starter\" href=\"/signup\">Choose Starter</a>\n</div>\n<div class=\"col\" data-kid=\"2-6-1-2-3\" data-name=\"pricing card: Pro\">\n<div class=\"c-head\" data-kid=\"2-6-1-2-3-1\" data-name=\"card header (tier name + price)\"><h3 data-kid=\"2-6-1-2-3-1-1\" data-name=\"tier name Title\">Pro</h3><span data-kid=\"2-6-1-2-3-1-2\" data-name=\"price badge (₹899)\">₹899</span></div>\n<p class=\"for\" data-kid=\"2-6-1-2-3-2\" data-name=\"card audience description\">For working professionals sitting several rounds at once.</p>\n<div class=\"amt\" data-kid=\"2-6-1-2-3-3\" data-name=\"monthly price display\">₹899<em data-kid=\"2-6-1-2-3-3-1\" data-name=\"per-month suffix\">/ month</em></div>\n<div class=\"quota\" data-kid=\"2-6-1-2-3-4\" data-name=\"quota section (interviews)\">\n<div class=\"qtop\" data-kid=\"2-6-1-2-3-4-1\" data-name=\"quota header row\"><span data-kid=\"2-6-1-2-3-4-1-1\" data-name=\"quota label (Interviews)\">Interviews</span><b data-kid=\"2-6-1-2-3-4-1-2\" data-name='quota value Text:false \"60 / 60\"'>60 / 60</b></div>\n<div class=\"qbar\" data-kid=\"2-6-1-2-3-4-2\" data-name=\"quota progress track\"><i data-kid=\"2-6-1-2-3-4-2-1\" data-name=\"quota progress fill (100%)\" style=\"width:100%\"></i></div>\n</div>\n<div class=\"clist\" data-kid=\"2-6-1-2-3-5\" data-name=\"feature list wrapper\">\n<div class=\"crow\" data-kid=\"2-6-1-2-3-5-1\" data-name=\"feature row: Answer mode\"><span data-kid=\"2-6-1-2-3-5-1-1\" data-name=\"feature label\">Answer mode</span><b data-kid=\"2-6-1-2-3-5-1-2\" data-name='feature value false \"Voice and text\"'>Voice and text</b></div>\n<div class=\"crow\" data-kid=\"2-6-1-2-3-5-2\" data-name=\"feature row: Saved resumes\"><span data-kid=\"2-6-1-2-3-5-2-1\" data-name=\"feature label\">Saved resumes</span><b data-kid=\"2-6-1-2-3-5-2-2\" data-name='feature value false \"10\"'>10</b></div>\n<div class=\"crow\" data-kid=\"2-6-1-2-3-5-3\" data-name=\"feature row: Report\"><span data-kid=\"2-6-1-2-3-5-3-1\" data-name=\"feature label\">Report</span><b data-kid=\"2-6-1-2-3-5-3-2\" data-name='feature value false \"Advanced\"'>Advanced</b></div>\n<div class=\"crow\" data-kid=\"2-6-1-2-3-5-4\" data-name=\"feature row: Personalities\" style=\"border-bottom:0\"><span data-kid=\"2-6-1-2-3-5-4-1\" data-name=\"feature label\">Personalities</span><b data-kid=\"2-6-1-2-3-5-4-2\" data-name='feature value false \"All 6\"'>All 6</b></div>\n</div>\n<a class=\"btn-line btn\" data-kid=\"2-6-1-2-3-6\" data-name=\"card CTA: Choose Pro\" href=\"/signup\">Choose Pro</a>\n</div>\n</div>\n<div class=\"note-row\" data-kid=\"2-6-1-3\" data-name=\"pricing footnotes / disclaimer row\">\n<span data-kid=\"2-6-1-3-1\" data-name=\"included-features note group\"><i class=\"ti ti-check\" data-kid=\"2-6-1-3-1-1\" data-name=\"checkmark icon\"></i>All 10 categories with every plan<i class=\"ti ti-check\" data-kid=\"2-6-1-3-1-2\" data-name=\"checkmark icon\"></i>Transcript and PDF export</span>\n<span data-kid=\"2-6-1-3-2\" data-name=\"GST / INR note\">Prices in INR, inclusive of GST</span>\n</div>\n</div>\n</section>\n<section class=\"faq-sec\" data-kid=\"2-7\" data-name=\"FAQ section\">\n<div class=\"wrap\" data-kid=\"2-7-1\" data-name=\"section container\">\n<div class=\"faq-head\" data-kid=\"2-7-1-1\" data-name=\"FAQ header (headline only)\"><h2 class=\"display\" data-kid=\"2-7-1-1-1\" data-name=\"section headline\">Before you sign up</h2></div>\n<div class=\"faq-grid\" data-kid=\"2-7-1-2\" data-name=\"FAQ two-column grid\">\n<div data-kid=\"2-7-1-2-1\" data-name=\"FAQ column (left)\">\n<div class=\"fq\" data-kid=\"2-7-1-2-1-1\" data-name=\"FAQ item\"><span class=\"m\" data-kid=\"2-7-1-2-1-1-1\" data-name=\"FAQ number label (hidden)\">01</span><div data-kid=\"2-7-1-2-1-1-2\" data-name=\"FAQ answer container\"><h4 data-kid=\"2-7-1-2-1-1-2-1\" data-name=\"FAQ question heading\">Do I have to interview in English?</h4><p data-kid=\"2-7-1-2-1-1-2-2\" data-name=\"FAQ answer text\">No. Pick any of the 11 languages before each session, including Hinglish. Questions, follow-ups and the report stay in that language.</p></div></div>\n<div class=\"fq\" data-kid=\"2-7-1-2-1-2\" data-name=\"FAQ item\"><span class=\"m\" data-kid=\"2-7-1-2-1-2-1\" data-name=\"FAQ number label (hidden)\">02</span><div data-kid=\"2-7-1-2-1-2-2\" data-name=\"FAQ answer container\"><h4 data-kid=\"2-7-1-2-1-2-2-1\" data-name=\"FAQ question heading\">Will the questions fit my course?</h4><p data-kid=\"2-7-1-2-1-2-2-2\" data-name=\"FAQ answer text\">Yes. Each category reads the course on your profile, so BBA sessions ask about marketing and operations, and science sessions ask about lab practice.</p></div></div>\n<div class=\"fq\" data-kid=\"2-7-1-2-1-3\" data-name=\"FAQ item\"><span class=\"m\" data-kid=\"2-7-1-2-1-3-1\" data-name=\"FAQ number label (hidden)\">03</span><div data-kid=\"2-7-1-2-1-3-2\" data-name=\"FAQ answer container\"><h4 data-kid=\"2-7-1-2-1-3-2-1\" data-name=\"FAQ question heading\">How is an answer scored?</h4><p data-kid=\"2-7-1-2-1-3-2-2\" data-name=\"FAQ answer text\">Against the rubric for your stream and category. The report names the criterion behind each score and separates code test results from communication feedback.</p></div></div>\n</div>\n<div data-kid=\"2-7-1-2-2\" data-name=\"FAQ column (right)\">\n<div class=\"fq\" data-kid=\"2-7-1-2-2-1\" data-name=\"FAQ item\"><span class=\"m\" data-kid=\"2-7-1-2-2-1-1\" data-name=\"FAQ number label (hidden)\">04</span><div data-kid=\"2-7-1-2-2-1-2\" data-name=\"FAQ answer container\"><h4 data-kid=\"2-7-1-2-2-1-2-1\" data-name=\"FAQ question heading\">Can I resume an interrupted interview?</h4><p data-kid=\"2-7-1-2-2-1-2-2\" data-name=\"FAQ answer text\">Yes. Every answer is saved, so reopening continues from the last turn and the timer stays paused until you return.</p></div></div>\n<div class=\"fq\" data-kid=\"2-7-1-2-2-2\" data-name=\"FAQ item\"><span class=\"m\" data-kid=\"2-7-1-2-2-2-1\" data-name=\"FAQ number label (hidden)\">05</span><div data-kid=\"2-7-1-2-2-2-2\" data-name=\"FAQ answer container\"><h4 data-kid=\"2-7-1-2-2-2-2-1\" data-name=\"FAQ question heading\">What if the microphone is blocked?</h4><p data-kid=\"2-7-1-2-2-2-2-2\" data-name=\"FAQ answer text\">The session switches to typed answers without ending, and the remaining questions continue in the same language.</p></div></div>\n<div class=\"fq\" data-kid=\"2-7-1-2-2-3\" data-name=\"FAQ item\"><span class=\"m\" data-kid=\"2-7-1-2-2-3-1\" data-name=\"FAQ number label (hidden)\">06</span><div data-kid=\"2-7-1-2-2-3-2\" data-name=\"FAQ answer container\"><h4 data-kid=\"2-7-1-2-2-3-2-1\" data-name=\"FAQ question heading\">Who can read my resume?</h4><p data-kid=\"2-7-1-2-2-3-2-2\" data-name=\"FAQ answer text\">Only your own sessions. Files are stored privately and can be deleted from the resume page at any time.</p></div></div>\n</div>\n</div>\n</div>\n</section>\n<section class=\"final\" data-kid=\"2-8\" data-name=\"final CTA section (turquoise)\">\n<div class=\"wrap final-in\" data-kid=\"2-8-1\" data-name=\"section content grid\">\n<div data-kid=\"2-8-1-1\" data-name=\"CTA headline and stats block\">\n<h2 class=\"display\" data-kid=\"2-8-1-1-1\" data-name=\"CTA headline\">Your Next Interview Starts Here.</h2>\n<div class=\"stats\" data-kid=\"2-8-1-1-2\" data-name=\"stats row\">\n<div class=\"st\" data-kid=\"2-8-1-1-2-1\" data-name=\"stat: 10 categories\"><b data-kid=\"2-8-1-1-2-1-1\" data-name=\"stat number\">10</b><span data-kid=\"2-8-1-1-2-1-2\" data-name=\"stat label\">categories</span></div>\n<div class=\"st\" data-kid=\"2-8-1-1-2-2\" data-name=\"stat: 11 languages\"><b data-kid=\"2-8-1-1-2-2-1\" data-name=\"stat number\">11</b><span data-kid=\"2-8-1-1-2-2-2\" data-name=\"stat label\">languages</span></div>\n<div class=\"st\" data-kid=\"2-8-1-1-2-3\" data-name=\"stat: 6 interviewers\"><b data-kid=\"2-8-1-1-2-3-1\" data-name=\"stat number\">6</b><span data-kid=\"2-8-1-1-2-3-2\" data-name=\"stat label\">interviewers</span></div>\n<div class=\"st\" data-kid=\"2-8-1-1-2-4\" data-name=\"stat: 4 coding languages\"><b data-kid=\"2-8-1-1-2-4-1\" data-name=\"stat number\">4</b><span data-kid=\"2-8-1-1-2-4-2\" data-name=\"stat label\">coding languages</span></div>\n</div>\n</div>\n<div class=\"final-right\" data-kid=\"2-8-1-2\" data-name=\"CTA right column (button + note)\">\n<a class=\"btn\" data-kid=\"2-8-1-2-1\" data-name=\"CTA primary button: Start Free Interview\" href=\"/signup\">Start Free Interview</a>\n<p class=\"micro\" data-kid=\"2-8-1-2-2\" data-name=\"CTA fine-print note\">Free plan: 3 interviews a month, no card.</p>\n</div>\n</div>\n</section>\n</main>\n<footer class=\"foot\" data-kid=\"3\" data-name=\"page footer\">\n<div class=\"wrap\" data-kid=\"3-1\" data-name=\"footer inner container\">\n<div class=\"foot-grid\" data-kid=\"3-1-1\" data-name=\"footer link grid\">\n<div class=\"foot-brand\" data-kid=\"3-1-1-1\" data-name=\"footer brand block\">\n<a class=\"brand\" data-kid=\"3-1-1-1-1\" data-name=\"footer logo brand link\" href=\"/\"><span class=\"mark\" data-kid=\"3-1-1-1-1-1\" data-name=\"logo mark with equalizer bars\"><i data-kid=\"3-1-1-1-1-1-1\" data-name=\"equalizer bar\"></i><i data-kid=\"3-1-1-1-1-1-2\" data-name=\"equalizer bar\"></i><i data-kid=\"3-1-1-1-1-1-3\" data-name=\"equalizer bar\"></i></span>MockMate AI</a>\n<p data-kid=\"3-1-1-1-2\" data-name=\"footer tagline\">AI mock interviews for every course and career path. Interface in English, interviews in 11 languages.</p>\n</div>\n<div data-kid=\"3-1-1-2\" data-name=\"footer column: Product\">\n<h5 data-kid=\"3-1-1-2-1\" data-name=\"column heading\">Product</h5>\n<ul data-kid=\"3-1-1-2-2\" data-name=\"product links list\"><li data-kid=\"3-1-1-2-2-1\" data-name=\"list item\"><a data-kid=\"3-1-1-2-2-1-1\" data-name=\"link: Features\" href=\"/features\">Features</a></li><li data-kid=\"3-1-1-2-2-2\" data-name=\"list item\"><a data-kid=\"3-1-1-2-2-2-1\" data-name=\"link: How it works\" href=\"/how-it-works\">How it works</a></li><li data-kid=\"3-1-1-2-2-3\" data-name=\"list item\"><a data-kid=\"3-1-1-2-2-3-1\" data-name=\"link: Pricing\" href=\"/pricing\">Pricing</a></li><li data-kid=\"3-1-1-2-2-4\" data-name=\"list item\"><a data-kid=\"3-1-1-2-2-4-1\" data-name=\"link: AI mock interview\" href=\"/ai-mock-interview\">AI mock interview</a></li></ul>\n</div>\n<div data-kid=\"3-1-1-3\" data-name=\"footer column: Practice\">\n<h5 data-kid=\"3-1-1-3-1\" data-name=\"column heading\">Practice</h5>\n<ul data-kid=\"3-1-1-3-2\" data-name=\"practice links list\"><li data-kid=\"3-1-1-3-2-1\" data-name=\"list item\"><a data-kid=\"3-1-1-3-2-1-1\" data-name=\"link: Interview questions\" href=\"/interview-questions\">Interview questions</a></li><li data-kid=\"3-1-1-3-2-2\" data-name=\"list item\"><a data-kid=\"3-1-1-3-2-2-1\" data-name=\"link: Coding round\" href=\"/coding-interview\">Coding round</a></li><li data-kid=\"3-1-1-3-2-3\" data-name=\"list item\"><a data-kid=\"3-1-1-3-2-3-1\" data-name=\"link: B.Tech\" href=\"/interview-preparation/btech\">B.Tech</a></li><li data-kid=\"3-1-1-3-2-4\" data-name=\"list item\"><a data-kid=\"3-1-1-3-2-4-1\" data-name=\"link: Law\" href=\"/interview-preparation/law\">Law</a></li></ul>\n</div>\n<div data-kid=\"3-1-1-4\" data-name=\"footer column: Company\">\n<h5 data-kid=\"3-1-1-4-1\" data-name=\"column heading\">Company</h5>\n<ul data-kid=\"3-1-1-4-2\" data-name=\"company links list\"><li data-kid=\"3-1-1-4-2-1\" data-name=\"list item\"><a data-kid=\"3-1-1-4-2-1-1\" data-name=\"link: About\" href=\"/about\">About</a></li><li data-kid=\"3-1-1-4-2-2\" data-name=\"list item\"><a data-kid=\"3-1-1-4-2-2-1\" data-name=\"link: Contact\" href=\"/contact\">Contact</a></li><li data-kid=\"3-1-1-4-2-3\" data-name=\"list item\"><a data-kid=\"3-1-1-4-2-3-1\" data-name=\"link: Blog\" href=\"/blog\">Blog</a></li><li data-kid=\"3-1-1-4-2-4\" data-name=\"list item\"><a data-kid=\"3-1-1-4-2-4-1\" data-name=\"link: FAQ\" href=\"/faq\">FAQ</a></li></ul>\n</div>\n<div data-kid=\"3-1-1-5\" data-name=\"footer column: Legal\">\n<h5 data-kid=\"3-1-1-5-1\" data-name=\"column heading\">Legal</h5>\n<ul data-kid=\"3-1-1-5-2\" data-name=\"legal links list\"><li data-kid=\"3-1-1-5-2-1\" data-name=\"list item\"><a data-kid=\"3-1-1-5-2-1-1\" data-name=\"link: Privacy policy\" href=\"/privacy\">Privacy policy</a></li><li data-kid=\"3-1-1-5-2-2\" data-name=\"list item\"><a data-kid=\"3-1-1-5-2-2-1\" data-name=\"link: Terms of service\" href=\"/terms\">Terms of service</a></li><li data-kid=\"3-1-1-5-2-3\" data-name=\"list item\"><a data-kid=\"3-1-1-5-2-3-1\" data-name=\"link: Cookie policy\" href=\"/cookies\">Cookie policy</a></li><li data-kid=\"3-1-1-5-2-4\" data-name=\"list item\"><a data-kid=\"3-1-1-5-2-4-1\" data-name=\"link: Interview tips\" href=\"/interview-tips\">Interview tips</a></li></ul>\n</div>\n</div>\n<div class=\"foot-bottom\" data-kid=\"3-1-2\" data-name=\"footer bottom bar\">\n<span data-kid=\"3-1-2-1\" data-name=\"copyright notice\">© 2026 MockMate AI</span>\n<div class=\"social\" data-kid=\"3-1-2-2\" data-name=\"social icons row\"><i class=\"ti ti-brand-linkedin\" data-kid=\"3-1-2-2-1\" data-name=\"LinkedIn icon\"></i><i class=\"ti ti-brand-youtube\" data-kid=\"3-1-2-2-2\" data-name=\"YouTube icon\"></i><i class=\"ti ti-brand-instagram\" data-kid=\"3-1-2-2-3\" data-name=\"Instagram icon\"></i><i class=\"ti ti-brand-x\" data-kid=\"3-1-2-2-4\" data-name=\"X (Twitter) icon\"></i></div>\n</div>\n</div>\n</footer>",
