    "var_330806d5007d": {
      "type": "variant",
      "label": "Interview Setup — V1 Baltic",
      "parentId": "var_7db23e2417f2",
      "themeId": null,
      "rect": {
        "x": 2760,
        "y": 0,
        "w": 1280,
        "h": 0
      },
      "html": "<style>\n@import url('https://fonts.googleapis.com/css2?family=Kumbh+Sans:wght@400;500;600;700&family=Share+Tech+Mono&display=swap');\n@import url(\"https://cdn.jsdelivr.net/npm/lucide-static@1.48.0/font/lucide.css\");\n:root{\n  --ground:#F2F4FF; --ink:#13293C; --ink70:rgba(19,41,60,.68); --ink45:rgba(41,41,60,.45);\n  --accent:#0A6A9E; --band:#A9E0F0; --line:#CFE0EE; --line2:#B9CCDD;\n  --ink-a:#0B1D2A; --ink2:#0B1D2A; --bg:#F4F7FA; --ink-muted:#5b6f7d;\n}\n*{box-sizing:border-box}\nbody{margin:0;background:var(--bg);color:var(--ink-a);font-family:'Kumbh Sans',system-ui,sans-serif;-webkit-font-smoothing:antialiased;font-size:14px}\nh1,h2,h3,h4,p,ul{margin:0;padding:0}ul{list-style:none}\na{text-decoration:none;color:inherit}\n.mono{font-family:'Share Tech Mono',ui-monospace,monospace}\n.wrap{max-width:1240px;margin:0 auto;padding:0 28px}\n\n/* app bar */\n.appbar{background:#fff;border-bottom:1px solid var(--line)}\n.bar-in{height:60px;display:flex;align-items:center;gap:22px}\n.brand{display:flex;align-items:center;gap:9px;font-weight:600;font-size:15px;color:var(--ink-a)}\n.mark{width:24px;height:24px;border-radius:4px;background:var(--ink-a);display:flex;align-items:flex-end;justify-content:center;gap:2px;padding:5px 4px}\n.mark i{display:block;width:2px;background:var(--band);border-radius:1px}\n.mark i:nth-child(1){height:60%}.mark i:nth-child(2){height:100%}.mark i:nth-child(3){height:44%}\n.crumb{display:flex;align-items:center;gap:7px;font-size:12.5px;color:var(--ink-muted);margin-left:6px}\n.crumb i{font-size:13px;opacity:.6}\n.crumb b{font-weight:600;color:var(--ink-a)}\n.bar-right{margin-left:auto;display:flex;align-items:center;gap:16px}\n.usage{font-size:11.5px;color:var(--ink-muted);border:1px solid var(--line);border-radius:4px;padding:5px 9px;background:#fff}\n.usage b{color:var(--ink-a);font-family:'Share Tech Mono',monospace;font-weight:400}\n.av{width:30px;height:30px;border-radius:50%;overflow:hidden;border:1px solid var(--line2)}\n.av img{width:100%;height:100%;display:block;object-fit:cover}\n\n/* page head */\n.page-head{padding:26px 0 18px;display:flex;align-items:flex-end;justify-content:space-between;gap:30px}\n.page-head h1{font-size:27px;font-weight:600;letter-spacing:-.02em}\n.page-head p{font-size:12.5px;color:var(--ink-muted);margin-top:6px;max-width:460px;line-height:1.55}\n.anchors{display:flex;gap:20px;font-size:12px;color:var(--ink-muted)}\n.anchors a{display:inline-flex;align-items:center;gap:6px;padding-bottom:3px;border-bottom:1px solid transparent}\n.anchors a.on{color:var(--ink-a);border-color:var(--accent);font-weight:600}\n.anchors .n{font-family:'Share Tech Mono',monospace;font-size:10.5px;color:var(--accent)}\n\n/* layout */\n.page{display:grid;grid-template-columns:minmax(0,1fr) 330px;gap:34px;padding-bottom:48px;align-items:start}\n.panel{background:#fff;border:1px solid var(--line)}\n.f-sec{padding:18px 20px 22px;border-top:1px solid var(--line)}\n.f-sec:first-child{border-top:0}\n.f-head{display:flex;align-items:baseline;justify-content:space-between;gap:14px;margin-bottom:13px}\n.f-head h2{font-size:14px;font-weight:600;letter-spacing:-.01em;display:flex;align-items:center;gap:8px}\n.f-head h2 .n{font-family:'Share Tech Mono',monospace;font-size:10.5px;color:var(--accent);border:1px solid var(--line2);border-radius:3px;padding:1px 5px;font-weight:400}\n.f-head span{font-size:10.5px;color:var(--ink-muted);text-transform:uppercase;letter-spacing:.08em}\n\n/* category grid */\n.cat-grid{display:grid;grid-template-columns:1fr 1fr;gap:7px}\n.csel{border:1px solid var(--line2);background:#fff;padding:10px 12px;display:grid;grid-template-columns:16px 1fr 12px;gap:9px;align-items:center;cursor:default}\n.csel i:first-child{font-size:15px;color:var(--accent)}\n.csel b{display:block;font-size:12.5px;font-weight:600}\n.csel em{display:block;font-style:normal;font-size:10.5px;color:var(--ink-muted);margin-top:2px}\n.csel .tick{font-size:12px;color:var(--accent);opacity:0}\n.csel.on{border-color:var(--ink-a);box-shadow:inset 0 0 0 1px var(--ink-a)}\n.csel.on .tick{opacity:1}\n\n/* rows */\n.frow{display:grid;grid-template-columns:150px 1fr;gap:16px;align-items:center;padding:9px 0;border-top:1px dashed var(--line)}\n.frow:first-of-type{border-top:0}\n.frow > label{font-size:12.5px;color:var(--ink-muted)}\n.ctrl{display:flex;align-items:center;gap:10px;flex-wrap:wrap}\n.select{border:1px solid var(--line2);background:#fff;padding:7px 10px;font-size:12.5px;display:flex;align-items:center;gap:10px;min-width:250px;justify-content:space-between}\n.select span{color:var(--ink-a)}\n.select .hint{font-size:10.5px;color:var(--ink-muted)}\n.select i{font-size:13px;color:var(--ink-muted)}\n.seg{display:inline-flex;border:1px solid var(--line2);background:#fff}\n.seg span{font-size:12px;padding:6px 12px;border-left:1px solid var(--line);color:var(--ink-muted)}\n.seg span:first-child{border-left:0}\n.seg span.on{background:var(--ink-a);color:#fff;font-weight:600}\n.chips{display:flex;flex-wrap:wrap;gap:5px}\n.fchip{font-size:11.5px;padding:5px 9px;border:1px solid var(--line2);background:#fff;color:var(--ink-muted)}\n.fchip.on{background:var(--accent);border-color:var(--accent);color:#fff;font-weight:500}\n.toggle{width:34px;height:20px;border-radius:10px;background:var(--accent);position:relative;flex:none}\n.toggle i{position:absolute;right:2px;top:2px;width:16px;height:16px;border-radius:50%;background:#fff}\n.toggle.off{background:#C9D6E2}\n.toggle.off i{left:2px;right:auto}\n.tgl-row{display:flex;align-items:center;gap:9px;font-size:12px;color:var(--ink-muted)}\n.helper{font-size:10.5px;color:var(--ink-muted);margin-top:6px;line-height:1.5}\n\n/* resume */\n.file{display:flex;align-items:center;gap:11px;border:1px solid var(--line2);background:#fff;padding:10px 12px}\n.fi{width:30px;height:30px;background:#E3F1FA;display:flex;align-items:center;justify-content:center;font-size:14px;color:var(--accent);flex:none}\n.file b{display:block;font-size:12.5px;font-weight:600}\n.file span{display:block;font-size:10.5px;color:var(--ink-muted);margin-top:2px}\n.file .acts{margin-left:auto;display:flex;gap:12px;font-size:11.5px;color:var(--accent)}\n.checkrow{display:flex;align-items:center;gap:8px;font-size:12px;color:var(--ink-muted);margin-top:11px}\n.box{width:14px;height:14px;border:1px solid var(--ink-a);display:flex;align-items:center;justify-content:center;font-size:9px;color:#fff;background:var(--ink-a)}\n\n/* summary */\n.sum{background:var(--ink-a);color:#F2F4FF;padding:18px 18px 16px;position:relative}\n.sum h3{font-size:12px;text-transform:uppercase;letter-spacing:.1em;color:rgba(242,244,255,.6);font-weight:500}\n.srow{display:flex;align-items:baseline;justify-content:space-between;gap:12px;padding:8px 0;border-bottom:1px solid rgba(242,244,255,.13);font-size:11.5px}\n.srow span{color:rgba(242,244,255,.58)}\n.srow b{font-weight:600;font-size:11.5px;text-align:right}\n.est{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin:14px 0 14px}\n.est div{background:rgba(242,244,255,.08);padding:9px 10px}\n.est span{display:block;font-size:9.5px;text-transform:uppercase;letter-spacing:.08em;color:rgba(242,244,255,.55)}\n.est b{display:block;font-family:'Share Tech Mono',monospace;font-size:17px;font-weight:400;margin-top:3px}\n.start{display:flex;align-items:center;justify-content:center;gap:8px;width:100%;background:linear-gradient(90deg,#4F46E5,#2563EB);color:#fff;font-size:13px;font-weight:600;padding:11px;border:0;border-radius:6px}\n.sum .micro{font-size:10px;color:rgba(242,244,255,.5);line-height:1.5;margin-top:10px}\n.sum .reset{display:inline-flex;align-items:center;gap:5px;font-size:10.5px;color:rgba(242,244,255,.62);margin-top:12px;border-bottom:1px solid rgba(242,244,255,.28);padding-bottom:1px}\n.sum-badge{position:absolute;top:0;right:0;background:var(--accent);font-size:9.5px;letter-spacing:.08em;text-transform:uppercase;padding:3px 8px;color:#fff}\n\n.side-note{background:#fff;border:1px solid var(--line);padding:14px 16px;margin-top:12px}\n.side-note h4{font-size:11.5px;font-weight:600;display:flex;align-items:center;gap:7px}\n.side-note h4 i{color:var(--accent);font-size:13px}\n.side-note p{font-size:10.5px;color:var(--ink-muted);line-height:1.55;margin-top:6px}\n\n@media (max-width:1024px){\n  .page{grid-template-columns:1fr}\n  .cat-grid{grid-template-columns:1fr}\n  .page-head{flex-direction:column;align-items:flex-start;gap:12px}\n  .anchors{display:none}\n}\n@media (max-width:720px){\n  .wrap{padding:0 16px}\n  .crumb{display:none}\n  .frow{grid-template-columns:1fr;gap:6px;padding:10px 0}\n  .select{min-width:0;width:100%}\n}\n</style>\n<header class=\"appbar\" data-kid=\"1\" data-name=\"app top bar\">\n<div class=\"wrap bar-in\" data-kid=\"1-1\" data-name=\"app bar inner content\">\n<a class=\"brand\" data-kid=\"1-1-1\" data-name=\"brand logo and product name\" href=\"/\"><span class=\"mark\" data-dynamic=\"true\" data-kid=\"1-1-1-1\" data-name=\"brand logo mark\" data-reason=\"children rendered by lucide icon script\"><i data-dynamic=\"true\" data-kid=\"1-1-1-1-1\" data-name=\"logo bar\" data-reason=\"element injected by lucide icon script\"></i><i data-dynamic=\"true\" data-kid=\"1-1-1-1-2\" data-name=\"logo bar\" data-reason=\"element injected by lucide icon script\"></i><i data-dynamic=\"true\" data-kid=\"1-1-1-1-3\" data-name=\"logo bar\" data-reason=\"element injected by lucide icon script\"></i></span>MockMate AI</a>\n<span class=\"crumb\" data-kid=\"1-1-2\" data-name=\"breadcrumb navigation\"><a data-kid=\"1-1-2-1\" data-name=\"breadcrumb Dashboard link\" href=\"/dashboard\">Dashboard</a><i class=\"icon-chevron-right\" data-dynamic=\"true\" data-kid=\"1-1-2-2\" data-name=\"breadcrumb chevron icon\" data-reason=\"element replaced by lucide icon script\"></i><a data-kid=\"1-1-2-3\" data-name=\"breadcrumb Interviews link\" href=\"/dashboard/interviews\">Interviews</a><i class=\"icon-chevron-right\" data-dynamic=\"true\" data-kid=\"1-1-2-4\" data-name=\"breadcrumb chevron icon\" data-reason=\"element replaced by lucide icon script\"></i><b data-kid=\"1-1-2-5\" data-name=\"current page breadcrumb label\">Setup</b></span>\n<div class=\"bar-right\" data-kid=\"1-1-3\" data-name=\"app bar right actions\">\n<span class=\"usage\" data-kid=\"1-1-3-1\" data-name=\"usage plan quota display\">Free plan <b data-kid=\"1-1-3-1-1\" data-name=\"usage count number\">1</b>/3 interviews used</span>\n<span class=\"av\" data-kid=\"1-1-3-2\" data-name=\"user avatar container\"><img alt=\"Profile photo of Ananya Sharma\" data-kid=\"1-1-3-2-1\" data-name=\"user profile photo\" decoding=\"async\" loading=\"lazy\" src=\"https://i.pravatar.cc/72?u=ananya-sharma\"/></span>\n</div>\n</div>\n</header>\n<main class=\"wrap\" data-kid=\"2\" data-name=\"main page content\">\n<div class=\"page-head\" data-kid=\"2-1\" data-name=\"page header\">\n<div data-kid=\"2-1-1\" data-name=\"page title block\">\n<h1 data-kid=\"2-1-1-1\" data-name=\"page headline\">Set up your interview</h1>\n<p data-kid=\"2-1-1-2\" data-name=\"page descriptive subtitle\">Defaults come from your profile. Changes here apply to this session only unless you save them.</p>\n</div>\n<nav class=\"anchors\" data-kid=\"2-1-2\" data-name=\"section anchor navigation\">\n<a class=\"on\" data-kid=\"2-1-2-1\" data-name=\"anchor Category link\" href=\"#category\"><span class=\"n\" data-kid=\"2-1-2-1-1\" data-name=\"anchor step number\">01</span>Category</a>\n<a data-kid=\"2-1-2-2\" data-name=\"anchor Session link\" href=\"#session\"><span class=\"n\" data-kid=\"2-1-2-2-1\" data-name=\"anchor step number\">02</span>Session</a>\n<a data-kid=\"2-1-2-3\" data-name=\"anchor Resume link\" href=\"#resume\"><span class=\"n\" data-kid=\"2-1-2-3-1\" data-name=\"anchor step number\">03</span>Resume</a>\n<a data-kid=\"2-1-2-4\" data-name=\"anchor Start link\" href=\"#start\"><span class=\"n\" data-kid=\"2-1-2-4-1\" data-name=\"anchor step number\">04</span>Start</a>\n</nav>\n</div>\n<div class=\"page\" data-kid=\"2-2\" data-name=\"page two-column layout\">\n<div class=\"panel\" data-kid=\"2-2-1\" data-name=\"settings form panel\">\n<section class=\"f-sec\" data-kid=\"2-2-1-1\" data-name=\"category selection section\" id=\"category\">\n<div class=\"f-head\" data-kid=\"2-2-1-1-1\" data-name=\"section header\"><h2 data-kid=\"2-2-1-1-1-1\" data-name=\"section header title\"><span class=\"n\" data-kid=\"2-2-1-1-1-1-1\" data-name=\"section number badge\">01</span>Interview category</h2><span data-kid=\"2-2-1-1-1-2\" data-name=\"section requirement label\">Required</span></div>\n<div class=\"cat-grid\" data-kid=\"2-2-1-1-2\" data-name=\"category grid\">\n<div class=\"csel on\" data-kid=\"2-2-1-1-2-1\" data-name=\"technical category card\"><i class=\"icon-cpu\" data-dynamic=\"true\" data-kid=\"2-2-1-1-2-1-1\" data-name=\"cpu icon\" data-reason=\"element replaced by lucide icon script\"></i><div data-kid=\"2-2-1-1-2-1-2\" data-name=\"category label wrapper\"><b data-kid=\"2-2-1-1-2-1-2-1\" data-name=\"category name\">Technical</b><em data-kid=\"2-2-1-1-2-1-2-2\" data-name=\"category description\">Branch subjects, fundamentals, projects</em></div><i class=\"icon-check tick\" data-dynamic=\"true\" data-kid=\"2-2-1-1-2-1-3\" data-name=\"selected checkmark icon\" data-reason=\"element replaced by lucide icon script\"></i></div>\n<div class=\"csel\" data-kid=\"2-2-1-1-2-2\" data-name=\"HR category card\"><i class=\"icon-users\" data-dynamic=\"true\" data-kid=\"2-2-1-1-2-2-1\" data-name=\"users icon\" data-reason=\"element replaced by lucide icon script\"></i><div data-kid=\"2-2-1-1-2-2-2\" data-name=\"category label wrapper\"><b data-kid=\"2-2-1-1-2-2-2-1\" data-name=\"category name\">HR</b><em data-kid=\"2-2-1-1-2-2-2-2\" data-name=\"category description\">Motivation, teamwork, salary</em></div><i class=\"icon-check tick\" data-dynamic=\"true\" data-kid=\"2-2-1-1-2-2-3\" data-name=\"selected checkmark icon\" data-reason=\"element replaced by lucide icon script\"></i></div>\n<div class=\"csel\" data-kid=\"2-2-1-1-2-3\" data-name=\"resume category card\"><i class=\"icon-file-text\" data-dynamic=\"true\" data-kid=\"2-2-1-1-2-3-1\" data-name=\"file text icon\" data-reason=\"element replaced by lucide icon script\"></i><div data-kid=\"2-2-1-1-2-3-2\" data-name=\"category label wrapper\"><b data-kid=\"2-2-1-1-2-3-2-1\" data-name=\"category name\">Resume-based</b><em data-kid=\"2-2-1-1-2-3-2-2\" data-name=\"category description\">Built from your uploaded resume</em></div><i class=\"icon-check tick\" data-dynamic=\"true\" data-kid=\"2-2-1-1-2-3-3\" data-name=\"selected checkmark icon\" data-reason=\"element replaced by lucide icon script\"></i></div>\n<div class=\"csel\" data-kid=\"2-2-1-1-2-4\" data-name=\"coding category card\"><i class=\"icon-code\" data-dynamic=\"true\" data-kid=\"2-2-1-1-2-4-1\" data-name=\"code icon\" data-reason=\"element replaced by lucide icon script\"></i><div data-kid=\"2-2-1-1-2-4-2\" data-name=\"category label wrapper\"><b data-kid=\"2-2-1-1-2-4-2-1\" data-name=\"category name\">Coding</b><em data-kid=\"2-2-1-1-2-4-2-2\" data-name=\"category description\">C++, Java, Python, JavaScript</em></div><i class=\"icon-check tick\" data-dynamic=\"true\" data-kid=\"2-2-1-1-2-4-3\" data-name=\"selected checkmark icon\" data-reason=\"element replaced by lucide icon script\"></i></div>\n<div class=\"csel\" data-kid=\"2-2-1-1-2-5\" data-name=\"management category card\"><i class=\"icon-briefcase\" data-dynamic=\"true\" data-kid=\"2-2-1-1-2-5-1\" data-name=\"briefcase icon\" data-reason=\"element replaced by lucide icon script\"></i><div data-kid=\"2-2-1-1-2-5-2\" data-name=\"category label wrapper\"><b data-kid=\"2-2-1-1-2-5-2-1\" data-name=\"category name\">Management</b><em data-kid=\"2-2-1-1-2-5-2-2\" data-name=\"category description\">Marketing, finance, operations</em></div><i class=\"icon-check tick\" data-dynamic=\"true\" data-kid=\"2-2-1-1-2-5-3\" data-name=\"selected checkmark icon\" data-reason=\"element replaced by lucide icon script\"></i></div>\n<div class=\"csel\" data-kid=\"2-2-1-1-2-6\" data-name=\"commerce category card\"><i class=\"icon-calculator\" data-dynamic=\"true\" data-kid=\"2-2-1-1-2-6-1\" data-name=\"calculator icon\" data-reason=\"element replaced by lucide icon script\"></i><div data-kid=\"2-2-1-1-2-6-2\" data-name=\"category label wrapper\"><b data-kid=\"2-2-1-1-2-6-2-1\" data-name=\"category name\">Commerce</b><em data-kid=\"2-2-1-1-2-6-2-2\" data-name=\"category description\">Accounting, taxation, banking</em></div><i class=\"icon-check tick\" data-dynamic=\"true\" data-kid=\"2-2-1-1-2-6-3\" data-name=\"selected checkmark icon\" data-reason=\"element replaced by lucide icon script\"></i></div>\n<div class=\"csel\" data-kid=\"2-2-1-1-2-7\" data-name=\"science category card\"><i class=\"icon-flask-conical\" data-dynamic=\"true\" data-kid=\"2-2-1-1-2-7-1\" data-name=\"flask icon\" data-reason=\"element replaced by lucide icon script\"></i><div data-kid=\"2-2-1-1-2-7-2\" data-name=\"category label wrapper\"><b data-kid=\"2-2-1-1-2-7-2-1\" data-name=\"category name\">Science</b><em data-kid=\"2-2-1-1-2-7-2-2\" data-name=\"category description\">Subject concepts, research method</em></div><i class=\"icon-check tick\" data-dynamic=\"true\" data-kid=\"2-2-1-1-2-7-3\" data-name=\"selected checkmark icon\" data-reason=\"element replaced by lucide icon script\"></i></div>\n<div class=\"csel\" data-kid=\"2-2-1-1-2-8\" data-name=\"law category card\"><i class=\"icon-scale\" data-dynamic=\"true\" data-kid=\"2-2-1-1-2-8-1\" data-name=\"scale icon\" data-reason=\"element replaced by lucide icon script\"></i><div data-kid=\"2-2-1-1-2-8-2\" data-name=\"category label wrapper\"><b data-kid=\"2-2-1-1-2-8-2-1\" data-name=\"category name\">Law</b><em data-kid=\"2-2-1-1-2-8-2-2\" data-name=\"category description\">Legal concepts, case analysis</em></div><i class=\"icon-check tick\" data-dynamic=\"true\" data-kid=\"2-2-1-1-2-8-3\" data-name=\"selected checkmark icon\" data-reason=\"element replaced by lucide icon script\"></i></div>\n<div class=\"csel\" data-kid=\"2-2-1-1-2-9\" data-name=\"medical category card\"><i class=\"icon-stethoscope\" data-dynamic=\"true\" data-kid=\"2-2-1-1-2-9-1\" data-name=\"stethoscope icon\" data-reason=\"element replaced by lucide icon script\"></i><div data-kid=\"2-2-1-1-2-9-2\" data-name=\"category label wrapper\"><b data-kid=\"2-2-1-1-2-9-2-1\" data-name=\"category name\">Medical</b><em data-kid=\"2-2-1-1-2-9-2-2\" data-name=\"category description\">Clinical knowledge, ethics</em></div><i class=\"icon-check tick\" data-dynamic=\"true\" data-kid=\"2-2-1-1-2-9-3\" data-name=\"selected checkmark icon\" data-reason=\"element replaced by lucide icon script\"></i></div>\n<div class=\"csel\" data-kid=\"2-2-1-1-2-10\" data-name=\"general professional category card\"><i class=\"icon-compass\" data-dynamic=\"true\" data-kid=\"2-2-1-1-2-10-1\" data-name=\"compass icon\" data-reason=\"element replaced by lucide icon script\"></i><div data-kid=\"2-2-1-1-2-10-2\" data-name=\"category label wrapper\"><b data-kid=\"2-2-1-1-2-10-2-1\" data-name=\"category name\">General professional</b><em data-kid=\"2-2-1-1-2-10-2-2\" data-name=\"category description\">Any other role or industry</em></div><i class=\"icon-check tick\" data-dynamic=\"true\" data-kid=\"2-2-1-1-2-10-3\" data-name=\"selected checkmark icon\" data-reason=\"element replaced by lucide icon script\"></i></div>\n</div>\n</section>\n<section class=\"f-sec\" data-kid=\"2-2-1-2\" data-name=\"session settings section\" id=\"session\">\n<div class=\"f-head\" data-kid=\"2-2-1-2-1\" data-name=\"section header\"><h2 data-kid=\"2-2-1-2-1-1\" data-name=\"section header title\"><span class=\"n\" data-kid=\"2-2-1-2-1-1-1\" data-name=\"section number badge\">02</span>Session settings</h2><span data-kid=\"2-2-1-2-1-2\" data-name=\"section state label\">Saved as default</span></div>\n<div class=\"frow\" data-kid=\"2-2-1-2-2\" data-name=\"course selection row\">\n<label data-kid=\"2-2-1-2-2-1\" data-name=\"course label\">Course or role</label>\n<div class=\"ctrl\" data-kid=\"2-2-1-2-2-2\" data-name=\"control wrapper\">\n<div class=\"select\" data-kid=\"2-2-1-2-2-2-1\" data-name=\"course dropdown selector\"><span data-kid=\"2-2-1-2-2-2-1-1\" data-name=\"selected course value\">BCA — Computer Applications</span><span class=\"hint\" data-kid=\"2-2-1-2-2-2-1-2\" data-name=\"source hint text\">from profile</span><i class=\"icon-chevron-down\" data-dynamic=\"true\" data-kid=\"2-2-1-2-2-2-1-3\" data-name=\"chevron down icon\" data-reason=\"element replaced by lucide icon script\"></i></div>\n</div>\n</div>\n<div class=\"frow\" data-kid=\"2-2-1-2-3\" data-name=\"difficulty row\">\n<label data-kid=\"2-2-1-2-3-1\" data-name=\"difficulty label\">Difficulty</label>\n<div class=\"ctrl\" data-kid=\"2-2-1-2-3-2\" data-name=\"control wrapper\">\n<div class=\"seg\" data-kid=\"2-2-1-2-3-2-1\" data-name=\"difficulty segmented control\"><span data-kid=\"2-2-1-2-3-2-1-1\" data-name=\"easy option\">Easy</span><span class=\"on\" data-kid=\"2-2-1-2-3-2-1-2\" data-name=\"medium option\">Medium</span><span data-kid=\"2-2-1-2-3-2-1-3\" data-name=\"hard option\">Hard</span></div>\n</div>\n</div>\n<div class=\"frow\" data-kid=\"2-2-1-2-4\" data-name=\"length row\">\n<label data-kid=\"2-2-1-2-4-1\" data-name=\"length label\">Length</label>\n<div class=\"ctrl\" data-kid=\"2-2-1-2-4-2\" data-name=\"control wrapper\">\n<div class=\"seg\" data-kid=\"2-2-1-2-4-2-1\" data-name=\"length segmented control\"><span data-kid=\"2-2-1-2-4-2-1-1\" data-name=\"15 min option\">15 min</span><span class=\"on\" data-kid=\"2-2-1-2-4-2-1-2\" data-name=\"30 min option\">30 min</span><span data-kid=\"2-2-1-2-4-2-1-3\" data-name=\"45 min option\">45 min</span><span data-kid=\"2-2-1-2-4-2-1-4\" data-name=\"60 min option\">60 min</span></div>\n</div>\n</div>\n<div class=\"frow\" data-kid=\"2-2-1-2-5\" data-name=\"interviewer row\">\n<label data-kid=\"2-2-1-2-5-1\" data-name=\"interviewer label\">Interviewer</label>\n<div class=\"ctrl\" data-kid=\"2-2-1-2-5-2\" data-name=\"control wrapper\">\n<div class=\"chips\" data-kid=\"2-2-1-2-5-2-1\" data-name=\"interviewer chips\">\n<span class=\"fchip\" data-kid=\"2-2-1-2-5-2-1-1\" data-name=\"friendly chip\">Friendly</span><span class=\"fchip\" data-kid=\"2-2-1-2-5-2-1-2\" data-name=\"professional chip\">Professional</span><span class=\"fchip\" data-kid=\"2-2-1-2-5-2-1-3\" data-name=\"strict chip\">Strict</span><span class=\"fchip on\" data-kid=\"2-2-1-2-5-2-1-4\" data-name=\"technical expert chip\">Technical Expert</span><span class=\"fchip\" data-kid=\"2-2-1-2-5-2-1-5\" data-name=\"HR specialist chip\">HR Specialist</span><span class=\"fchip\" data-kid=\"2-2-1-2-5-2-1-6\" data-name=\"hiring manager chip\">Hiring Manager</span>\n</div>\n</div>\n</div>\n<div class=\"frow\" data-kid=\"2-2-1-2-6\" data-name=\"language row\">\n<label data-kid=\"2-2-1-2-6-1\" data-name=\"language label\">Language</label>\n<div class=\"ctrl\" data-kid=\"2-2-1-2-6-2\" data-name=\"language control wrapper\">\n<div class=\"chips\" data-kid=\"2-2-1-2-6-2-1\" data-name=\"language chips\">\n<span class=\"fchip on\" data-kid=\"2-2-1-2-6-2-1-1\" data-name=\"English chip\">English</span><span class=\"fchip\" data-kid=\"2-2-1-2-6-2-1-2\" data-name=\"Hindi chip\">हिन्दी</span><span class=\"fchip\" data-kid=\"2-2-1-2-6-2-1-3\" data-name=\"Hinglish chip\">Hinglish</span><span class=\"fchip\" data-kid=\"2-2-1-2-6-2-1-4\" data-name=\"Bangla chip\">বাংলা</span><span class=\"fchip\" data-kid=\"2-2-1-2-6-2-1-5\" data-name=\"Tamil chip\">தமிழ்</span><span class=\"fchip\" data-kid=\"2-2-1-2-6-2-1-6\" data-name=\"Telugu chip\">తెలుగు</span><span class=\"fchip\" data-kid=\"2-2-1-2-6-2-1-7\" data-name=\"Marathi chip\">मराठी</span><span class=\"fchip\" data-kid=\"2-2-1-2-6-2-1-8\" data-name=\"Gujarati chip\">ગુજરાતી</span><span class=\"fchip\" data-kid=\"2-2-1-2-6-2-1-9\" data-name=\"Kannada chip\">ಕನ್ನಡ</span><span class=\"fchip\" data-kid=\"2-2-1-2-6-2-1-10\" data-name=\"Malayalam chip\">മലയാളം</span><span class=\"fchip\" data-kid=\"2-2-1-2-6-2-1-11\" data-name=\"Punjabi chip\">ਪੰਜਾਬੀ</span>\n</div>\n<p class=\"helper\" data-kid=\"2-2-1-2-6-2-2\" data-name=\"language helper text\">Questions, follow-ups and the report use this language. Speech availability differs by language; typed answers work in all 11.</p>\n</div>\n</div>\n<div class=\"frow\" data-kid=\"2-2-1-2-7\" data-name=\"answer mode row\">\n<label data-kid=\"2-2-1-2-7-1\" data-name=\"answer mode label\">Answer mode</label>\n<div class=\"ctrl\" data-kid=\"2-2-1-2-7-2\" data-name=\"control wrapper\">\n<div class=\"seg\" data-kid=\"2-2-1-2-7-2-1\" data-name=\"mode segmented control\"><span class=\"on\" data-kid=\"2-2-1-2-7-2-1-1\" data-name=\"voice option\"><i class=\"icon-mic\" data-dynamic=\"true\" data-kid=\"2-2-1-2-7-2-1-1-1\" data-name=\"mic icon\" data-reason=\"element replaced by lucide icon script\" style=\"font-size:12px;margin-right:5px\"></i>Voice</span><span data-kid=\"2-2-1-2-7-2-1-2\" data-name=\"text option\">Text</span></div>\n<span class=\"helper\" data-kid=\"2-2-1-2-7-2-2\" data-name=\"mode helper text\" style=\"margin:0\">Microphone access is requested when the session starts.</span>\n</div>\n</div>\n<div class=\"frow\" data-kid=\"2-2-1-2-8\" data-name=\"coding round row\">\n<label data-kid=\"2-2-1-2-8-1\" data-name=\"coding round label\">Coding round</label>\n<div class=\"ctrl\" data-kid=\"2-2-1-2-8-2\" data-name=\"control wrapper\">\n<span class=\"tgl-row\" data-kid=\"2-2-1-2-8-2-1\" data-name=\"toggle with status\"><span class=\"toggle off\" data-kid=\"2-2-1-2-8-2-1-1\" data-name=\"off toggle switch\"><i data-kid=\"2-2-1-2-8-2-1-1-1\" data-name=\"toggle knob\"></i></span>Off for this session</span>\n<span class=\"helper\" data-kid=\"2-2-1-2-8-2-2\" data-name=\"coding round helper text\" style=\"margin:0\">Available for Technical and Coding categories.</span>\n</div>\n</div>\n</section>\n<section class=\"f-sec\" data-kid=\"2-2-1-3\" data-name=\"resume section\" id=\"resume\">\n<div class=\"f-head\" data-kid=\"2-2-1-3-1\" data-name=\"section header\"><h2 data-kid=\"2-2-1-3-1-1\" data-name=\"section header title\"><span class=\"n\" data-kid=\"2-2-1-3-1-1-1\" data-name=\"section number badge\">03</span>Resume</h2><span data-kid=\"2-2-1-3-1-2\" data-name=\"section requirement label\">Optional</span></div>\n<div class=\"file\" data-kid=\"2-2-1-3-2\" data-name=\"uploaded file display\">\n<span class=\"fi\" data-kid=\"2-2-1-3-2-1\" data-name=\"file icon container\"><i class=\"icon-file-text\" data-dynamic=\"true\" data-kid=\"2-2-1-3-2-1-1\" data-name=\"file text icon\" data-reason=\"element replaced by lucide icon script\"></i></span>\n<div data-kid=\"2-2-1-3-2-2\" data-name=\"file info wrapper\">\n<b data-kid=\"2-2-1-3-2-2-1\" data-name=\"file name\">Resume_Ananya_BCA.pdf</b>\n<span data-kid=\"2-2-1-3-2-2-2\" data-name=\"file metadata\">2 pages · 148 KB · parsed 8 Nov 2026</span>\n</div>\n<span class=\"acts\" data-kid=\"2-2-1-3-2-3\" data-name=\"file action links\"><a data-kid=\"2-2-1-3-2-3-1\" data-name=\"replace file link\" href=\"#\">Replace</a><a data-kid=\"2-2-1-3-2-3-2\" data-name=\"remove file link\" href=\"#\">Remove</a></span>\n</div>\n<div class=\"checkrow\" data-kid=\"2-2-1-3-3\" data-name=\"use resume checkbox row\"><span class=\"box\" data-kid=\"2-2-1-3-3-1\" data-name=\"checked checkbox\"><i class=\"icon-check\" data-dynamic=\"true\" data-kid=\"2-2-1-3-3-1-1\" data-name=\"checkmark icon\" data-reason=\"element replaced by lucide icon script\"></i></span>Use this resume for question generation</div>\n</section>\n</div>\n<aside data-kid=\"2-2-2\" data-name=\"session summary sidebar\">\n<div class=\"sum\" data-kid=\"2-2-2-1\" data-name=\"summary card\">\n<span class=\"sum-badge\" data-kid=\"2-2-2-1-1\" data-name=\"draft status badge\">Draft</span>\n<h3 data-kid=\"2-2-2-1-2\" data-name=\"summary heading\">Session summary</h3>\n<div class=\"srow\" data-kid=\"2-2-2-1-3\" data-name=\"category summary row\"><span data-kid=\"2-2-2-1-3-1\" data-name=\"row label\">Category</span><b data-kid=\"2-2-2-1-3-2\" data-name=\"row value\">Technical</b></div>\n<div class=\"srow\" data-kid=\"2-2-2-1-4\" data-name=\"course summary row\"><span data-kid=\"2-2-2-1-4-1\" data-name=\"row label\">Course</span><b data-kid=\"2-2-2-1-4-2\" data-name=\"row value\">BCA — Computer Applications</b></div>\n<div class=\"srow\" data-kid=\"2-2-2-1-5\" data-name=\"difficulty summary row\"><span data-kid=\"2-2-2-1-5-1\" data-name=\"row label\">Difficulty</span><b data-kid=\"2-2-2-1-5-2\" data-name=\"row value\">Medium</b></div>\n<div class=\"srow\" data-kid=\"2-2-2-1-6\" data-name=\"length summary row\"><span data-kid=\"2-2-2-1-6-1\" data-name=\"row label\">Length</span><b data-kid=\"2-2-2-1-6-2\" data-name=\"row value\">30 min</b></div>\n<div class=\"srow\" data-kid=\"2-2-2-1-7\" data-name=\"interviewer summary row\"><span data-kid=\"2-2-2-1-7-1\" data-name=\"row label\">Interviewer</span><b data-kid=\"2-2-2-1-7-2\" data-name=\"row value\">Technical Expert</b></div>\n<div class=\"srow\" data-kid=\"2-2-2-1-8\" data-name=\"language summary row\"><span data-kid=\"2-2-2-1-8-1\" data-name=\"row label\">Language</span><b data-kid=\"2-2-2-1-8-2\" data-name=\"row value\">English</b></div>\n<div class=\"srow\" data-kid=\"2-2-2-1-9\" data-name=\"answer mode summary row\"><span data-kid=\"2-2-2-1-9-1\" data-name=\"row label\">Answer mode</span><b data-kid=\"2-2-2-1-9-2\" data-name=\"row value\">Voice</b></div>\n<div class=\"srow\" data-kid=\"2-2-2-1-10\" data-name=\"resume summary row\" style=\"border-bottom:0\"><span data-kid=\"2-2-2-1-10-1\" data-name=\"row label\">Resume</span><b data-kid=\"2-2-2-1-10-2\" data-name=\"row value\">Resume_Ananya_BCA.pdf</b></div>\n<div class=\"est\" data-kid=\"2-2-2-1-11\" data-name=\"estimates row\">\n<div data-kid=\"2-2-2-1-11-1\" data-name=\"questions estimate card\"><span data-kid=\"2-2-2-1-11-1-1\" data-name=\"estimate label\">Questions</span><b data-kid=\"2-2-2-1-11-1-2\" data-name=\"estimate value\">12</b></div>\n<div data-kid=\"2-2-2-1-11-2\" data-name=\"rubric estimate card\"><span data-kid=\"2-2-2-1-11-2-1\" data-name=\"estimate label\">Rubric</span><b data-kid=\"2-2-2-1-11-2-2\" data-name=\"estimate value\">BCA</b></div>\n</div>\n<a class=\"start\" data-kid=\"2-2-2-1-12\" data-name=\"start interview call-to-action\" href=\"/interview/session/sess_8f21\" id=\"start\"><i class=\"icon-mic\" data-dynamic=\"true\" data-kid=\"2-2-2-1-12-1\" data-name=\"mic icon\" data-reason=\"element replaced by lucide icon script\"></i>Start interview</a>\n<p class=\"micro\" data-kid=\"2-2-2-1-13\" data-name=\"microprint disclaimer\">Saved at every answer. You can leave and reopen the session from Interviews.</p>\n<a class=\"reset\" data-kid=\"2-2-2-1-14\" data-name=\"reset defaults link\" href=\"#\"><i class=\"icon-rotate-ccw\" data-dynamic=\"true\" data-kid=\"2-2-2-1-14-1\" data-name=\"rotate counter-clockwise icon\" data-reason=\"element replaced by lucide icon script\"></i>Reset to profile defaults</a>\n</div>\n<div class=\"side-note\" data-kid=\"2-2-2-2\" data-name=\"language note card\">\n<h4 data-kid=\"2-2-2-2-1\" data-name=\"note heading\"><i class=\"icon-languages\" data-dynamic=\"true\" data-kid=\"2-2-2-2-1-1\" data-name=\"languages icon\" data-reason=\"element replaced by lucide icon script\"></i>Reports follow the language</h4>\n<p data-kid=\"2-2-2-2-2\" data-name=\"note body text\">Scores, missed concepts and suggested answers are written in the language picked for the session.</p>\n</div>\n</aside>\n</div>\n</main>",
      "comments": [],
      "created": "2026-11-10T15:16:22.073497+00:00",
      "modified": "2026-11-10T15:20:52.211148+00:00",
      "id": "var_330806d5007d",
      "contentHeight": 1205
    },
    "var_a75ba1c90a9b": {
      "type": "variant",
      "label": "Interview Setup — V2 Risograph",
      "parentId": "var_330806d5007d",
      "themeId": null,
      "rect": {
        "x": 4140,
        "y": 0,
        "w": 1280,
        "h": 0
      },
      "html": "<style>\n@import url('https://fonts.googleapis.com/css2?family=Cardo:ital,wght@0,400;0,700;1,400&family=Albert+Sans:wght@400;500;600;700&display=swap');\n@import url(\"https://cdn.jsdelivr.net/npm/@phosphor-icons/web@2.1.2/src/regular/style.css\");\n:root{\n  --peach:#FEBE9B; --shell:#F8EDE8; --cream:#FBF4F0; --ink:#1D1411; --ink70:rgba(29,20,17,.72); --ink50:rgba(29,20,17,.5);\n  --coral:#FE8B65; --gold:#F1C160; --indigo:#4F46E5; --soft:rgba(29,20,17,.16);\n}\n*{box-sizing:border-box}\nbody{margin:0;background:var(--cream);color:var(--ink);font-family:'Albert Sans',system-ui,sans-serif;-webkit-font-smoothing:antialiased;font-size:14px}\nh1,h2,h3,h4,p,ul{margin:0;padding:0}ul{list-style:none}\na{text-decoration:none;color:inherit}\n.serif{font-family:'Cardo',Georgia,serif;font-weight:400}\n.wrap{max-width:1200px;margin:0 auto;padding:0 30px}\n\n/* header */\n.topbar{background:var(--shell);border-bottom:1px solid var(--soft)}\n.top-in{height:64px;display:flex;align-items:center;gap:24px}\n.brand{display:flex;align-items:center;gap:9px;font-size:16px;font-weight:700;letter-spacing:-.02em}\n.dot{position:relative;width:22px;height:22px}\n.dot i{position:absolute;width:17px;height:17px;border-radius:50%;border:1.4px solid var(--ink)}\n.dot i:first-child{left:0;top:0;background:var(--coral)}\n.dot i:last-child{right:0;bottom:0;background:var(--gold);mix-blend-mode:multiply}\n.top-nav{display:flex;gap:6px;margin-left:8px;font-size:13px}\n.top-nav a{padding:6px 12px;border-radius:999px;color:var(--ink70)}\n.top-nav a.on{background:var(--ink);color:var(--shell);font-weight:600}\n.top-right{margin-left:auto;display:flex;align-items:center;gap:12px}\n.quota{font-size:11.5px;color:var(--ink70);border:1px solid var(--soft);border-radius:999px;padding:5px 11px;background:#fff}\n.av{width:30px;height:30px;border-radius:50%;overflow:hidden;border:1px solid rgba(29,20,17,.28)}\n.av img{width:100%;height:100%;object-fit:cover;display:block}\n\n/* band */\n.band{background:var(--peach);padding:26px 0 88px;position:relative;overflow:hidden}\n.band-in{display:flex;align-items:flex-start;justify-content:space-between;gap:36px}\n.band h1{font-size:42px;line-height:1.05;letter-spacing:-.02em}\n.band p{font-size:13.5px;color:var(--ink70);margin-top:8px;max-width:400px;line-height:1.55}\n.profile-chip{background:rgba(248,237,232,.72);border:1px solid rgba(29,20,17,.2);border-radius:14px;padding:12px 16px;display:flex;align-items:center;gap:10px;flex:none}\n.profile-chip i{font-size:18px}\n.profile-chip b{display:block;font-size:12.5px}\n.profile-chip span{display:block;font-size:11px;color:var(--ink70)}\n.reg{position:absolute;width:16px;height:16px;opacity:.4}\n.reg::before,.reg::after{content:\"\";position:absolute;background:var(--ink)}\n.reg::before{left:0;top:50%;width:100%;height:1px}\n.reg::after{top:0;left:50%;height:100%;width:1px}\n.reg.a{right:30px;bottom:96px}\n.reg.b{left:30px;bottom:70px}\n\n/* main */\n.main{background:var(--cream);margin-top:-66px;padding-bottom:46px;position:relative;z-index:3}\n.grid{display:grid;grid-template-columns:minmax(0,1fr) 336px;gap:20px;align-items:start}\n.card{background:#fff;border:1px solid var(--soft);border-radius:18px;box-shadow:5px 5px 0 rgba(29,20,17,.07);padding:20px 22px 22px;margin-bottom:14px}\n.card-head{display:flex;align-items:baseline;justify-content:space-between;gap:14px;margin-bottom:13px}\n.card-head h2{font-size:19px;letter-spacing:-.01em}\n.card-head span{font-size:10.5px;letter-spacing:.08em;text-transform:uppercase;color:var(--ink50);font-weight:600}\n\n/* category */\n.ctiles{display:grid;grid-template-columns:1fr 1fr;gap:7px}\n.ctile{border:1px solid rgba(29,20,17,.14);border-radius:12px;padding:10px 12px;display:grid;grid-template-columns:15px 1fr 12px;gap:9px;align-items:center;background:rgba(248,237,232,.4)}\n.ctile i{font-size:14px;color:var(--ink70)}\n.ctile b{font-size:12.5px;font-weight:600}\n.ctile em{display:block;font-style:normal;font-size:10.5px;color:var(--ink70);margin-top:1px}\n.ctile .ck{opacity:0;color:var(--gold);font-size:13px}\n.ctile.on{background:var(--ink);border-color:var(--ink)}\n.ctile.on b{color:var(--shell)}\n.ctile.on em{color:rgba(248,237,232,.6)}\n.ctile.on i{color:var(--gold)}\n.ctile.on .ck{opacity:1}\n\n/* persona + language */\n.pwrap{display:flex;flex-wrap:wrap;gap:6px}\n.pchip{font-size:12px;padding:7px 13px;border-radius:999px;border:1px solid rgba(29,20,17,.2);color:var(--ink70)}\n.pchip.on{background:var(--coral);border-color:var(--coral);color:var(--ink);font-weight:600}\n.persona-note{margin-top:11px;background:rgba(254,190,155,.34);border:1px solid rgba(29,20,17,.14);border-radius:12px;padding:11px 14px;font-size:11.5px;color:var(--ink70);line-height:1.5}\n.persona-note b{color:var(--ink);font-weight:600}\n.lchips{display:flex;flex-wrap:wrap;gap:5px;margin-top:4px}\n.lchip{font-size:11.5px;padding:5px 10px;border-radius:999px;border:1px solid rgba(29,20,17,.18);color:var(--ink70)}\n.lchip.on{background:var(--ink);border-color:var(--ink);color:var(--shell)}\n.divider{height:1px;background:rgba(29,20,17,.12);margin:14px 0}\n.sub-h{font-size:12px;font-weight:600;display:flex;align-items:center;gap:7px}\n.sub-h i{font-size:14px;color:var(--ink70)}\n\n/* session */\n.diff{display:grid;grid-template-columns:repeat(3,1fr);gap:7px}\n.dtile{border:1px solid rgba(29,20,17,.16);border-radius:12px;padding:10px 12px;background:rgba(248,237,232,.4)}\n.dtile b{font-size:12.5px;font-weight:600;display:block}\n.dtile span{display:block;font-size:10.5px;color:var(--ink70);margin-top:3px;line-height:1.4}\n.dtile.on{background:rgba(241,193,96,.42);border-color:var(--gold)}\n.rows{margin-top:14px}\n.row{display:grid;grid-template-columns:110px 1fr;gap:14px;align-items:center;padding:9px 0;border-top:1px dashed rgba(29,20,17,.16)}\n.row > label{font-size:12px;color:var(--ink70)}\n.pcaps{display:flex;gap:5px;flex-wrap:wrap}\n.pcap{font-size:11.5px;padding:5px 11px;border-radius:999px;border:1px solid rgba(29,20,17,.18);color:var(--ink70)}\n.pcap.on{background:var(--ink);border-color:var(--ink);color:var(--shell);font-weight:600}\n\n/* resume */\n.drop{border:1.5px dashed rgba(29,20,17,.3);border-radius:14px;padding:16px;background:rgba(248,237,232,.55);display:flex;align-items:center;gap:13px}\n.drop .ic{width:38px;height:38px;border-radius:10px;background:rgba(254,139,101,.28);display:flex;align-items:center;justify-content:center;font-size:18px;color:var(--ink);flex:none}\n.drop b{font-size:12.5px;display:block}\n.drop span{font-size:11px;color:var(--ink70);display:block;margin-top:2px}\n.drop .act{margin-left:auto;font-size:11.5px;font-weight:600;border-bottom:1.5px solid rgba(29,20,17,.35);padding-bottom:1px}\n.usefile{display:flex;align-items:center;gap:8px;font-size:11.5px;color:var(--ink70);margin-top:10px}\n.cbx{width:15px;height:15px;border-radius:4px;background:var(--indigo);color:#fff;display:flex;align-items:center;justify-content:center;font-size:10px}\n\n/* ticket */\n.ticket{background:var(--peach);border:1px solid rgba(29,20,17,.22);border-radius:20px;box-shadow:7px 7px 0 rgba(29,20,17,.11);overflow:hidden}\n.tk-head{display:flex;align-items:center;gap:10px;padding:16px 18px;border-bottom:1px dashed rgba(29,20,17,.28)}\n.tk-head .pic{width:38px;height:38px;border-radius:50%;overflow:hidden;border:1.5px solid var(--ink);flex:none;background:var(--coral)}\n.tk-head .pic img{width:100%;height:100%;object-fit:cover;display:block}\n.tk-head b{display:block;font-size:13px;font-weight:700}\n.tk-head span{display:block;font-size:10.5px;color:var(--ink70);margin-top:2px}\n.tk-body{padding:14px 18px 16px}\n.tk-row{display:flex;align-items:baseline;justify-content:space-between;gap:12px;font-size:11.5px;padding:6px 0;border-bottom:1px solid rgba(29,20,17,.12)}\n.tk-row:last-of-type{border-bottom:0}\n.tk-row span{color:var(--ink70)}\n.tk-row b{font-weight:600;text-align:right;font-size:11.5px}\n.tk-notes{display:flex;gap:8px;margin:10px 0 14px}\n.tk-note{flex:1;background:rgba(248,237,232,.66);border:1px solid rgba(29,20,17,.14);border-radius:10px;padding:8px 10px}\n.tk-note span{display:block;font-size:9.5px;letter-spacing:.07em;text-transform:uppercase;color:var(--ink50)}\n.tk-note b{display:block;font-family:'Cardo',Georgia,serif;font-size:17px;margin-top:2px}\n.cta{display:flex;align-items:center;justify-content:center;gap:8px;background:var(--indigo);color:#fff;font-size:13px;font-weight:600;padding:12px;border-radius:999px;box-shadow:3px 3px 0 rgba(29,20,17,.22)}\n.tk-foot{padding:12px 18px 16px;border-top:1px dashed rgba(29,20,17,.28);background:rgba(248,237,232,.35)}\n.tk-foot p{font-size:10.5px;line-height:1.5;color:var(--ink70)}\n.tk-foot a{font-size:10.5px;font-weight:600;border-bottom:1px solid rgba(29,20,17,.4);display:inline-flex;align-items:center;gap:5px;margin-top:9px}\n.side-note{background:#fff;border:1px solid var(--soft);border-radius:16px;padding:15px 17px;margin-top:14px;box-shadow:4px 4px 0 rgba(29,20,17,.06)}\n.side-note h4{font-size:12.5px;font-weight:600;display:flex;align-items:center;gap:7px}\n.side-note h4 i{font-size:15px;color:var(--coral)}\n.side-note p{font-size:11px;color:var(--ink70);line-height:1.55;margin-top:6px}\n\n@media (max-width:1024px){\n  .grid{grid-template-columns:1fr}\n  .band-in{flex-direction:column;gap:16px}\n  .ctiles{grid-template-columns:1fr}\n  .diff{grid-template-columns:1fr}\n}\n@media (max-width:720px){\n  .wrap{padding:0 18px}\n  .top-nav{display:none}\n  .band h1{font-size:30px}\n  .row{grid-template-columns:1fr;gap:5px}\n  .main{margin-top:-50px}\n}\n</style>\n<header class=\"topbar\" data-kid=\"1\" data-name=\"top header bar\">\n<div class=\"wrap top-in\" data-kid=\"1-1\" data-name=\"page header content container\">\n<a class=\"brand\" data-kid=\"1-1-1\" data-name=\"MockMate AI brand logo link\" href=\"/\"><span class=\"dot\" data-kid=\"1-1-1-1\" data-name=\"overlapping dots logo mark\"><i data-kid=\"1-1-1-1-1\" data-name=\"coral circle logo dot\"></i><i data-kid=\"1-1-1-1-2\" data-name=\"gold circle logo dot\"></i></span>MockMate AI</a>\n<nav class=\"top-nav\" data-kid=\"1-1-2\" data-name=\"main navigation menu\">\n<a data-kid=\"1-1-2-1\" data-name=\"dashboard nav link\" href=\"/dashboard\">Dashboard</a>\n<a class=\"on\" data-kid=\"1-1-2-2\" data-name=\"active interviews nav link\" href=\"/dashboard/interviews\">Interviews</a>\n<a data-kid=\"1-1-2-3\" data-name=\"progress nav link\" href=\"/dashboard/progress\">Progress</a>\n<a data-kid=\"1-1-2-4\" data-name=\"resume nav link\" href=\"/dashboard/resume\">Resume</a>\n</nav>\n<div class=\"top-right\" data-kid=\"1-1-3\" data-name=\"top-right account area\">\n<span class=\"quota\" data-kid=\"1-1-3-1\" data-name=\"interview quota badge\">Starter plan: 14 of 20 left</span>\n<span class=\"av\" data-kid=\"1-1-3-2\" data-name=\"user avatar frame\"><img alt=\"Profile photo of Rohit Menon\" data-kid=\"1-1-3-2-1\" data-name=\"user profile photo\" decoding=\"async\" loading=\"lazy\" src=\"https://i.pravatar.cc/72?u=rohit-menon\"/></span>\n</div>\n</div>\n</header>\n<section class=\"band\" data-kid=\"2\" data-name=\"page title band\">\n<span class=\"reg a\" data-kid=\"2-1\" data-name=\"decorative registration mark top\"></span><span class=\"reg b\" data-kid=\"2-2\" data-name=\"decorative registration mark bottom\"></span>\n<div class=\"wrap band-in\" data-kid=\"2-3\" data-name=\"title band content container\">\n<div data-kid=\"2-3-1\" data-name=\"page title block\">\n<h1 class=\"serif\" data-kid=\"2-3-1-1\" data-name=\"set up interview headline\">Set up an interview</h1>\n<p data-kid=\"2-3-1-2\" data-name=\"profile prefill explanation text\">Pulled from your profile. Anything you change here stays for the next session too.</p>\n</div>\n<div class=\"profile-chip\" data-kid=\"2-3-2\" data-name=\"education profile chip\">\n<i class=\"ph ph-graduation-cap\" data-kid=\"2-3-2-1\" data-name=\"graduation cap icon\"></i>\n<div data-kid=\"2-3-2-2\" data-name=\"profile education details\"><b data-kid=\"2-3-2-2-1\" data-name=\"degree and year label\">B.Com, Final year</b><span data-kid=\"2-3-2-2-2\" data-name=\"college and city text\">Maharaja College · Kochi</span></div>\n</div>\n</div>\n</section>\n<main class=\"main\" data-kid=\"3\" data-name=\"main configuration area\">\n<div class=\"wrap grid\" data-kid=\"3-1\" data-name=\"two column layout grid\">\n<div data-kid=\"3-1-1\" data-name=\"configuration cards column\">\n<div class=\"card\" data-kid=\"3-1-1-1\" data-name=\"interview category card\">\n<div class=\"card-head\" data-kid=\"3-1-1-1-1\" data-name=\"category card header\"><h2 class=\"serif\" data-kid=\"3-1-1-1-1-1\" data-name=\"category section heading\">Category</h2><span data-kid=\"3-1-1-1-1-2\" data-name=\"pick one hint label\">Pick one</span></div>\n<div class=\"ctiles\" data-kid=\"3-1-1-1-2\" data-name=\"category tile grid\">\n<div class=\"ctile\" data-kid=\"3-1-1-1-2-1\" data-name=\"technical category tile\"><i class=\"ph ph-desktop\" data-kid=\"3-1-1-1-2-1-1\" data-name=\"desktop icon\"></i><div data-kid=\"3-1-1-1-2-1-2\" data-name=\"technical tile text block\"><b data-kid=\"3-1-1-1-2-1-2-1\" data-name=\"technical category label\">Technical</b><em data-kid=\"3-1-1-1-2-1-2-2\" data-name=\"technical category description\">Branch subjects and projects</em></div><i class=\"ph ph-check ck\" data-kid=\"3-1-1-1-2-1-3\" data-name=\"technical selected checkmark icon\"></i></div>\n<div class=\"ctile\" data-kid=\"3-1-1-1-2-2\" data-name=\"HR category tile\"><i class=\"ph ph-users\" data-kid=\"3-1-1-1-2-2-1\" data-name=\"users icon\"></i><div data-kid=\"3-1-1-1-2-2-2\" data-name=\"HR tile text block\"><b data-kid=\"3-1-1-1-2-2-2-1\" data-name=\"HR category label\">HR</b><em data-kid=\"3-1-1-1-2-2-2-2\" data-name=\"HR category description\">Motivation, teamwork, salary</em></div><i class=\"ph ph-check ck\" data-kid=\"3-1-1-1-2-2-3\" data-name=\"HR checkmark icon\"></i></div>\n<div class=\"ctile\" data-kid=\"3-1-1-1-2-3\" data-name=\"resume-based category tile\"><i class=\"ph ph-file-text\" data-kid=\"3-1-1-1-2-3-1\" data-name=\"file text icon\"></i><div data-kid=\"3-1-1-1-2-3-2\" data-name=\"resume-based tile text block\"><b data-kid=\"3-1-1-1-2-3-2-1\" data-name=\"resume-based category label\">Resume-based</b><em data-kid=\"3-1-1-1-2-3-2-2\" data-name=\"resume-based category description\">From your uploaded resume</em></div><i class=\"ph ph-check ck\" data-kid=\"3-1-1-1-2-3-3\" data-name=\"resume-based checkmark icon\"></i></div>\n<div class=\"ctile\" data-kid=\"3-1-1-1-2-4\" data-name=\"coding category tile\"><i class=\"ph ph-code\" data-kid=\"3-1-1-1-2-4-1\" data-name=\"code icon\"></i><div data-kid=\"3-1-1-1-2-4-2\" data-name=\"coding tile text block\"><b data-kid=\"3-1-1-1-2-4-2-1\" data-name=\"coding category label\">Coding</b><em data-kid=\"3-1-1-1-2-4-2-2\" data-name=\"coding category description\">Four languages, test cases</em></div><i class=\"ph ph-check ck\" data-kid=\"3-1-1-1-2-4-3\" data-name=\"coding checkmark icon\"></i></div>\n<div class=\"ctile\" data-kid=\"3-1-1-1-2-5\" data-name=\"management category tile\"><i class=\"ph ph-briefcase\" data-kid=\"3-1-1-1-2-5-1\" data-name=\"briefcase icon\"></i><div data-kid=\"3-1-1-1-2-5-2\" data-name=\"management tile text block\"><b data-kid=\"3-1-1-1-2-5-2-1\" data-name=\"management category label\">Management</b><em data-kid=\"3-1-1-1-2-5-2-2\" data-name=\"management category description\">Marketing, finance, cases</em></div><i class=\"ph ph-check ck\" data-kid=\"3-1-1-1-2-5-3\" data-name=\"management checkmark icon\"></i></div>\n<div class=\"ctile on\" data-kid=\"3-1-1-1-2-6\" data-name=\"selected commerce category tile\"><i class=\"ph ph-calculator\" data-kid=\"3-1-1-1-2-6-1\" data-name=\"calculator icon\"></i><div data-kid=\"3-1-1-1-2-6-2\" data-name=\"commerce tile text block\"><b data-kid=\"3-1-1-1-2-6-2-1\" data-name=\"commerce category label\">Commerce</b><em data-kid=\"3-1-1-1-2-6-2-2\" data-name=\"commerce category description\">Accounting, taxation, banking</em></div><i class=\"ph ph-check ck\" data-kid=\"3-1-1-1-2-6-3\" data-name=\"commerce selected checkmark icon\"></i></div>\n<div class=\"ctile\" data-kid=\"3-1-1-1-2-7\" data-name=\"science category tile\"><i class=\"ph ph-flask\" data-kid=\"3-1-1-1-2-7-1\" data-name=\"flask icon\"></i><div data-kid=\"3-1-1-1-2-7-2\" data-name=\"science tile text block\"><b data-kid=\"3-1-1-1-2-7-2-1\" data-name=\"science category label\">Science</b><em data-kid=\"3-1-1-1-2-7-2-2\" data-name=\"science category description\">Concepts and lab practice</em></div><i class=\"ph ph-check ck\" data-kid=\"3-1-1-1-2-7-3\" data-name=\"science checkmark icon\"></i></div>\n<div class=\"ctile\" data-kid=\"3-1-1-1-2-8\" data-name=\"law category tile\"><i class=\"ph ph-scales\" data-kid=\"3-1-1-1-2-8-1\" data-name=\"scales icon\"></i><div data-kid=\"3-1-1-1-2-8-2\" data-name=\"law tile text block\"><b data-kid=\"3-1-1-1-2-8-2-1\" data-name=\"law category label\">Law</b><em data-kid=\"3-1-1-1-2-8-2-2\" data-name=\"law category description\">Case analysis and reasoning</em></div><i class=\"ph ph-check ck\" data-kid=\"3-1-1-1-2-8-3\" data-name=\"law checkmark icon\"></i></div>\n<div class=\"ctile\" data-kid=\"3-1-1-1-2-9\" data-name=\"medical category tile\"><i class=\"ph ph-stethoscope\" data-kid=\"3-1-1-1-2-9-1\" data-name=\"stethoscope icon\"></i><div data-kid=\"3-1-1-1-2-9-2\" data-name=\"medical tile text block\"><b data-kid=\"3-1-1-1-2-9-2-1\" data-name=\"medical category label\">Medical</b><em data-kid=\"3-1-1-1-2-9-2-2\" data-name=\"medical category description\">Clinical scenarios and ethics</em></div><i class=\"ph ph-check ck\" data-kid=\"3-1-1-1-2-9-3\" data-name=\"medical checkmark icon\"></i></div>\n<div class=\"ctile\" data-kid=\"3-1-1-1-2-10\" data-name=\"general category tile\"><i class=\"ph ph-compass\" data-kid=\"3-1-1-1-2-10-1\" data-name=\"compass icon\"></i><div data-kid=\"3-1-1-1-2-10-2\" data-name=\"general tile text block\"><b data-kid=\"3-1-1-1-2-10-2-1\" data-name=\"general category label\">General</b><em data-kid=\"3-1-1-1-2-10-2-2\" data-name=\"general category description\">Any other role or industry</em></div><i class=\"ph ph-check ck\" data-kid=\"3-1-1-1-2-10-3\" data-name=\"general checkmark icon\"></i></div>\n</div>\n</div>\n<div class=\"card\" data-kid=\"3-1-1-2\" data-name=\"interviewer and language card\">\n<div class=\"card-head\" data-kid=\"3-1-1-2-1\" data-name=\"interviewer language card header\"><h2 class=\"serif\" data-kid=\"3-1-1-2-1-1\" data-name=\"interviewer language section heading\">Interviewer and language</h2><span data-kid=\"3-1-1-2-1-2\" data-name=\"both apply hint label\">Both apply per session</span></div>\n<div class=\"pwrap\" data-kid=\"3-1-1-2-2\" data-name=\"interviewer persona chip group\">\n<span class=\"pchip\" data-kid=\"3-1-1-2-2-1\" data-name=\"friendly persona chip\">Friendly</span><span class=\"pchip on\" data-kid=\"3-1-1-2-2-2\" data-name=\"selected professional persona chip\">Professional</span><span class=\"pchip\" data-kid=\"3-1-1-2-2-3\" data-name=\"strict persona chip\">Strict</span><span class=\"pchip\" data-kid=\"3-1-1-2-2-4\" data-name=\"technical expert persona chip\">Technical Expert</span><span class=\"pchip\" data-kid=\"3-1-1-2-2-5\" data-name=\"HR specialist persona chip\">HR Specialist</span><span class=\"pchip\" data-kid=\"3-1-1-2-2-6\" data-name=\"hiring manager persona chip\">Hiring Manager</span>\n</div>\n<div class=\"persona-note\" data-kid=\"3-1-1-2-3\" data-name=\"persona description note\"><b data-kid=\"3-1-1-2-3-1\" data-name=\"selected persona name\">Professional</b> keeps to the agenda and the clock. Best for rehearsing under real interview conditions.</div>\n<div class=\"divider\" data-kid=\"3-1-1-2-4\" data-name=\"section divider line\"></div>\n<div class=\"sub-h\" data-kid=\"3-1-1-2-5\" data-name=\"interview language subheading\"><i class=\"ph ph-translate\" data-kid=\"3-1-1-2-5-1\" data-name=\"translate icon\"></i>Interview language</div>\n<div class=\"lchips\" data-kid=\"3-1-1-2-6\" data-name=\"language chip group\">\n<span class=\"lchip\" data-kid=\"3-1-1-2-6-1\" data-name=\"English language chip\">English</span><span class=\"lchip\" data-kid=\"3-1-1-2-6-2\" data-name=\"Hindi language chip\">हिन्दी</span><span class=\"lchip on\" data-kid=\"3-1-1-2-6-3\" data-name=\"selected Hinglish language chip\">Hinglish</span><span class=\"lchip\" data-kid=\"3-1-1-2-6-4\" data-name=\"Bengali language chip\">বাংলা</span><span class=\"lchip\" data-kid=\"3-1-1-2-6-5\" data-name=\"Tamil language chip\">தமிழ்</span><span class=\"lchip\" data-kid=\"3-1-1-2-6-6\" data-name=\"Telugu language chip\">తెలుగు</span><span class=\"lchip\" data-kid=\"3-1-1-2-6-7\" data-name=\"Marathi language chip\">मराठी</span><span class=\"lchip\" data-kid=\"3-1-1-2-6-8\" data-name=\"Gujarati language chip\">ગુજરાતી</span><span class=\"lchip\" data-kid=\"3-1-1-2-6-9\" data-name=\"Kannada language chip\">ಕನ್ನಡ</span><span class=\"lchip\" data-kid=\"3-1-1-2-6-10\" data-name=\"Malayalam language chip\">മലയാളം</span><span class=\"lchip\" data-kid=\"3-1-1-2-6-11\" data-name=\"Punjabi language chip\">ਪੰਜਾਬੀ</span>\n</div>\n</div>\n<div class=\"card\" data-kid=\"3-1-1-3\" data-name=\"session settings card\">\n<div class=\"card-head\" data-kid=\"3-1-1-3-1\" data-name=\"session card header\"><h2 class=\"serif\" data-kid=\"3-1-1-3-1-1\" data-name=\"session section heading\">Session</h2><span data-kid=\"3-1-1-3-1-2\" data-name=\"question count hint label\">12 questions at these settings</span></div>\n<div class=\"diff\" data-kid=\"3-1-1-3-2\" data-name=\"difficulty tile group\">\n<div class=\"dtile\" data-kid=\"3-1-1-3-2-1\" data-name=\"easy difficulty tile\"><b data-kid=\"3-1-1-3-2-1-1\" data-name=\"easy difficulty label\">Easy</b><span data-kid=\"3-1-1-3-2-1-2\" data-name=\"easy difficulty description\">Fundamentals, forgiving follow-ups.</span></div>\n<div class=\"dtile on\" data-kid=\"3-1-1-3-2-2\" data-name=\"selected medium difficulty tile\"><b data-kid=\"3-1-1-3-2-2-1\" data-name=\"medium difficulty label\">Medium</b><span data-kid=\"3-1-1-3-2-2-2\" data-name=\"medium difficulty description\">Placement-level depth and pace.</span></div>\n<div class=\"dtile\" data-kid=\"3-1-1-3-2-3\" data-name=\"hard difficulty tile\"><b data-kid=\"3-1-1-3-2-3-1\" data-name=\"hard difficulty label\">Hard</b><span data-kid=\"3-1-1-3-2-3-2\" data-name=\"hard difficulty description\">Edge cases and pressure follow-ups.</span></div>\n</div>\n<div class=\"rows\" data-kid=\"3-1-1-3-3\" data-name=\"session settings rows\">\n<div class=\"row\" data-kid=\"3-1-1-3-3-1\" data-name=\"interview length setting row\"><label data-kid=\"3-1-1-3-3-1-1\" data-name=\"length row label\">Length</label><div class=\"pcaps\" data-kid=\"3-1-1-3-3-1-2\" data-name=\"length option group\"><span class=\"pcap\" data-kid=\"3-1-1-3-3-1-2-1\" data-name=\"15 minute option\">15 min</span><span class=\"pcap on\" data-kid=\"3-1-1-3-3-1-2-2\" data-name=\"selected 30 minute option\">30 min</span><span class=\"pcap\" data-kid=\"3-1-1-3-3-1-2-3\" data-name=\"45 minute option\">45 min</span><span class=\"pcap\" data-kid=\"3-1-1-3-3-1-2-4\" data-name=\"60 minute option\">60 min</span></div></div>\n<div class=\"row\" data-kid=\"3-1-1-3-3-2\" data-name=\"answer mode setting row\"><label data-kid=\"3-1-1-3-3-2-1\" data-name=\"answer mode row label\">Answer by</label><div class=\"pcaps\" data-kid=\"3-1-1-3-3-2-2\" data-name=\"answer mode option group\"><span class=\"pcap on\" data-kid=\"3-1-1-3-3-2-2-1\" data-name=\"selected voice answer option\"><i class=\"ph ph-mic\" data-kid=\"3-1-1-3-3-2-2-1-1\" data-name=\"microphone icon\" style=\"font-size:11px;margin-right:4px\"></i>Voice</span><span class=\"pcap\" data-kid=\"3-1-1-3-3-2-2-2\" data-name=\"text answer option\">Text</span></div></div>\n<div class=\"row\" data-kid=\"3-1-1-3-3-3\" data-name=\"resume setting row\"><label data-kid=\"3-1-1-3-3-3-1\" data-name=\"resume row label\">Resume</label>\n<div data-kid=\"3-1-1-3-3-3-2\" data-name=\"resume upload area\">\n<div class=\"drop\" data-kid=\"3-1-1-3-3-3-2-1\" data-name=\"uploaded resume file card\">\n<span class=\"ic\" data-kid=\"3-1-1-3-3-3-2-1-1\" data-name=\"PDF file icon badge\"><i class=\"ph ph-file-pdf\" data-kid=\"3-1-1-3-3-3-2-1-1-1\" data-name=\"PDF file icon\"></i></span>\n<div data-kid=\"3-1-1-3-3-3-2-1-2\" data-name=\"uploaded resume file details\"><b data-kid=\"3-1-1-3-3-3-2-1-2-1\" data-name=\"resume file name\">Resume_Rohit_BCom.pdf</b><span data-kid=\"3-1-1-3-3-3-2-1-2-2\" data-name=\"resume file metadata text\">2 pages, 148 KB, parsed 8 Nov 2026</span></div>\n<span class=\"act\" data-kid=\"3-1-1-3-3-3-2-1-3\" data-name=\"replace resume link text\">Replace</span>\n</div>\n<div class=\"usefile\" data-kid=\"3-1-1-3-3-3-2-2\" data-name=\"use resume for questions option\"><span class=\"cbx\" data-kid=\"3-1-1-3-3-3-2-2-1\" data-name=\"use resume checkbox\"><i class=\"ph ph-check\" data-kid=\"3-1-1-3-3-3-2-2-1-1\" data-name=\"checkbox checkmark icon\"></i></span>Ask questions from this resume</div>\n</div>\n</div>\n</div>\n</div>\n</div>\n<aside data-kid=\"3-1-2\" data-name=\"interview summary sidebar\">\n<div class=\"ticket\" data-kid=\"3-1-2-1\" data-name=\"interviewer summary ticket card\">\n<div class=\"tk-head\" data-kid=\"3-1-2-1-1\" data-name=\"ticket interviewer header\">\n<span class=\"pic\" data-kid=\"3-1-2-1-1-1\" data-name=\"interviewer avatar frame\"><img alt=\"Illustrated AI interviewer avatar with headset\" data-kid=\"3-1-2-1-1-1-1\" data-name=\"AI interviewer avatar image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/.kombai/canvas/assets/riso-avatar.svg\"/></span>\n<div data-kid=\"3-1-2-1-1-2\" data-name=\"interviewer name and tone block\"><b data-kid=\"3-1-2-1-1-2-1\" data-name=\"professional interviewer name\">Professional interviewer</b><span data-kid=\"3-1-2-1-1-2-2\" data-name=\"interviewer tone description\">Neutral tone, keeps to the clock</span></div>\n</div>\n<div class=\"tk-body\" data-kid=\"3-1-2-1-2\" data-name=\"ticket session details body\">\n<div class=\"tk-row\" data-kid=\"3-1-2-1-2-1\" data-name=\"ticket category row\"><span data-kid=\"3-1-2-1-2-1-1\" data-name=\"category row label\">Category</span><b data-kid=\"3-1-2-1-2-1-2\" data-name=\"selected category value\">Commerce</b></div>\n<div class=\"tk-row\" data-kid=\"3-1-2-1-2-2\" data-name=\"ticket course row\"><span data-kid=\"3-1-2-1-2-2-1\" data-name=\"course row label\">Course</span><b data-kid=\"3-1-2-1-2-2-2\" data-name=\"course value\">B.Com</b></div>\n<div class=\"tk-row\" data-kid=\"3-1-2-1-2-3\" data-name=\"ticket difficulty row\"><span data-kid=\"3-1-2-1-2-3-1\" data-name=\"difficulty row label\">Difficulty</span><b data-kid=\"3-1-2-1-2-3-2\" data-name=\"difficulty value\">Medium</b></div>\n<div class=\"tk-row\" data-kid=\"3-1-2-1-2-4\" data-name=\"ticket length row\"><span data-kid=\"3-1-2-1-2-4-1\" data-name=\"length row label\">Length</span><b data-kid=\"3-1-2-1-2-4-2\" data-name=\"length value\">30 min</b></div>\n<div class=\"tk-row\" data-kid=\"3-1-2-1-2-5\" data-name=\"ticket language row\"><span data-kid=\"3-1-2-1-2-5-1\" data-name=\"language row label\">Language</span><b data-kid=\"3-1-2-1-2-5-2\" data-name=\"language value\">Hinglish</b></div>\n<div class=\"tk-row\" data-kid=\"3-1-2-1-2-6\" data-name=\"ticket answer mode row\"><span data-kid=\"3-1-2-1-2-6-1\" data-name=\"answer mode row label\">Answer mode</span><b data-kid=\"3-1-2-1-2-6-2\" data-name=\"answer mode value\">Voice</b></div>\n<div class=\"tk-row\" data-kid=\"3-1-2-1-2-7\" data-name=\"ticket resume row\"><span data-kid=\"3-1-2-1-2-7-1\" data-name=\"resume row label\">Resume</span><b data-kid=\"3-1-2-1-2-7-2\" data-name=\"resume file name value\">Resume_Rohit_BCom.pdf</b></div>\n<div class=\"tk-notes\" data-kid=\"3-1-2-1-2-8\" data-name=\"ticket summary stats\">\n<div class=\"tk-note\" data-kid=\"3-1-2-1-2-8-1\" data-name=\"questions count stat\"><span data-kid=\"3-1-2-1-2-8-1-1\" data-name=\"questions stat label\">Questions</span><b data-kid=\"3-1-2-1-2-8-1-2\" data-name=\"questions count value\">12</b></div>\n<div class=\"tk-note\" data-kid=\"3-1-2-1-2-8-2\" data-name=\"rubric stat\"><span data-kid=\"3-1-2-1-2-8-2-1\" data-name=\"rubric stat label\">Rubric</span><b data-kid=\"3-1-2-1-2-8-2-2\" data-name=\"rubric value\">B.Com</b></div>\n</div>\n<a class=\"cta\" data-kid=\"3-1-2-1-2-9\" data-name=\"start interview call-to-action button\" href=\"/interview/session/sess_4c19\"><i class=\"ph ph-microphone\" data-kid=\"3-1-2-1-2-9-1\" data-name=\"microphone icon\"></i>Start interview</a>\n</div>\n<div class=\"tk-foot\" data-kid=\"3-1-2-1-3\" data-name=\"ticket footer\">\n<p data-kid=\"3-1-2-1-3-1\" data-name=\"muted start and typed answer note\">Starts muted. Typed answers work at any point if the microphone is blocked.</p>\n<a data-kid=\"3-1-2-1-3-2\" data-name=\"edit profile defaults link\" href=\"/dashboard/profile\">Edit profile defaults <i class=\"ph ph-arrow-right\" data-kid=\"3-1-2-1-3-2-1\" data-name=\"right arrow icon\"></i></a>\n</div>\n</div>\n<div class=\"side-note\" data-kid=\"3-1-2-2\" data-name=\"report language side note\">\n<h4 data-kid=\"3-1-2-2-1\" data-name=\"report language heading\"><i class=\"ph ph-note\" data-kid=\"3-1-2-2-1-1\" data-name=\"note icon\"></i>Report in Hinglish</h4>\n<p data-kid=\"3-1-2-2-2\" data-name=\"report language description text\">Rubric notes, missed concepts and suggested answers are written in the language picked for the session.</p>\n</div>\n</aside>\n</div>\n</main>",
      "comments": [],
      "created": "2026-11-10T15:17:00.887753+00:00",
      "modified": "2026-11-10T15:21:04.810551+00:00",
      "id": "var_a75ba1c90a9b",
      "contentHeight": 1270
    },
    "var_e119a86f0e0e": {
      "type": "variant",
      "label": "Interview Setup — V3 Briefing Deck",
      "parentId": "var_a75ba1c90a9b",
      "themeId": null,
      "rect": {
        "x": 5520,
        "y": 0,
        "w": 1280,
        "h": 0
      },
      "html": "<style>\n@import url('https://fonts.googleapis.com/css2?family=Saira+Condensed:wght@500;600;700&family=Commissioner:wght@400;500;600;700&display=swap');\n@import url(\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.48.0/dist/tabler-icons.min.css\");\n:root{\n  --turq:#31AFD4; --light:#F3F5F9; --ink:#291720; --ink70:rgba(41,23,32,.72); --ink50:rgba(41,23,32,.5);\n  --blue:#004FFF; --orchid:#E07BE0; --cta:#4F46E5; --hair:rgba(41,23,32,.2);\n}\n*{box-sizing:border-box}\nbody{margin:0;background:var(--light);color:var(--ink);font-family:'Commissioner',system-ui,sans-serif;-webkit-font-smoothing:antialiased;font-size:13.5px}\nh1,h2,h3,h4,p,ul{margin:0;padding:0}ul{list-style:none}\na{text-decoration:none;color:inherit}\n.display{font-family:'Saira Condensed',Impact,sans-serif;font-weight:600}\n.wrap{max-width:1290px;margin:0 auto;padding:0 26px}\n.cham{clip-path:polygon(8px 0,100% 0,100% calc(100% - 8px),calc(100% - 8px) 100%,0 100%,0 8px)}\n\n/* topbar */\n.topbar{background:#fff;border-bottom:1px solid var(--hair)}\n.top-in{height:58px;display:flex;align-items:center;gap:20px}\n.brand{display:flex;align-items:center;gap:8px;font-weight:700;font-size:15px}\n.mark{width:24px;height:24px;background:var(--ink);display:flex;align-items:center;justify-content:center;gap:2px;clip-path:polygon(6px 0,100% 0,100% calc(100% - 6px),calc(100% - 6px) 100%,0 100%,0 6px)}\n.mark i{display:block;width:2px;background:var(--turq)}\n.mark i:nth-child(1){height:6px}.mark i:nth-child(2){height:12px}.mark i:nth-child(3){height:4px}\n.top-nav{display:flex;gap:18px;font-size:12.5px;font-weight:500;color:var(--ink70);margin-left:10px}\n.top-nav a.on{color:var(--ink);border-bottom:2px solid var(--blue);padding-bottom:2px;font-weight:600}\n.top-right{margin-left:auto;display:flex;align-items:center;gap:12px}\n.quota{font-size:10.5px;letter-spacing:.05em;text-transform:uppercase;border:1px solid var(--hair);padding:5px 9px;color:var(--ink70)}\n.av{width:28px;height:28px;border-radius:2px;overflow:hidden;border:1px solid var(--hair)}\n.av img{width:100%;height:100%;object-fit:cover;display:block}\n\n/* page head */\n.head{background:var(--turq);border-bottom:1px solid rgba(41,23,32,.3);padding:20px 0 22px}\n.head-in{display:flex;align-items:flex-end;justify-content:space-between;gap:30px}\n.head h1{font-size:36px;line-height:1.05}\n.head p{font-size:11.5px;color:rgba(41,23,32,.8);margin-top:6px;max-width:430px;line-height:1.55}\n.head-right{display:flex;gap:8px;align-items:center}\n.hchip{background:rgba(243,245,249,.85);border:1px solid rgba(41,23,32,.28);padding:7px 11px;font-size:10.5px;letter-spacing:.05em;text-transform:uppercase}\n.hchip b,.hchip span{display:block;font-size:12.5px;letter-spacing:0;text-transform:none;margin-top:3px;color:var(--ink);font-weight:600}\n\n/* layout */\n.shell{display:grid;grid-template-columns:206px minmax(0,1fr) 306px;gap:16px;padding:18px 0 40px;align-items:start}\n\n/* rail */\n.rail{border:1px solid var(--hair);background:#fff}\n.rail-h{padding:10px 12px;border-bottom:1px solid var(--hair);font-size:9.5px;letter-spacing:.12em;text-transform:uppercase;color:var(--ink50)}\n.rail a{display:flex;align-items:center;gap:9px;padding:11px 12px;border-bottom:1px solid rgba(41,23,32,.1);font-size:12.5px;color:var(--ink70)}\n.rail a .sq{width:9px;height:9px;border:1px solid var(--hair);background:#fff;flex:none}\n.rail a .n{font-size:10px;letter-spacing:.06em;color:var(--ink50);width:16px;flex:none}\n.rail a.on{background:var(--ink);color:#F3F5F9;font-weight:600}\n.rail a.on .sq{background:var(--orchid);border-color:var(--orchid)}\n.rail a.on .n{color:var(--orchid)}\n.rail a:last-child{border-bottom:0}\n.rail-foot{padding:12px;background:rgba(49,175,212,.14);border-top:1px solid var(--hair)}\n.rail-foot span{font-size:9.5px;letter-spacing:.1em;text-transform:uppercase;color:var(--ink50)}\n.rail-foot b{display:block;font-family:'Saira Condensed',sans-serif;font-size:22px;font-weight:600;margin-top:2px}\n.rail-foot p{font-size:10px;color:var(--ink70);line-height:1.5}\n\n/* plates */\n.plate{border:1px solid var(--hair);background:#fff;margin-bottom:10px}\n.plate-h{display:flex;align-items:center;justify-content:space-between;gap:14px;padding:10px 14px;border-bottom:1px solid var(--hair);background:rgba(243,245,249,.7)}\n.plate-h h2{font-family:'Saira Condensed',sans-serif;font-size:17px;font-weight:600;letter-spacing:.01em;display:flex;align-items:center;gap:8px}\n.plate-h h2 .num{font-size:10px;letter-spacing:.08em;color:var(--blue);border:1px solid var(--hair);padding:1px 5px;font-family:'Commissioner',sans-serif}\n.plate-h span{font-size:9.5px;letter-spacing:.09em;text-transform:uppercase;color:var(--ink50)}\n.plate-b{padding:13px 14px 15px}\n\n/* category chips */\n.cwall{display:grid;grid-template-columns:repeat(5,1fr);gap:6px}\n.cch{border:1px solid var(--hair);padding:9px 10px;font-size:11.5px;display:flex;align-items:center;gap:7px;background:#fff;font-weight:500}\n.cch i{font-size:13px;color:var(--blue)}\n.cch.on{background:var(--ink);border-color:var(--ink);color:#F3F5F9}\n.cch.on i{color:var(--orchid)}\n.hint{font-size:10.5px;color:var(--ink70);line-height:1.55;margin-top:9px}\n.hint b{color:var(--ink)}\n\n/* interviewer grid */\n.pgrid{display:grid;grid-template-columns:1fr 1fr;gap:6px}\n.pcell{border:1px solid var(--hair);padding:9px 11px;display:flex;align-items:center;justify-content:space-between;gap:8px}\n.pcell .pt{font-size:12px;font-weight:600;display:block}\n.pcell .pd{font-size:10px;color:var(--ink70);display:block;margin-top:2px}\n.pcell .tag{font-size:8.5px;letter-spacing:.07em;text-transform:uppercase;color:var(--ink50);border:1px solid var(--hair);padding:1px 4px;flex:none}\n.pcell.on{border-color:var(--ink);background:rgba(41,23,32,.04);box-shadow:inset 0 0 0 1px var(--ink)}\n.pcell.on .tag{background:var(--orchid);border-color:var(--orchid);color:var(--ink)}\n\n/* settings rows */\n.frow{display:grid;grid-template-columns:112px 1fr;gap:12px;align-items:start;padding:9px 0;border-top:1px dashed rgba(41,23,32,.18)}\n.frow:first-of-type{border-top:0;padding-top:0}\n.frow label{font-size:10px;letter-spacing:.08em;text-transform:uppercase;color:var(--ink50);padding-top:6px}\n.seg{display:flex;gap:5px;flex-wrap:wrap}\n.dbtn{border:1px solid var(--hair);padding:6px 13px;font-size:11.5px;background:#fff;color:var(--ink70)}\n.dbtn.on{background:var(--blue);border-color:var(--blue);color:#fff;font-weight:600}\n.lchips{display:flex;flex-wrap:wrap;gap:4px}\n.lch{border:1px solid var(--hair);padding:4px 8px;font-size:11px;color:var(--ink70)}\n.lch.on{background:var(--ink);border-color:var(--ink);color:#F3F5F9}\n.select{border:1px solid var(--hair);padding:6px 10px;font-size:11.5px;display:inline-flex;align-items:center;gap:9px;background:#fff}\n.select i{font-size:12px;color:var(--ink50)}\n.tgl{display:inline-flex;align-items:center;gap:8px;font-size:11px;color:var(--ink70)}\n.sw{width:32px;height:18px;border-radius:9px;background:var(--blue);position:relative;flex:none}\n.sw i{position:absolute;right:2px;top:2px;width:14px;height:14px;border-radius:50%;background:#fff}\n.sw.off{background:#C6CEDA}\n.sw.off i{left:2px;right:auto}\n\n/* file */\n.file{display:flex;align-items:center;gap:10px;border:1px solid var(--hair);padding:9px 11px;background:#fff}\n.file .fi{width:27px;height:27px;background:rgba(49,175,212,.2);display:flex;align-items:center;justify-content:center;color:var(--ink);font-size:15px}\n.file b{font-size:11.5px;display:block}\n.file span{font-size:10px;color:var(--ink70);display:block;margin-top:1px}\n.file .acts{margin-left:auto;display:flex;gap:10px;font-size:10.5px;color:var(--blue)}\n\n/* brief */\n.brief{background:var(--ink);color:#F3F5F9;padding:0 0 14px}\n.brief-h{padding:10px 14px;border-bottom:1px solid rgba(243,245,249,.2);display:flex;align-items:center;justify-content:space-between}\n.brief-h h3{font-size:10px;letter-spacing:.13em;text-transform:uppercase;color:rgba(243,245,249,.6);font-weight:500}\n.brief-h .dot{width:6px;height:6px;background:var(--orchid)}\n.brief-b{padding:12px 14px}\n.brow{display:grid;grid-template-columns:7px 1fr auto;gap:8px;align-items:center;padding:7px 0;border-bottom:1px solid rgba(243,245,249,.13);font-size:11px}\n.brow .q{width:5px;height:5px;background:var(--orchid)}\n.brow span{color:rgba(243,245,249,.6);font-size:10px;letter-spacing:.05em;text-transform:uppercase}\n.brow b{font-weight:600;font-size:11px}\n.checks{margin:12px 0 0;padding-top:11px;border-top:1px solid rgba(243,245,249,.2)}\n.checks h4{font-size:9px;letter-spacing:.12em;text-transform:uppercase;color:rgba(243,245,249,.5);margin-bottom:8px}\n.chk{display:flex;align-items:center;gap:7px;font-size:10.5px;color:rgba(243,245,249,.78);padding:3px 0}\n.chk i{font-size:12px;color:var(--turq)}\n.chk.pending i{color:var(--orchid)}\n.brief-cta{margin:12px 14px 0;display:flex;align-items:center;justify-content:center;gap:8px;background:var(--cta);color:#fff;font-size:12.5px;font-weight:600;padding:11px;clip-path:polygon(9px 0,100% 0,100% calc(100% - 9px),calc(100% - 9px) 100%,0 100%,0 9px)}\n.brief-micro{font-size:9.5px;line-height:1.5;color:rgba(243,245,249,.5);padding:10px 14px 0}\n.brief-save{display:flex;align-items:center;gap:6px;font-size:10px;color:rgba(243,245,249,.62);padding:9px 14px 0;border-top:1px solid rgba(243,245,249,.16);margin-top:12px;border-bottom:0}\n.side-note{border:1px solid var(--hair);background:#fff;padding:11px 13px;margin-top:10px}\n.side-note h4{font-size:10px;letter-spacing:.08em;text-transform:uppercase;color:var(--ink50)}\n.side-note p{font-size:10.5px;color:var(--ink70);line-height:1.55;margin-top:5px}\n\n@media (max-width:1100px){\n  .shell{grid-template-columns:1fr}\n  .rail{display:flex;overflow:auto}\n  .rail-h,.rail-foot{display:none}\n  .rail a{flex:1;border-bottom:0;border-right:1px solid rgba(41,23,32,.1);white-space:nowrap}\n  .cwall{grid-template-columns:1fr 1fr}\n  .head-in{flex-direction:column;align-items:flex-start;gap:12px}\n}\n@media (max-width:720px){\n  .wrap{padding:0 14px}\n  .top-nav{display:none}\n  .head h1{font-size:28px}\n  .pgrid{grid-template-columns:1fr}\n  .frow{grid-template-columns:1fr;gap:6px}\n  .frow label{padding-top:0}\n}\n</style>\n<header class=\"topbar\" data-kid=\"1\" data-name=\"top application header bar\">\n<div class=\"wrap top-in\" data-kid=\"1-1\" data-name=\"top bar content container\">\n<a class=\"brand\" data-kid=\"1-1-1\" data-name=\"brand logo link\" href=\"/\"><span class=\"mark\" data-kid=\"1-1-1-1\" data-name=\"brand logo mark\"><i data-kid=\"1-1-1-1-1\" data-name=\"logo bar icon short\"></i><i data-kid=\"1-1-1-1-2\" data-name=\"logo bar icon tall\"></i><i data-kid=\"1-1-1-1-3\" data-name=\"logo bar icon small\"></i></span>MockMate AI</a>\n<nav class=\"top-nav\" data-kid=\"1-1-2\" data-name=\"main section navigation\">\n<a data-kid=\"1-1-2-1\" data-name=\"dashboard nav link\" href=\"/dashboard\">Dashboard</a>\n<a class=\"on\" data-kid=\"1-1-2-2\" data-name=\"interviews nav link active\" href=\"/dashboard/interviews\">Interviews</a>\n<a data-kid=\"1-1-2-3\" data-name=\"progress nav link\" href=\"/dashboard/progress\">Progress</a>\n<a data-kid=\"1-1-2-4\" data-name=\"resume nav link\" href=\"/dashboard/resume\">Resume</a>\n</nav>\n<div class=\"top-right\" data-kid=\"1-1-3\" data-name=\"top right account area\">\n<span class=\"quota\" data-kid=\"1-1-3-1\" data-name=\"interview quota badge\">Pro plan · 38 of 60 left</span>\n<span class=\"av\" data-kid=\"1-1-3-2\" data-name=\"profile avatar frame\"><img alt=\"Profile photo of Arjun Verma\" data-kid=\"1-1-3-2-1\" data-name=\"profile photo of candidate\" decoding=\"async\" loading=\"lazy\" src=\"https://i.pravatar.cc/64?u=arjun-verma\"/></span>\n</div>\n</div>\n</header>\n<section class=\"head\" data-kid=\"2\" data-name=\"page heading section\">\n<div class=\"wrap head-in\" data-kid=\"2-1\" data-name=\"page heading content container\">\n<div data-kid=\"2-1-1\" data-name=\"page title and description block\">\n<h1 class=\"display\" data-kid=\"2-1-1-1\" data-name=\"interview setup page title\">Interview setup</h1>\n<p data-kid=\"2-1-1-2\" data-name=\"page intro description text\">Brief the interviewer before the round starts. Everything below is used for this session.</p>\n</div>\n<div class=\"head-right\" data-kid=\"2-1-2\" data-name=\"candidate summary chips group\">\n<div class=\"hchip\" data-kid=\"2-1-2-1\" data-name=\"candidate name chip\">Candidate<span data-kid=\"2-1-2-1-1\" data-name=\"candidate name value\">Arjun Verma</span></div>\n<div class=\"hchip\" data-kid=\"2-1-2-2\" data-name=\"course info chip\">Course<span data-kid=\"2-1-2-2-1\" data-name=\"course value\">B.Tech, CSE</span></div>\n<div class=\"hchip\" data-kid=\"2-1-2-3\" data-name=\"quota info chip\">Quota<span data-kid=\"2-1-2-3-1\" data-name=\"quota remaining value\">38 left</span></div>\n</div>\n</div>\n</section>\n<main class=\"wrap shell\" data-kid=\"3\" data-name=\"main setup layout\">\n<nav class=\"rail\" data-kid=\"3-1\" data-name=\"setup step navigation rail\">\n<div class=\"rail-h\" data-kid=\"3-1-1\" data-name=\"setup rail heading\">Setup</div>\n<a class=\"on\" data-kid=\"3-1-2\" data-name=\"category step link active\" href=\"#cat\"><span class=\"sq\" data-kid=\"3-1-2-1\" data-name=\"category step checkbox square\"></span><span class=\"n\" data-kid=\"3-1-2-2\" data-name=\"category step number\">01</span>Category</a>\n<a data-kid=\"3-1-3\" data-name=\"interviewer step link\" href=\"#who\"><span class=\"sq\" data-kid=\"3-1-3-1\" data-name=\"interviewer step checkbox square\"></span><span class=\"n\" data-kid=\"3-1-3-2\" data-name=\"interviewer step number\">02</span>Interviewer</a>\n<a data-kid=\"3-1-4\" data-name=\"settings step link\" href=\"#set\"><span class=\"sq\" data-kid=\"3-1-4-1\" data-name=\"settings step checkbox square\"></span><span class=\"n\" data-kid=\"3-1-4-2\" data-name=\"settings step number\">03</span>Settings</a>\n<a data-kid=\"3-1-5\" data-name=\"resume step link\" href=\"#res\"><span class=\"sq\" data-kid=\"3-1-5-1\" data-name=\"resume step checkbox square\"></span><span class=\"n\" data-kid=\"3-1-5-2\" data-name=\"resume step number\">04</span>Resume</a>\n<a data-kid=\"3-1-6\" data-name=\"start step link\" href=\"#start\"><span class=\"sq\" data-kid=\"3-1-6-1\" data-name=\"start step checkbox square\"></span><span class=\"n\" data-kid=\"3-1-6-2\" data-name=\"start step number\">05</span>Start</a>\n<div class=\"rail-foot\" data-kid=\"3-1-7\" data-name=\"interview quota footer panel\">\n<span data-kid=\"3-1-7-1\" data-name=\"interviews used label\">Interviews used</span>\n<b data-kid=\"3-1-7-2\" data-name=\"interviews used count\">22 / 60</b>\n<p data-kid=\"3-1-7-3\" data-name=\"quota reset note\">Resets on 1 December.</p>\n</div>\n</nav>\n<div data-kid=\"3-2\" data-name=\"setup form column\">\n<section class=\"plate\" data-kid=\"3-2-1\" data-name=\"category selection plate\" id=\"cat\">\n<div class=\"plate-h\" data-kid=\"3-2-1-1\" data-name=\"category plate header\"><h2 data-kid=\"3-2-1-1-1\" data-name=\"category plate title\"><span class=\"num\" data-kid=\"3-2-1-1-1-1\" data-name=\"category section number badge\">01</span>Category</h2><span data-kid=\"3-2-1-1-2\" data-name=\"category required label\">One required</span></div>\n<div class=\"plate-b\" data-kid=\"3-2-1-2\" data-name=\"category plate body\">\n<div class=\"cwall\" data-kid=\"3-2-1-2-1\" data-name=\"category chip grid\">\n<span class=\"cch on\" data-kid=\"3-2-1-2-1-1\" data-name=\"technical category chip selected\"><i class=\"ti ti-cpu\" data-kid=\"3-2-1-2-1-1-1\" data-name=\"cpu icon\"></i>Technical</span>\n<span class=\"cch\" data-kid=\"3-2-1-2-1-2\" data-name=\"hr category chip\"><i class=\"ti ti-users\" data-kid=\"3-2-1-2-1-2-1\" data-name=\"users icon\"></i>HR</span>\n<span class=\"cch\" data-kid=\"3-2-1-2-1-3\" data-name=\"resume category chip\"><i class=\"ti ti-file-text\" data-kid=\"3-2-1-2-1-3-1\" data-name=\"file text icon\"></i>Resume</span>\n<span class=\"cch\" data-kid=\"3-2-1-2-1-4\" data-name=\"coding category chip\"><i class=\"ti ti-code\" data-kid=\"3-2-1-2-1-4-1\" data-name=\"code icon\"></i>Coding</span>\n<span class=\"cch\" data-kid=\"3-2-1-2-1-5\" data-name=\"management category chip\"><i class=\"ti ti-briefcase\" data-kid=\"3-2-1-2-1-5-1\" data-name=\"briefcase icon\"></i>Management</span>\n<span class=\"cch\" data-kid=\"3-2-1-2-1-6\" data-name=\"commerce category chip\"><i class=\"ti ti-calculator\" data-kid=\"3-2-1-2-1-6-1\" data-name=\"calculator icon\"></i>Commerce</span>\n<span class=\"cch\" data-kid=\"3-2-1-2-1-7\" data-name=\"science category chip\"><i class=\"ti ti-flask\" data-kid=\"3-2-1-2-1-7-1\" data-name=\"flask icon\"></i>Science</span>\n<span class=\"cch\" data-kid=\"3-2-1-2-1-8\" data-name=\"law category chip\"><i class=\"ti ti-scale\" data-kid=\"3-2-1-2-1-8-1\" data-name=\"scale icon\"></i>Law</span>\n<span class=\"cch\" data-kid=\"3-2-1-2-1-9\" data-name=\"medical category chip\"><i class=\"ti ti-stethoscope\" data-kid=\"3-2-1-2-1-9-1\" data-name=\"stethoscope icon\"></i>Medical</span>\n<span class=\"cch\" data-kid=\"3-2-1-2-1-10\" data-name=\"general category chip\"><i class=\"ti ti-compass\" data-kid=\"3-2-1-2-1-10-1\" data-name=\"compass icon\"></i>General</span>\n</div>\n<p class=\"hint\" data-kid=\"3-2-1-2-2\" data-name=\"category question hint text\">Questions for <b data-kid=\"3-2-1-2-2-1\" data-name=\"technical category emphasis\">Technical</b> come from the B.Tech CSE bank: data structures, databases, operating systems, networks and your final-year project.</p>\n</div>\n</section>\n<section class=\"plate\" data-kid=\"3-2-2\" data-name=\"interviewer selection plate\" id=\"who\">\n<div class=\"plate-h\" data-kid=\"3-2-2-1\" data-name=\"interviewer plate header\"><h2 data-kid=\"3-2-2-1-1\" data-name=\"interviewer plate title\"><span class=\"num\" data-kid=\"3-2-2-1-1-1\" data-name=\"interviewer section number badge\">02</span>Interviewer</h2><span data-kid=\"3-2-2-1-2\" data-name=\"interviewer plate subtitle\">Chair tactics and follow-ups</span></div>\n<div class=\"plate-b\" data-kid=\"3-2-2-2\" data-name=\"interviewer plate body\">\n<div class=\"pgrid\" data-kid=\"3-2-2-2-1\" data-name=\"interviewer option grid\">\n<div class=\"pcell\" data-kid=\"3-2-2-2-1-1\" data-name=\"friendly interviewer option\"><div data-kid=\"3-2-2-2-1-1-1\" data-name=\"friendly option text block\"><b class=\"pt\" data-kid=\"3-2-2-2-1-1-1-1\" data-name=\"friendly interviewer name\">Friendly</b><span class=\"pd\" data-kid=\"3-2-2-2-1-1-1-2\" data-name=\"friendly interviewer description\">Warm, patient follow-ups</span></div><span class=\"tag\" data-kid=\"3-2-2-2-1-1-2\" data-name=\"first try tag\">First try</span></div>\n<div class=\"pcell\" data-kid=\"3-2-2-2-1-2\" data-name=\"professional interviewer option\"><div data-kid=\"3-2-2-2-1-2-1\" data-name=\"professional option text block\"><b class=\"pt\" data-kid=\"3-2-2-2-1-2-1-1\" data-name=\"professional interviewer name\">Professional</b><span class=\"pd\" data-kid=\"3-2-2-2-1-2-1-2\" data-name=\"professional interviewer description\">Neutral, keeps the clock</span></div><span class=\"tag\" data-kid=\"3-2-2-2-1-2-2\" data-name=\"real tag\">Real</span></div>\n<div class=\"pcell\" data-kid=\"3-2-2-2-1-3\" data-name=\"strict interviewer option\"><div data-kid=\"3-2-2-2-1-3-1\" data-name=\"strict option text block\"><b class=\"pt\" data-kid=\"3-2-2-2-1-3-1-1\" data-name=\"strict interviewer name\">Strict</b><span class=\"pd\" data-kid=\"3-2-2-2-1-3-1-2\" data-name=\"strict interviewer description\">Presses on thin answers</span></div><span class=\"tag\" data-kid=\"3-2-2-2-1-3-2\" data-name=\"pressure tag\">Pressure</span></div>\n<div class=\"pcell on\" data-kid=\"3-2-2-2-1-4\" data-name=\"technical expert interviewer option selected\"><div data-kid=\"3-2-2-2-1-4-1\" data-name=\"technical expert option text block\"><b class=\"pt\" data-kid=\"3-2-2-2-1-4-1-1\" data-name=\"technical expert interviewer name\">Technical Expert</b><span class=\"pd\" data-kid=\"3-2-2-2-1-4-1-2\" data-name=\"technical expert interviewer description\">Goes down to fundamentals</span></div><span class=\"tag\" data-kid=\"3-2-2-2-1-4-2\" data-name=\"chosen tag\">Chosen</span></div>\n<div class=\"pcell\" data-kid=\"3-2-2-2-1-5\" data-name=\"hr specialist interviewer option\"><div data-kid=\"3-2-2-2-1-5-1\" data-name=\"hr option text block\"><b class=\"pt\" data-kid=\"3-2-2-2-1-5-1-1\" data-name=\"hr specialist interviewer name\">HR Specialist</b><span class=\"pd\" data-kid=\"3-2-2-2-1-5-1-2\" data-name=\"hr specialist interviewer description\">Behavioural, culture, pay</span></div><span class=\"tag\" data-kid=\"3-2-2-2-1-5-2\" data-name=\"hr tag\">HR</span></div>\n<div class=\"pcell\" data-kid=\"3-2-2-2-1-6\" data-name=\"hiring manager interviewer option\"><div data-kid=\"3-2-2-2-1-6-1\" data-name=\"hiring manager option text block\"><b class=\"pt\" data-kid=\"3-2-2-2-1-6-1-1\" data-name=\"hiring manager interviewer name\">Hiring Manager</b><span class=\"pd\" data-kid=\"3-2-2-2-1-6-1-2\" data-name=\"hiring manager interviewer description\">Trade-offs and ownership</span></div><span class=\"tag\" data-kid=\"3-2-2-2-1-6-2\" data-name=\"senior tag\">Senior</span></div>\n</div>\n</div>\n</section>\n<section class=\"plate\" data-kid=\"3-2-3\" data-name=\"session settings plate\" id=\"set\">\n<div class=\"plate-h\" data-kid=\"3-2-3-1\" data-name=\"session settings plate header\"><h2 data-kid=\"3-2-3-1-1\" data-name=\"session settings plate title\"><span class=\"num\" data-kid=\"3-2-3-1-1-1\" data-name=\"settings section number badge\">03</span>Session settings</h2><span data-kid=\"3-2-3-1-2\" data-name=\"saved to profile note\">Saved to profile</span></div>\n<div class=\"plate-b\" data-kid=\"3-2-3-2\" data-name=\"session settings body\">\n<div class=\"frow\" data-kid=\"3-2-3-2-1\" data-name=\"course setting row\">\n<label data-kid=\"3-2-3-2-1-1\" data-name=\"course field label\">Course</label>\n<div data-kid=\"3-2-3-2-1-2\" data-name=\"course field wrapper\"><div class=\"select\" data-kid=\"3-2-3-2-1-2-1\" data-name=\"course dropdown select\"><span data-kid=\"3-2-3-2-1-2-1-1\" data-name=\"course dropdown value\">B.Tech, Computer Science, 2026</span><i class=\"ti ti-chevron-down\" data-kid=\"3-2-3-2-1-2-1-2\" data-name=\"course dropdown chevron icon\"></i></div></div>\n</div>\n<div class=\"frow\" data-kid=\"3-2-3-2-2\" data-name=\"difficulty setting row\">\n<label data-kid=\"3-2-3-2-2-1\" data-name=\"difficulty field label\">Difficulty</label>\n<div data-kid=\"3-2-3-2-2-2\" data-name=\"difficulty control group\"><div class=\"seg\" data-kid=\"3-2-3-2-2-2-1\" data-name=\"difficulty segmented buttons\"><span class=\"dbtn\" data-kid=\"3-2-3-2-2-2-1-1\" data-name=\"easy difficulty button\">Easy</span><span class=\"dbtn on\" data-kid=\"3-2-3-2-2-2-1-2\" data-name=\"medium difficulty button selected\">Medium</span><span class=\"dbtn\" data-kid=\"3-2-3-2-2-2-1-3\" data-name=\"hard difficulty button\">Hard</span></div><p class=\"hint\" data-kid=\"3-2-3-2-2-2-2\" data-name=\"difficulty explanation hint\">Medium asks one follow-up per answer and expects a concrete example.</p></div>\n</div>\n<div class=\"frow\" data-kid=\"3-2-3-2-3\" data-name=\"length setting row\">\n<label data-kid=\"3-2-3-2-3-1\" data-name=\"length field label\">Length</label>\n<div data-kid=\"3-2-3-2-3-2\" data-name=\"length control group\"><div class=\"seg\" data-kid=\"3-2-3-2-3-2-1\" data-name=\"length segmented buttons\"><span class=\"dbtn\" data-kid=\"3-2-3-2-3-2-1-1\" data-name=\"15 minute length button\">15 min</span><span class=\"dbtn on\" data-kid=\"3-2-3-2-3-2-1-2\" data-name=\"30 minute length button selected\">30 min</span><span class=\"dbtn\" data-kid=\"3-2-3-2-3-2-1-3\" data-name=\"45 minute length button\">45 min</span><span class=\"dbtn\" data-kid=\"3-2-3-2-3-2-1-4\" data-name=\"60 minute length button\">60 min</span></div></div>\n</div>\n<div class=\"frow\" data-kid=\"3-2-3-2-4\" data-name=\"language setting row\">\n<label data-kid=\"3-2-3-2-4-1\" data-name=\"language field label\">Language</label>\n<div data-kid=\"3-2-3-2-4-2\" data-name=\"language control group\">\n<div class=\"lchips\" data-kid=\"3-2-3-2-4-2-1\" data-name=\"language chip list\">\n<span class=\"lch on\" data-kid=\"3-2-3-2-4-2-1-1\" data-name=\"english language chip selected\">English</span><span class=\"lch\" data-kid=\"3-2-3-2-4-2-1-2\" data-name=\"hindi language chip\">हिन्दी</span><span class=\"lch\" data-kid=\"3-2-3-2-4-2-1-3\" data-name=\"hinglish language chip\">Hinglish</span><span class=\"lch\" data-kid=\"3-2-3-2-4-2-1-4\" data-name=\"bengali language chip\">বাংলা</span><span class=\"lch\" data-kid=\"3-2-3-2-4-2-1-5\" data-name=\"tamil language chip\">தமிழ்</span><span class=\"lch\" data-kid=\"3-2-3-2-4-2-1-6\" data-name=\"telugu language chip\">తెలుగు</span><span class=\"lch\" data-kid=\"3-2-3-2-4-2-1-7\" data-name=\"marathi language chip\">मराठी</span><span class=\"lch\" data-kid=\"3-2-3-2-4-2-1-8\" data-name=\"gujarati language chip\">ગુજરાતી</span><span class=\"lch\" data-kid=\"3-2-3-2-4-2-1-9\" data-name=\"kannada language chip\">ಕನ್ನಡ</span><span class=\"lch\" data-kid=\"3-2-3-2-4-2-1-10\" data-name=\"malayalam language chip\">മലയാളം</span><span class=\"lch\" data-kid=\"3-2-3-2-4-2-1-11\" data-name=\"punjabi language chip\">ਪੰਜਾਬੀ</span>\n</div>\n<p class=\"hint\" data-kid=\"3-2-3-2-4-2-2\" data-name=\"language speech note\">Speech runs in English for this session. The typed mode stays available in every language.</p>\n</div>\n</div>\n<div class=\"frow\" data-kid=\"3-2-3-2-5\" data-name=\"answer mode setting row\">\n<label data-kid=\"3-2-3-2-5-1\" data-name=\"answer mode field label\">Answer mode</label>\n<div data-kid=\"3-2-3-2-5-2\" data-name=\"answer mode control group\"><div class=\"seg\" data-kid=\"3-2-3-2-5-2-1\" data-name=\"answer mode segmented buttons\"><span class=\"dbtn on\" data-kid=\"3-2-3-2-5-2-1-1\" data-name=\"voice answer mode button selected\"><i class=\"ti ti-microphone\" data-kid=\"3-2-3-2-5-2-1-1-1\" data-name=\"microphone icon\" style=\"font-size:11px;margin-right:4px\"></i>Voice</span><span class=\"dbtn\" data-kid=\"3-2-3-2-5-2-1-2\" data-name=\"text answer mode button\">Text</span></div></div>\n</div>\n<div class=\"frow\" data-kid=\"3-2-3-2-6\" data-name=\"coding round setting row\">\n<label data-kid=\"3-2-3-2-6-1\" data-name=\"coding round field label\">Coding round</label>\n<div data-kid=\"3-2-3-2-6-2\" data-name=\"coding round control group\"><span class=\"tgl\" data-kid=\"3-2-3-2-6-2-1\" data-name=\"coding round toggle\"><span class=\"sw\" data-kid=\"3-2-3-2-6-2-1-1\" data-name=\"coding round toggle switch\"><i data-kid=\"3-2-3-2-6-2-1-1-1\" data-name=\"coding round toggle knob\"></i></span>On, 2 problems with test cases</span></div>\n</div>\n</div>\n</section>\n<section class=\"plate\" data-kid=\"3-2-4\" data-name=\"resume upload plate\" id=\"res\">\n<div class=\"plate-h\" data-kid=\"3-2-4-1\" data-name=\"resume plate header\"><h2 data-kid=\"3-2-4-1-1\" data-name=\"resume plate title\"><span class=\"num\" data-kid=\"3-2-4-1-1-1\" data-name=\"resume section number badge\">04</span>Resume</h2><span data-kid=\"3-2-4-1-2\" data-name=\"resume optional label\">Optional</span></div>\n<div class=\"plate-b\" data-kid=\"3-2-4-2\" data-name=\"resume plate body\">\n<div class=\"file\" data-kid=\"3-2-4-2-1\" data-name=\"uploaded resume file row\">\n<span class=\"fi\" data-kid=\"3-2-4-2-1-1\" data-name=\"resume file icon tile\"><i class=\"ti ti-file-text\" data-kid=\"3-2-4-2-1-1-1\" data-name=\"file text icon\"></i></span>\n<div data-kid=\"3-2-4-2-1-2\" data-name=\"resume file details\"><b data-kid=\"3-2-4-2-1-2-1\" data-name=\"resume file name\">Arjun_Verma_Resume.pdf</b><span data-kid=\"3-2-4-2-1-2-2\" data-name=\"resume file metadata\">1 page, 96 KB, parsed 9 Nov 2026</span></div>\n<span class=\"acts\" data-kid=\"3-2-4-2-1-3\" data-name=\"resume file actions\"><a data-kid=\"3-2-4-2-1-3-1\" data-name=\"replace resume link\" href=\"#\">Replace</a><a data-kid=\"3-2-4-2-1-3-2\" data-name=\"remove resume link\" href=\"#\">Remove</a></span>\n</div>\n<p class=\"hint\" data-kid=\"3-2-4-2-2\" data-name=\"resume usage hint text\" style=\"margin-top:9px\">Project and internship sections are read for follow-up questions.</p>\n</div>\n</section>\n</div>\n<aside data-kid=\"3-3\" data-name=\"session summary sidebar\">\n<div class=\"brief\" data-kid=\"3-3-1\" data-name=\"session brief card\">\n<div class=\"brief-h\" data-kid=\"3-3-1-1\" data-name=\"session brief header\"><h3 data-kid=\"3-3-1-1-1\" data-name=\"session brief title\">Session brief</h3><span class=\"dot\" data-kid=\"3-3-1-1-2\" data-name=\"session brief accent dot\"></span></div>\n<div class=\"brief-b\" data-kid=\"3-3-1-2\" data-name=\"session brief body\">\n<div class=\"brow\" data-kid=\"3-3-1-2-1\" data-name=\"category summary row\"><span class=\"q\" data-kid=\"3-3-1-2-1-1\" data-name=\"category summary marker\"></span><span data-kid=\"3-3-1-2-1-2\" data-name=\"category summary label\">Category</span><b data-kid=\"3-3-1-2-1-3\" data-name=\"category summary value\">Technical</b></div>\n<div class=\"brow\" data-kid=\"3-3-1-2-2\" data-name=\"course summary row\"><span class=\"q\" data-kid=\"3-3-1-2-2-1\" data-name=\"course summary marker\"></span><span data-kid=\"3-3-1-2-2-2\" data-name=\"course summary label\">Course</span><b data-kid=\"3-3-1-2-2-3\" data-name=\"course summary value\">B.Tech CSE</b></div>\n<div class=\"brow\" data-kid=\"3-3-1-2-3\" data-name=\"chair summary row\"><span class=\"q\" data-kid=\"3-3-1-2-3-1\" data-name=\"chair summary marker\"></span><span data-kid=\"3-3-1-2-3-2\" data-name=\"chair summary label\">Chair</span><b data-kid=\"3-3-1-2-3-3\" data-name=\"chair summary value\">Technical Expert</b></div>\n<div class=\"brow\" data-kid=\"3-3-1-2-4\" data-name=\"difficulty summary row\"><span class=\"q\" data-kid=\"3-3-1-2-4-1\" data-name=\"difficulty summary marker\"></span><span data-kid=\"3-3-1-2-4-2\" data-name=\"difficulty summary label\">Difficulty</span><b data-kid=\"3-3-1-2-4-3\" data-name=\"difficulty summary value\">Medium</b></div>\n<div class=\"brow\" data-kid=\"3-3-1-2-5\" data-name=\"length summary row\"><span class=\"q\" data-kid=\"3-3-1-2-5-1\" data-name=\"length summary marker\"></span><span data-kid=\"3-3-1-2-5-2\" data-name=\"length summary label\">Length</span><b data-kid=\"3-3-1-2-5-3\" data-name=\"length summary value\">30 min</b></div>\n<div class=\"brow\" data-kid=\"3-3-1-2-6\" data-name=\"language summary row\"><span class=\"q\" data-kid=\"3-3-1-2-6-1\" data-name=\"language summary marker\"></span><span data-kid=\"3-3-1-2-6-2\" data-name=\"language summary label\">Language</span><b data-kid=\"3-3-1-2-6-3\" data-name=\"language summary value\">English</b></div>\n<div class=\"brow\" data-kid=\"3-3-1-2-7\" data-name=\"mode summary row\"><span class=\"q\" data-kid=\"3-3-1-2-7-1\" data-name=\"mode summary marker\"></span><span data-kid=\"3-3-1-2-7-2\" data-name=\"mode summary label\">Mode</span><b data-kid=\"3-3-1-2-7-3\" data-name=\"mode summary value\">Voice</b></div>\n<div class=\"brow\" data-kid=\"3-3-1-2-8\" data-name=\"coding summary row\" style=\"border-bottom:0\"><span class=\"q\" data-kid=\"3-3-1-2-8-1\" data-name=\"coding summary marker\"></span><span data-kid=\"3-3-1-2-8-2\" data-name=\"coding summary label\">Coding</span><b data-kid=\"3-3-1-2-8-3\" data-name=\"coding summary value\">On</b></div>\n<div class=\"checks\" data-kid=\"3-3-1-2-9\" data-name=\"pre-start checklist\">\n<h4 data-kid=\"3-3-1-2-9-1\" data-name=\"pre-start checklist heading\">Before you start</h4>\n<div class=\"chk\" data-kid=\"3-3-1-2-9-2\" data-name=\"resume parsed check item\"><i class=\"ti ti-check\" data-kid=\"3-3-1-2-9-2-1\" data-name=\"resume parsed check icon\"></i>Resume parsed</div>\n<div class=\"chk\" data-kid=\"3-3-1-2-9-3\" data-name=\"question bank check item\"><i class=\"ti ti-check\" data-kid=\"3-3-1-2-9-3-1\" data-name=\"question bank check icon\"></i>Question bank loaded: 12 questions</div>\n<div class=\"chk pending\" data-kid=\"3-3-1-2-9-4\" data-name=\"microphone permission pending item\"><i class=\"ti ti-microphone\" data-kid=\"3-3-1-2-9-4-1\" data-name=\"microphone pending icon\"></i>Microphone permission</div>\n<div class=\"chk\" data-kid=\"3-3-1-2-9-5\" data-name=\"timer start note item\"><i class=\"ti ti-clock\" data-kid=\"3-3-1-2-9-5-1\" data-name=\"timer clock icon\"></i>Timer starts on the first question</div>\n</div>\n</div>\n<a class=\"brief-cta\" data-kid=\"3-3-1-3\" data-name=\"start interview call-to-action button\" href=\"/interview/session/sess_71bd\" id=\"start\"><i class=\"ti ti-player-play\" data-kid=\"3-3-1-3-1\" data-name=\"play icon\"></i>Start interview</a>\n<p class=\"brief-micro\" data-kid=\"3-3-1-4\" data-name=\"answer autosave and pause note\">Answers are saved as you go. Leaving the tab pauses the clock for up to 30 minutes.</p>\n<a class=\"brief-save\" data-kid=\"3-3-1-5\" data-name=\"save defaults link\" href=\"/dashboard/settings\"><i class=\"ti ti-device-floppy\" data-kid=\"3-3-1-5-1\" data-name=\"save floppy icon\"></i>Save these as my defaults</a>\n</div>\n<div class=\"side-note\" data-kid=\"3-3-2\" data-name=\"scoring rubric note card\">\n<h4 data-kid=\"3-3-2-1\" data-name=\"scoring rubric heading\">Scoring rubric</h4>\n<p data-kid=\"3-3-2-2\" data-name=\"scoring rubric description text\">Technical accuracy, problem solving, coding correctness where applicable, structure, communication and time management.</p>\n</div>\n</aside>\n</main>",
      "comments": [],
      "created": "2026-11-10T15:17:44.320995+00:00",
      "modified": "2026-11-10T15:21:05.960934+00:00",
      "id": "var_e119a86f0e0e",
      "contentHeight": 1258
    },
    "var_38fee1f1d44d": {
      "type": "variant",
      "label": "Live Interview Room — V1 Baltic",
      "parentId": "var_e119a86f0e0e",
      "themeId": null,
      "rect": {
        "x": 6900,
        "y": 0,
        "w": 1280,
        "h": 0
      },
      "html": "<style>\n@import url('https://fonts.googleapis.com/css2?family=Kumbh+Sans:wght@400;500;600;700&family=Share+Tech+Mono&display=swap');\n@import url(\"https://cdn.jsdelivr.net/npm/lucide-static@1.48.0/font/lucide.css\");\n:root{\n  --room:#0E2233; --plate:#142D3F; --plate2:#183445; --line:rgba(242,244,255,.13);\n  --text:#F2F4FF; --muted:rgba(242,244,255,.6); --dim:rgba(242,244,255,.38);\n  --ice:#96C5F7; --ice2:#A9D3FF; --baltic:#006494;\n}\n*{box-sizing:border-box}\nbody{margin:0;background:var(--room);color:var(--text);font-family:'Kumbh Sans',system-ui,sans-serif;-webkit-font-smoothing:antialiased;font-size:14px}\nh1,h2,h3,h4,p,ul{margin:0;padding:0}ul{list-style:none}\na{text-decoration:none;color:inherit}\n.mono{font-family:'Share Tech Mono',ui-monospace,monospace}\n.room{min-height:860px;display:flex;flex-direction:column}\n\n/* top bar */\n.rbar{height:58px;border-bottom:1px solid var(--line);display:flex;align-items:center;gap:16px;padding:0 22px;background:#0B1B29}\n.rbrand{display:flex;align-items:center;gap:8px;font-size:14px;font-weight:600}\n.mark{width:22px;height:22px;border-radius:3px;background:var(--ice);display:flex;align-items:flex-end;justify-content:center;gap:2px;padding:5px 4px}\n.mark i{display:block;width:2px;background:#0B1B29;border-radius:1px}\n.mark i:nth-child(1){height:60%}.mark i:nth-child(2){height:100%}.mark i:nth-child(3){height:44%}\n.smeta{display:flex;align-items:center;gap:6px;margin-left:8px;padding-left:14px;border-left:1px solid var(--line)}\n.tag{font-size:10.5px;border:1px solid var(--line);border-radius:3px;padding:3px 7px;color:var(--muted)}\n.tag.hi{background:var(--ice);border-color:var(--ice);color:#0B1B29;font-weight:600}\n.rbar-center{margin-left:auto;display:flex;align-items:center;gap:14px}\n.clock{display:flex;align-items:center;gap:8px;background:rgba(150,197,247,.1);border:1px solid rgba(150,197,247,.28);padding:5px 10px;border-radius:4px}\n.clock i{font-size:13px;color:var(--ice)}\n.clock b{font-family:'Share Tech Mono',monospace;font-size:14px;font-weight:400;letter-spacing:.04em}\n.clock span{font-size:10px;color:var(--dim);text-transform:uppercase;letter-spacing:.07em}\n.qcount{font-family:'Share Tech Mono',monospace;font-size:11.5px;color:var(--muted)}\n.rbar-right{display:flex;align-items:center;gap:8px;margin-left:18px}\n.btn-end{display:inline-flex;align-items:center;gap:6px;font-size:12px;font-weight:600;border:1px solid rgba(242,244,255,.3);padding:7px 12px;border-radius:4px;color:var(--text)}\n.btn-end:hover{background:rgba(242,244,255,.08)}\n.icon-btn{width:30px;height:30px;border:1px solid var(--line);border-radius:4px;display:flex;align-items:center;justify-content:center;font-size:13px;color:var(--muted)}\n\n/* grid */\n.rgrid{flex:1;display:grid;grid-template-columns:236px minmax(0,1fr) 288px;gap:0}\n\n/* agenda */\n.agenda{border-right:1px solid var(--line);padding:16px 14px;background:#0B1B29}\n.agenda h3{font-size:9.5px;letter-spacing:.14em;text-transform:uppercase;color:var(--dim);font-weight:500;margin-bottom:11px}\n.qitem{display:grid;grid-template-columns:20px 1fr;gap:8px;align-items:center;padding:7px 6px;font-size:11.5px;color:var(--muted);border-radius:3px}\n.qitem .n{font-family:'Share Tech Mono',monospace;font-size:10px;color:var(--dim)}\n.qitem.done{color:var(--dim)}\n.qitem.done .n{color:var(--ice)}\n.qitem.now{background:rgba(150,197,247,.14);color:var(--text);font-weight:600}\n.qitem.now .n{color:var(--ice)}\n.qitem.now:after{content:\"\";justify-self:end}\n.agenda-foot{margin-top:14px;padding-top:12px;border-top:1px solid var(--line)}\n.agenda-foot .row{display:flex;justify-content:space-between;font-size:10px;color:var(--dim);padding:3px 0}\n.agenda-foot b{color:var(--muted);font-weight:600}\n\n/* stage */\n.stage{padding:18px 22px 22px}\n.q-block{background:var(--plate);border:1px solid var(--line);border-radius:6px;padding:16px 18px}\n.q-top{display:flex;align-items:center;gap:8px;font-size:9.5px;letter-spacing:.12em;text-transform:uppercase;color:var(--dim);margin-bottom:9px}\n.q-top b{color:var(--ice);letter-spacing:.04em;font-weight:400;font-family:'Share Tech Mono',monospace;text-transform:none;font-size:11px}\n.q-top .sp{margin-left:auto;display:flex;align-items:center;gap:6px;font-size:10.5px;letter-spacing:0;text-transform:none;color:var(--muted);border:1px solid var(--line);padding:3px 8px;border-radius:3px}\n.q-text{font-size:20px;line-height:1.42;letter-spacing:-.01em;font-weight:500}\n.q-sub{font-size:11.5px;color:var(--dim);margin-top:8px}\n\n/* answer zone */\n.answer{margin-top:12px;background:var(--plate2);border:1px solid var(--line);border-radius:6px;padding:14px 16px 12px}\n.a-top{display:flex;align-items:center;gap:9px;font-size:9.5px;letter-spacing:.12em;text-transform:uppercase;color:var(--dim)}\n.a-top .live{margin-left:auto;display:inline-flex;align-items:center;gap:6px;color:var(--ice);letter-spacing:.04em}\n.pulse{width:6px;height:6px;border-radius:50%;background:var(--ice);animation:bl 1.5s ease-in-out infinite}\n@keyframes bl{0%,100%{opacity:.3}50%{opacity:1}}\n.transcript{margin-top:10px;font-size:14.5px;line-height:1.62;color:var(--text);min-height:74px}\n.transcript .dim{color:var(--dim)}\n.caret{display:inline-block;width:1.5px;height:16px;background:var(--ice);vertical-align:-3px;animation:bl 1s steps(2) infinite}\n.editrow{display:flex;align-items:center;gap:12px;margin-top:8px;border-top:1px solid var(--line);padding-top:9px}\n.editrow span{font-size:10.5px;color:var(--dim)}\n.editrow a{margin-left:auto;font-size:11px;color:var(--ice);border-bottom:1px solid rgba(150,197,247,.4);padding-bottom:1px}\n\n/* meter + controls */\n.voice-row{display:grid;grid-template-columns:1fr auto;gap:16px;align-items:center;margin-top:12px;background:var(--plate);border:1px solid var(--line);border-radius:6px;padding:12px 16px}\n.meter{display:flex;align-items:flex-end;gap:3px;height:44px}\n.meter i{flex:1;background:rgba(150,197,247,.22);border-radius:1px}\n.meter i.on{background:var(--ice)}\n.meter i:nth-child(1){height:30%}.meter i:nth-child(2){height:56%}.meter i:nth-child(3){height:82%}\n.meter i:nth-child(4){height:64%}.meter i:nth-child(5){height:94%}.meter i:nth-child(6){height:72%}\n.meter i:nth-child(7){height:44%}.meter i:nth-child(8){height:26%}.meter i:nth-child(9){height:18%}\n.meter i:nth-child(10){height:12%}.meter i:nth-child(11){height:8%}.meter i:nth-child(12){height:5%}\n.meter-label{display:flex;align-items:center;gap:8px;font-family:'Share Tech Mono',monospace;font-size:10px;color:var(--dim);margin-top:6px}\n.controls{display:flex;align-items:center;gap:8px}\n.cbtn{width:38px;height:38px;border-radius:6px;border:1px solid var(--line);display:flex;align-items:center;justify-content:center;font-size:15px;color:var(--text);background:rgba(242,244,255,.04)}\n.cbtn.mic{width:52px;height:52px;border-radius:50%;background:var(--ice);border-color:var(--ice);color:#0B1B29;font-size:20px;box-shadow:0 0 0 6px rgba(150,197,247,.14)}\n.cbtn:hover{background:rgba(242,244,255,.1)}\n.submit{display:inline-flex;align-items:center;gap:8px;background:linear-gradient(90deg,#4F46E5,#2563EB);color:#fff;font-size:13px;font-weight:600;padding:11px 18px;border-radius:5px;margin-left:4px}\n.submit:hover{filter:brightness(1.07)}\n.disclaimer{margin-top:10px;font-size:10.5px;color:var(--dim);line-height:1.5}\n\n/* side */\n.side{border-left:1px solid var(--line);padding:16px 14px;background:#0B1B29}\n.who{display:flex;align-items:center;gap:10px;padding-bottom:12px;border-bottom:1px solid var(--line)}\n.who .mono-mark{width:38px;height:38px;border-radius:4px;background:rgba(150,197,247,.14);border:1px solid rgba(150,197,247,.3);display:flex;align-items:center;justify-content:center;font-family:'Share Tech Mono',monospace;font-size:12px;color:var(--ice)}\n.who b{display:block;font-size:12.5px;font-weight:600}\n.who span{display:block;font-size:10px;color:var(--dim);margin-top:2px}\n.side h4{font-size:9px;letter-spacing:.14em;text-transform:uppercase;color:var(--dim);font-weight:500;margin:14px 0 8px}\n.fact{display:flex;align-items:baseline;justify-content:space-between;gap:10px;font-size:11px;padding:5px 0;border-bottom:1px solid rgba(242,244,255,.08)}\n.fact span{color:var(--dim)}\n.fact b{font-weight:600;font-size:11px}\n.prog{margin-top:4px}\n.prog-top{display:flex;justify-content:space-between;font-size:10px;color:var(--dim);margin-bottom:5px}\n.bar{height:5px;background:rgba(242,244,255,.12);border-radius:3px;overflow:hidden}\n.bar i{display:block;height:100%;width:50%;background:var(--ice)}\n.note{background:rgba(150,197,247,.08);border:1px solid rgba(150,197,247,.2);border-radius:5px;padding:10px 11px;margin-top:14px}\n.note b{font-size:10.5px;display:flex;align-items:center;gap:6px;color:var(--ice2);font-weight:600}\n.note p{font-size:10px;color:var(--muted);line-height:1.5;margin-top:5px}\n.side-foot{margin-top:14px;padding-top:12px;border-top:1px solid var(--line);display:flex;flex-direction:column;gap:8px}\n.side-foot a{display:flex;align-items:center;gap:7px;font-size:11px;color:var(--muted)}\n.side-foot a i{font-size:13px}\n\n.history{margin-top:16px;border-top:1px solid var(--line);padding-top:14px}\n.h-top{display:flex;align-items:center;justify-content:space-between;font-size:9.5px;letter-spacing:.12em;text-transform:uppercase;color:var(--dim);margin-bottom:8px}\n.turn{padding:10px 0;border-bottom:1px solid rgba(242,244,255,.07)}\n.turn:last-child{border-bottom:0}\n.t-q{font-size:12px;font-weight:600;color:var(--muted);display:flex;gap:7px;align-items:baseline}\n.t-q b{font-family:'Share Tech Mono',monospace;font-weight:400;font-size:10.5px;color:var(--ice)}\n.t-a{font-size:11.5px;line-height:1.6;color:var(--dim);margin-top:4px;padding-left:26px}\n\n@media (max-width:1100px){\n  .rgrid{grid-template-columns:1fr}\n  .agenda,.side{display:none}\n}\n@media (max-width:720px){\n  .rbar{padding:0 14px;height:52px}\n  .smeta{display:none}\n  .qcount{display:none}\n  .stage{padding:14px}\n  .q-text{font-size:17px}\n  .voice-row{grid-template-columns:1fr;gap:12px}\n  .controls{flex-wrap:wrap}\n}\n</style>\n<div class=\"room\" data-kid=\"1\" data-name=\"page layout container\">\n<header class=\"rbar\" data-kid=\"1-1\" data-name=\"main top navigation bar\">\n<a class=\"rbrand\" data-kid=\"1-1-1\" data-name=\"app brand logo and name link\" href=\"/\"><span class=\"mark\" data-kid=\"1-1-1-1\" data-name=\"logo mark with equalizer bars\"><i data-kid=\"1-1-1-1-1\" data-name=\"equalizer bar (short)\"></i><i data-kid=\"1-1-1-1-2\" data-name=\"equalizer bar (tall)\"></i><i data-kid=\"1-1-1-1-3\" data-name=\"equalizer bar (mid-low)\"></i></span>MockMate AI</a>\n<div class=\"smeta\" data-kid=\"1-1-2\" data-name=\"question metadata tags group\">\n<span class=\"tag hi\" data-kid=\"1-1-2-1\" data-name=\"interview type tag (Technical)\">Technical</span>\n<span class=\"tag\" data-kid=\"1-1-2-2\" data-name=\"exam and course tag\">BCA · Computer Applications</span>\n<span class=\"tag\" data-kid=\"1-1-2-3\" data-name=\"difficulty tag (Medium)\">Medium</span>\n<span class=\"tag\" data-kid=\"1-1-2-4\" data-name=\"interviewer persona tag\">Technical Expert</span>\n</div>\n<div class=\"rbar-center\" data-kid=\"1-1-3\" data-name=\"top bar center info group\">\n<span class=\"qcount\" data-dynamic=\"true\" data-kid=\"1-1-3-1\" data-name=\"question progress counter (Q6/12)\" data-reason=\"text reflects dynamic question index updated as interview advances\">Q6 / 12</span>\n<span class=\"clock\" data-kid=\"1-1-3-2\" data-name=\"countdown timer chip\"><i class=\"icon-timer\" data-kid=\"1-1-3-2-1\" data-name=\"timer icon\"></i><b data-dynamic=\"true\" data-kid=\"1-1-3-2-2\" data-name=\"remaining time value\" data-reason=\"time text decrements every second by clock script\">18:42</b><span data-kid=\"1-1-3-2-3\" data-name=\"time unit label (left)\">left</span></span>\n</div>\n<div class=\"rbar-right\" data-kid=\"1-1-4\" data-name=\"top bar right actions group\">\n<span class=\"icon-btn\" data-kid=\"1-1-4-1\" data-name=\"volume icon button\"><i class=\"icon-volume-2\" data-kid=\"1-1-4-1-1\" data-name=\"volume icon\"></i></span>\n<a class=\"btn-end\" data-kid=\"1-1-4-2\" data-name=\"end interview button link\" href=\"/dashboard/interviews\"><i class=\"icon-phone-off\" data-kid=\"1-1-4-2-1\" data-name=\"phone-off exit icon\"></i>End interview</a>\n</div>\n</header>\n<div class=\"rgrid\" data-kid=\"1-2\" data-name=\"main content grid (agenda/stage/side)\">\n<aside class=\"agenda\" data-kid=\"1-2-1\" data-name=\"question agenda sidebar\">\n<h3 data-kid=\"1-2-1-1\" data-name=\"agenda heading (Questions)\">Questions</h3>\n<div class=\"qitem done\" data-kid=\"1-2-1-2\" data-name=\"agenda item (done): final-year project\"><span class=\"n\" data-kid=\"1-2-1-2-1\" data-name=\"question number 01\">01</span>Final-year project</div>\n<div class=\"qitem done\" data-kid=\"1-2-1-3\" data-name=\"agenda item (done): database schema\"><span class=\"n\" data-kid=\"1-2-1-3-1\" data-name=\"question number 02\">02</span>Database schema</div>\n<div class=\"qitem done\" data-kid=\"1-2-1-4\" data-name=\"agenda item (done): normal forms\"><span class=\"n\" data-kid=\"1-2-1-4-1\" data-name=\"question number 03\">03</span>Normal forms</div>\n<div class=\"qitem done\" data-kid=\"1-2-1-5\" data-name=\"agenda item (done): indexes\"><span class=\"n\" data-kid=\"1-2-1-5-1\" data-name=\"question number 04\">04</span>Indexes</div>\n<div class=\"qitem done\" data-kid=\"1-2-1-6\" data-name=\"agenda item (done): session handling\"><span class=\"n\" data-kid=\"1-2-1-6-1\" data-name=\"question number 05\">05</span>Session handling</div>\n<div class=\"qitem now\" data-kid=\"1-2-1-7\" data-name=\"current agenda item: webhook retries\"><span class=\"n\" data-kid=\"1-2-1-7-1\" data-name=\"question number 06\">06</span>Webhook retries</div>\n<div class=\"qitem\" data-kid=\"1-2-1-8\" data-name=\"agenda item: caching layer\"><span class=\"n\" data-kid=\"1-2-1-8-1\" data-name=\"question number 07\">07</span>Caching layer</div>\n<div class=\"qitem\" data-kid=\"1-2-1-9\" data-name=\"agenda item: auth and roles\"><span class=\"n\" data-kid=\"1-2-1-9-1\" data-name=\"question number 08\">08</span>Auth and roles</div>\n<div class=\"qitem\" data-kid=\"1-2-1-10\" data-name=\"agenda item: test strategy\"><span class=\"n\" data-kid=\"1-2-1-10-1\" data-name=\"question number 09\">09</span>Test strategy</div>\n<div class=\"qitem\" data-kid=\"1-2-1-11\" data-name=\"agenda item: deployment\"><span class=\"n\" data-kid=\"1-2-1-11-1\" data-name=\"question number 10\">10</span>Deployment</div>\n<div class=\"qitem\" data-kid=\"1-2-1-12\" data-name=\"agenda item: team conflict\"><span class=\"n\" data-kid=\"1-2-1-12-1\" data-name=\"question number 11\">11</span>Team conflict</div>\n<div class=\"qitem\" data-kid=\"1-2-1-13\" data-name=\"agenda item: your questions\"><span class=\"n\" data-kid=\"1-2-1-13-1\" data-name=\"question number 12\">12</span>Your questions</div>\n</aside>\n<section class=\"stage\" data-kid=\"1-2-2\" data-name=\"interview stage main panel\">\n<div class=\"q-block\" data-kid=\"1-2-2-1\" data-name=\"current question card\">\n<div class=\"q-top\" data-kid=\"1-2-2-1-1\" data-name=\"question card header\">\n<b data-kid=\"1-2-2-1-1-1\" data-name=\"question number label (Q6)\">Q6</b>Technical Expert asking\n          <span class=\"sp\" data-kid=\"1-2-2-1-1-2\" data-name=\"replay question button\"><i class=\"icon-repeat\" data-kid=\"1-2-2-1-1-2-1\" data-name=\"repeat icon\"></i>Replay question</span>\n</div>\n<p class=\"q-text\" data-kid=\"1-2-2-1-2\" data-name=\"question prompt text\">You mentioned a payment webhook in your project. What happens when the same event arrives twice?</p>\n<p class=\"q-sub\" data-kid=\"1-2-2-1-3\" data-name=\"question instruction subtext\">Answer in English. Switch to typed answers at any time.</p>\n</div>\n<div class=\"answer\" data-kid=\"1-2-2-2\" data-name=\"answer zone card\">\n<div class=\"a-top\" data-kid=\"1-2-2-2-1\" data-name=\"answer zone header\">\n<i class=\"icon-mic\" data-kid=\"1-2-2-2-1-1\" data-name=\"mic icon\" style=\"font-size:12px;color:var(--ice)\"></i>Your answer\n          <span class=\"live\" data-dynamic=\"true\" data-kid=\"1-2-2-2-1-2\" data-name=\"live listening status badge\" data-reason=\"listening timer text updates every second\"><span class=\"pulse\" data-kid=\"1-2-2-2-1-2-1\" data-name=\"blinking pulse indicator dot\"></span>Listening · 00:14</span>\n</div>\n<p class=\"transcript\" data-dynamic=\"true\" data-kid=\"1-2-2-2-2\" data-name=\"live transcription text of user answer\" data-reason=\"transcript text is incrementally replaced by speech recognition stream\">I store the event id before I process it, so if the same webhook comes in again the lookup fails and I return a 200 without charging again<span class=\"caret\" data-kid=\"1-2-2-2-2-1\" data-name=\"blinking text caret\"></span><span class=\"dim\" data-kid=\"1-2-2-2-2-2\" data-name=\"dim trailing ellipsis\"> …</span></p>\n<div class=\"editrow\" data-kid=\"1-2-2-2-3\" data-name=\"answer edit row\">\n<span data-kid=\"1-2-2-2-3-1\" data-name=\"edit hint text\">Transcription is editable before you submit.</span>\n<a data-kid=\"1-2-2-2-3-2\" data-name=\"edit answer link\" href=\"#\">Edit answer</a>\n</div>\n</div>\n<div class=\"voice-row\" data-kid=\"1-2-2-3\" data-name=\"voice controls row (mic meter + buttons)\">\n<div data-kid=\"1-2-2-3-1\" data-name=\"mic level meter wrapper\">\n<div class=\"meter\" data-kid=\"1-2-2-3-1-1\" data-name=\"voice level meter bars\">\n<i class=\"on\" data-kid=\"1-2-2-3-1-1-1\" data-name=\"meter bar (active)\"></i><i class=\"on\" data-kid=\"1-2-2-3-1-1-2\" data-name=\"meter bar (active)\"></i><i class=\"on\" data-kid=\"1-2-2-3-1-1-3\" data-name=\"meter bar (active)\"></i><i class=\"on\" data-kid=\"1-2-2-3-1-1-4\" data-name=\"meter bar (active)\"></i><i class=\"on\" data-kid=\"1-2-2-3-1-1-5\" data-name=\"meter bar (active)\"></i><i class=\"on\" data-kid=\"1-2-2-3-1-1-6\" data-name=\"meter bar (active)\"></i><i class=\"on\" data-kid=\"1-2-2-3-1-1-7\" data-name=\"meter bar (active)\"></i><i data-kid=\"1-2-2-3-1-1-8\" data-name=\"meter bar (partially on)\" style=\"height:22%\"></i><i data-kid=\"1-2-2-3-1-1-9\" data-name=\"meter bar (idle)\"></i><i data-kid=\"1-2-2-3-1-1-10\" data-name=\"meter bar (idle)\"></i><i data-kid=\"1-2-2-3-1-1-11\" data-name=\"meter bar (idle)\"></i><i data-kid=\"1-2-2-3-1-1-12\" data-name=\"meter bar (idle)\"></i>\n</div>\n<div class=\"meter-label\" data-kid=\"1-2-2-3-1-2\" data-name=\"meter reading label row\"><span data-kid=\"1-2-2-3-1-2-1\" data-name=\"MIC LEVEL label\">MIC LEVEL</span><span data-dynamic=\"true\" data-kid=\"1-2-2-3-1-2-2\" data-name=\"mic decibel reading\" data-reason=\"dB value reinitialized from audio level input from mic stream\">-12 dB</span><span data-kid=\"1-2-2-3-1-2-3\" data-name=\"connection status (CONNECTED)\" style=\"margin-left:auto\">CONNECTED</span></div>\n</div>\n<div class=\"controls\" data-kid=\"1-2-2-3-2\" data-name=\"voice control buttons group\">\n<span class=\"cbtn\" data-kid=\"1-2-2-3-2-1\" data-name=\"switch to keyboard input button\"><i class=\"icon-keyboard\" data-kid=\"1-2-2-3-2-1-1\" data-name=\"keyboard icon\"></i></span>\n<span class=\"cbtn mic\" data-kid=\"1-2-2-3-2-2\" data-name=\"primary mic toggle button\"><i class=\"icon-mic\" data-kid=\"1-2-2-3-2-2-1\" data-name=\"mic icon\"></i></span>\n<span class=\"cbtn\" data-kid=\"1-2-2-3-2-3\" data-name=\"pause voice input button\"><i class=\"icon-pause\" data-kid=\"1-2-2-3-2-3-1\" data-name=\"pause icon\"></i></span>\n<a class=\"submit\" data-kid=\"1-2-2-3-2-4\" data-name=\"submit answer call-to-action button\" href=\"#\"><i class=\"icon-arrow-right\" data-kid=\"1-2-2-3-2-4-1\" data-name=\"arrow-right icon\"></i>Submit answer</a>\n</div>\n</div>\n<p class=\"disclaimer\" data-kid=\"1-2-2-4\" data-name=\"submission disclaimer text\">Submitting ends your turn. The interviewer scores this answer privately and moves to the next question.</p>\n<div class=\"history\" data-kid=\"1-2-2-5\" data-name=\"interview history section\">\n<div class=\"h-top\" data-kid=\"1-2-2-5-1\" data-name=\"history header (Earlier in this interview)\">Earlier in this interview<span data-kid=\"1-2-2-5-1-1\" data-name=\"history turn count badge\">5 turns</span></div>\n<div class=\"turn\" data-kid=\"1-2-2-5-2\" data-name=\"history turn: question 5 with answer\">\n<div class=\"t-q\" data-kid=\"1-2-2-5-2-1\" data-name=\"history question header (Q5)\"><b data-kid=\"1-2-2-5-2-1-1\" data-name=\"history question number\">Q5</b>How are sessions stored between requests?</div>\n<div class=\"t-a\" data-kid=\"1-2-2-5-2-2\" data-name=\"history answer text\">I used a signed cookie holding the session id, and kept the actual session record in Postgres with an expiry column. Middleware rejects a request if the row is expired.</div>\n</div>\n<div class=\"turn\" data-kid=\"1-2-2-5-3\" data-name=\"history turn: question 4 with answer\">\n<div class=\"t-q\" data-kid=\"1-2-2-5-3-1\" data-name=\"history question header (Q4)\"><b data-kid=\"1-2-2-5-3-1-1\" data-name=\"history question number\">Q4</b>Which column did you index, and why that one?</div>\n<div class=\"t-a\" data-kid=\"1-2-2-5-3-2\" data-name=\"history answer text\">Event id, because every webhook lookup filters on it and it is unique. The lookup was a sequential scan before that.</div>\n</div>\n</div>\n</section>\n<aside class=\"side\" data-kid=\"1-2-3\" data-name=\"right sidebar panel\">\n<div class=\"who\" data-kid=\"1-2-3-1\" data-name=\"interviewer identity header\">\n<span class=\"mono-mark\" data-kid=\"1-2-3-1-1\" data-name=\"interviewer initials monogram (TE)\">TE</span>\n<div data-kid=\"1-2-3-1-2\" data-name=\"interviewer name and role text\"><b data-kid=\"1-2-3-1-2-1\" data-name=\"interviewer name label\">Technical Expert</b><span data-kid=\"1-2-3-1-2-2\" data-name=\"interviewer behavior description\">Follows project decisions to fundamentals</span></div>\n</div>\n<h4 data-kid=\"1-2-3-2\" data-name=\"Session section heading\">Session</h4>\n<div class=\"fact\" data-kid=\"1-2-3-3\" data-name=\"session fact row: Course/false\"><span data-kid=\"1-2-3-3-1\" data-name=\"Session fact label (Course)\">Course</span><b data-kid=\"1-2-3-3-2\" data-name=\"Session fact value (BCA)\">BCA</b></div>\n<div class=\"fact\" data-kid=\"1-2-3-4\" data-name=\"session fact row: Difficulty\"><span data-kid=\"1-2-3-4-1\" data-name=\"Session fact label (Difficulty)\">Difficulty</span><b data-kid=\"1-2-3-4-2\" data-name=\"Session fact value (Medium)\">Medium</b></div>\n<div class=\"fact\" data-kid=\"1-2-3-5\" data-name=\"session fact row: Language\"><span data-kid=\"1-2-3-5-1\" data-name=\"Session fact label (Language)\">Language</span><b data-kid=\"1-2-3-5-2\" data-name=\"Session fact value (English)\">English</b></div>\n<div class=\"fact\" data-kid=\"1-2-3-6\" data-name=\"session fact row: Mode\"><span data-kid=\"1-2-3-6-1\" data-name=\"Session fact label (Mode)\">Mode</span><b data-kid=\"1-2-3-6-2\" data-name=\"Session fact value (Voice)\">Voice</b></div>\n<div class=\"fact\" data-kid=\"1-2-3-7\" data-name=\"session fact row: Resume\" style=\"border-bottom:0\"><span data-kid=\"1-2-3-7-1\" data-name=\"Session fact label (Resume)\">Resume</span><b data-kid=\"1-2-3-7-2\" data-name=\"Session fact value (On)\">On</b></div>\n<h4 data-kid=\"1-2-3-8\" data-name=\"Progress section heading\">Progress</h4>\n<div class=\"prog\" data-kid=\"1-2-3-9\" data-name=\"interview progress meter\">\n<div class=\"prog-top\" data-kid=\"1-2-3-9-1\" data-name=\"progress meter top labels\"><span data-kid=\"1-2-3-9-1-1\" data-name=\"progress question count text\">6 of 12 questions</span><span class=\"mono\" data-kid=\"1-2-3-9-1-2\" data-name=\"progress percentage text\">50%</span></div>\n<div class=\"bar\" data-kid=\"1-2-3-9-2\" data-name=\"progress bar track\"><i data-kid=\"1-2-3-9-2-1\" data-name=\"progress bar fill\"></i></div>\n</div>\n<div class=\"note\" data-kid=\"1-2-3-10\" data-name=\"informational note card (scores hidden)\">\n<b data-kid=\"1-2-3-10-1\" data-name=\"note title (lock icon + text)\"><i class=\"icon-lock\" data-kid=\"1-2-3-10-1-1\" data-name=\"lock icon\"></i>Scores stay hidden</b>\n<p data-kid=\"1-2-3-10-2\" data-name=\"note body text\">Every answer is scored against the BCA rubric. The full report opens when the interview ends.</p>\n</div>\n<div class=\"side-foot\" data-kid=\"1-2-3-11\" data-name=\"sidebar footer action links\">\n<a data-kid=\"1-2-3-11-1\" data-name=\"pause interview action link\" href=\"#\"><i class=\"icon-pause-circle\" data-kid=\"1-2-3-11-1-1\" data-name=\"pause-circle icon\"></i>Pause interview</a>\n<a data-kid=\"1-2-3-11-2\" data-name=\"report a problem action link\" href=\"#\"><i class=\"icon-flag\" data-kid=\"1-2-3-11-2-1\" data-name=\"flag icon\"></i>Report a problem</a>\n</div>\n</aside>\n</div>\n</div>",
      "comments": [],
      "created": "2026-11-10T15:18:15.051563+00:00",
      "modified": "2026-11-10T15:20:51.555746+00:00",
      "id": "var_38fee1f1d44d",
      "contentHeight": 860
    },
    "var_2ed5e3858b14": {
      "type": "variant",
      "label": "Live Interview Room — V2 Risograph",
      "parentId": "var_38fee1f1d44d",
      "themeId": null,
      "rect": {
        "x": 8280,
        "y": 0,
        "w": 1280,
        "h": 0
      },
      "html": "<style>\n@import url('https://fonts.googleapis.com/css2?family=Cardo:ital,wght@0,400;0,700;1,400&family=Albert+Sans:wght@400;500;600;700&display=swap');\n@import url(\"https://cdn.jsdelivr.net/npm/@phosphor-icons/web@2.1.2/src/regular/style.css\");\n:root{\n  --peach:#FEBE9B; --shell:#F8EDE8; --cream:#FBF4F0; --ink:#1D1411; --ink70:rgba(29,20,17,.72); --ink50:rgba(29,20,17,.5);\n  --coral:#FE8B65; --gold:#F1C160; --indigo:#4F46E5; --hair:rgba(29,20,17,.16);\n}\n*{box-sizing:border-box}\nbody{margin:0;background:var(--cream);color:var(--ink);font-family:'Albert Sans',system-ui,sans-serif;-webkit-font-smoothing:antialiased;font-size:14px}\nh1,h2,h3,h4,p,ul{margin:0;padding:0}ul{list-style:none}\na{text-decoration:none;color:inherit}\n.serif{font-family:'Cardo',Georgia,serif;font-weight:400}\n\n/* bar */\n.bar{background:var(--shell);border-bottom:1px solid var(--hair);height:62px;display:flex;align-items:center;gap:14px;padding:0 26px}\n.brand{display:flex;align-items:center;gap:8px;font-size:15px;font-weight:700}\n.dot{position:relative;width:20px;height:20px}\n.dot i{position:absolute;width:15px;height:15px;border-radius:50%;border:1.3px solid var(--ink)}\n.dot i:first-child{left:0;top:0;background:var(--coral)}\n.dot i:last-child{right:0;bottom:0;background:var(--gold);mix-blend-mode:multiply}\n.meta{display:flex;align-items:center;gap:6px;margin-left:10px}\n.mtag{font-size:11px;border:1px solid rgba(29,20,17,.2);border-radius:999px;padding:4px 10px;color:var(--ink70)}\n.mtag.solid{background:var(--ink);border-color:var(--ink);color:var(--shell);font-weight:600}\n.bar-right{margin-left:auto;display:flex;align-items:center;gap:10px}\n.clock{display:inline-flex;align-items:center;gap:7px;background:rgba(254,190,155,.5);border:1px solid rgba(29,20,17,.2);border-radius:999px;padding:6px 13px;font-size:12.5px;font-weight:600}\n.end{display:inline-flex;align-items:center;gap:6px;font-size:12px;font-weight:600;border:1px solid rgba(29,20,17,.35);border-radius:999px;padding:7px 14px}\n\n/* layout */\n.wrap{max-width:1260px;margin:0 auto;padding:18px 26px 26px}\n.grid{display:grid;grid-template-columns:minmax(0,1fr) 318px;gap:18px;align-items:start}\n\n/* chat */\n.chat{background:#fff;border:1px solid var(--hair);border-radius:20px;box-shadow:6px 6px 0 rgba(29,20,17,.08);overflow:hidden;display:flex;flex-direction:column;min-height:806px}\n.chat-h{display:flex;align-items:center;gap:10px;padding:14px 20px;border-bottom:1px dashed rgba(29,20,17,.24)}\n.chat-h b{font-size:13.5px;display:block}\n.chat-h span{font-size:11px;color:var(--ink70);display:block;margin-top:2px}\n.chat-h .qbadge{margin-left:auto;font-size:11px;border:1px solid rgba(29,20,17,.2);border-radius:999px;padding:4px 10px;color:var(--ink70)}\n.msgs{padding:18px 20px;display:flex;flex-direction:column;gap:12px;flex:1}\n.bub{max-width:84%;font-size:13px;line-height:1.6;padding:12px 15px}\n.bub.ai{background:var(--shell);border:1px solid rgba(29,20,17,.12);border-radius:16px 16px 16px 5px;align-self:flex-start}\n.bub.me{background:rgba(79,70,229,.09);border:1px solid rgba(79,70,229,.26);border-radius:16px 16px 4px 16px;align-self:flex-end}\n.bub-tag{display:block;font-size:10px;letter-spacing:.07em;text-transform:uppercase;color:var(--ink50);margin-bottom:5px}\n.bub.small{opacity:.72;font-size:12px;max-width:78%}\n.qnow{border-left:0;background:var(--peach);border:1px solid rgba(29,20,17,.2);border-radius:16px 16px 16px 5px;align-self:flex-start;max-width:88%;padding:14px 16px;box-shadow:3px 3px 0 rgba(29,20,17,.1)}\n.qnow .bub-tag{display:flex;align-items:center;gap:6px}\n.qnow .bub-tag i{color:var(--ink)}\n.answer-line{margin-top:10px;display:flex;align-items:center;gap:9px;font-size:11.5px;color:var(--ink70);border-top:1px dashed rgba(29,20,17,.28);padding-top:9px}\n.answer-line .p{width:6px;height:6px;border-radius:50%;background:var(--coral);animation:bl 1.5s ease-in-out infinite}\n@keyframes bl{0%,100%{opacity:.3}50%{opacity:1}}\n\n/* answer bar */\n.abar{border-top:1px solid var(--hair);background:rgba(248,237,232,.6);padding:14px 20px}\n.abar-top{display:flex;align-items:center;gap:8px;font-size:10.5px;letter-spacing:.08em;text-transform:uppercase;color:var(--ink50)}\n.abar-main{display:flex;align-items:center;gap:12px;margin-top:10px}\n.mic{width:52px;height:52px;border-radius:50%;background:var(--coral);border:1.5px solid var(--ink);display:flex;align-items:center;justify-content:center;font-size:21px;flex:none;box-shadow:0 0 0 5px rgba(254,139,101,.28)}\n.ta{flex:1;background:#fff;border:1px solid rgba(29,20,17,.2);border-radius:14px;padding:10px 13px;font-size:12.5px;line-height:1.5;color:var(--ink70);min-height:44px}\n.ta .caret{display:inline-block;width:1.5px;height:14px;background:var(--indigo);vertical-align:-2px;animation:bl 1s steps(2) infinite}\n.abar-ctl{display:flex;align-items:center;gap:8px;margin-left:auto}\n.ghost{width:38px;height:38px;border-radius:50%;border:1px solid rgba(29,20,17,.24);display:flex;align-items:center;justify-content:center;font-size:16px;background:#fff}\n.send{display:inline-flex;align-items:center;gap:7px;background:var(--indigo);color:#fff;border-radius:999px;padding:11px 20px;font-size:12.5px;font-weight:600;box-shadow:3px 3px 0 rgba(29,20,17,.22)}\n.abar-foot{display:flex;align-items:center;gap:14px;margin-top:10px;font-size:10.5px;color:var(--ink50)}\n.abar-foot a{border-bottom:1px solid rgba(29,20,17,.35);padding-bottom:1px;color:var(--ink70);font-weight:500}\n\n/* side */\n.persona{background:var(--peach);border:1px solid rgba(29,20,17,.22);border-radius:18px;box-shadow:5px 5px 0 rgba(29,20,17,.1);overflow:hidden}\n.p-head{display:flex;align-items:center;gap:10px;padding:14px 16px;border-bottom:1px dashed rgba(29,20,17,.3)}\n.p-head .pic{width:38px;height:38px;border-radius:50%;overflow:hidden;border:1.5px solid var(--ink);flex:none;background:var(--coral)}\n.p-head .pic img{width:100%;height:100%;object-fit:cover;display:block}\n.p-head b{display:block;font-size:12.5px}\n.p-head span{display:block;font-size:10.5px;color:var(--ink70);margin-top:2px}\n.p-body{padding:12px 16px 14px}\n.p-row{display:flex;justify-content:space-between;gap:10px;font-size:11.5px;padding:5px 0;border-bottom:1px solid rgba(29,20,17,.12)}\n.p-row:last-of-type{border-bottom:0}\n.p-row span{color:var(--ink70)}\n.p-row b{font-weight:600}\n\n.card{background:#fff;border:1px solid var(--hair);border-radius:16px;padding:14px 16px;margin-top:12px;box-shadow:4px 4px 0 rgba(29,20,17,.06)}\n.card h4{font-size:11px;letter-spacing:.08em;text-transform:uppercase;color:var(--ink50);margin-bottom:9px}\n.dots{display:flex;gap:4px}\n.dots i{flex:1;height:7px;border-radius:99px;background:rgba(29,20,17,.12)}\n.dots i.done{background:var(--coral)}\n.dots i.now{background:var(--indigo)}\n.dots-cap{display:flex;justify-content:space-between;font-size:10.5px;color:var(--ink70);margin-top:7px}\n.langs{display:flex;flex-wrap:wrap;gap:5px}\n.lg{font-size:10.5px;padding:4px 9px;border-radius:999px;border:1px solid rgba(29,20,17,.18);color:var(--ink70)}\n.lg.on{background:var(--ink);border-color:var(--ink);color:var(--shell);font-weight:600}\n.card p{font-size:10.5px;color:var(--ink70);line-height:1.55}\n.card p b{color:var(--ink)}\n\n@media (max-width:1024px){\n  .grid{grid-template-columns:1fr}\n  .meta{display:none}\n}\n@media (max-width:720px){\n  .wrap{padding:12px 14px 20px}\n  .bar{padding:0 14px;height:56px}\n  .abar-main{flex-wrap:wrap}\n  .ta{order:3;width:100%;flex:auto}\n  .chat{min-height:auto}\n  .bub{max-width:94%}\n}\n</style>\n<header class=\"bar\" data-kid=\"1\" data-name=\"header navigation bar\">\n<a class=\"brand\" data-kid=\"1-1\" data-name=\"brand logo with links to home\" href=\"/\"><span class=\"dot\" data-kid=\"1-1-1\" data-name=\"logo mark of two overlapping circles\"><i data-kid=\"1-1-1-1\" data-name=\"logo coral circle\"></i><i data-kid=\"1-1-1-2\" data-name=\"logo gold circle\"></i></span>MockMate AI</a>\n<div class=\"meta\" data-kid=\"1-2\" data-name=\"context tag group\">\n<span class=\"mtag solid\" data-kid=\"1-2-1\" data-name=\"category pill Commerce\">Commerce</span>\n<span class=\"mtag\" data-kid=\"1-2-2\" data-name=\"course pill B.Com Final year\">B.Com, Final year</span>\n<span class=\"mtag\" data-kid=\"1-2-3\" data-name=\"difficulty pill Medium\">Medium</span>\n</div>\n<div class=\"bar-right\" data-kid=\"1-3\" data-name=\"header right actions\">\n<span class=\"clock\" data-dynamic=\"true\" data-kid=\"1-3-1\" data-name=\"remaining time countdown pill\" data-reason=\"time text (18:42 left) reinitialized by timer script as time elapses\"><i class=\"ph ph-timer\" data-kid=\"1-3-1-1\" data-name=\"timer icon\"></i>18:42 left</span>\n<a class=\"end\" data-kid=\"1-3-2\" data-name=\"end interview button\" href=\"/dashboard/interviews\"><i class=\"ph ph-phone-disconnect\" data-kid=\"1-3-2-1\" data-name=\"phone disconnect icon\"></i>End interview</a>\n</div>\n</header>\n<div class=\"wrap grid\" data-kid=\"2\" data-name=\"page content grid\">\n<section class=\"chat\" data-kid=\"2-1\" data-name=\"chat interview panel\">\n<div class=\"chat-h\" data-kid=\"2-1-1\" data-name=\"chat header with interviewer info\">\n<div data-kid=\"2-1-1-1\" data-name=\"interviewer identity block\"><b data-kid=\"2-1-1-1-1\" data-name=\"interviewer title\">Professional interviewer</b><span data-kid=\"2-1-1-1-2\" data-name=\"interviewer mode details\">Hinglish · Voice mode · 12 questions</span></div>\n<span class=\"qbadge\" data-kid=\"2-1-1-2\" data-name=\"current question number badge\">Question 4 of 12</span>\n</div>\n<div class=\"msgs\" data-kid=\"2-1-2\" data-name=\"chat messages list\">\n<div class=\"bub ai small\" data-kid=\"2-1-2-1\" data-name=\"previous AI question bubble Q2\"><span class=\"bub-tag\" data-kid=\"2-1-2-1-1\" data-name=\"question label Q2\">Q2</span>आपको commerce में कौन सा subject सबसे practical लगता है और क्यों?</div>\n<div class=\"bub me small\" data-kid=\"2-1-2-2\" data-name=\"previous user answer bubble\">Accounting, क्योंकि वहाँ numbers के पीछे का logic सीधे company के books में दिखता है।</div>\n<div class=\"bub ai small\" data-kid=\"2-1-2-3\" data-name=\"previous AI question bubble Q3\"><span class=\"bub-tag\" data-kid=\"2-1-2-3-1\" data-name=\"question label Q3\">Q3</span>आपने GST returns file किए — कौन सा form किसके लिए था?</div>\n<div class=\"bub me small\" data-kid=\"2-1-2-4\" data-name=\"previous user answer bubble\">GSTR-1 outward sales की detail के लिए, और GSTR-3B monthly summary और payment के लिए।</div>\n<div class=\"qnow\" data-kid=\"2-1-2-5\" data-name=\"current question highlight bubble Q4\">\n<span class=\"bub-tag\" data-kid=\"2-1-2-5-1\" data-name=\"current question label with icon\"><i class=\"ph ph-question\" data-kid=\"2-1-2-5-1-1\" data-name=\"question mark icon\"></i>Q4 · current question</span>\n        एक client का GSTR-1 और GSTR-3B mismatch था। आपने exactly क्या किया?\n        <div class=\"answer-line\" data-dynamic=\"true\" data-kid=\"2-1-2-5-2\" data-name=\"listening status line\" data-reason=\"listening timer text 00:14 reinitialized by script\"><span class=\"p\" data-kid=\"2-1-2-5-2-1\" data-name=\"blinking listening indicator dot\"></span>Listening in Hinglish · 00:14</div>\n</div>\n<div class=\"bub me\" data-kid=\"2-1-2-6\" data-name=\"current user answer bubble\">मैंने पहले invoice-wise reconciliation निकाला — GSTR-1 में जो invoices थे और 3B में जो declared थे, उनका mismatch list बनाया। ज़्यादातर difference एक credit note का था जो period change हो गया था।<span class=\"caret\" data-dynamic=\"true\" data-kid=\"2-1-2-6-1\" data-name=\"typing caret in current answer\" data-reason=\"caret text reinitialized by live transcription script\" style=\"display:inline-block;width:1.5px;height:14px;background:var(--indigo);vertical-align:-2px;margin-left:2px\"></span></div>\n</div>\n<div class=\"abar\" data-kid=\"2-1-3\" data-name=\"answer composition bar\">\n<div class=\"abar-top\" data-kid=\"2-1-3-1\" data-name=\"answering status header\"><i class=\"ph ph-microphone\" data-kid=\"2-1-3-1-1\" data-name=\"microphone icon\"></i>Answering now</div>\n<div class=\"abar-main\" data-kid=\"2-1-3-2\" data-name=\"answer bar main controls\">\n<span class=\"mic\" data-kid=\"2-1-3-2-1\" data-name=\"microphone record button\"><i class=\"ph ph-microphone\" data-kid=\"2-1-3-2-1-1\" data-name=\"microphone glyph icon\"></i></span>\n<div class=\"ta\" data-kid=\"2-1-3-2-2\" data-name=\"transcription text area\">…और उस credit note को मैंने next period में adjust किया ताकि दोनों returns match हो जाएँ<span class=\"caret\" data-dynamic=\"true\" data-kid=\"2-1-3-2-2-1\" data-name=\"typing caret in transcription\" data-reason=\"caret positioned/updated by live transcription script\"></span></div>\n<div class=\"abar-ctl\" data-kid=\"2-1-3-2-3\" data-name=\"answer bar control buttons\">\n<span class=\"ghost\" data-kid=\"2-1-3-2-3-1\" data-name=\"keyboard toggle button\"><i class=\"ph ph-keyboard\" data-kid=\"2-1-3-2-3-1-1\" data-name=\"keyboard icon\"></i></span>\n<span class=\"ghost\" data-kid=\"2-1-3-2-3-2\" data-name=\"pause button\"><i class=\"ph ph-pause\" data-kid=\"2-1-3-2-3-2-1\" data-name=\"pause icon\"></i></span>\n<a class=\"send\" data-kid=\"2-1-3-2-3-3\" data-name=\"submit answer button\" href=\"#\"><i class=\"ph ph-arrow-right\" data-kid=\"2-1-3-2-3-3-1\" data-name=\"arrow right icon\"></i>Submit</a>\n</div>\n</div>\n<div class=\"abar-foot\" data-kid=\"2-1-3-3\" data-name=\"answer bar footer links\"><span data-kid=\"2-1-3-3-1\" data-name=\"editable transcription note\">Editable transcription</span><span data-kid=\"2-1-3-3-2\" data-name=\"microphone status label\">Microphone on</span><a data-kid=\"2-1-3-3-3\" data-name=\"review answer link\" href=\"#\">Review answer</a></div>\n</div>\n</section>\n<aside data-kid=\"2-2\" data-name=\"side details column\">\n<div class=\"persona\" data-kid=\"2-2-1\" data-name=\"interviewer persona card\">\n<div class=\"p-head\" data-kid=\"2-2-1-1\" data-name=\"persona header\">\n<span class=\"pic\" data-kid=\"2-2-1-1-1\" data-name=\"interviewer avatar image clip\"><img alt=\"Illustrated AI interviewer avatar with headset\" data-kid=\"2-2-1-1-1-1\" data-name=\"AI interviewer avatar image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/.kombai/canvas/assets/riso-avatar.svg\"/></span>\n<div data-kid=\"2-2-1-1-2\" data-name=\"persona name and tone text\"><b data-kid=\"2-2-1-1-2-1\" data-name=\"persona name\">Professional interviewer</b><span data-kid=\"2-2-1-1-2-2\" data-name=\"persona tone description\">Neutral tone, keeps to the clock</span></div>\n</div>\n<div class=\"p-body\" data-kid=\"2-2-1-2\" data-name=\"persona attribute rows\">\n<div class=\"p-row\" data-kid=\"2-2-1-2-1\" data-name=\"category attribute row\"><span data-kid=\"2-2-1-2-1-1\" data-name=\"attribute label Category\">Category</span><b data-kid=\"2-2-1-2-1-2\" data-name=\"attribute value Commerce\">Commerce</b></div>\n<div class=\"p-row\" data-kid=\"2-2-1-2-2\" data-name=\"course attribute row\"><span data-kid=\"2-2-1-2-2-1\" data-name=\"attribute label Course\">Course</span><b data-kid=\"2-2-1-2-2-2\" data-name=\"attribute value B.Com\">B.Com</b></div>\n<div class=\"p-row\" data-kid=\"2-2-1-2-3\" data-name=\"difficulty attribute row\"><span data-kid=\"2-2-1-2-3-1\" data-name=\"attribute label Difficulty\">Difficulty</span><b data-kid=\"2-2-1-2-3-2\" data-name=\"attribute value Medium\">Medium</b></div>\n<div class=\"p-row\" data-kid=\"2-2-1-2-4\" data-name=\"language attribute row\"><span data-kid=\"2-2-1-2-4-1\" data-name=\"attribute label Language\">Language</span><b data-kid=\"2-2-1-2-4-2\" data-name=\"attribute value Hinglish\">Hinglish</b></div>\n<div class=\"p-row\" data-kid=\"2-2-1-2-5\" data-name=\"mode attribute row\"><span data-kid=\"2-2-1-2-5-1\" data-name=\"attribute label Mode\">Mode</span><b data-kid=\"2-2-1-2-5-2\" data-name=\"attribute value Voice\">Voice</b></div>\n</div>\n</div>\n<div class=\"card\" data-kid=\"2-2-2\" data-name=\"progress card\">\n<h4 data-kid=\"2-2-2-1\" data-name=\"progress card title\">Progress</h4>\n<div class=\"dots\" data-kid=\"2-2-2-2\" data-name=\"question progress dot track\"><i class=\"done\" data-kid=\"2-2-2-2-1\" data-name=\"answered question dot 1\"></i><i class=\"done\" data-kid=\"2-2-2-2-2\" data-name=\"answered question dot 2\"></i><i class=\"done\" data-kid=\"2-2-2-2-3\" data-name=\"answered question dot 3\"></i><i class=\"now\" data-kid=\"2-2-2-2-4\" data-name=\"current question dot 4\"></i><i data-kid=\"2-2-2-2-5\" data-name=\"upcoming question dot 5\"></i><i data-kid=\"2-2-2-2-6\" data-name=\"upcoming question dot 6\"></i><i data-kid=\"2-2-2-2-7\" data-name=\"upcoming question dot 7\"></i><i data-kid=\"2-2-2-2-8\" data-name=\"upcoming question dot 8\"></i><i data-kid=\"2-2-2-2-9\" data-name=\"upcoming question dot 9\"></i><i data-kid=\"2-2-2-2-10\" data-name=\"upcoming question dot 10\"></i><i data-kid=\"2-2-2-2-11\" data-name=\"upcoming question dot 11\"></i><i data-kid=\"2-2-2-2-12\" data-name=\"upcoming question dot 12\"></i></div>\n<div class=\"dots-cap\" data-kid=\"2-2-2-3\" data-name=\"progress dot caption\"><span data-kid=\"2-2-2-3-1\" data-name=\"answered count caption\">3 answered</span><span data-kid=\"2-2-2-3-2\" data-name=\"in progress count caption\">1 in progress</span><span data-kid=\"2-2-2-3-3\" data-name=\"remaining count caption\">8 left</span></div>\n</div>\n<div class=\"card\" data-kid=\"2-2-3\" data-name=\"interview language card\">\n<h4 data-kid=\"2-2-3-1\" data-name=\"language card title\">Interview language</h4>\n<div class=\"langs\" data-kid=\"2-2-3-2\" data-name=\"language selector pills\">\n<span class=\"lg\" data-kid=\"2-2-3-2-1\" data-name=\"English language pill\">English</span><span class=\"lg\" data-kid=\"2-2-3-2-2\" data-name=\"Hindi language pill\">हिन्दी</span><span class=\"lg on\" data-kid=\"2-2-3-2-3\" data-name=\"selected Hinglish language pill\">Hinglish</span><span class=\"lg\" data-kid=\"2-2-3-2-4\" data-name=\"Bengali language pill\">বাংলা</span><span class=\"lg\" data-kid=\"2-2-3-2-5\" data-name=\"Tamil language pill\">தமிழ்</span><span class=\"lg\" data-kid=\"2-2-3-2-6\" data-name=\"Marathi language pill\">मराठी</span>\n</div>\n<p data-kid=\"2-2-3-3\" data-name=\"language note text\" style=\"margin-top:9px\">The report for this session is written in Hinglish.</p>\n</div>\n<div class=\"card\" data-kid=\"2-2-4\" data-name=\"scores card\">\n<h4 data-kid=\"2-2-4-1\" data-name=\"scores card title\">Scores</h4>\n<p data-kid=\"2-2-4-2\" data-name=\"scores description text\"><b data-kid=\"2-2-4-2-1\" data-name=\"scores emphasis lead text\">Held until the end.</b> Answers are scored against the B.Com rubric — accounting accuracy, financial concepts, structure and communication.</p>\n</div>\n</aside>\n</div>",
      "comments": [],
      "created": "2026-11-10T15:18:40.632876+00:00",
      "modified": "2026-11-10T15:20:52.085008+00:00",
      "id": "var_2ed5e3858b14",
      "contentHeight": 912
    },
    "var_076bb40ea0b6": {
      "type": "variant",
      "label": "Live Interview Room — V3 Briefing Deck",
      "parentId": "var_2ed5e3858b14",
      "themeId": null,
      "rect": {
        "x": 9660,
        "y": 0,
        "w": 1280,
        "h": 0
      },
      "html": "<style>\n@import url('https://fonts.googleapis.com/css2?family=Saira+Condensed:wght@500;600;700&family=Commissioner:wght@400;500;600;700&display=swap');\n@import url(\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.48.0/dist/tabler-icons.min.css\");\n:root{\n  --turq:#31AFD4; --light:#F3F5F9; --ink:#291720; --ink70:rgba(41,23,32,.72); --ink50:rgba(41,23,32,.5);\n  --blue:#004FFF; --orchid:#E07BE0; --cta:#4F46E5; --hair:rgba(41,23,32,.2);\n  --panel:#131C22; --panel2:#1B252C; --pline:rgba(243,245,249,.14);\n}\n*{box-sizing:border-box}\nbody{margin:0;background:var(--panel);color:#F3F5F9;font-family:'Commissioner',system-ui,sans-serif;-webkit-font-smoothing:antialiased;font-size:13px}\nh1,h2,h3,h4,p,ul{margin:0;padding:0}ul{list-style:none}\na{text-decoration:none;color:inherit}\n.display{font-family:'Saira Condensed',Impact,sans-serif;font-weight:600}\n\n/* bar */\n.bar{height:54px;background:#0E1519;border-bottom:1px solid var(--pline);display:flex;align-items:center;gap:14px;padding:0 20px}\n.brand{display:flex;align-items:center;gap:8px;font-weight:700;font-size:13.5px;color:#F3F5F9}\n.mark{width:22px;height:22px;background:var(--turq);display:flex;align-items:center;justify-content:center;gap:2px;clip-path:polygon(6px 0,100% 0,100% calc(100% - 6px),calc(100% - 6px) 100%,0 100%,0 6px)}\n.mark i{display:block;width:2px;background:var(--ink)}\n.mark i:nth-child(1){height:6px}.mark i:nth-child(2){height:12px}.mark i:nth-child(3){height:4px}\n.meta{display:flex;gap:5px;margin-left:8px;padding-left:12px;border-left:1px solid var(--pline)}\n.mtag{font-size:9.5px;letter-spacing:.07em;text-transform:uppercase;border:1px solid var(--pline);padding:3px 7px;color:rgba(243,245,249,.7)}\n.mtag.on{background:var(--turq);border-color:var(--turq);color:var(--ink);font-weight:600}\n.bar-r{margin-left:auto;display:flex;align-items:center;gap:10px}\n.clock{display:flex;align-items:center;gap:6px;border:1px solid var(--pline);padding:5px 9px;font-size:11.5px;font-weight:600}\n.clock i{color:var(--turq);font-size:12px}\n.live{display:flex;align-items:center;gap:6px;font-size:9.5px;letter-spacing:.09em;text-transform:uppercase;color:var(--turq)}\n.live .p{width:5px;height:5px;background:var(--turq);animation:bl 1.4s ease-in-out infinite}\n@keyframes bl{0%,100%{opacity:.3}50%{opacity:1}}\n.end{display:inline-flex;align-items:center;gap:6px;font-size:11px;font-weight:600;background:var(--orchid);color:var(--ink);padding:7px 12px;clip-path:polygon(7px 0,100% 0,100% calc(100% - 7px),calc(100% - 7px) 100%,0 100%,0 7px)}\n\n/* shell */\n.shell{display:grid;grid-template-columns:196px minmax(0,1fr) 282px;min-height:640px}\n.hist{margin-top:14px;border-top:1px solid var(--pline);padding-top:11px}\n.hh{display:flex;justify-content:space-between;font-size:8.5px;letter-spacing:.13em;text-transform:uppercase;color:rgba(243,245,249,.4);margin-bottom:7px}\n.ht{padding:8px 0;border-bottom:1px solid rgba(243,245,249,.07);font-size:11px;color:rgba(243,245,249,.62);line-height:1.55}\n.ht:last-child{border-bottom:0}\n.ht b{color:var(--turq);font-weight:600;margin-right:7px;font-size:10px}\n.ht .ha{color:rgba(243,245,249,.42);display:block;margin-top:3px;padding-left:2px}\n\n/* agenda */\n.agenda{background:#0E1519;border-right:1px solid var(--pline);padding:14px 12px}\n.agenda h3{font-size:9px;letter-spacing:.14em;text-transform:uppercase;color:rgba(243,245,249,.4);margin-bottom:10px}\n.ai{display:flex;align-items:center;gap:8px;padding:7px 6px;font-size:11px;color:rgba(243,245,249,.55);border-left:2px solid transparent}\n.ai .n{font-size:9.5px;color:rgba(243,245,249,.32);width:14px}\n.ai.done{color:rgba(243,245,249,.4)}\n.ai.done .n{color:var(--turq)}\n.ai.now{background:rgba(49,175,212,.14);border-left-color:var(--turq);color:#F3F5F9;font-weight:600}\n.ai.now .n{color:var(--turq)}\n.rail-foot{margin-top:12px;padding-top:10px;border-top:1px solid var(--pline)}\n.rail-foot .r{display:flex;justify-content:space-between;font-size:9.5px;color:rgba(243,245,249,.4);padding:3px 0}\n.rail-foot b{color:rgba(243,245,249,.75);font-weight:600}\n\n/* center */\n.center{padding:16px 18px 18px}\n.qhead{display:flex;align-items:center;gap:8px;font-size:9px;letter-spacing:.13em;text-transform:uppercase;color:rgba(243,245,249,.44)}\n.qhead b{color:var(--orchid);letter-spacing:.05em}\n.qhead .rp{margin-left:auto;display:flex;align-items:center;gap:6px;font-size:10px;letter-spacing:0;text-transform:none;color:rgba(243,245,249,.62);border:1px solid var(--pline);padding:3px 8px}\n.qtext{font-family:'Saira Condensed',Impact,sans-serif;font-weight:500;font-size:25px;line-height:1.25;margin-top:9px}\n.qsub{font-size:10.5px;color:rgba(243,245,249,.44);margin-top:7px}\n\n.scope{margin-top:12px;border:1px solid var(--pline);background:var(--panel2);padding:12px 14px}\n.scope-h{display:flex;align-items:center;gap:8px;font-size:9px;letter-spacing:.13em;text-transform:uppercase;color:rgba(243,245,249,.44)}\n.scope-h .li{margin-left:auto;display:inline-flex;align-items:center;gap:5px;color:var(--turq);letter-spacing:.04em;text-transform:none;font-size:10px}\n.wave{display:flex;align-items:flex-end;gap:2.5px;height:56px;margin:12px 0 10px}\n.wave i{flex:1;background:rgba(49,175,212,.35);border-radius:0}\n.wave i.on{background:var(--turq)}\n.wave i.hot{background:var(--blue)}\n.wave i:nth-child(4n+1){height:34%}.wave i:nth-child(4n+2){height:82%}\n.wave i:nth-child(4n+3){height:54%}.wave i:nth-child(4n+4){height:96%}\n.wave i:nth-child(n+18){height:16%}\n.tx{font-size:12.5px;line-height:1.6;color:#F3F5F9;border-top:1px solid var(--pline);padding-top:10px}\n.tx .dim{color:rgba(243,245,249,.4)}\n.caret{display:inline-block;width:1.5px;height:14px;background:var(--turq);vertical-align:-2px;animation:bl 1s steps(2) infinite}\n\n/* controls */\n.ctl{margin-top:12px;border:1px solid var(--pline);display:grid;grid-template-columns:1fr auto;gap:14px;align-items:center;padding:11px 13px;background:#0E1519}\n.meter{display:flex;align-items:flex-end;gap:2.5px;height:34px}\n.meter i{flex:1;background:rgba(243,245,249,.14)}\n.meter i.on{background:var(--turq)}\n.meter i:nth-child(1){height:32%}.meter i:nth-child(2){height:64%}.meter i:nth-child(3){height:88%}\n.meter i:nth-child(4){height:58%}.meter i:nth-child(5){height:96%}.meter i:nth-child(6){height:70%}\n.meter i:nth-child(7){height:40%}.meter i:nth-child(8){height:22%}.meter i:nth-child(9){height:14%}\n.meter i:nth-child(10){height:8%}\n.mlab{display:flex;justify-content:space-between;font-size:9px;letter-spacing:.08em;text-transform:uppercase;color:rgba(243,245,249,.4);margin-top:6px}\n.buttons{display:flex;align-items:center;gap:6px}\n.sqbtn{width:32px;height:32px;border:1px solid var(--pline);display:flex;align-items:center;justify-content:center;font-size:14px;color:#F3F5F9;background:transparent}\n.mic{width:44px;height:44px;border:1px solid var(--turq);background:var(--turq);color:var(--ink);display:flex;align-items:center;justify-content:center;font-size:19px}\n.submit{display:inline-flex;align-items:center;gap:7px;background:var(--cta);color:#fff;font-size:11.5px;font-weight:600;padding:10px 15px;clip-path:polygon(8px 0,100% 0,100% calc(100% - 8px),calc(100% - 8px) 100%,0 100%,0 8px)}\n.hint-row{display:flex;align-items:center;gap:14px;margin-top:10px;font-size:9.5px;letter-spacing:.04em;color:rgba(243,245,249,.4)}\n.hint-row a{color:rgba(243,245,249,.72);border-bottom:1px solid rgba(243,245,249,.3);padding-bottom:1px}\n\n/* right */\n.right{border-left:1px solid var(--pline);background:#0E1519;padding:14px 12px}\n.who{display:flex;align-items:center;gap:9px;padding-bottom:11px;border-bottom:1px solid var(--pline)}\n.who .mm{width:34px;height:34px;border:1px solid var(--turq);background:rgba(49,175,212,.16);display:flex;align-items:center;justify-content:center;font-family:'Saira Condensed',sans-serif;font-size:13px;color:var(--turq);clip-path:polygon(7px 0,100% 0,100% calc(100% - 7px),calc(100% - 7px) 100%,0 100%,0 7px)}\n.who b{display:block;font-size:11.5px}\n.who span{display:block;font-size:9.5px;color:rgba(243,245,249,.44);margin-top:2px}\n.right h4{font-size:8.5px;letter-spacing:.14em;text-transform:uppercase;color:rgba(243,245,249,.4);margin:12px 0 6px}\n.fact{display:flex;justify-content:space-between;gap:8px;font-size:10.5px;padding:4px 0;border-bottom:1px solid rgba(243,245,249,.08)}\n.fact span{color:rgba(243,245,249,.44)}\n.fact b{font-weight:600}\n.dots{display:flex;gap:3px;margin-top:2px}\n.dots i{flex:1;height:14px;border:1px solid var(--pline);border-top:2px solid transparent}\n.dots i.done{background:rgba(49,175,212,.5);border-color:rgba(49,175,212,.7)}\n.dots i.now{background:var(--orchid);border-color:var(--orchid)}\n.dcap{display:flex;justify-content:space-between;font-size:9px;letter-spacing:.06em;color:rgba(243,245,249,.4);margin-top:6px}\n.note{margin-top:12px;border:1px solid rgba(224,123,224,.35);background:rgba(224,123,224,.09);padding:9px 10px}\n.note b{font-size:9.5px;letter-spacing:.08em;text-transform:uppercase;color:var(--orchid);display:flex;align-items:center;gap:5px}\n.note p{font-size:9.5px;line-height:1.5;color:rgba(243,245,249,.62);margin-top:5px}\n.rfoot{margin-top:12px;padding-top:10px;border-top:1px solid var(--pline);display:flex;flex-direction:column;gap:7px}\n.rfoot a{display:flex;align-items:center;gap:6px;font-size:10px;color:rgba(243,245,249,.55)}\n.rfoot a i{font-size:12px}\n\n@media (max-width:1100px){\n  .shell{grid-template-columns:1fr}\n  .agenda,.right{display:none}\n}\n@media (max-width:720px){\n  .bar{padding:0 12px;height:50px}\n  .meta{display:none}\n  .center{padding:12px}\n  .qtext{font-size:20px}\n  .ctl{grid-template-columns:1fr}\n}\n</style>\n<header class=\"bar\" data-kid=\"1\" data-name=\"top application header bar\">\n<a class=\"brand\" data-kid=\"1-1\" data-name=\"brand home link\" href=\"/\"><span class=\"mark\" data-kid=\"1-1-1\" data-name=\"brand logo mark\"><i data-kid=\"1-1-1-1\" data-name=\"logo bar icon\"></i><i data-kid=\"1-1-1-2\" data-name=\"logo bar icon\"></i><i data-kid=\"1-1-1-3\" data-name=\"logo bar icon\"></i></span>MockMate AI</a>\n<div class=\"meta\" data-kid=\"1-2\" data-name=\"interview metadata tag group\">\n<span class=\"mtag on\" data-kid=\"1-2-1\" data-name=\"technical topic tag selected\">Technical</span>\n<span class=\"mtag\" data-kid=\"1-2-2\" data-name=\"course program tag\">B.Tech CSE</span>\n<span class=\"mtag\" data-kid=\"1-2-3\" data-name=\"difficulty level tag\">Medium</span>\n<span class=\"mtag\" data-kid=\"1-2-4\" data-name=\"expert chair tag\">Expert chair</span>\n</div>\n<div class=\"bar-r\" data-kid=\"1-3\" data-name=\"header right controls group\">\n<span class=\"live\" data-kid=\"1-3-1\" data-name=\"recording live indicator\"><span class=\"p\" data-kid=\"1-3-1-1\" data-name=\"recording pulse dot\"></span>Recording</span>\n<span class=\"clock\" data-dynamic=\"true\" data-kid=\"1-3-2\" data-name=\"session elapsed clock\" data-reason=\"time text updated by clock script\"><i class=\"ti ti-clock\" data-kid=\"1-3-2-1\" data-name=\"clock icon\"></i>18:42</span>\n<a class=\"end\" data-kid=\"1-3-3\" data-name=\"end interview button\" href=\"/dashboard/interviews\"><i class=\"ti ti-phone-off\" data-kid=\"1-3-3-1\" data-name=\"end call phone icon\"></i>End</a>\n</div>\n</header>\n<div class=\"shell\" data-kid=\"2\" data-name=\"interview body layout\">\n<aside class=\"agenda\" data-kid=\"2-1\" data-name=\"question plan sidebar\">\n<h3 data-kid=\"2-1-1\" data-name=\"question plan heading\">Question plan</h3>\n<div class=\"ai done\" data-kid=\"2-1-2\" data-name=\"question 01 completed item\"><span class=\"n\" data-kid=\"2-1-2-1\" data-name=\"question 01 number\">01</span>Project overview</div>\n<div class=\"ai done\" data-kid=\"2-1-3\" data-name=\"question 02 completed item\"><span class=\"n\" data-kid=\"2-1-3-1\" data-name=\"question 02 number\">02</span>Schema design</div>\n<div class=\"ai done\" data-kid=\"2-1-4\" data-name=\"question 03 completed item\"><span class=\"n\" data-kid=\"2-1-4-1\" data-name=\"question 03 number\">03</span>Normalisation</div>\n<div class=\"ai done\" data-kid=\"2-1-5\" data-name=\"question 04 completed item\"><span class=\"n\" data-kid=\"2-1-5-1\" data-name=\"question 04 number\">04</span>Index choice</div>\n<div class=\"ai done\" data-kid=\"2-1-6\" data-name=\"question 05 completed item\"><span class=\"n\" data-kid=\"2-1-6-1\" data-name=\"question 05 number\">05</span>Session store</div>\n<div class=\"ai now\" data-kid=\"2-1-7\" data-name=\"current question 06 item\"><span class=\"n\" data-kid=\"2-1-7-1\" data-name=\"question 06 number\">06</span>Webhook retries</div>\n<div class=\"ai\" data-kid=\"2-1-8\" data-name=\"question 07 upcoming item\"><span class=\"n\" data-kid=\"2-1-8-1\" data-name=\"question 07 number\">07</span>Caching</div>\n<div class=\"ai\" data-kid=\"2-1-9\" data-name=\"question 08 upcoming item\"><span class=\"n\" data-kid=\"2-1-9-1\" data-name=\"question 08 number\">08</span>Roles and auth</div>\n<div class=\"ai\" data-kid=\"2-1-10\" data-name=\"question 09 upcoming item\"><span class=\"n\" data-kid=\"2-1-10-1\" data-name=\"question 09 number\">09</span>Test strategy</div>\n<div class=\"ai\" data-kid=\"2-1-11\" data-name=\"question 10 upcoming item\"><span class=\"n\" data-kid=\"2-1-11-1\" data-name=\"question 10 number\">10</span>Deployment</div>\n<div class=\"ai\" data-kid=\"2-1-12\" data-name=\"question 11 upcoming item\"><span class=\"n\" data-kid=\"2-1-12-1\" data-name=\"question 11 number\">11</span>Team conflict</div>\n<div class=\"ai\" data-kid=\"2-1-13\" data-name=\"question 12 upcoming item\"><span class=\"n\" data-kid=\"2-1-13-1\" data-name=\"question 12 number\">12</span>Your questions</div>\n<div class=\"rail-foot\" data-kid=\"2-1-14\" data-name=\"sidebar elapsed and progress footer\">\n<div class=\"r\" data-kid=\"2-1-14-1\" data-name=\"elapsed time row\"><span data-kid=\"2-1-14-1-1\" data-name=\"elapsed label\">Elapsed</span><b data-dynamic=\"true\" data-kid=\"2-1-14-1-2\" data-name=\"elapsed time value\" data-reason=\"time value updated by timer script\">11:18</b></div>\n<div class=\"r\" data-kid=\"2-1-14-2\" data-name=\"answered count row\"><span data-kid=\"2-1-14-2-1\" data-name=\"answered label\">Answered</span><b data-kid=\"2-1-14-2-2\" data-name=\"answered count value\">5 of 12</b></div>\n</div>\n</aside>\n<section class=\"center\" data-kid=\"2-2\" data-name=\"main question panel\">\n<div class=\"qhead\" data-kid=\"2-2-1\" data-name=\"question header row\"><b data-kid=\"2-2-1-1\" data-name=\"question number badge\">Q6</b>Technical Expert · probing your project<span class=\"rp\" data-kid=\"2-2-1-2\" data-name=\"replay question button\"><i class=\"ti ti-repeat\" data-kid=\"2-2-1-2-1\" data-name=\"replay icon\"></i>Replay</span></div>\n<h1 class=\"qtext\" data-kid=\"2-2-2\" data-name=\"current question headline\">You mentioned a payment webhook. What happens when the same event arrives twice?</h1>\n<p class=\"qsub\" data-kid=\"2-2-3\" data-name=\"question instruction subtext\">Answer in English. Coding round is on for this session.</p>\n<div class=\"scope\" data-kid=\"2-2-4\" data-name=\"answer capture panel\">\n<div class=\"scope-h\" data-kid=\"2-2-4-1\" data-name=\"answer panel header\"><i class=\"ti ti-wave-sine\" data-kid=\"2-2-4-1-1\" data-name=\"voice wave icon\"></i>Your answer<span class=\"li\" data-kid=\"2-2-4-1-2\" data-name=\"listening status indicator\"><span class=\"p\" data-kid=\"2-2-4-1-2-1\" data-name=\"listening pulse dot\" style=\"width:5px;height:5px;background:var(--turq);display:inline-block\"></span>Listening · 00:14</span></div>\n<div class=\"wave\" data-kid=\"2-2-4-2\" data-name=\"voice waveform visualizer\">\n<i class=\"on\" data-kid=\"2-2-4-2-1\" data-name=\"waveform bar\"></i><i class=\"on\" data-kid=\"2-2-4-2-2\" data-name=\"waveform bar\"></i><i class=\"on hot\" data-kid=\"2-2-4-2-3\" data-name=\"waveform peak bar\"></i><i class=\"on\" data-kid=\"2-2-4-2-4\" data-name=\"waveform bar\"></i><i class=\"on hot\" data-kid=\"2-2-4-2-5\" data-name=\"waveform peak bar\"></i><i class=\"on\" data-kid=\"2-2-4-2-6\" data-name=\"waveform bar\"></i><i class=\"on\" data-kid=\"2-2-4-2-7\" data-name=\"waveform bar\"></i><i class=\"on\" data-kid=\"2-2-4-2-8\" data-name=\"waveform bar\"></i><i data-kid=\"2-2-4-2-9\" data-name=\"waveform idle bar\"></i><i data-kid=\"2-2-4-2-10\" data-name=\"waveform idle bar\"></i><i data-kid=\"2-2-4-2-11\" data-name=\"waveform idle bar\"></i><i data-kid=\"2-2-4-2-12\" data-name=\"waveform idle bar\"></i><i data-kid=\"2-2-4-2-13\" data-name=\"waveform idle bar\"></i><i data-kid=\"2-2-4-2-14\" data-name=\"waveform idle bar\"></i><i data-kid=\"2-2-4-2-15\" data-name=\"waveform idle bar\"></i><i data-kid=\"2-2-4-2-16\" data-name=\"waveform idle bar\"></i><i data-kid=\"2-2-4-2-17\" data-name=\"waveform idle bar\"></i><i data-kid=\"2-2-4-2-18\" data-name=\"waveform idle bar\"></i><i data-kid=\"2-2-4-2-19\" data-name=\"waveform idle bar\"></i><i data-kid=\"2-2-4-2-20\" data-name=\"waveform idle bar\"></i><i data-kid=\"2-2-4-2-21\" data-name=\"waveform idle bar\"></i><i data-kid=\"2-2-4-2-22\" data-name=\"waveform idle bar\"></i><i data-kid=\"2-2-4-2-23\" data-name=\"waveform idle bar\"></i><i data-kid=\"2-2-4-2-24\" data-name=\"waveform idle bar\"></i><i data-kid=\"2-2-4-2-25\" data-name=\"waveform idle bar\"></i><i data-kid=\"2-2-4-2-26\" data-name=\"waveform idle bar\"></i><i data-kid=\"2-2-4-2-27\" data-name=\"waveform idle bar\"></i><i data-kid=\"2-2-4-2-28\" data-name=\"waveform idle bar\"></i>\n</div>\n<p class=\"tx\" data-kid=\"2-2-4-3\" data-name=\"answer transcript text\">I keep the event id in a unique column before processing, so a repeat delivery fails the insert and returns 200 without charging again<span class=\"caret\" data-kid=\"2-2-4-3-1\" data-name=\"transcript typing caret\"></span><span class=\"dim\" data-kid=\"2-2-4-3-2\" data-name=\"transcript ellipsis text\"> …</span></p>\n</div>\n<div class=\"ctl\" data-kid=\"2-2-5\" data-name=\"answer controls panel\">\n<div data-kid=\"2-2-5-1\" data-name=\"microphone level meter block\">\n<div class=\"meter\" data-kid=\"2-2-5-1-1\" data-name=\"mic level meter bars\"><i class=\"on\" data-kid=\"2-2-5-1-1-1\" data-name=\"mic level bar\"></i><i class=\"on\" data-kid=\"2-2-5-1-1-2\" data-name=\"mic level bar\"></i><i class=\"on\" data-kid=\"2-2-5-1-1-3\" data-name=\"mic level bar\"></i><i class=\"on\" data-kid=\"2-2-5-1-1-4\" data-name=\"mic level bar\"></i><i class=\"on\" data-kid=\"2-2-5-1-1-5\" data-name=\"mic level bar\"></i><i class=\"on\" data-kid=\"2-2-5-1-1-6\" data-name=\"mic level bar\"></i><i data-kid=\"2-2-5-1-1-7\" data-name=\"mic level bar\"></i><i data-kid=\"2-2-5-1-1-8\" data-name=\"mic level bar\"></i><i data-kid=\"2-2-5-1-1-9\" data-name=\"mic level bar\"></i><i data-kid=\"2-2-5-1-1-10\" data-name=\"mic level bar\"></i></div>\n<div class=\"mlab\" data-kid=\"2-2-5-1-2\" data-name=\"mic level labels\"><span data-kid=\"2-2-5-1-2-1\" data-name=\"mic level label\">Mic level</span><span data-kid=\"2-2-5-1-2-2\" data-name=\"mic decibel reading\">-12 dB</span><span data-kid=\"2-2-5-1-2-3\" data-name=\"mic connection status label\">Connected</span></div>\n</div>\n<div class=\"buttons\" data-kid=\"2-2-5-2\" data-name=\"answer action buttons\">\n<span class=\"sqbtn\" data-kid=\"2-2-5-2-1\" data-name=\"keyboard input toggle button\"><i class=\"ti ti-keyboard\" data-kid=\"2-2-5-2-1-1\" data-name=\"keyboard icon\"></i></span>\n<span class=\"mic\" data-kid=\"2-2-5-2-2\" data-name=\"primary microphone button\"><i class=\"ti ti-microphone\" data-kid=\"2-2-5-2-2-1\" data-name=\"microphone icon\"></i></span>\n<span class=\"sqbtn\" data-kid=\"2-2-5-2-3\" data-name=\"pause recording button\"><i class=\"ti ti-pause\" data-kid=\"2-2-5-2-3-1\" data-name=\"pause icon\"></i></span>\n<a class=\"submit\" data-kid=\"2-2-5-2-4\" data-name=\"submit answer button\" href=\"#\"><i class=\"ti ti-arrow-right\" data-kid=\"2-2-5-2-4-1\" data-name=\"arrow right icon\"></i>Submit answer</a>\n</div>\n</div>\n<div class=\"hint-row\" data-kid=\"2-2-6\" data-name=\"answer hint row\"><span data-kid=\"2-2-6-1\" data-name=\"transcription editable hint\">Transcription editable before submit</span><a data-kid=\"2-2-6-2\" data-name=\"edit answer link\" href=\"#\">Edit answer</a><span data-kid=\"2-2-6-3\" data-name=\"timer pause hint\">Timer pauses if you leave</span></div>\n<div class=\"hist\" data-kid=\"2-2-7\" data-name=\"earlier questions history\">\n<div class=\"hh\" data-kid=\"2-2-7-1\" data-name=\"history header row\"><span data-kid=\"2-2-7-1-1\" data-name=\"history heading\">Earlier in this session</span><span data-kid=\"2-2-7-1-2\" data-name=\"history turn count\">5 turns</span></div>\n<div class=\"ht\" data-kid=\"2-2-7-2\" data-name=\"history entry Q5\"><b data-kid=\"2-2-7-2-1\" data-name=\"Q5 label\">Q5</b>How did you store sessions between requests?<span class=\"ha\" data-kid=\"2-2-7-2-2\" data-name=\"Q5 answer summary\">Signed cookie with the session id; the row lives in Postgres with an expiry column.</span></div>\n<div class=\"ht\" data-kid=\"2-2-7-3\" data-name=\"history entry Q4\"><b data-kid=\"2-2-7-3-1\" data-name=\"Q4 label\">Q4</b>Which column did you index, and why that one?<span class=\"ha\" data-kid=\"2-2-7-3-2\" data-name=\"Q4 answer summary\">Event id — every webhook lookup filters on it and it is unique.</span></div>\n<div class=\"ht\" data-kid=\"2-2-7-4\" data-name=\"history entry Q3\"><b data-kid=\"2-2-7-4-1\" data-name=\"Q3 label\">Q3</b>Where would you break normal form here?<span class=\"ha\" data-kid=\"2-2-7-4-2\" data-name=\"Q3 answer summary\">A cached total on the invoice row for the dashboard, refreshed on write.</span></div>\n</div>\n</section>\n<aside class=\"right\" data-kid=\"2-3\" data-name=\"session details sidebar\">\n<div class=\"who\" data-kid=\"2-3-1\" data-name=\"interviewer identity card\">\n<span class=\"mm\" data-kid=\"2-3-1-1\" data-name=\"interviewer initials avatar\">TE</span>\n<div data-kid=\"2-3-1-2\" data-name=\"interviewer name and role\"><b data-kid=\"2-3-1-2-1\" data-name=\"interviewer name\">Technical Expert</b><span data-kid=\"2-3-1-2-2\" data-name=\"interviewer specialty text\">Fundamentals and trade-offs</span></div>\n</div>\n<h4 data-kid=\"2-3-2\" data-name=\"session details heading\">Session</h4>\n<div class=\"fact\" data-kid=\"2-3-3\" data-name=\"course fact row\"><span data-kid=\"2-3-3-1\" data-name=\"course label\">Course</span><b data-kid=\"2-3-3-2\" data-name=\"course value\">B.Tech CSE</b></div>\n<div class=\"fact\" data-kid=\"2-3-4\" data-name=\"difficulty fact row\"><span data-kid=\"2-3-4-1\" data-name=\"difficulty label\">Difficulty</span><b data-kid=\"2-3-4-2\" data-name=\"difficulty value\">Medium</b></div>\n<div class=\"fact\" data-kid=\"2-3-5\" data-name=\"language fact row\"><span data-kid=\"2-3-5-1\" data-name=\"language label\">Language</span><b data-kid=\"2-3-5-2\" data-name=\"language value\">English</b></div>\n<div class=\"fact\" data-kid=\"2-3-6\" data-name=\"mode fact row\"><span data-kid=\"2-3-6-1\" data-name=\"mode label\">Mode</span><b data-kid=\"2-3-6-2\" data-name=\"mode value\">Voice</b></div>\n<div class=\"fact\" data-kid=\"2-3-7\" data-name=\"coding fact row\" style=\"border-bottom:0\"><span data-kid=\"2-3-7-1\" data-name=\"coding label\">Coding</span><b data-kid=\"2-3-7-2\" data-name=\"coding value\">On</b></div>\n<h4 data-kid=\"2-3-8\" data-name=\"question plan progress heading\">Question plan</h4>\n<div class=\"dots\" data-kid=\"2-3-9\" data-name=\"question progress dots\"><i class=\"done\" data-kid=\"2-3-9-1\" data-name=\"progress dot answered\"></i><i class=\"done\" data-kid=\"2-3-9-2\" data-name=\"progress dot answered\"></i><i class=\"done\" data-kid=\"2-3-9-3\" data-name=\"progress dot answered\"></i><i class=\"done\" data-kid=\"2-3-9-4\" data-name=\"progress dot answered\"></i><i class=\"done\" data-kid=\"2-3-9-5\" data-name=\"progress dot answered\"></i><i class=\"now\" data-kid=\"2-3-9-6\" data-name=\"progress dot current\"></i><i data-kid=\"2-3-9-7\" data-name=\"progress dot upcoming\"></i><i data-kid=\"2-3-9-8\" data-name=\"progress dot upcoming\"></i><i data-kid=\"2-3-9-9\" data-name=\"progress dot upcoming\"></i><i data-kid=\"2-3-9-10\" data-name=\"progress dot upcoming\"></i><i data-kid=\"2-3-9-11\" data-name=\"progress dot upcoming\"></i><i data-kid=\"2-3-9-12\" data-name=\"progress dot upcoming\"></i></div>\n<div class=\"dcap\" data-kid=\"2-3-10\" data-name=\"progress caption row\"><span data-kid=\"2-3-10-1\" data-name=\"answered count caption\">5 answered</span><span data-kid=\"2-3-10-2\" data-name=\"current question caption\">6 current</span><span data-kid=\"2-3-10-3\" data-name=\"questions left caption\">6 left</span></div>\n<div class=\"note\" data-kid=\"2-3-11\" data-name=\"scores held notice\">\n<b data-kid=\"2-3-11-1\" data-name=\"scores held title\"><i class=\"ti ti-eye-off\" data-kid=\"2-3-11-1-1\" data-name=\"hidden eye icon\"></i>Scores held</b>\n<p data-kid=\"2-3-11-2\" data-name=\"scores held explanation text\">Scored after each turn against the B.Tech rubric. The report opens when you end the session.</p>\n</div>\n<div class=\"rfoot\" data-kid=\"2-3-12\" data-name=\"sidebar action links\">\n<a data-kid=\"2-3-12-1\" data-name=\"pause session link\" href=\"#\"><i class=\"ti ti-player-pause\" data-kid=\"2-3-12-1-1\" data-name=\"pause icon\"></i>Pause session</a>\n<a data-kid=\"2-3-12-2\" data-name=\"report problem link\" href=\"#\"><i class=\"ti ti-flag\" data-kid=\"2-3-12-2-1\" data-name=\"flag icon\"></i>Report a problem</a>\n<a data-kid=\"2-3-12-3\" data-name=\"session notes toggle link\" href=\"#\"><i class=\"ti ti-notes\" data-kid=\"2-3-12-3-1\" data-name=\"notes icon\"></i>Session notes are off</a>\n</div>\n</aside>\n</div>",
      "comments": [],
      "created": "2026-11-10T15:19:26.314880+00:00",
      "modified": "2026-11-10T15:21:01.576605+00:00",
      "id": "var_076bb40ea0b6",
      "contentHeight": 697
    },
    "var_116b5457c4e9": {
      "type": "variant",
      "label": "Mobile Homepage — V1 Baltic (390)",
      "parentId": "var_076bb40ea0b6",
      "themeId": null,
      "rect": {
        "x": 11040,
        "y": 0,
        "w": 390,
        "h": 0
      },
      "html": "<style>\n@import url('https://fonts.googleapis.com/css2?family=Kumbh+Sans:wght@400;500;600;700&family=Share+Tech+Mono&display=swap');\n@import url(\"https://cdn.jsdelivr.net/npm/lucide-static@1.48.0/font/lucide.css\");\n:root{\n  --ground:#F2F4FF; --ink:#13293D; --ink70:rgba(19,41,61,.70); --ink50:rgba(19,41,61,.5);\n  --accent:#006494; --band:#A9D3FF; --support:#96C5F7; --line:rgba(19,41,61,.14); --line2:rgba(0,100,148,.22);\n}\n*{box-sizing:border-box}\nbody{margin:0;background:var(--ground);color:var(--ink);font-family:'Kumbh Sans',system-ui,sans-serif;-webkit-font-smoothing:antialiased;font-size:14px}\nh1,h2,h3,h4,p,ul{margin:0;padding:0}ul{list-style:none}\na{text-decoration:none;color:inherit}\n.mono{font-family:'Share Tech Mono',ui-monospace,monospace}\n.pad{padding:0 20px}\n.band{background:var(--band)}\n\n/* nav */\n.nav{height:58px;display:flex;align-items:center;gap:10px;border-bottom:1px solid var(--line);background:var(--ground)}\n.brand{display:flex;align-items:center;gap:8px;font-weight:600;font-size:15px}\n.mark{width:24px;height:24px;border-radius:4px;background:var(--ink);display:flex;align-items:flex-end;justify-content:center;gap:2px;padding:5px 4px}\n.mark i{display:block;width:2px;background:var(--support);border-radius:1px}\n.mark i:nth-child(1){height:60%}.mark i:nth-child(2){height:100%}.mark i:nth-child(3){height:44%}\n.nav-right{margin-left:auto;display:flex;align-items:center;gap:10px}\n.btn{display:inline-flex;align-items:center;justify-content:center;gap:7px;border-radius:6px;font-weight:600;font-size:13px;padding:10px 14px}\n.btn-primary{background:linear-gradient(90deg,#4F46E5,#2563EB);color:#fff}\n.btn-full{width:100%;padding:13px;font-size:14px}\n.btn-line{border:1px solid var(--line2);color:var(--accent);background:transparent;width:100%;padding:12px;font-size:13.5px}\n.burger{width:34px;height:34px;border:1px solid var(--line2);border-radius:5px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:3px}\n.burger i{width:14px;height:1.5px;background:var(--ink)}\n\n/* hero */\n.hero{padding:22px 0 24px}\n.hero h1{font-size:31px;line-height:1.07;letter-spacing:-.025em;font-weight:600}\n.hero p{font-size:14px;line-height:1.55;color:var(--ink70);margin-top:12px}\n.hero-cta{margin-top:18px;display:flex;flex-direction:column;gap:11px;align-items:stretch}\n.hero-link{align-self:flex-start;font-size:13px;font-weight:500;color:var(--accent);display:inline-flex;align-items:center;gap:6px;border-bottom:1px solid var(--line2);padding-bottom:2px}\n.micro{font-size:11px;color:var(--ink50);margin-top:11px}\n\n/* sample card */\n.sample{margin-top:16px;background:var(--ink);border-radius:8px;padding:13px;color:#F2F4FF}\n.s-top{display:flex;align-items:center;gap:5px;flex-wrap:wrap}\n.chip{font-size:9.5px;font-family:'Share Tech Mono',monospace;padding:2px 6px;border:1px solid rgba(242,244,255,.26);border-radius:3px;color:rgba(242,244,255,.9)}\n.chip.on{background:var(--support);border-color:var(--support);color:#13293D}\n.s-time{margin-left:auto;font-family:'Share Tech Mono',monospace;font-size:10px;color:rgba(242,244,255,.7)}\n.s-q{font-size:12.5px;line-height:1.45;margin-top:8px}\n.wave{display:flex;align-items:flex-end;gap:2px;height:34px;margin-top:10px}\n.wave i{flex:1;background:var(--support);border-radius:1px}\n.wave i:nth-child(4n+1){height:30%}.wave i:nth-child(4n+2){height:76%}\n.wave i:nth-child(4n+3){height:48%}.wave i:nth-child(4n+4){height:94%}\n.answer{display:flex;align-items:center;gap:8px;margin-top:10px;background:rgba(242,244,255,.07);border:1px solid rgba(242,244,255,.14);border-radius:6px;padding:7px 9px}\n.mic{width:26px;height:26px;border-radius:50%;background:var(--support);color:#13293D;display:flex;align-items:center;justify-content:center;font-size:12px;flex:none}\n.answer span{font-size:10px;color:rgba(242,244,255,.66);line-height:1.35}\n.answer b{color:#F2F4FF;font-weight:500}\n\n/* stats */\n.stats{display:grid;grid-template-columns:1fr 1fr;border-top:1px solid var(--line);margin-top:22px}\n.stat{padding:14px 0;border-bottom:1px solid var(--line)}\n.stat:nth-child(odd){border-right:1px solid var(--line);padding-right:12px}\n.stat:nth-child(even){padding-left:14px}\n.stat b{font-family:'Share Tech Mono',monospace;font-size:23px;font-weight:400;display:block}\n.stat span{font-size:10.5px;color:var(--ink70);display:block;margin-top:2px;line-height:1.35}\n\n/* section shell */\n.sec{padding:26px 0}\n.sec-h{display:flex;align-items:flex-end;justify-content:space-between;gap:12px;margin-bottom:14px}\n.sec-h h2{font-size:21px;font-weight:600;letter-spacing:-.02em;line-height:1.15}\n.sec-h span{font-size:10.5px;color:var(--ink50);flex:none;padding-bottom:2px}\n.sec-note{font-size:11.5px;color:var(--ink70);line-height:1.5;margin-top:-6px;margin-bottom:13px}\n\n/* steps track */\n.track{display:flex;gap:9px;overflow-x:auto;scroll-snap-type:x mandatory;padding-bottom:4px}\n.step{flex:0 0 79%;scroll-snap-align:start;background:var(--ground);border:1px solid var(--line2);border-radius:8px;padding:13px 14px}\n.step .n{font-family:'Share Tech Mono',monospace;font-size:10.5px;color:var(--accent)}\n.step h3{font-size:14px;font-weight:600;margin-top:4px}\n.step p{font-size:11.5px;color:var(--ink70);line-height:1.45;margin-top:3px}\n.track-cap{display:flex;align-items:center;gap:6px;margin-top:10px;font-size:10px;color:var(--ink50)}\n.track-cap .bar{flex:1;height:2px;background:rgba(19,41,61,.14)}\n.track-cap .bar i{display:block;height:2px;width:20%;background:var(--accent)}\n\n/* categories */\n.catgrid{display:grid;grid-template-columns:1fr 1fr;gap:6px}\n.cat{display:flex;align-items:center;gap:7px;border:1px solid var(--line);background:#fff;border-radius:6px;padding:9px 10px;font-size:11.5px;font-weight:500}\n.cat i{font-size:13px;color:var(--accent)}\n.cat-all{display:flex;align-items:center;justify-content:space-between;margin-top:10px;font-size:11.5px;color:var(--accent);font-weight:500}\n\n/* personas */\n.pc{flex:0 0 68%;scroll-snap-align:start;border:1px solid var(--line);background:#fff;border-radius:8px;padding:12px 13px}\n.pc b{font-size:13px;display:block}\n.pc em{font-style:normal;font-family:'Share Tech Mono',monospace;font-size:9px;color:var(--accent);border:1px solid var(--line2);border-radius:3px;padding:1px 5px;display:inline-block;margin-top:5px}\n.pc p{font-size:11px;color:var(--ink70);line-height:1.45;margin-top:6px}\n\n/* languages */\n.langbox{background:var(--ink);border-radius:8px;padding:15px;color:#F2F4FF}\n.langbox h3{font-size:14px;font-weight:600}\n.langbox p{font-size:10.5px;color:rgba(242,244,255,.58);line-height:1.5;margin-top:4px}\n.chips{display:flex;flex-wrap:wrap;gap:5px;margin-top:11px}\n.lchip{font-size:10.5px;padding:4px 8px;border:1px solid rgba(242,244,255,.26);border-radius:4px}\n.lchip.on{background:var(--support);border-color:var(--support);color:#13293D;font-weight:500}\n\n/* features list */\n.flist{border-top:1px solid var(--line)}\n.frow{display:grid;grid-template-columns:16px 1fr 12px;gap:10px;align-items:center;padding:12px 0;border-bottom:1px solid var(--line)}\n.frow i:first-child{font-size:14px;color:var(--accent)}\n.frow b{font-size:13px;display:block;font-weight:600}\n.frow span{font-size:11px;color:var(--ink70);display:block;margin-top:2px}\n.frow .ar{font-size:12px;color:var(--ink50)}\n\n/* pricing */\n.segbar{display:flex;border:1px solid var(--line2);border-radius:6px;overflow:hidden;background:#fff;margin-bottom:12px}\n.segbar span{flex:1;text-align:center;font-size:11.5px;padding:8px 0;border-left:1px solid var(--line);color:var(--ink70)}\n.segbar span:first-child{border-left:0}\n.segbar span.on{background:var(--ink);color:#F2F4FF;font-weight:600}\n.plan{border:1px solid var(--line2);border-radius:8px;background:#fff;padding:14px}\n.plan-top{display:flex;align-items:baseline;justify-content:space-between}\n.plan h3{font-size:14px;font-weight:600}\n.price b{font-size:24px;font-weight:600;letter-spacing:-.02em}\n.price span{font-size:10.5px;color:var(--ink50);margin-left:3px}\n.plan .who{font-size:11px;color:var(--ink70);margin-top:4px;line-height:1.45}\n.limits{margin:10px 0 12px}\n.limits div{display:flex;justify-content:space-between;font-size:11.5px;padding:6px 0;border-top:1px dashed rgba(19,41,61,.14);color:var(--ink70)}\n.limits b{font-family:'Share Tech Mono',monospace;font-weight:400;font-size:11px;color:var(--ink)}\n.plan-note{font-size:10px;color:var(--ink50);margin-top:9px;line-height:1.45}\n\n/* faq */\n.faq{border-top:1px solid var(--line)}\n.fq{padding:11px 0;border-bottom:1px solid var(--line)}\n.fq-top{display:flex;align-items:center;gap:10px}\n.fq-top h4{font-size:12.5px;font-weight:600;flex:1;line-height:1.35}\n.fq-top i{font-size:13px;color:var(--accent)}\n.fq p{font-size:11px;color:var(--ink70);line-height:1.55;margin-top:6px}\n\n/* cta + footer */\n.closer{padding:26px 0 24px;text-align:left}\n.closer h2{font-size:23px;line-height:1.1;letter-spacing:-.025em;font-weight:600}\n.closer p{font-size:11.5px;color:var(--ink70);margin-top:8px}\n.closer .btn-full{margin-top:14px}\n.foot{padding:20px 0 16px;border-top:1px solid var(--line);background:var(--ground)}\n.f-grid{display:grid;grid-template-columns:1fr 1fr;gap:16px}\n.f-grid h5{font-family:'Share Tech Mono',monospace;font-size:9px;text-transform:uppercase;letter-spacing:.08em;color:var(--ink50);margin-bottom:8px;font-weight:400}\n.f-grid li{font-size:11px;color:var(--ink70);margin-bottom:6px}\n.f-brand{grid-column:1/-1;padding-bottom:12px;border-bottom:1px solid var(--line)}\n.f-brand p{font-size:10.5px;color:var(--ink70);margin-top:8px;line-height:1.5}\n.f-bottom{display:flex;align-items:center;justify-content:space-between;margin-top:12px;font-size:10px;color:var(--ink50)}\n.f-bottom .soc{display:flex;gap:10px;font-size:13px}\n\n/* gutters win over section shorthand padding */\n.pad{padding-left:20px;padding-right:20px}\n</style>\n<header class=\"nav pad\" data-kid=\"1\">\n<a class=\"brand\" data-kid=\"1-1\" href=\"/\"><span class=\"mark\" data-kid=\"1-1-1\"><i data-kid=\"1-1-1-1\"></i><i data-kid=\"1-1-1-2\"></i><i data-kid=\"1-1-1-3\"></i></span>MockMate AI</a>\n<div class=\"nav-right\" data-kid=\"1-2\">\n<a class=\"btn btn-primary\" data-kid=\"1-2-1\" href=\"/signup\" style=\"padding:8px 11px;font-size:12px\">Start free</a>\n<span class=\"burger\" data-kid=\"1-2-2\"><i data-kid=\"1-2-2-1\"></i><i data-kid=\"1-2-2-2\"></i><i data-kid=\"1-2-2-3\"></i></span>\n</div>\n</header>\n<main data-kid=\"2\">\n<section class=\"hero pad\" data-kid=\"2-1\">\n<h1 data-kid=\"2-1-1\">Practice Smarter.<br data-kid=\"2-1-1-1\"/>Interview Better.<br data-kid=\"2-1-1-2\"/>Get Career Ready.</h1>\n<p data-kid=\"2-1-2\">AI mock interviews with voice answers, resume-based questions and a scored report for every course.</p>\n<div class=\"hero-cta\" data-kid=\"2-1-3\">\n<a class=\"btn btn-primary btn-full\" data-kid=\"2-1-3-1\" href=\"/signup\">Start Free Interview</a>\n<a class=\"hero-link\" data-kid=\"2-1-3-2\" href=\"/how-it-works\">See how it works <i class=\"icon-arrow-right\" data-kid=\"2-1-3-2-1\"></i></a>\n</div>\n<p class=\"micro\" data-kid=\"2-1-4\">Free plan: 3 interviews a month, no card required.</p>\n<div class=\"sample\" data-kid=\"2-1-5\">\n<div class=\"s-top\" data-kid=\"2-1-5-1\">\n<span class=\"chip on\" data-kid=\"2-1-5-1-1\">Technical</span><span class=\"chip\" data-kid=\"2-1-5-1-2\">BCA</span><span class=\"chip\" data-kid=\"2-1-5-1-3\">Medium</span>\n<span class=\"s-time\" data-dynamic=\"true\" data-kid=\"2-1-5-1-4\" data-name=\"demo session countdown timer\" data-reason=\"timer text reinitializes each second by countdown script\">18:42 left</span>\n</div>\n<p class=\"s-q\" data-kid=\"2-1-5-2\">You mentioned a payment webhook. What happens when the same event arrives twice?</p>\n<div aria-hidden=\"true\" class=\"wave\" data-kid=\"2-1-5-3\">\n<i data-kid=\"2-1-5-3-1\"></i><i data-kid=\"2-1-5-3-2\"></i><i data-kid=\"2-1-5-3-3\"></i><i data-kid=\"2-1-5-3-4\"></i><i data-kid=\"2-1-5-3-5\"></i><i data-kid=\"2-1-5-3-6\"></i><i data-kid=\"2-1-5-3-7\"></i><i data-kid=\"2-1-5-3-8\"></i><i data-kid=\"2-1-5-3-9\"></i><i data-kid=\"2-1-5-3-10\"></i><i data-kid=\"2-1-5-3-11\"></i><i data-kid=\"2-1-5-3-12\"></i><i data-kid=\"2-1-5-3-13\"></i><i data-kid=\"2-1-5-3-14\"></i><i data-kid=\"2-1-5-3-15\"></i><i data-kid=\"2-1-5-3-16\"></i><i data-kid=\"2-1-5-3-17\"></i><i data-kid=\"2-1-5-3-18\"></i><i data-kid=\"2-1-5-3-19\"></i><i data-kid=\"2-1-5-3-20\"></i><i data-kid=\"2-1-5-3-21\"></i><i data-kid=\"2-1-5-3-22\"></i><i data-kid=\"2-1-5-3-23\"></i><i data-kid=\"2-1-5-3-24\"></i>\n</div>\n<div class=\"answer\" data-kid=\"2-1-5-4\">\n<span class=\"mic\" data-kid=\"2-1-5-4-1\"><i class=\"icon-mic\" data-kid=\"2-1-5-4-1-1\"></i></span>\n<span data-kid=\"2-1-5-4-2\"><b data-kid=\"2-1-5-4-2-1\">Listening</b><br data-kid=\"2-1-5-4-2-2\"/>Answer in English or switch language</span>\n<span class=\"chip\" data-dynamic=\"true\" data-kid=\"2-1-5-4-3\" data-name=\"response duration chip\" data-reason=\"duration text reinitializes by elapsed recording script\" style=\"margin-left:auto\">00:14</span>\n</div>\n</div>\n<div class=\"stats\" data-kid=\"2-1-6\">\n<div class=\"stat\" data-kid=\"2-1-6-1\"><b data-kid=\"2-1-6-1-1\">10</b><span data-kid=\"2-1-6-1-2\">interview categories</span></div>\n<div class=\"stat\" data-kid=\"2-1-6-2\"><b data-kid=\"2-1-6-2-1\">11</b><span data-kid=\"2-1-6-2-2\">interview languages</span></div>\n<div class=\"stat\" data-kid=\"2-1-6-3\"><b data-kid=\"2-1-6-3-1\">6</b><span data-kid=\"2-1-6-3-2\">interviewer personalities</span></div>\n<div class=\"stat\" data-kid=\"2-1-6-4\"><b data-kid=\"2-1-6-4-1\">4</b><span data-kid=\"2-1-6-4-2\">coding languages</span></div>\n</div>\n</section>\n<section class=\"sec band\" data-kid=\"2-2\">\n<div class=\"pad\" data-kid=\"2-2-1\">\n<div class=\"sec-h\" data-kid=\"2-2-1-1\"><h2 data-kid=\"2-2-1-1-1\">How a session runs</h2><span data-kid=\"2-2-1-1-2\">5 steps</span></div>\n<div aria-label=\"Five steps of a session\" class=\"track\" data-kid=\"2-2-1-2\">\n<div class=\"step\" data-kid=\"2-2-1-2-1\"><span class=\"n\" data-kid=\"2-2-1-2-1-1\">01</span><h3 data-kid=\"2-2-1-2-1-2\">Create your profile</h3><p data-kid=\"2-2-1-2-1-3\">Course, year, experience level, target role.</p></div>\n<div class=\"step\" data-kid=\"2-2-1-2-2\"><span class=\"n\" data-kid=\"2-2-1-2-2-1\">02</span><h3 data-kid=\"2-2-1-2-2-2\">Choose your goal</h3><p data-kid=\"2-2-1-2-2-3\">Category and role, from BCA fresher to analyst.</p></div>\n<div class=\"step\" data-kid=\"2-2-1-2-3\"><span class=\"n\" data-kid=\"2-2-1-2-3-1\">03</span><h3 data-kid=\"2-2-1-2-3-2\">Pick a language</h3><p data-kid=\"2-2-1-2-3-3\">Any of 11, including Hinglish, per session.</p></div>\n<div class=\"step\" data-kid=\"2-2-1-2-4\"><span class=\"n\" data-kid=\"2-2-1-2-4-1\">04</span><h3 data-kid=\"2-2-1-2-4-2\">Start your interview</h3><p data-kid=\"2-2-1-2-4-3\">Voice or text, with adaptive follow-ups.</p></div>\n<div class=\"step\" data-kid=\"2-2-1-2-5\"><span class=\"n\" data-kid=\"2-2-1-2-5-1\">05</span><h3 data-kid=\"2-2-1-2-5-2\">Read your report</h3><p data-kid=\"2-2-1-2-5-3\">Rubric scores, missed points, better answers.</p></div>\n</div>\n<div class=\"track-cap\" data-kid=\"2-2-1-3\"><span data-dynamic=\"true\" data-kid=\"2-2-1-3-1\" data-name=\"current step indicator text\" data-reason=\"text reinitializes to reflect active step as track scrolls\">Step 1 of 5</span><span class=\"bar\" data-kid=\"2-2-1-3-2\"><i data-dynamic=\"true\" data-kid=\"2-2-1-3-2-1\" data-name=\"progress bar fill\" data-reason=\"fill width reinitializes based on active step in track\"></i></span><span data-kid=\"2-2-1-3-3\">Swipe</span></div>\n</div>\n</section>\n<section class=\"sec pad\" data-kid=\"2-3\">\n<div class=\"sec-h\" data-kid=\"2-3-1\"><h2 data-kid=\"2-3-1-1\">Interview categories</h2><span data-kid=\"2-3-1-2\">10</span></div>\n<div class=\"catgrid\" data-kid=\"2-3-2\">\n<a class=\"cat\" data-kid=\"2-3-2-1\" href=\"/technical-interview\"><i class=\"icon-cpu\" data-kid=\"2-3-2-1-1\"></i>Technical</a>\n<a class=\"cat\" data-kid=\"2-3-2-2\" href=\"/hr-interview\"><i class=\"icon-users\" data-kid=\"2-3-2-2-1\"></i>HR</a>\n<a class=\"cat\" data-kid=\"2-3-2-3\" href=\"/resume-based-interview\"><i class=\"icon-file-text\" data-kid=\"2-3-2-3-1\"></i>Resume</a>\n<a class=\"cat\" data-kid=\"2-3-2-4\" href=\"/coding-interview\"><i class=\"icon-code\" data-kid=\"2-3-2-4-1\"></i>Coding</a>\n<a class=\"cat\" data-kid=\"2-3-2-5\" href=\"/features\"><i class=\"icon-briefcase\" data-kid=\"2-3-2-5-1\"></i>Management</a>\n<a class=\"cat\" data-kid=\"2-3-2-6\" href=\"/interview-preparation/bcom\"><i class=\"icon-calculator\" data-kid=\"2-3-2-6-1\"></i>Commerce</a>\n<a class=\"cat\" data-kid=\"2-3-2-7\" href=\"/interview-preparation/bsc\"><i class=\"icon-flask-conical\" data-kid=\"2-3-2-7-1\"></i>Science</a>\n<a class=\"cat\" data-kid=\"2-3-2-8\" href=\"/interview-preparation/law\"><i class=\"icon-scale\" data-kid=\"2-3-2-8-1\"></i>Law</a>\n<a class=\"cat\" data-kid=\"2-3-2-9\" href=\"/interview-preparation/medical\"><i class=\"icon-stethoscope\" data-kid=\"2-3-2-9-1\"></i>Medical</a>\n<a class=\"cat\" data-kid=\"2-3-2-10\" href=\"/interview-for-freshers\"><i class=\"icon-compass\" data-kid=\"2-3-2-10-1\"></i>General</a>\n</div>\n<a class=\"cat-all\" data-kid=\"2-3-3\" href=\"/features\"><span data-kid=\"2-3-3-1\">All 10 categories with question banks per course</span><i class=\"icon-arrow-right\" data-kid=\"2-3-3-2\"></i></a>\n</section>\n<section class=\"sec pad\" data-kid=\"2-4\" style=\"padding-top:0\">\n<div class=\"sec-h\" data-kid=\"2-4-1\"><h2 data-kid=\"2-4-1-1\">Who interviews you</h2><span data-kid=\"2-4-1-2\">6 chairs</span></div>\n<div class=\"track\" data-kid=\"2-4-2\">\n<div class=\"pc\" data-kid=\"2-4-2-1\"><b data-kid=\"2-4-2-1-1\">Friendly</b><em data-kid=\"2-4-2-1-2\">First attempts</em><p data-kid=\"2-4-2-1-3\">Warm tone, longer answers, gentle follow-ups.</p></div>\n<div class=\"pc\" data-kid=\"2-4-2-2\"><b data-kid=\"2-4-2-2-1\">Professional</b><em data-kid=\"2-4-2-2-2\">Real conditions</em><p data-kid=\"2-4-2-2-3\">Neutral tone, keeps to the agenda and the clock.</p></div>\n<div class=\"pc\" data-kid=\"2-4-2-3\"><b data-kid=\"2-4-2-3-1\">Strict</b><em data-kid=\"2-4-2-3-2\">Pressure rounds</em><p data-kid=\"2-4-2-3-3\">Presses on thin answers and asks for evidence.</p></div>\n<div class=\"pc\" data-kid=\"2-4-2-4\"><b data-kid=\"2-4-2-4-1\">Technical Expert</b><em data-kid=\"2-4-2-4-2\">Technical</em><p data-kid=\"2-4-2-4-3\">Follows project decisions down to fundamentals.</p></div>\n</div>\n</section>\n<section class=\"sec pad\" data-kid=\"2-5\" style=\"padding-top:0\">\n<div class=\"langbox\" data-kid=\"2-5-1\">\n<h3 data-kid=\"2-5-1-1\">Interview languages</h3>\n<p data-kid=\"2-5-1-2\">Interface in English. Questions, follow-ups and the report in the language you pick.</p>\n<div class=\"chips\" data-kid=\"2-5-1-3\">\n<span class=\"lchip on\" data-kid=\"2-5-1-3-1\">English</span><span class=\"lchip\" data-kid=\"2-5-1-3-2\">हिन्दी</span><span class=\"lchip\" data-kid=\"2-5-1-3-3\">Hinglish</span><span class=\"lchip\" data-kid=\"2-5-1-3-4\">বাংলা</span><span class=\"lchip\" data-kid=\"2-5-1-3-5\">தமிழ்</span><span class=\"lchip\" data-kid=\"2-5-1-3-6\">తెలుగు</span><span class=\"lchip\" data-kid=\"2-5-1-3-7\">मराठी</span><span class=\"lchip\" data-kid=\"2-5-1-3-8\">ગુજરાતી</span><span class=\"lchip\" data-kid=\"2-5-1-3-9\">ಕನ್ನಡ</span><span class=\"lchip\" data-kid=\"2-5-1-3-10\">മലയാളം</span><span class=\"lchip\" data-kid=\"2-5-1-3-11\">ਪੰਜਾਬੀ</span>\n</div>\n</div>\n</section>\n<section class=\"sec band\" data-kid=\"2-6\">\n<div class=\"pad\" data-kid=\"2-6-1\">\n<div class=\"sec-h\" data-kid=\"2-6-1-1\"><h2 data-kid=\"2-6-1-1-1\">In every session</h2><span data-kid=\"2-6-1-1-2\">6 tools</span></div>\n<div class=\"flist\" data-kid=\"2-6-1-2\">\n<a class=\"frow\" data-kid=\"2-6-1-2-1\" href=\"/ai-mock-interview\"><i class=\"icon-mic\" data-kid=\"2-6-1-2-1-1\"></i><div data-kid=\"2-6-1-2-1-2\"><b data-kid=\"2-6-1-2-1-2-1\">Voice answers</b><span data-kid=\"2-6-1-2-1-2-2\">Speech-to-text with a typed fallback</span></div><i class=\"icon-arrow-up-right ar\" data-kid=\"2-6-1-2-1-3\"></i></a>\n<a class=\"frow\" data-kid=\"2-6-1-2-2\" href=\"/resume-based-interview\"><i class=\"icon-file-text\" data-kid=\"2-6-1-2-2-1\"></i><div data-kid=\"2-6-1-2-2-2\"><b data-kid=\"2-6-1-2-2-2-1\">Resume questions</b><span data-kid=\"2-6-1-2-2-2-2\">PDF or DOCX, parsed privately</span></div><i class=\"icon-arrow-up-right ar\" data-kid=\"2-6-1-2-2-3\"></i></a>\n<a class=\"frow\" data-kid=\"2-6-1-2-3\" href=\"/coding-interview\"><i class=\"icon-code\" data-kid=\"2-6-1-2-3-1\"></i><div data-kid=\"2-6-1-2-3-2\"><b data-kid=\"2-6-1-2-3-2-1\">Coding round</b><span data-kid=\"2-6-1-2-3-2-2\">C++, Java, Python, JavaScript</span></div><i class=\"icon-arrow-up-right ar\" data-kid=\"2-6-1-2-3-3\"></i></a>\n<a class=\"frow\" data-kid=\"2-6-1-2-4\" href=\"/features\"><i class=\"icon-note\" data-kid=\"2-6-1-2-4-1\"></i><div data-kid=\"2-6-1-2-4-2\"><b data-kid=\"2-6-1-2-4-2-1\">Scored report</b><span data-kid=\"2-6-1-2-4-2-2\">Rubric notes and better answers</span></div><i class=\"icon-arrow-up-right ar\" data-kid=\"2-6-1-2-4-3\"></i></a>\n<a class=\"frow\" data-kid=\"2-6-1-2-5\" href=\"/dashboard/progress\" style=\"border-bottom:0\"><i class=\"icon-chart-line\" data-kid=\"2-6-1-2-5-1\"></i><div data-kid=\"2-6-1-2-5-2\"><b data-kid=\"2-6-1-2-5-2-1\">Progress</b><span data-kid=\"2-6-1-2-5-2-2\">Score by category across attempts</span></div><i class=\"icon-arrow-up-right ar\" data-kid=\"2-6-1-2-5-3\"></i></a>\n</div>\n</div>\n</section>\n<section class=\"sec pad\" data-kid=\"2-7\">\n<div class=\"sec-h\" data-kid=\"2-7-1\"><h2 data-kid=\"2-7-1-1\">Pricing</h2><span data-kid=\"2-7-1-2\">3 plans</span></div>\n<div class=\"segbar\" data-kid=\"2-7-2\"><span class=\"on\" data-kid=\"2-7-2-1\">Free</span><span data-kid=\"2-7-2-2\">Starter</span><span data-kid=\"2-7-2-3\">Pro</span></div>\n<div class=\"plan\" data-kid=\"2-7-3\">\n<div class=\"plan-top\" data-kid=\"2-7-3-1\"><h3 data-kid=\"2-7-3-1-1\">Free</h3><span class=\"price\" data-kid=\"2-7-3-1-2\"><b data-kid=\"2-7-3-1-2-1\">₹0</b><span data-kid=\"2-7-3-1-2-2\">/ month</span></span></div>\n<p class=\"who\" data-kid=\"2-7-3-2\">For a first look at how an AI interview feels.</p>\n<div class=\"limits\" data-kid=\"2-7-3-3\">\n<div data-kid=\"2-7-3-3-1\"><span data-kid=\"2-7-3-3-1-1\">AI interviews</span><b data-kid=\"2-7-3-3-1-2\">3 / mo</b></div>\n<div data-kid=\"2-7-3-3-2\"><span data-kid=\"2-7-3-3-2-1\">Answer mode</span><b data-kid=\"2-7-3-3-2-2\">Text</b></div>\n<div data-kid=\"2-7-3-3-3\"><span data-kid=\"2-7-3-3-3-1\">Saved resumes</span><b data-kid=\"2-7-3-3-3-2\">1</b></div>\n<div data-kid=\"2-7-3-3-4\"><span data-kid=\"2-7-3-3-4-1\">Report</span><b data-kid=\"2-7-3-3-4-2\">Basic</b></div>\n</div>\n<a class=\"btn btn-primary btn-full\" data-kid=\"2-7-3-4\" href=\"/signup\">Start free</a>\n<p class=\"plan-note\" data-kid=\"2-7-3-5\">Starter adds voice, resume questions and full reports at ₹399 a month.</p>\n</div>\n<p class=\"plan-note\" data-kid=\"2-7-4\" style=\"margin-top:10px\">Prices in INR, inclusive of GST. Introductory pricing, subject to change.</p>\n</section>\n<section class=\"sec pad\" data-kid=\"2-8\" style=\"padding-top:0\">\n<div class=\"sec-h\" data-kid=\"2-8-1\"><h2 data-kid=\"2-8-1-1\">Before you sign up</h2></div>\n<div class=\"faq\" data-kid=\"2-8-2\">\n<div class=\"fq\" data-kid=\"2-8-2-1\"><div class=\"fq-top\" data-kid=\"2-8-2-1-1\"><h4 data-kid=\"2-8-2-1-1-1\">Do I have to interview in English?</h4><i class=\"icon-minus\" data-kid=\"2-8-2-1-1-2\"></i></div><p data-kid=\"2-8-2-1-2\">No. Choose any of the 11 languages before a session, including Hinglish. Follow-ups and the report stay in that language.</p></div>\n<div class=\"fq\" data-kid=\"2-8-2-2\"><div class=\"fq-top\" data-kid=\"2-8-2-2-1\"><h4 data-kid=\"2-8-2-2-1-1\">Will the questions fit my course?</h4><i class=\"icon-plus\" data-kid=\"2-8-2-2-1-2\"></i></div></div>\n<div class=\"fq\" data-kid=\"2-8-2-3\"><div class=\"fq-top\" data-kid=\"2-8-2-3-1\"><h4 data-kid=\"2-8-2-3-1-1\">How is an answer scored?</h4><i class=\"icon-plus\" data-kid=\"2-8-2-3-1-2\"></i></div></div>\n<div class=\"fq\" data-kid=\"2-8-2-4\"><div class=\"fq-top\" data-kid=\"2-8-2-4-1\"><h4 data-kid=\"2-8-2-4-1-1\">Who can read my resume?</h4><i class=\"icon-plus\" data-kid=\"2-8-2-4-1-2\"></i></div></div>\n</div>\n</section>\n<section class=\"closer band pad\" data-kid=\"2-9\">\n<h2 data-kid=\"2-9-1\">Your Next Interview Starts Here.</h2>\n<p data-kid=\"2-9-2\">Free plan: 3 interviews a month, text mode, no card.</p>\n<a class=\"btn btn-primary btn-full\" data-kid=\"2-9-3\" href=\"/signup\">Start Free Interview</a>\n</section>\n</main>\n<footer class=\"foot pad\" data-kid=\"3\">\n<div class=\"f-grid\" data-kid=\"3-1\">\n<div class=\"f-brand\" data-kid=\"3-1-1\">\n<a class=\"brand\" data-kid=\"3-1-1-1\" href=\"/\"><span class=\"mark\" data-kid=\"3-1-1-1-1\"><i data-kid=\"3-1-1-1-1-1\"></i><i data-kid=\"3-1-1-1-1-2\"></i><i data-kid=\"3-1-1-1-1-3\"></i></span>MockMate AI</a>\n<p data-kid=\"3-1-1-2\">AI mock interviews for every course and career path. Interface in English, interviews in 11 languages.</p>\n</div>\n<div data-kid=\"3-1-2\">\n<h5 data-kid=\"3-1-2-1\">Product</h5>\n<ul data-kid=\"3-1-2-2\"><li data-kid=\"3-1-2-2-1\"><a data-kid=\"3-1-2-2-1-1\" href=\"/features\">Features</a></li><li data-kid=\"3-1-2-2-2\"><a data-kid=\"3-1-2-2-2-1\" href=\"/how-it-works\">How it works</a></li><li data-kid=\"3-1-2-2-3\"><a data-kid=\"3-1-2-2-3-1\" href=\"/pricing\">Pricing</a></li></ul>\n</div>\n<div data-kid=\"3-1-3\">\n<h5 data-kid=\"3-1-3-1\">Practice</h5>\n<ul data-kid=\"3-1-3-2\"><li data-kid=\"3-1-3-2-1\"><a data-kid=\"3-1-3-2-1-1\" href=\"/interview-questions\">Questions</a></li><li data-kid=\"3-1-3-2-2\"><a data-kid=\"3-1-3-2-2-1\" href=\"/coding-interview\">Coding</a></li><li data-kid=\"3-1-3-2-3\"><a data-kid=\"3-1-3-2-3-1\" href=\"/blog\">Blog</a></li></ul>\n</div>\n<div data-kid=\"3-1-4\">\n<h5 data-kid=\"3-1-4-1\">Company</h5>\n<ul data-kid=\"3-1-4-2\"><li data-kid=\"3-1-4-2-1\"><a data-kid=\"3-1-4-2-1-1\" href=\"/about\">About</a></li><li data-kid=\"3-1-4-2-2\"><a data-kid=\"3-1-4-2-2-1\" href=\"/contact\">Contact</a></li><li data-kid=\"3-1-4-2-3\"><a data-kid=\"3-1-4-2-3-1\" href=\"/faq\">FAQ</a></li></ul>\n</div>\n<div data-kid=\"3-1-5\">\n<h5 data-kid=\"3-1-5-1\">Legal</h5>\n<ul data-kid=\"3-1-5-2\"><li data-kid=\"3-1-5-2-1\"><a data-kid=\"3-1-5-2-1-1\" href=\"/privacy\">Privacy</a></li><li data-kid=\"3-1-5-2-2\"><a data-kid=\"3-1-5-2-2-1\" href=\"/terms\">Terms</a></li><li data-kid=\"3-1-5-2-3\"><a data-kid=\"3-1-5-2-3-1\" href=\"/cookies\">Cookies</a></li></ul>\n</div>\n</div>\n<div class=\"f-bottom\" data-kid=\"3-2\">\n<span data-kid=\"3-2-1\">© 2026 MockMate AI</span>\n<div class=\"soc\" data-kid=\"3-2-2\"><i class=\"icon-linkedin\" data-kid=\"3-2-2-1\"></i><i class=\"icon-instagram\" data-kid=\"3-2-2-2\"></i><i class=\"icon-youtube\" data-kid=\"3-2-2-3\"></i></div>\n</div>\n</footer>",
      "comments": [],
      "created": "2026-11-10T15:20:03.473018+00:00",
      "modified": "2026-11-10T15:23:09.586412+00:00",
