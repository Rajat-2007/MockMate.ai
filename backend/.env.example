# Copy to backend/.env for local development. Never commit real secrets.

APP_NAME="MockMate AI API"
ENVIRONMENT=local
DEBUG=true
VERSION=0.1.0

# 32+ characters. Required in production; the app refuses to boot with the default.
SECRET_KEY=change-me-use-a-long-random-string

# Comma-separated list of allowed browser origins.
BACKEND_CORS_ORIGINS=http://localhost:3000

# PostgreSQL. Leave DATABASE_URL empty to run health checks in "not configured" mode.
DATABASE_URL=postgresql+psycopg://mockmate:mockmate@localhost:5432/mockmate
DB_ECHO=false

# Redis. Leave empty to skip the Redis health check.
REDIS_URL=redis://localhost:6379/0

# OpenAI-compatible AI provider. Keep the API key only in this backend env file.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=60

# Local LLM options retained for local development.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# File storage. local | s3
STORAGE_BACKEND=local
UPLOAD_DIR=./storage

# Payments. Empty values keep the checkout in an honest "not configured" state.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_BASE_URL=https://api.razorpay.com/v1
FOUNDER_EMAIL=founder@example.com
